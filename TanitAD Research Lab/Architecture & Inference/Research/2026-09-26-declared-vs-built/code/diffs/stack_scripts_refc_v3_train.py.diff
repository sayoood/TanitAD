+def trunk_equalize_rows_as_trained(config: dict) -> tuple[int, str]:
+    """``(rows, why)`` -- the C26 rows a RECORDED run's trunk ACTUALLY zeroed.
+
+    ⛔⛔ FOR EVERY REBUILD OF A PRE-FIX CHECKPOINT. Before 2026-09-26 (FIX-3) the value was an
+    undeclared attribute: with ``--image-hw`` the rebuild dropped it and the trunk trained with
+    0 rows (refcv6-r101-s0: argv 43, trunk 0); without ``--image-hw`` it survived. A tree with
+    the fix rebuilds EVERY such argv with the rows argv names -- a model the weights never
+    were. An eval loader rebuilding a recorded run must override the trunk (not the lift) to
+    this value when ``config.json`` predates the stamp.
+
+    * ``seams.trunk_equalize_bottom_rows`` present -> that (a post-fix record states it);
+    * else argv ``--equalize-bottom-rows N > 0`` with ``--image-hw`` -> ``0`` (DROPPED);
+    * else argv ``N`` (no rebuild ran, the attribute reached the trunk) or ``0``.
+    """
+    seams = config.get("seams") if isinstance(config, dict) else None
+    if isinstance(seams, dict) and "trunk_equalize_bottom_rows" in seams:
+        return int(seams["trunk_equalize_bottom_rows"]), "stamped (post-fix record)"
+    argv = list(config.get("argv") or []) if isinstance(config, dict) else []
+    n = 0
+    if "--equalize-bottom-rows" in argv:
+        n = int(argv[argv.index("--equalize-bottom-rows") + 1])
+    if n > 0 and "--image-hw" in argv:
+        return 0, (f"DROPPED: pre-fix record, argv --equalize-bottom-rows {n} with --image-hw "
+                   f"(D-REFCV6-EQUALIZE-DROPPED) -- the trunk trained with 0 rows")
+    return n, ("no --equalize-bottom-rows in argv" if n == 0 else
+               "pre-fix record without --image-hw: the attribute reached the trunk")
+
