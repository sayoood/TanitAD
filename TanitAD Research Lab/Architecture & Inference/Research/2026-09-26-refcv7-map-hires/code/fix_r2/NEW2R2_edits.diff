+                                         "near.lift.unobserved"]
+    assert all(torch.equal(sa[k], sb[k]) for k in sa)             # built LAST
+    with torch.no_grad():
+        la = a(f, *geo)["map_hires_logits"]
+        lb = b(f, *geo)["map_hires_logits"]
+    assert torch.equal(la, lb)                                     # zero-initialised
