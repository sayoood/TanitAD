+def _box_main_only(argv_sha):
+    """The box harness for `--arms main` (g_box_overfit main()): no must-fail arm, RESULT FAIL."""
+    r_ = _gbo_record(argv_sha, RESULT="FAIL")
+    del r_["arms"]["memory_zeros"], r_["arms"]["presence_w0"]
+    return r_
