# refcv6 (SPEC_REFCV6_V2) -- resnet101 primary, seed 0. THE LAUNCH MANIFEST, 2026-09-23.
# ⛔ Sourced ONCE by sup_refcv6.sh at startup (its rule 7): to change a live run, edit this file,
#    kill the SUPERVISOR first, then the trainer (by explicit pid), then start a fresh supervisor.
# Filled from `refcv6-r101-s0.env.template` (commit 284393c) with the MEASURED smoke decisions
# (LAUNCH_READINESS_FIXES.md sec. 10) and the PI's 2026-09-23 choices ("Full, ~4.0 days" and
# "Keep every 10th"): batch 16 by the pre-registered rule; STEPS = ceil(805,680 / 16) rounded up
# to 50 = 50,400 -- the pre-registered `full`, fixed in SAMPLES; conflict probe every 10th step.
export CODE=/home/nvidia/refcv6_run/82c2331a2f
# ⛔ CODE 284393c -> 287d72e at a checkpoint (2026-09-23; LOGGING ONLY -- the arm is unchanged):
#    287d72e writes a conflict reading that falls off the --log-every cadence as its own row.
#    Under 284393c every reading (steps 10k+1) was computed and discarded at LOG_EVERY 50.
export OUT=/home/nvidia/refcv6_run/runs/refcv6-r101-s0
export BATCH=16 STEPS=50400 CONFLICT_EVERY=10 WORKERS=6
export EVAL=1 EVAL_EVERY=500 EVAL_BATCHES=8 SAVE_EVERY=500 LOG_EVERY=50
export AGENT_JOIN=/home/nvidia/data/joins/b1_train_plus_eval_agents.jsonl.xz
export JOIN3D=/home/nvidia/data/join3d/b1_train_plus_eval_agents_3d.jsonl.xz
# the speed levers (sec. 8-10), each MEASURED on Thor and recorded by the trainer, read back
# from the BUILT trunk, in config.json `trunk_memory_levers`
export TRUNK_CHUNK=8 TRUNK_BF16=1 TRUNK_CL=1 TRUNK_FOLD_BN=1 TRUNK_DEDUP=1 TRUNK_COMPILE=1
# A16 2026-09-26 (PI: 'Stop now, resume with fixes'): the true label clock
export CLIP_CLOCK=/home/nvidia/data/refcv6_clip_clock_sidecar.jsonl
TRAIN_CMD="bash $CODE/ops/run_refcv6.sh"
OUT_DIR="$OUT"
MAX_RELAUNCH=4
POLL_S=300
