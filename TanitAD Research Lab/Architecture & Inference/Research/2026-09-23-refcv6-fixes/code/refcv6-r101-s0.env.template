# refcv6 (SPEC_REFCV6_V2) -- resnet101 primary, seed 0.
# ⛔ Sourced ONCE by sup_refcv6.sh at startup (its rule 7): to change a live run, edit this file,
#    kill the SUPERVISOR first, then the trainer (by explicit pid), then start a fresh supervisor.
# __B__ / __S__ / __N__ / __W__ are filled from the post-reboot smoke's metrics.jsonl
# (cuda_max_mem_gb, s/step); __S__ = ceil(805,680 / __B__) -- the budget is fixed in SAMPLES.
export CODE=/home/nvidia/refcv6_run/__TAG__
export OUT=/home/nvidia/refcv6_run/runs/refcv6-r101-s0
export BATCH=__B__ STEPS=__S__ CONFLICT_EVERY=__N__ WORKERS=__W__
export EVAL=1 EVAL_EVERY=500 EVAL_BATCHES=8 SAVE_EVERY=500 LOG_EVERY=50
export AGENT_JOIN=/home/nvidia/data/joins/b1_train_plus_eval_agents.jsonl.xz
export JOIN3D=/home/nvidia/data/join3d/b1_train_plus_eval_agents_3d.jsonl.xz
TRAIN_CMD="bash $CODE/ops/run_refcv6.sh"
OUT_DIR="$OUT"
MAX_RELAUNCH=4
POLL_S=300
