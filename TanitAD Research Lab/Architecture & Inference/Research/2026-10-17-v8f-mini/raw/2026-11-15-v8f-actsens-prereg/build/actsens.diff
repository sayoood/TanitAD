+def gate(init, name, extra=(), ck=True, base=BASE):
+    try:
+        rc = TR.main(["--out", str(init["root"] / name), *base, *(["--init-ckpt", str(init["ck"])] if ck else []), *extra, "--selfcheck-only"])
+    except SystemExit as e:
+        rc = e.code
+    return rc
