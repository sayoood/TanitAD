+def check_cell_shares(epoch_fn, windows, feats, *, n_batches: int = DIVRS_CHECK_BATCHES, tol: float = DIVRS_SHARE_TOL, min_expected: int = DIVRS_MIN_EXPECTED, yaw_edges=DIVRS_YAW_EDGES,
