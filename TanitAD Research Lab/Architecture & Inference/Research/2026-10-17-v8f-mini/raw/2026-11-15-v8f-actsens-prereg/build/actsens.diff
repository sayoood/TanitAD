+    for c in range(DIVRS_N_CELLS):
+        exp = float(tgt[c] * n_draws)
+        real = cnt[c] / n_draws
+        rel = None if tgt[c] == 0 else float(real / tgt[c] - 1.0)
+        resolved = tgt[c] > 0 and exp >= min_expected
