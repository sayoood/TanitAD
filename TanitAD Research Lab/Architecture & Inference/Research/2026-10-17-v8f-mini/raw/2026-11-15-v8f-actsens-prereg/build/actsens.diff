+
+    def epoch(self, ep: int):
+        rng = np.random.default_rng((self.seed, ep, 0xD1D5))
+        by_clip: dict = {}
+        for i, w in enumerate(self.windows):
+            by_clip.setdefault(w[0], []).append(i)
