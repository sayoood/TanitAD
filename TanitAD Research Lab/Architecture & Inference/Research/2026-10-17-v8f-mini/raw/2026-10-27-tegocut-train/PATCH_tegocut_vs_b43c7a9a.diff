+def _t_ego_train(base, batch, steps: int = 3, lr: float = 1e-3) -> dict:
+    """The training half of one branch (clauses d, e): live_check's own three AdamW steps on a COPY of ``base``. (d) the gradient accumulated on read_t, trunk_t, h_goal, h_lat, h_lon, h_cons and e_ego; (e) the buffer
+    is a buffer (not a Parameter) and its bytes after the steps."""
+    m = copy.deepcopy(base)
+    m.train()
+    r = {"e_is_a_buffer_not_a_parameter": bool(m.t_ego_c is not None and not m.t_ego_c.requires_grad and not any(p is m.t_ego_c for p in m.parameters()) and "t_ego_c" in dict(m.named_buffers()))}
+    before = m.t_ego_c.detach().clone() if m.t_ego_c is not None else None
+    grp = {"read_t": m.read_t, "trunk_t": m.trunk_t, "h_goal": m.h_goal, "h_lat": m.h_lat, "h_lon": m.h_lon, "h_cons": m.h_cons, "e_ego": m.e_ego}
+    acc = {k: 0.0 for k in grp}
+    opt = torch.optim.AdamW([p for p in m.parameters() if p.requires_grad], lr=lr)
+    for s_ in range(steps):
+        opt.zero_grad(set_to_none=False)
+        m.loss(batch, p_gt=0.5, gen=torch.Generator().manual_seed(s_))["terms"]["total"].backward()
+        for k, v in grp.items():
+            acc[k] += sum(float(p.grad.abs().sum()) for p in v.parameters() if p.grad is not None)
+        opt.step()
+    r["d_grad_by_group"] = acc
+    r["e_max_abs_change_of_c_after_3_steps"] = None if before is None else float((m.t_ego_c.detach() - before).abs().max())
+    return r
+
+
+def t_ego_probe(model, batch, cfg) -> dict:
+    """G-LIVE for PREREG_V8F_TEGOCUT: what T's ego token IS, read from the tensors the BUILT model's readers are handed in a forward of a COPY on the real probe batch (its own seeds; the donor is the batch's p10f rolled by
