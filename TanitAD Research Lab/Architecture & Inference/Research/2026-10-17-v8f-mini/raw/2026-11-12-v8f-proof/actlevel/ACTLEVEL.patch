+    old = AC.level_label_mask
+    try:
+        AC.level_label_mask = ns["level_label_mask"]
+        assert abs(float(AC.act_cons_term(m, adapt, bt, d, MAXOFF, level=True)["level"]) - 2.5) > 0.1      # label one frame early: RED
+    finally:
+        AC.level_label_mask = old
