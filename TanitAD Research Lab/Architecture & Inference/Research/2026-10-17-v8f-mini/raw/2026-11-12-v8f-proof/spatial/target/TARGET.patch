+def _loss(world, extra, **over):
+    a, cfg, model, opt, info = _built(world, extra, d_feat=world["batch"]["feats"].shape[-1], **over)
+    model.train()
+    out = model.loss(dict(world["batch"]), p_gt=0.5, gen=torch.Generator().manual_seed(11))
+    return model, out
+
