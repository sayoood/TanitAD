+class _SpatialBlock(nn.Module):
+    """Pre-LN transformer block, NOT causal: self-attention over the tokens of ONE time step (the cells plus one action token).
+
+    ``x <- x + Attn(LN(x))``, ``x <- x + MLP(LN(x))``. The action enters as a token of the sequence (the card's design),
+    so the block carries no modulation of its own. Hand-written on ``scaled_dot_product_attention`` like :class:`_AdaLNBlock`.
+    """
+
+    def __init__(self, width: int, heads: int, ff: int, dropout: float):
+        super().__init__()
+        if width % heads:
+            raise ValueError("width must be divisible by heads")
+        self.heads, self.dropout = heads, dropout
+        self.ln1 = nn.LayerNorm(width)
+        self.ln2 = nn.LayerNorm(width)
+        self.qkv = nn.Linear(width, 3 * width)
+        self.proj = nn.Linear(width, width)
+        self.mlp = nn.Sequential(nn.Linear(width, ff), nn.GELU(), nn.Dropout(dropout),
+                                 nn.Linear(ff, width), nn.Dropout(dropout))
+
+    def forward(self, x: Tensor) -> Tensor:
+        b, n, w = x.shape
+        q, k, v = self.qkv(self.ln1(x)).reshape(b, n, 3, self.heads, w // self.heads).permute(2, 0, 3, 1, 4)
+        a = F.scaled_dot_product_attention(q, k, v, is_causal=False,
+                                           dropout_p=self.dropout if self.training else 0.0)
+        x = x + self.proj(a.transpose(1, 2).reshape(b, n, w))
+        return x + self.mlp(self.ln2(x))
+
+
+class CellCausalPredictor(nn.Module):
+    """PREREG_V8F_PROOF_ADD16 (CELLPRED): a level-1 predictor that keeps the cell layout of the state.
+
+    Same interface as :class:`CausalPredictor`: ``forward(z_ctx [B, L, D], a_ctx [B, L, E]) -> [B, L, D]``, attribute
+    ``context``, ``latent_dim``, ``action_dim``; ``D = n_cells * cell_dim`` and the state is laid out cell-major (cell ``c``
+    owns the numbers ``c * cell_dim : (c + 1) * cell_dim``, the layout of ``WMAux.z1``). Position ``i`` of the output is
+    the prediction of ``z_{i+1}`` from ``z_{<= i}`` and ``a_{<= i}`` (teacher forcing) and no skip carries the input state
+    to the output (``residual`` is not offered).
+
+    * tokens: every cell of every step is one token; ONE shared ``Linear(cell_dim, width)`` embeds a cell; a learned cell
+      position (``n_cells``) and a learned time position (``context``) are added;
+    * ``depth`` layers, each = (a) :class:`_SpatialBlock` over the ``n_cells`` cells of ONE step plus one token that carries
+      the embedded action of that step (the action token is re-appended at every layer and its updated value is dropped),
+      then (b) :class:`_AdaLNBlock` (causal over time, conditioned on the action embedding exactly as the flat predictor)
+      applied to each cell's own sequence over time;
+    * output: ONE shared two-layer map per cell, ``width -> width -> cell_dim``.
+
+    ``in_proj`` is the per-cell embedding, so ``in_proj.weight.shape[0]`` is the predictor width, as for the flat predictor.
+    """
+
+    def __init__(self, latent_dim: int, action_dim: int, n_cells: int, width: int = 128, depth: int = 2,
+                 heads: int = 4, ff: Optional[int] = None, context: int = 3, dropout: float = 0.0,
+                 adaln_init: str = "identity_gate"):
+        super().__init__()
+        if n_cells < 2 or latent_dim % n_cells:
+            raise ValueError(f"latent_dim {latent_dim} must be a multiple of n_cells {n_cells} (n_cells >= 2)")
+        self.latent_dim, self.action_dim, self.context = latent_dim, action_dim, context
+        self.n_cells, self.cell_dim = n_cells, latent_dim // n_cells
+        self.in_proj = nn.Linear(self.cell_dim, width)
+        self.cell_pos = nn.Parameter(torch.randn(n_cells, width) * 0.02)
+        self.time_pos = nn.Parameter(torch.randn(context, width) * 0.02)
+        self.act_tok = nn.Linear(action_dim, width)
+        ff_ = ff or 4 * width
+        self.spatial = nn.ModuleList([_SpatialBlock(width, heads, ff_, dropout) for _ in range(depth)])
+        self.temporal = nn.ModuleList([_AdaLNBlock(width, heads, ff_, action_dim, dropout, adaln_init)
+                                       for _ in range(depth)])
+        self.final_ln = nn.LayerNorm(width)
+        self.out = nn.Sequential(nn.Linear(width, width), nn.GELU(), nn.Linear(width, self.cell_dim))
+
+    def forward(self, z_ctx: Tensor, a_ctx: Tensor) -> Tensor:
+        b, L, _ = z_ctx.shape
+        if L > self.context:
+            raise ValueError(f"context length {L} exceeds the predictor's {self.context}")
+        n = self.n_cells
+        x = self.in_proj(z_ctx.reshape(b, L, n, self.cell_dim))                       # [B, L, n, W]
+        x = x + self.cell_pos[None, None] + self.time_pos[:L][None, :, None]
+        w = x.shape[-1]
+        at = self.act_tok(a_ctx)                                                      # [B, L, W]: the embedded action of each step
+        cond = a_ctx[:, None].expand(b, n, L, a_ctx.shape[-1]).reshape(b * n, L, -1)  # the action of the step, for every cell's own sequence
+        for sp, tp in zip(self.spatial, self.temporal):
+            t = torch.cat([x, at[:, :, None]], dim=2).reshape(b * L, n + 1, w)        # cells of ONE step + the action token
+            x = sp(t).reshape(b, L, n + 1, w)[:, :, :n]
+            x = tp(x.permute(0, 2, 1, 3).reshape(b * n, L, w), cond)                  # causal over time, per cell
+            x = x.reshape(b, n, L, w).permute(0, 2, 1, 3)
+        y = self.out(self.final_ln(x))                                                # [B, L, n, cell_dim]
+        return y.reshape(b, L, n * self.cell_dim)
+
+
