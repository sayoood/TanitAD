+    @torch.no_grad()
+    def probe_pred(self) -> dict:
+        """PREREG_V8F_PROOF_ADD16 (c4, c2): what the BUILT level-1 predictor is. ``kind`` is read from the module's class and its per-cell embedding
+        (cell: ``in_proj`` takes ``latent_dim / n_cells`` numbers), never from the config; ``cross_cell`` is behavioural (changing ONE cell of the input
+        moves the prediction of the other cells; a dense flat map moves them too, so it does not by itself tell the kinds apart). ``params_flat_ref`` = the
+        parameter count of the flat predictor that this state width would get today (the c2 bound). Fixed generator: the global RNG stream is not touched."""
+        from tanitad.models.hjepa import CausalPredictor, CellCausalPredictor
+        pred = self.stack.predictors[0]
+        n = lambda m: int(sum(p.numel() for p in m.parameters()))   # noqa: E731
+        dev = next(pred.parameters()).device
+        g = torch.Generator().manual_seed(4321)
+        z = torch.randn(1, 1, pred.latent_dim, generator=g).to(dev)
+        a = torch.randn(1, 1, pred.action_dim, generator=g).to(dev)
+        cw = pred.latent_dim // self.n_tok
+        z2 = z.clone()
+        z2[..., :cw] += 1.0                                        # cell 0 only (cell-major layout)
+        was = self.training
+        self.eval()
+        try:
+            d = (pred(z, a) - pred(z2, a))[..., cw:].abs().max()
+        finally:
+            self.train(was)
+        in_f = int(pred.in_proj.weight.shape[1])
+        if isinstance(pred, CellCausalPredictor) and pred.n_cells > 1 and in_f * pred.n_cells == pred.latent_dim:
+            kind = "cell"
+        elif type(pred) is CausalPredictor and in_f == pred.latent_dim:
+            kind = "flat"
+        else:
