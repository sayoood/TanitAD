+    return {"pres": pres, "gap": gap32, "clos": clos32, "off": off, "sha256": h.hexdigest(), "n_rows": N, "n_pres": int(lv.sum()),
+            "n_gap": int(np.isfinite(gap32).sum()), "n_clos": int(np.isfinite(clos32).sum())}
