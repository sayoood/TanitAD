+    with torch.no_grad():
+        adapt = m._encode(batch)
+        last = torch.full((adapt.shape[0],), adapt.shape[1] - 1, dtype=torch.long, device=adapt.device)
+        u = m._lead_u(batch, adapt, last)
+        h = cfg.lead_hist
+        pos = last[:, None] - (h - 1 - torch.arange(h, device=adapt.device))[None]
+        rows = torch.gather(batch["frame_ok"], 1, pos).all(-1)
+        o = m.wm.lead_head(m.wm.z1(torch.gather(adapt, 1, pos[:, :, None, None].expand(-1, -1, adapt.shape[2], adapt.shape[3]))))[:, 0].float()
+        p, g = torch.sigmoid(o[:, 0])[rows], o[:, 1].clamp(0.0, M.LEAD_COND_GAP_MAX)[rows]
