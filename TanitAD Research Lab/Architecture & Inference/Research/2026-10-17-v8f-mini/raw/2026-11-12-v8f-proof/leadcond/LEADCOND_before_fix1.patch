+    ma = grads_of(m2, batch, cfg)
+    mb = grads_of(m2, batch, cfg, drop_path=True)
+    lead_names = [n for n, _ in m2.named_parameters() if n.startswith("wm.lead_head.")]
+    d_lead = max(float((ma[n] - mb[n]).abs().max()) for n in lead_names)
+    zc = grads(True)
+    rec = {"lead_cond": "on", "n_rows": n_rows, "n_batch": int(rows.numel()), "p_mean": float(p.mean()) if n_rows else None, "p_std": float(p.std()) if n_rows > 1 else None,
+           "g_mean": float(g.mean()) if n_rows else None, "g_std": float(g.std()) if n_rows > 1 else None, "u_abs_max": float(u.abs().max()),
+           "grad_norm_weight": gw, "grad_norm_bias": gb, "control_zero_u_grad_norm_weight": float(zc.lead_cond.weight.grad.abs().sum()), "control_zero_u_grad_norm_bias": float(zc.lead_cond.bias.grad.abs().sum()),
