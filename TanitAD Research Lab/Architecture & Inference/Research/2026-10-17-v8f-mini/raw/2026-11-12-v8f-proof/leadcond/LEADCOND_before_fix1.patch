+    if not (np.isfinite(gw) and gw > 0.0 and np.isfinite(gb) and gb > 0.0 and torch.isfinite(u).all() and np.isfinite(rec["p_mean"]) and np.isfinite(rec["g_mean"])):
+        raise AssertionError(f"lead cond probe: the token does not reach the loss (weight gradient {gw}, bias gradient {gb}) or u is not finite: {rec}")
+    if rec["control_zero_u_grad_norm_weight"] != 0.0 or not rec["control_zero_u_grad_norm_bias"] > 0.0:
