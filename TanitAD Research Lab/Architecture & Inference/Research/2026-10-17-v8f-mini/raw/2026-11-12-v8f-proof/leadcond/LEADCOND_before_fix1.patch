+        mm.zero_grad(set_to_none=True)
+        out = mm.loss(dict(batch), p_gt=0.5, gen=torch.Generator().manual_seed(11))
+        T = out["terms"]
+        plan = T["total"] - cfg.w_lead_sup * T["lead_sup"]                                  # the loss without the head's own term
+        plan.backward()
+        return mm
+
+    mm = grads(False)
+    gw, gb = float(mm.lead_cond.weight.grad.abs().sum()), float(mm.lead_cond.bias.grad.abs().sum())
