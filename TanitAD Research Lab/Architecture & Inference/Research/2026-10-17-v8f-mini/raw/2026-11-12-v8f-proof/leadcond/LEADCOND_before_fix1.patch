+def grads_of(model, batch, cfg, drop_path: bool = False) -> dict:
+    """Named gradients of the plan loss (total minus the lead_sup term) on a COPY; ``drop_path`` removes the lead_cond module (the token is not added)."""
+    mm = copy.deepcopy(model)
+    if drop_path:
+        mm.lead_cond = None
+    mm.zero_grad(set_to_none=True)
+    out = mm.loss(dict(batch), p_gt=0.5, gen=torch.Generator().manual_seed(11))
