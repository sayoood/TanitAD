+def lead_cond_probe(model, batch, cfg) -> dict:
+    """G-LIVE for LEADCOND, read from the BUILT model's own ``loss`` on the real probe batch (a COPY). Reports and requires:
+      u         n_rows = batch rows whose lead window is all real frames (u is non-zero only there); mean / std of p and of g over those rows (g = the gap output, clamped); both finite
+      reach     the gradient of the total on ``lead_cond.weight`` is above 0 (and finite) -- the token enters the loss path; the bias gradient is above 0
+      detach    the plan loss (total minus the lead_sup term) gives the lead head's parameters the SAME gradient with and without the lead_cond path, i.e. nothing flows back through u
+                (grad_norm_lead_head_through_u, the difference, reads EXACTLY 0.0)
+      control   u forced to zeros: the gradient on ``lead_cond.weight`` reads EXACTLY 0.0 (the bias gradient stays above 0): the probe can read zero
+    Any violation is an AssertionError (the caller turns it into a refusal)."""
+    if cfg.lead_cond != "on":
+        return {"lead_cond": "off", "pass": True}
+    m = copy.deepcopy(model)
+    m.train()
+
+    def grads(zero_u: bool):
