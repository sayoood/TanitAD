+      reach     the gradient norm of the term on the level-1 predictor and on its action embedding is above 0 (on a fresh adaLN-zero predictor the action input has no path yet: then the same read is made on a copy whose
+                zero-initialised predictor tensors are woken with small noise, and ``woken`` is recorded True)
+      zeros     the gradient on the lead head's parameters, on the start-state projection and on every parameter outside the predictor / action embedding (the encoder path) reads EXACTLY 0.0
+      control   an all-invalid batch (no presence label) gives the term exactly 0.0 with no graph
+    Any violation is an AssertionError (the caller turns it into a refusal)."""
+    if a.w_act_cons <= 0.0:
+        return {"act_cons": "off", "pass": True}
+    m = copy.deepcopy(model).cpu()
+    m.train()
+    d = AC.draw_offsets(a.seed, 0, int(batch["frame_ok"].shape[0]), a.act_cons_max)
+
+    def run(mm, bt):
+        mm.zero_grad(set_to_none=True)
+        out = mm.loss(dict(bt), p_gt=0.5, gen=torch.Generator().manual_seed(11))
+        r = AC.act_cons_term(mm, out["adapt"], bt, d, a.act_cons_max)
+        if r["term"].requires_grad:
+            r["term"].backward()
+        return r
+
+    def norms(mm):
+        pred = {id(p) for p in list(mm.wm.stack.predictors[0].parameters())}
+        emb = {id(p) for p in list(mm.wm.stack.act_embed.parameters())}
+        g = lambda ps: float(sum((p.grad.abs().sum() for p in ps if p.grad is not None), torch.zeros(()))) if ps else 0.0   # noqa: E731
+        allp = list(mm.named_parameters())
+        head = [p for n, p in allp if n.startswith("wm.lead_head.")]
+        proj = [p for n, p in allp if n.startswith("wm.proj.")]
+        other = [p for n, p in allp if id(p) not in pred and id(p) not in emb]
+        return {"grad_norm_predictor": g([p for n, p in allp if id(p) in pred]), "grad_norm_action_embed": g([p for n, p in allp if id(p) in emb]), "grad_norm_lead_head": g(head),
+                "grad_norm_state_projection": g(proj), "grad_abs_sum_outside_predictor_and_embed": g(other)}
+
+    r = run(m, batch)
