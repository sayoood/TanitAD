+    assert float(r_all["term"]) == float(r_s["term"]) and float(r_all["n_valid"]) == float(r_s["n_valid"])
+    assert set(g_all) == set(g_s) and all(torch.equal(g_all[k], g_s[k]) for k in g_all)
