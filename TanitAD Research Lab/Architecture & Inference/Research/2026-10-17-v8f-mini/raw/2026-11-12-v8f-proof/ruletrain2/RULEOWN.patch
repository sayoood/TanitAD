+def bad_rule_own(a, data_info) -> list:
+    """RULEOWN (G-DVB): ``--w-rule-own`` and ``--rule-relabel-weight`` read back from the BUILT stage record ``info["rule_own"]`` (the weights RuleOwn holds, the rule file sha256, the label rows). W = 0 (off): no record may exist. W > 0: the record
+    equals the declared value, the label arrays have lead rows, and the stages that rewrite the logged state (ego perturbation, DAgger swap, recovery, LoRA frames) are off. ``--rule-relabel-weight`` != 1 needs ``--rule-relabel on`` and the same built value."""
+    rec = (data_info or {}).get("rule_own")
+    bad = []
+    if not (a.w_rule_own >= 0.0 and a.w_rule_own == a.w_rule_own and a.w_rule_own != float("inf")):
+        bad.append(f"w_rule_own {a.w_rule_own!r} must be finite and >= 0")
+    if not (a.rule_relabel_weight >= 0.0 and a.rule_relabel_weight == a.rule_relabel_weight and a.rule_relabel_weight != float("inf")):
+        bad.append(f"rule_relabel_weight {a.rule_relabel_weight!r} must be finite and >= 0")
+    if a.w_rule_own == 0.0:
+        if rec and rec.get("w_rule_own") != 0.0:
+            bad.append("w_rule_own 0 declared but a rule-own stage with a weight was built")
+    else:
+        if not rec:
+            return bad + ["w_rule_own > 0 declared but no rule-own stage was built"]
+        if rec.get("w_rule_own") != a.w_rule_own:
+            bad.append(f"w_rule_own: declared {a.w_rule_own} but built {rec.get('w_rule_own')}")
+        for k in ("n_pres", "n_gap", "n_clos"):
+            if not (isinstance(rec.get(k), int) and rec[k] > 0):
+                bad.append(f"rule_own labels: {k} = {rec.get(k)!r}: no label lead rows (a lever that is declared and does nothing)")
+        if not rec.get("labels_sha256") or not rec.get("dist_rule_sha256"):
+            bad.append("rule_own: the label arrays' or the rule file's sha256 is not recorded")
+        for flag, val in (("ego_perturb_p", a.ego_perturb_p), ("dagger_p", a.dagger_p), ("recover_p", a.recover_p)):
+            if val != 0.0:
+                bad.append(f"w_rule_own > 0 with --{flag.replace('_', '-')} {val}: the rule is applied to the LOGGED frame, which that stage rewrites")
+        if a.encoder != "cache":
+            bad.append("w_rule_own is not built for --encoder lora (the loop's batch path differs)")
+    wrec = (data_info or {}).get("rule_relabel_weight")
+    if a.rule_relabel_weight == 1.0:
