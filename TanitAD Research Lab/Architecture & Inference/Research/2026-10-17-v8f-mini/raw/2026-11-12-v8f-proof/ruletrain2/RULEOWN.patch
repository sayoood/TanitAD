+def rule_own_probe(model, probe_logged, RO, inp, cfg) -> dict:
+    """G-LIVE for RULEOWN flag A, read from the BUILT model on a COPY, on the real probe batch. off: {"rule_own": "off"}. on, with out["traj30"] of the model's own loss call on the probe batch:
+      count     n_lead (samples with a label lead) > 0, else a refusal
+      term      finite, >= 0; n_active (samples with a term above 0); the gradient norm of W x term and of the trajectory loss (w_traj x (ade / 3 + 0.5 fde / 6)) on traj30
+      reach     the loop's own add helper moves the total by W x term; when n_active > 0 the gradient norm of the term on traj30 is above 0
+      controls  an all-False mask gives term exactly 0.0 and gradient norm exactly 0.0; the same call twice gives the same term
+    Any violation is an AssertionError (the caller turns it into a refusal)."""
+    if not RO.own_on:
+        return {"rule_own": "off", "pass": True}
+    if int(inp["mask"].sum()) <= 0:
+        raise AssertionError("rule own probe: no sample of the probe batch has a label lead: the count is 0")
+    m = copy.deepcopy(model).cpu()
+    m.train()
+    torch.manual_seed(20261115)
+    out = m.loss(dict(probe_logged), p_gt=0.5, gen=torch.Generator().manual_seed(11))
+    tr, T = out["traj30"], out["terms"]
+    total0 = T["total"].detach().clone()
+    term, info = ROW.own_term(tr, inp)
+    term2, _ = ROW.own_term(tr, inp)
+    traj_loss = cfg.w_traj * (T["ade"] / 3.0 + 0.5 * T["fde"] / 6.0)
+    gn = lambda y: float(torch.autograd.grad(y, tr, retain_graph=True, allow_unused=True)[0].abs().sum()) if y.requires_grad else 0.0      # noqa: E731
+    g_term, g_traj = gn(RO.w_own * term), gn(traj_loss)
+    Tc = {"total": T["total"]}
+    info2 = ROW.add_own_term(Tc, tr, inp, RO.w_own)
+    none_inp = {**inp, "mask": np.zeros_like(inp["mask"])}
+    term0, info0 = ROW.own_term(tr, none_inp)
+    rec = {"rule_own": "on", "w_rule_own": RO.w_own, "term": float(term.detach()), "n_rows": info["n_rows"], "n_lead": info["n_lead"], "n_active": info["n_active"], "grad_norm_term_on_traj30": g_term,
+           "grad_norm_traj_loss_on_traj30": g_traj, "total_before": float(total0), "total_after": float(Tc["total"].detach()), "total_delta": float(Tc["total"].detach() - total0),
+           "control_same_call_term_diff": abs(float(term.detach()) - float(term2.detach())), "control_all_false_term": float(term0.detach()), "control_all_false_n_lead": info0["n_lead"],
+           "control_all_false_requires_grad": bool(term0.requires_grad)}
+    if not np.isfinite(rec["term"]) or rec["term"] < 0.0 or not np.isfinite(g_term) or not np.isfinite(g_traj):
+        raise AssertionError(f"rule own probe: the term or a gradient norm is not finite / not >= 0: {rec}")
+    if rec["control_same_call_term_diff"] != 0.0 or rec["control_all_false_term"] != 0.0 or rec["control_all_false_n_lead"] != 0 or rec["control_all_false_requires_grad"]:
+        raise AssertionError(f"rule own probe: a control does not read exactly 0.0: {rec}")
+    if info["n_active"] > 0 and not (g_term > 0.0 and abs(rec["total_delta"] - RO.w_own * rec["term"]) <= 1e-5 * (1.0 + abs(rec["total_before"]))):
+        raise AssertionError(f"rule own probe: n_active {info['n_active']} > 0 but the term does not reach the total / the trajectory output: {rec}")
+    if info["n_active"] == 0 and rec["term"] != 0.0:
+        raise AssertionError(f"rule own probe: n_active 0 but the term is {rec['term']}: {rec}")
+    rec["reach_visible"] = bool(info["n_active"] > 0)
+    rec["pass"] = True
+    return rec
+
