+           "total_w": t_w, "total_0": t_0, "contribution": t_w - t_0, "w_traj_x_W_x_term_over_3": want,
+           "head_o_grad_diff": dsum(g_w, g_0, "head_o."), "read_o_grad_diff": dsum(g_w, g_0, "read_o."),
