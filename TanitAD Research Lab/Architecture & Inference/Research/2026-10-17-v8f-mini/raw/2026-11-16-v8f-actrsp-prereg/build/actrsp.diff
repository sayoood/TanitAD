+        diff_lat = rd[2] - rd[3]                                                     # ... and under the +/- yaw-rate command
+        g = torch.stack([diff_lon / (2.0 * dlt[0] * slope), diff_lat / (2.0 * dlt[1] * slope)], dim=-1)   # (B, A, K, c', c)
