+    ot, on = run_loss(mt, b), run_loss(mn, b)
+    assert set(ot["terms"]) == set(on["terms"]), "no new T key with the lever off"
+    for k in ot["terms"]:
+        assert torch.equal(ot["terms"][k], on["terms"][k]), k
+    ot["terms"]["total"].backward()
