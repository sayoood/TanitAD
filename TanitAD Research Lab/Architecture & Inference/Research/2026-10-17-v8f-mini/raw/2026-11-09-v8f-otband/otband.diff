+        return {"stok_dir": str(self.root), "stok_dim": self.dim, "n_clips": len(self.clips), "stok_shuffle": self.shuffle_seed,
+                "n_self_sourced": sum(1 for c, s in self.source.items() if c == s)}
+
+
