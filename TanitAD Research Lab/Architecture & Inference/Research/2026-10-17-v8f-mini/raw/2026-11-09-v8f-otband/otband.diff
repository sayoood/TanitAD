+"""v8F-mini -- the PI's three-layer v8F (S -> T -> O) on CACHED frozen DINOv3-L features (track M, 8 GB GPU).
+
+Spec: ``Project Steering/PLAN_V8F_REFAV1_HJEPA_2026-10-17.md`` §13 (binding) and ``PREREG_V8F_MINI.md``.
+
+* **S (strategic, 1 Hz)**   scene summary (unless ``navonly``) + nav + distance + ego dynamics + max speed
+                            -> route CHECKPOINTS (x, y, heading) at 30 / 50 / 80 m of arc, ego frame.
+* **T (tactical, 2 Hz)**    checkpoints (S, held) + inputs + scene (unless ``navonly``)
+                            -> v9 goal logits, lat / lon action logits, constraint regressions.
+* **O (operative, 10 Hz)**  T's output (held) + checkpoints (held) + inputs + scene
+                            -> a 6 s trajectory (60 x 0.1 s) as a RESIDUAL on the P10 prior.
+
+SAMPLE-AND-HOLD: each layer is evaluated at its OWN tick frame (NOW - age) and the lower layer reads the held
+output. Ages are in 0.2 s cache steps (the cache grid): T ticked ``a_t`` in 0..2 steps ago (< 0.5 s), S ticked
+``a_s - a_t`` in 0..4 steps before T (< 1.0 s). Held checkpoints are re-expressed in the reading layer's frame with
+the MEASURED odometry between the two tick frames (``pose`` -- an ego-dynamics input, not a label).
+SCHEDULED SAMPLING: during training, with probability ``p_gt`` (1.0 -> 0.2) a layer reads the GT upper-layer output
+(v9 labels at the tick frame) instead of the predicted one; at inference never (``forward_infer`` reads no label).
+
+ADMISSIBILITY (binding 2026-08-03): S, T and O are computed from vision + nav + ego dynamics + max speed ONLY.
+``assert_no_situation_classifier_input`` pins it: the inference entry point reads exactly
+:data:`INFERENCE_INPUT_KEYS` (recorded at call time) and the source mentions no situation classifier.
+
+CONSISTENCY: differentiable hinge penalties for SPEED / STOP / TURN / LEAD that are zero iff the numpy rule of
+``taniteval.v8f_consistency`` says "no violation" (agreement is tested); plus the HARD inference projection
+(:func:`project_speed`) onto the R1 speed cap and the Kamm circle (mu 0.7).
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import json
+import math
+import os
+from dataclasses import dataclass, field, fields
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from torch import Tensor, nn
+
+DT = 0.2
+K30, N60 = 30, 60
+CKPT_ARCS = (30.0, 50.0, 80.0)
+N_GOAL, N_LAT, N_LON, N_CONS = 22, 5, 7, 26
+CODE_DIM = N_GOAL + N_LAT + N_LON + N_CONS
+TURN_L_I, TURN_R_I, STOP_I = 1, 2, 6                      # GOAL22 indices
+LON_FOLLOW = 3
+CONS_NAMES = ("lat_theta_deg", "turn_t_start_s", "turn_t_end_s", "turn_d_start_m", "turn_len_m", "turn_dyaw_deg",
+              "turn_r_arc_m", "turn_exit_x_m", "turn_exit_y_m", "turn_exit_psi_deg", "lc_t_cross_s", "lc_d_cross_m",
+              "lon_v_target_ms", "lon_t_reach_s", "lon_d_reach_m", "lon_t_start_s", "stop_x_m", "stop_y_m",
+              "lead_gap_m", "lead_tg_s", "lead_gap_min_m", "lead_tg_min_s", "v_a_ms", "v_end_ms", "v_lo_ms", "v_hi_ms")
+CI = {n: i for i, n in enumerate(CONS_NAMES)}
+#: PREREG_V8F_TAC Amendment 1: a PARTITION of T's code [goal 22 | lat 5 | lon 7 | cons 26] into six groups, so a per-group oracle can
+#: replace one part at a time. Every code index belongs to exactly one group (pinned by test_v8f_tac.py).
+_C0 = N_GOAL + N_LAT + N_LON
+CODE_GROUPS = {
+    "goal": tuple(range(0, N_GOAL)),
+    "latdec": tuple(range(N_GOAL, N_GOAL + N_LAT)),
+    "londec": tuple(range(N_GOAL + N_LAT, _C0)),
+    "latcons": tuple(_C0 + CI[n] for n in ("lat_theta_deg", "turn_t_start_s", "turn_t_end_s", "turn_d_start_m", "turn_len_m",
+                                            "turn_dyaw_deg", "turn_r_arc_m", "turn_exit_x_m", "turn_exit_y_m", "turn_exit_psi_deg",
+                                            "lc_t_cross_s", "lc_d_cross_m")),
+    "lonspeed": tuple(_C0 + CI[n] for n in ("lon_v_target_ms", "lon_t_reach_s", "lon_d_reach_m", "lon_t_start_s", "v_a_ms", "v_end_ms",
+                                             "v_lo_ms", "v_hi_ms")),
+    "stoplead": tuple(_C0 + CI[n] for n in ("stop_x_m", "stop_y_m", "lead_gap_m", "lead_tg_s", "lead_gap_min_m", "lead_tg_min_s")),
+}
+#: the two composites the Amendment 1 decision reads: the categorical DECISIONS vs the continuous CONSTRAINTS
+CODE_COMPOSITES = {"decisions": ("goal", "latdec", "londec"), "constraints": ("latcons", "lonspeed", "stoplead")}
+#: PREREG_V8F_KIND: a SECOND partition of the same 26 constraint cells, by what a cell MEASURES rather than by which decision it hangs off:
+#: speeds, angles, times-to-event, time gaps, geometry (metres of path) and lead gaps. Each cell is in exactly one kind and the six kinds' union is
+#: the ``constraints`` composite (pinned by test_v8f_kind.py). A kind's name must not collide with CODE_GROUPS / CODE_COMPOSITES. ``code_group_index``
+#: takes a kind anywhere it takes a group: ``speed``, ``speed+angle``, ``all-speed`` (GT everywhere EXCEPT the speed cells).
+CODE_KINDS = {
+    "speed": tuple(_C0 + CI[n] for n in ("lon_v_target_ms", "v_a_ms", "v_end_ms", "v_lo_ms", "v_hi_ms")),
+    "angle": tuple(_C0 + CI[n] for n in ("lat_theta_deg", "turn_dyaw_deg", "turn_exit_psi_deg")),
+    "tte": tuple(_C0 + CI[n] for n in ("turn_t_start_s", "turn_t_end_s", "lc_t_cross_s", "lon_t_reach_s", "lon_t_start_s")),
+    "timegap": tuple(_C0 + CI[n] for n in ("lead_tg_s", "lead_tg_min_s")),
+    "geom": tuple(_C0 + CI[n] for n in ("turn_d_start_m", "turn_len_m", "turn_r_arc_m", "turn_exit_x_m", "turn_exit_y_m", "lc_d_cross_m",
+                                         "lon_d_reach_m", "stop_x_m", "stop_y_m")),
+    "leadgap": tuple(_C0 + CI[n] for n in ("lead_gap_m", "lead_gap_min_m")),
+}
+
+
+def code_group_index(spec: str) -> list:
+    """``"goal+londec"`` | ``"decisions"`` | ``"speed+angle"`` (a PREREG_V8F_KIND kind) | ``"all"`` | ``"all-<spec>"`` -> sorted code indices. Unknown names are refused.
+    ``all-<spec>`` is the COMPLEMENT (PREREG_V8F_TAC Amendment 2's leave-one-out: GT everywhere except ``<spec>``)."""
+    if spec == "all":
+        return list(range(CODE_DIM))
+    if spec.startswith("all-"):
+        drop = set(code_group_index(spec[len("all-"):]))
+        keep = [i for i in range(CODE_DIM) if i not in drop]
+        if not keep:
+            raise ValueError(f"code group {spec!r} selects nothing")
+        return keep
+    names, idx = [], set()
+    for part in spec.split("+"):
+        if part in CODE_COMPOSITES:
+            names.extend(CODE_COMPOSITES[part])
+        elif part in CODE_GROUPS:
+            names.append(part)
+        elif part in CODE_KINDS:                    # PREREG_V8F_KIND: a kind of constraint cell
+            idx.update(CODE_KINDS[part])
+        else:
+            raise ValueError(f"unknown code group {part!r}: use {sorted(CODE_GROUPS) + sorted(CODE_COMPOSITES) + sorted(CODE_KINDS)} or 'all', joined by '+'")
+    idx.update(i for n in names for i in CODE_GROUPS[n])
+    return sorted(idx)
+
+
+#: PREREG_V8F_MIXO (`--code-mix`): the granularity of O's teacher forcing. ``whole`` (the default, every earlier arm bit for bit) = ONE GT-or-own switch per sample over the whole
+#: code; ``kind`` = an independent switch per sample AND per UNIT, at the same p_gt, so O also trains on a code that is partly right and partly T's own.
+CODE_MIX_MODES = ("whole", "kind")
+#: the units ``kind`` draws over: the decisions (goal + latdec + londec, one unit) and the six constraint kinds of PREREG_V8F_KIND. Every code index is in EXACTLY one unit (the
+#: decisions' 34 indices and the 26 constraint cells; pinned by test_v8f_mixo.py).
+CODE_MIX_UNITS = {"decisions": tuple(i for n in CODE_COMPOSITES["decisions"] for i in CODE_GROUPS[n]), **CODE_KINDS}
+N_CODE_UNITS = len(CODE_MIX_UNITS)
+if sorted(i for idx in CODE_MIX_UNITS.values() for i in idx) != list(range(CODE_DIM)):
+    raise ImportError("CODE_MIX_UNITS is not a partition of the code: every index must be in exactly one unit")
+#: code index -> its unit's column in the [B, N_CODE_UNITS] draw (built from the partition checked above)
+CODE_UNIT_OF = tuple(next(u for u, idx in enumerate(CODE_MIX_UNITS.values()) if i in idx) for i in range(CODE_DIM))
+
+
+#: PREREG_V8F_FLAT (`--o-interface`): what O reads of the two layers above it. ``full`` (the default, every earlier arm bit for bit, the RNG stream included) = S's checkpoints and T's
+#: code. ``cut`` = a CONSTANT in place of BOTH (T's code = zeros, S's checkpoints for O = the nominal ``ck_nom`` with ok = 0), applied after every override so no eval can reach O through them.
+#: S and T are still built, trained on their own losses and run; T still reads S. Only the wires into O are cut.
+O_INTERFACE_MODES = ("full", "cut")
+
+#: PREREG_V8F_LEVEL (`--level-head`, lever (a) of DECISION_K2): the speed LEVEL read from VISION. ``off`` (default) builds nothing = every earlier arm, bit for bit (state dict AND outputs). ``on`` builds a head
+#: ``lvl_head`` (mean of the CURRENT tick frame's adapted tokens -> MLP(d, d, 1) -> v_hat, m/s; it reads vision tokens ONLY) and a conditioning embedding ``e_level`` (Linear(1, d), weight AND bias zero-initialised)
+#: whose output O adds to its ego conditioning token. O reads ``v_hat.detach() / LEVEL_SCALE`` (train and inference alike: no exposure gap). The head's loss is ``w_level`` x Huber(v_hat, the LOGGED speed at NOW).
+LEVEL_HEAD_MODES = ("off", "on")
+LEVEL_SCALE = 10.0                         # m/s: e_level reads v_hat / LEVEL_SCALE
+LEVEL_HUBER_DELTA = 1.0                    # m/s
+#: the state-dict keys the lever adds (and ONLY these): an older checkpoint loads into a lever-ON model with exactly these keys missing (`--init-ckpt`)
+LEVEL_KEY_PREFIXES = ("lvl_head.", "e_level.")
+#: identifiers the level head's own code (``V8FMini._level``) must not mention: every ego / nav / limit / code / label input (the head is VISION ONLY; PREREG_V8F_LEVEL, CLAUDE.md "LABELS MAY USE EGO; INFERENCE IS VISION-ONLY")
+LEVEL_FORBIDDEN_NAMES = ("p10f", "nav", "limit", "limit_ok", "act", "pose", "pose_now", "pose_t", "pose_s", "base", "kin3", "a_t", "a_s", "code", "ck", "_ego", "e_ego", "e_nav", "e_lim", "e_age", "e_ck", "e_code",
+                         "level_y", "level_ok", "gt", "lab", "lab_s", "lab_t", "prior")
+#: the only batch key the head's ``_level`` may read besides the adapted tokens it is handed (``feats`` is read by ``_encode``, upstream of it)
+LEVEL_ALLOWED_KEYS = frozenset({"frame_ok"})
+
+#: PREREG_LEVELHEAD_A2 (`--lead-head`, `--w-lead`, `--aux-cond`; arm LLR): the LEAD head, a second vision-only head wired the same way as the level head. ``off`` (default) builds nothing = every earlier arm, bit for bit
+#: (state dict AND outputs). ``on`` builds ``lead_head`` (mean of the CURRENT tick frame's adapted tokens -> MLP(d, d, 2) -> (presence logit for "a lead within LEAD_RANGE_M", gap_hat = sigmoid(.) = gap / LEAD_RANGE_M in
+#: [0, 1])). O reads ``[sigmoid(logit), gap_hat]`` DETACHED. ``--aux-cond`` fixes HOW: ``add`` = ``e_lead`` (Linear(2, d), weight AND bias zero) ADDED to O's ego conditioning token like ``e_level``; ``token`` = ONE extra
+#: conditioning token of O, ``e_aux`` (Linear(3, d), default non-zero init) of ``[v_hat / LEVEL_SCALE if the level head is built else 0, sigmoid(logit), gap_hat]`` (detached), which REPLACES the additive paths of BOTH heads
+#: (``e_level`` and ``e_lead`` are not built). ``token`` is refused unless at least one head is on (the launch gate: bad_lead).
+LEAD_HEAD_MODES = ("off", "on")
+AUX_COND_MODES = ("add", "token")
+LEAD_RANGE_M = 40.0                        # m: the presence label is "a lead within this range", the gap target is min(gap, this) / this
+LEAD_HUBER_DELTA = 0.1                     # in gap / 40 units (= 4 m): the card names a Huber on the gap and no delta; this is the builder's choice, a module constant, pinned by a test
+AUX_TOKEN_DIM = 3                          # [v_hat / LEVEL_SCALE, sigmoid(presence logit), gap_hat]
+LEAD_KEY_PREFIXES = ("lead_head.", "e_lead.")
+AUX_KEY_PREFIXES = ("e_aux.",)
+#: every state-dict key a declared lever may ADD to an older checkpoint's key set (load_init_ckpt: EXACTLY these may be fresh)
+NEW_LEVER_KEY_PREFIXES = LEVEL_KEY_PREFIXES + LEAD_KEY_PREFIXES + AUX_KEY_PREFIXES
+#: identifiers the lead head's own code (``V8FMini._lead``) and the aux-token assembly (``V8FMini._aux_in``) must not mention (the level list + the lead labels): the head is VISION ONLY
+LEAD_FORBIDDEN_NAMES = LEVEL_FORBIDDEN_NAMES + ("lead_y", "lead_has", "lead_near", "lead_gap_h", "s_h", "pose_now")
+LEAD_ALLOWED_KEYS = frozenset({"frame_ok"})
+
+
+LIMITS_MS = (30 / 3.6, 50 / 3.6, 100 / 3.6, 120 / 3.6)
+#: the scale the WM auxiliary divides action channel 1 by, per kin mode (PI ruling D-PI-YAWRATE-1): the recorded steer angle
+#: (rad) in the legacy mode, the MEASURED yaw rate (rad/s) in the compliant one. 0.4 keeps the scaled channel's std at 0.255 vs the
+#: steer channel's 0.267 (MEASURED on the first 200 sha12 train clips: std omega 0.1022 rad/s, std steer 0.0802 rad).
+CH1_SCALE = {"steer": 0.3, "yaw": 0.4}
+#: the scale the WM auxiliary divides action channel 0 (longitudinal acceleration, m/s^2) by.
+WM_ACC_SCALE = 2.0
+#: EXACTLY the batch keys the inference path may read. Everything else (``lab*``, ``gt``, ``s_h``, ``lead_gap_h`` ...)
+#: is a label or an evaluator-side quantity and is never touched by ``forward_infer``.
+INFERENCE_INPUT_KEYS = frozenset({"feats", "frame_ok", "p10f", "act", "nav", "pose", "limit", "limit_ok", "base",
+                                  "a_t", "a_s", "pose_now", "pose_t", "pose_s"})
+
+
+# ------------------------------------------------------------------------------------------------ config
+@dataclass
+class V8FMiniConfig:
+    """Every field is a lever; ``built_levers`` reports what the BUILT model actually does so the trainer can
+    refuse a launch whose argv declares something the model did not build."""
+    d: int = 256
+    heads: int = 4
+    ff: int = 512
+    d_feat: int = 1024
+    n_tok: int = 40
+    hist: int = 4
+    hmax: int = 10
+    n_q: int = 4
+    depth_s: int = 1
+    depth_t: int = 1
+    depth_o: int = 2
+    nb: int = 12                       # residual basis size per axis
+    res_scale_m: float = 2.0
+    navonly: bool = False              # S and T lose the scene input (PREREG M1-navonly)
+    consistency: bool = True           # False = penalties at 0 (PREREG M1-nocons)
+    wm: str = "off"                    # off | a (H-JEPA aux without IDM) | b (with IDM)
+    wm_dim: int = 128
+    wm_strides: tuple = (2, 2)
+    wm_k: int = 1                      # PREREG_V8F_MRATE (`--wm-k`): how many past states each WM level's state reads, spaced at that level's own step. 1 = W0 = every earlier arm, bit for bit (no module, no key added);
+                                       # K > 1 = W1: L1 reads the adapter tokens of frames t, t-1, .., t-K+1; L2 / L3 read K states of the level below at wm_strides[l-2] apart (hjepa LevelConfig.window / dilation / causal_pad)
+    wm_rollout_k: tuple = (1, 1, 1)    # PREREG_V8F_LADDER (`--wm-rollout-k`): free-run steps of the k-step loss per WM level. (1, 1, 1) = every earlier arm, bit for bit (no term, no key added)
+    wm_rollout_stride: tuple = (1, 1, 1)   # PREREG_V8F_LADDER (`--wm-rollout-stride`): the free run starts at every n-th state of the level (used only where the level's k > 1)
+    wm_rollout_w: float = 1.0          # PREREG_V8F_LADDER (`--wm-rollout-w`): weight of every level's k-step term (constant over training; used only where k > 1)
+    wm_ctx: tuple = (3, 3, 3)          # PREREG_V8F_LADDER (`--wm-ctx`): each WM level's predictor context (states). (3, 3, 3) = every earlier arm (the LevelConfig default); changing it changes the predictor's parameter shape
+    w_ckpt: float = 1.0
+    w_tac: float = 1.0
+    w_cons: float = 0.5
+    w_traj: float = 1.0
+    w_pen: float = 0.5                 # x each of SPEED / STOP / TURN / LEAD vs the GT constraints
+    w_pen_self: float = 0.25           # x each, vs the model's OWN predicted constraints
+    w_wm: float = 0.1
+    wm_beta: float = 0.08
+    wm_gamma: float = 100.0
+    p_gt_start: float = 1.0
+    p_gt_end: float = 0.2
+    max_age_t: int = 2
+    max_age_s: int = 6
+    detach_upper: bool = False         # stop O/T gradients into the upper layer's output
+    kin_mode: str = "steer"            # steer | yaw: what the kinematic inputs (P10 features, base, WM action channel 1) are made of
+    cons_absent: str = "mask"          # mask: an ABSENT constraint is out of T's loss (M1 / M2b as built); zero: T's target there is the 0
+                                       # that _code_gt writes and O is teacher-forced on (PREREG_V8F_CZ)
+    window_start: int = -1             # PREREG_V8F_HIST Amendment 1 (`--window-start`): the first TRAINING window's cache step t AND the held-age clamp's origin
+                                       # (a DATA lever: the model never reads it, the checkpoint records it). -1 = absent = hist - 1 = every earlier arm, bit for bit
+    code_mix: str = "whole"            # PREREG_V8F_MIXO (`--code-mix`): how O's teacher forcing draws GT-or-own over T's code. whole = one switch per sample (every earlier arm,
+                                       # bit for bit, RNG stream included); kind = an independent switch per sample AND per unit (CODE_MIX_UNITS). Training only: the eval never teacher-forces
+    o_interface: str = "full"          # PREREG_V8F_FLAT (`--o-interface`): full = O reads S's checkpoints and T's code (every earlier arm, bit for bit); cut = O reads a CONSTANT for both (the FLAT control:
+                                       # T's code = zeros AFTER every override, S's checkpoints = the nominal ck_nom with ok = 0). S and T are still built, trained and run
+    w_acc: float = 0.0                 # PREREG_V8F_OACC (`--w-acc`): the weight of the acceleration-matching term on O's plan (accel_term below). 0.0 = the term is NOT in the total = every earlier arm,
+                                       # bit for bit (the term is still LOGGED under T["acc"]). > 0 = OACC's X: its value is fixed by the PREREG's rule, written into the argv, never tuned
+    launch_intent_w: float = 0.0       # PREREG_V8F_LAUNCH_INTENT (`--launch-intent-w`): W, the extra weight on O's ALONG-TRACK distance over knots 1-12 (tau 0.2-2.4 s, the executed horizon at m = 10) for the samples
+                                       # `launch_mask` marks (GT-launch: v0 < 6 m/s and the GT chord speed over the last 0.2 s of the horizon >= v0 + 1 m/s). 0.0 = the term is NOT in the total and NOT computed =
+                                       # every earlier arm, bit for bit (no new tensor op, no new T key). > 0 = the batch must carry `launch` (the trainer computes it from the LOGGED state before any ego stage)
+
+    level_head: str = "off"            # PREREG_V8F_LEVEL (`--level-head`): off = nothing built (every earlier arm, bit for bit); on = the vision-only speed-level head + O's level conditioning (LEVEL_HEAD_MODES)
+    lead_head: str = "off"             # PREREG_LEVELHEAD_A2 (`--lead-head`): off = nothing built (every earlier arm, bit for bit); on = the vision-only lead head (presence + gap) + O's lead conditioning (LEAD_HEAD_MODES)
+    w_lead: float = 0.0                # PREREG_LEVELHEAD_A2 (`--w-lead`): the weight of BCE(presence) + Huber(gap_hat) in the total. Must be > 0 with the head on and exactly 0.0 with it off (checked by the launch gate)
+    aux_cond: str = "add"              # PREREG_LEVELHEAD_A2 (`--aux-cond`): how O reads the head outputs: add (e_level / e_lead ADDED to the ego token, zero-init) | token (ONE extra conditioning token, replaces both additive paths)
+    w_level: float = 0.0               # PREREG_V8F_LEVEL (`--w-level`): the weight of Huber(v_hat, logged speed) in the total. Must be > 0 with the head on and exactly 0.0 with it off (checked by the launch gate: a head with no loss, or a weight with no head, is refused)
+
+    @property
+    def window_start_effective(self) -> int:
+        """The number the data side must have built: ``hist - 1`` when the flag is absent (-1), else the flag."""
+        return self.hist - 1 if self.window_start == -1 else self.window_start
+
+    def __post_init__(self):
+        if self.kin_mode not in CH1_SCALE:
+            raise ValueError(f"kin_mode must be one of {tuple(CH1_SCALE)}, got {self.kin_mode!r}")
+        if self.wm not in ("off", "a", "b"):
+            raise ValueError(f"wm must be off|a|b, got {self.wm!r}")
+        if self.cons_absent not in ("mask", "zero"):
+            raise ValueError(f"cons_absent must be mask|zero, got {self.cons_absent!r}")
+        if self.code_mix not in CODE_MIX_MODES:
+            raise ValueError(f"code_mix must be one of {CODE_MIX_MODES}, got {self.code_mix!r}")
+        if self.o_interface not in O_INTERFACE_MODES:
+            raise ValueError(f"o_interface must be one of {O_INTERFACE_MODES}, got {self.o_interface!r}")
+        if not (math.isfinite(self.w_acc) and self.w_acc >= 0.0):
+            raise ValueError(f"w_acc must be a finite number >= 0, got {self.w_acc!r}")
+        if not (math.isfinite(self.launch_intent_w) and self.launch_intent_w >= 0.0):
+            raise ValueError(f"launch_intent_w must be a finite number >= 0, got {self.launch_intent_w!r}")
+        if self.level_head not in LEVEL_HEAD_MODES:
+            raise ValueError(f"level_head must be one of {LEVEL_HEAD_MODES}, got {self.level_head!r}")
+        if not (math.isfinite(self.w_level) and self.w_level >= 0.0):
+            raise ValueError(f"w_level must be a finite number >= 0, got {self.w_level!r}")
+        if self.lead_head not in LEAD_HEAD_MODES:
+            raise ValueError(f"lead_head must be one of {LEAD_HEAD_MODES}, got {self.lead_head!r}")
+        if self.aux_cond not in AUX_COND_MODES:
+            raise ValueError(f"aux_cond must be one of {AUX_COND_MODES}, got {self.aux_cond!r}")
+        if not (math.isfinite(self.w_lead) and self.w_lead >= 0.0):
+            raise ValueError(f"w_lead must be a finite number >= 0, got {self.w_lead!r}")
+        if self.hmax < self.hist + self.max_age_s:
+            raise ValueError("hmax must cover hist + max_age_s")
+        if self.window_start != -1 and not 0 <= self.window_start <= self.hist - 1:
+            raise ValueError(f"window_start must be -1 (absent = hist - 1) or in [0, hist - 1] = [0, {self.hist - 1}], got {self.window_start}")
+        ws = self.wm_strides                                                   # PREREG_V8F_LFS (`--wm-strides`): two ints >= 1
+        if not (isinstance(ws, (tuple, list)) and len(ws) == 2 and all(isinstance(s, int) and not isinstance(s, bool) and s >= 1 for s in ws)):
+            raise ValueError(f"wm_strides must be two ints >= 1 (the L2 and the L3 step, in states of the level below), got {ws!r}")
+        if self.wm != "off" and self.hmax < 2 * self.wm_strides[0] * self.wm_strides[1] + 4:
+            raise ValueError("hmax too short for the WM levels")
+        if not (isinstance(self.wm_k, int) and not isinstance(self.wm_k, bool) and self.wm_k >= 1):
+            raise ValueError(f"wm_k must be an int >= 1, got {self.wm_k!r}")
+        if self.wm_k > 1 and self.wm == "off":
+            raise ValueError("wm_k > 1 needs a world model (wm a or b): a lever that is declared and builds nothing")
+        for nm in ("wm_rollout_k", "wm_rollout_stride", "wm_ctx"):               # PREREG_V8F_LADDER: three ints >= 1 (one per WM level)
+            v = getattr(self, nm)
+            if not (isinstance(v, (tuple, list)) and len(v) == 3 and all(isinstance(x, int) and not isinstance(x, bool) and x >= 1 for x in v)):
+                raise ValueError(f"{nm} must be three ints >= 1 (levels 1, 2, 3), got {v!r}")
+        if not (isinstance(self.wm_rollout_w, (int, float)) and math.isfinite(self.wm_rollout_w) and self.wm_rollout_w >= 0.0):
+            raise ValueError(f"wm_rollout_w must be a finite number >= 0, got {self.wm_rollout_w!r}")
+        if self.wm == "off" and (tuple(self.wm_rollout_k) != (1, 1, 1) or tuple(self.wm_ctx) != (3, 3, 3)):
+            raise ValueError("wm_rollout_k / wm_ctx moved with no world model (wm off): a lever that is declared and builds nothing")
+        if self.wm != "off":                                                      # the reach a level declares must fit the window: k steps of S_l frames need k * S_l + 1 frames
+            cum = (1, self.wm_strides[0], self.wm_strides[0] * self.wm_strides[1])
+            for lv in range(3):
+                if self.wm_rollout_k[lv] > 1 and self.hmax < self.wm_rollout_k[lv] * cum[lv] + 1:
+                    raise ValueError(f"hmax {self.hmax} is shorter than the {self.wm_rollout_k[lv] * cum[lv] + 1} frames level {lv + 1} needs for k = {self.wm_rollout_k[lv]} steps at stride {cum[lv]}: the declared reach could never be trained")
+
+
+# ------------------------------------------------------------------------------------------------ geometry
+def wrap(a: Tensor) -> Tensor:
+    return (a + math.pi) % (2 * math.pi) - math.pi
+
+
+def transform_ckpt(ck: Tensor, src: Tensor, dst: Tensor) -> Tensor:
+    """Re-express ``ck`` [B, M, 3] (x, y, psi) given in the ``src`` frame in the ``dst`` frame; poses [B, 3] = world
+    (x, y, yaw) of each tick frame (measured odometry)."""
+    cs, ss = torch.cos(src[:, 2])[:, None], torch.sin(src[:, 2])[:, None]
+    wx = src[:, 0:1] + cs * ck[..., 0] - ss * ck[..., 1]
+    wy = src[:, 1:2] + ss * ck[..., 0] + cs * ck[..., 1]
+    dx, dy = wx - dst[:, 0:1], wy - dst[:, 1:2]
+    cd, sd = torch.cos(dst[:, 2])[:, None], torch.sin(dst[:, 2])[:, None]
+    return torch.stack([cd * dx + sd * dy, -sd * dx + cd * dy, wrap(ck[..., 2] + src[:, 2:3] - dst[:, 2:3])], -1)
+
+
+# ------------------------------------------------------------------------------------------------ P10 prior
+class P10Prior(nn.Module):
+    """The frozen, fitted P10 floor: ``kd_x(correct-unit) + MLP(standardised 8 kinematic features)``.
+
+    Built from ``taniteval.floors_kin.fit_p10`` output ``(net, (xm, xs, ym), best)``. ``forward(f8, base)`` takes the
+    RAW (unstandardised) 8 features and the kd_x base ``[B, 30, 2]`` and returns the P10 prediction ``[B, 30, 2]``."""
+
+    def __init__(self, xm, xs, ym, hidden: int = 256, k: int = K30):
+        super().__init__()
+        self.k = int(k)
+        self.net = nn.Sequential(nn.Linear(8, hidden), nn.GELU(), nn.Linear(hidden, 2 * self.k))
+        for nm, v in (("xm", xm), ("xs", xs), ("ym", ym)):
+            self.register_buffer(nm, torch.as_tensor(np.asarray(v), dtype=torch.float32).clone())
+        self.requires_grad_(False)
+
+    @classmethod
+    def from_fit(cls, fit):
+        net, (xm, xs, ym), _best = fit
+        m = cls(xm, xs, ym, hidden=net[0].out_features, k=net[2].out_features // 2)
+        m.net.load_state_dict(net.state_dict())
+        return m
+
+    @classmethod
+    def synthetic(cls, seed: int = 0):
+        """Random NON-ZERO weights (so 'zero residual reproduces P10' is not satisfied trivially)."""
+        g = torch.Generator().manual_seed(seed)
+        m = cls(torch.zeros(8), torch.ones(8), torch.zeros(2 * K30))
+        with torch.no_grad():
+            for p in m.net.parameters():
+                p.copy_(torch.randn(p.shape, generator=g) * 0.05)
+        return m
+
+    def standardise(self, f8: Tensor) -> Tensor:
+        return (f8 - self.xm) / self.xs
+
+    def forward(self, f8: Tensor, base: Tensor) -> Tensor:
+        y = self.net(self.standardise(f8)) + self.ym
+        return base + y.reshape(-1, self.k, 2)
+
+
+def save_p10(prior: P10Prior, path, meta: dict | None = None):
+    torch.save({"state": prior.state_dict(), "hidden": prior.net[0].out_features, "k": prior.k, "meta": meta or {}}, path)
+
+
+def p10_meta(path) -> dict:
+    """The ``meta`` dict a P10 artifact was saved with (``units`` is ``steer`` | ``pose_kappa``; absent => ``steer``)."""
+    return dict(torch.load(path, map_location="cpu", weights_only=True).get("meta") or {})
+
+
+def check_p10_units(path, kin_mode: str) -> str:
+    """REFUSE a P10 artifact whose declared feature unit is not the one ``kin_mode`` builds (a steer prior fed yaw-derived
+    features -- or the reverse -- is a silently wrong model, not an error the first forward pass would raise). Returns the units."""
+    want = {"steer": "steer", "yaw": "pose_kappa"}[kin_mode]
+    got = p10_meta(path).get("units", "steer")
+    if got != want:
+        raise ValueError(f"P10 prior {path} declares units {got!r} but kin_mode {kin_mode!r} needs {want!r} "
+                         f"(a steer-unit prior cannot be fed yaw-derived features, nor the reverse)")
+    return got
+
+
+def load_p10(path, kin_mode: str | None = None) -> P10Prior:
+    """Load the frozen prior. With ``kin_mode`` named, the artifact's declared units must match it (``check_p10_units``)."""
+    if kin_mode is not None:
+        check_p10_units(path, kin_mode)
+    o = torch.load(path, map_location="cpu", weights_only=True)
+    m = P10Prior(torch.zeros(8), torch.ones(8), torch.zeros(2 * o["k"]), hidden=o["hidden"], k=o["k"])
+    m.load_state_dict(o["state"])
+    return m
+
+
+def upsample_prior(p30: Tensor) -> Tensor:
+    """P10 on the 0.2 s grid [B, 30, 2] -> the 0.1 s grid [B, 60, 2]: odd indices (tau = 0.2 j) ARE the knots,
+    even indices are the midpoints (origin at tau = 0)."""
+    B = p30.shape[0]
+    knots = torch.cat([p30.new_zeros(B, 1, 2), p30], 1)               # tau = 0, 0.2, ..., 6.0
+    mid = 0.5 * (knots[:, :-1] + knots[:, 1:])                          # tau = 0.1, 0.3, ...
+    out = torch.stack([mid, knots[:, 1:]], 2).reshape(B, N60, 2)       # i even -> mid (tau 0.1(i+1)), i odd -> knot
+    return out
+
+
+def subsample_02(traj60: Tensor) -> Tensor:
+    return traj60[:, 1::2]
+
+
+# ------------------------------------------------------------------------------------------------ HACC post-map (PREREG_V8F_HACC)
+#: the two keys of a HACC weights JSON (``weights_HACC_<model>.json``): the 30 per-step weights of each axis, 0.2 s knots, axis 0 = along, 1 = cross (the ego frame at NOW)
+HACC_KEYS = ("w_along_by_step", "w_cross_by_step")
+
+
+def hacc_check_weights(w) -> np.ndarray:
+    """The ONE validator of a HACC weight table: returns it as float64 ``[30, 2]`` (step x axis), or REFUSES with ``ValueError`` -- a wrong shape, a non-finite entry or an entry
+    outside [0, 1] (the map is then not a convex blend of the prior and O's plan, and would extrapolate beyond both)."""
+    try:
+        a = np.asarray(w.detach().cpu().numpy() if isinstance(w, Tensor) else w, dtype=np.float64)
+    except (TypeError, ValueError) as e:
+        raise ValueError(f"HACC weights are not a numeric array: {e}") from e
+    if a.shape != (K30, 2):
+        raise ValueError(f"HACC weights must have shape ({K30}, 2) (0.2 s step x [along, cross]), got {tuple(a.shape)}")
+    if not np.isfinite(a).all():
+        raise ValueError("HACC weights contain a non-finite entry")
+    if a.min() < 0.0 or a.max() > 1.0:
+        raise ValueError(f"HACC weights must lie in [0, 1], got range [{a.min():.6g}, {a.max():.6g}]")
+    return a
+
+
+def read_hacc_weights(src) -> np.ndarray:
+    """A HACC weights JSON (a path, or its parsed dict) -> the validated ``[30, 2]`` float64 table (:func:`hacc_check_weights`): column 0 = ``w_along_by_step``, column 1 = ``w_cross_by_step``."""
+    if isinstance(src, (str, os.PathLike)):
+        with open(src, "r", encoding="utf-8") as fh:
+            src = json.load(fh)
+    if not isinstance(src, dict) or any(k not in src for k in HACC_KEYS):
+        raise ValueError(f"a HACC weights file needs the keys {HACC_KEYS}")
+    try:
+        cols = np.stack([np.asarray(src[k], dtype=np.float64) for k in HACC_KEYS], 1)
+    except (TypeError, ValueError) as e:
+        raise ValueError(f"HACC weights {HACC_KEYS} are not two equal-length numeric lists: {e}") from e
+    return hacc_check_weights(cols)
+
+
+def hacc_w_midpoints(w30: Tensor) -> Tensor:
+    """The 60 weights of ``traj60`` (the 0.1 s grid) from the 30 fitted ones (the 0.2 s knots): the odd rows (tau = 0.2 j) ARE the knot weights; each even row (tau = 0.1 + 0.2 j) is the mean of the
+    two knot weights around it, and the first (tau = 0.1, between NOW and the first knot) is the first knot's. HBLEND's ``w_midpoints`` verbatim -- the midpoints are not identifiable from the
+    data (GT exists only on the knots), so this is DERIVED, and ``upsample_prior`` already puts the prior's own midpoints at the mean of its neighbours."""
+    mid = torch.cat([w30[:1], 0.5 * (w30[:-1] + w30[1:])], 0)
+    return torch.stack([mid, w30], 1).reshape(N60, 2)
+
+
+def hacc_apply(plan: Tensor, prior: Tensor, w: Tensor) -> Tensor:
+    """HACC: ``prior + w * (plan - prior)``, ``w`` broadcast over the batch (``[n, 2]`` against ``[B, n, 2]``): a per-step, per-axis convex blend of the P10 prior and O's plan. ``torch.lerp`` is
+    that number, EXACT at both ends (w = 0 gives the prior and w = 1 the plan, bit for bit; the plain difference form is off by an ulp of the larger one at w = 1)."""
+    return torch.lerp(prior, plan, w.expand_as(prior))
+
+
+def traj_terms(traj30: Tensor, gt: Tensor, gok: Tensor) -> tuple:
+    """O's two position terms on the 0.2 s knots, ``(ade, fde)``: the mean / last-knot L2 distance to the GT, averaged over the GT-valid windows (``gok`` [B]). The loss reads this; so does the
+    w_acc rule of PREREG_V8F_OACC (``v8f_mini_eval_oacc.py wacc``), so the trajectory loss it balances against IS the trainer's, never a re-implementation."""
+    d = torch.sqrt(((traj30 - gt) ** 2).sum(-1) + 1e-9)
+    return (d.mean(1) * gok).sum() / gok.sum().clamp_min(1.0), (d[:, -1] * gok).sum() / gok.sum().clamp_min(1.0)
+
+
+def second_diff_02(xy: Tensor) -> Tensor:
+    """PREREG_V8F_OACC: the second difference, on the 0.2 s plan grid, of a plan ``[B, 30, 2]`` (tau = 0.2 ... 6.0 s) INCLUDING the origin knot (tau = 0, the ego at NOW), exactly as
+    ``upsample_prior`` prepends it: 31 knots -> 29 interior centres -> ``[B, 29, 2]``, in m per (0.2 s)^2. HSPEC's stage 2 uses the same 29 rows (``d2_matrix``)."""
+    P = torch.cat([xy.new_zeros(xy.shape[0], 1, 2), xy], 1)
+    return P[:, 2:] - 2.0 * P[:, 1:-1] + P[:, :-2]
+
+
+def accel_term(traj30: Tensor, gt: Tensor, gok: Tensor) -> Tensor:
+    """PREREG_V8F_OACC: ``1/|M| sum_{t in M} || D2 tau30(t) - D2 y30(t) ||^2`` -- O's plan against the human's, on the second difference. ``gok`` [B] is the GT-valid mask the ADE/FDE terms
+    use (a window's GT is valid for ALL 30 steps or for none: ``gt_future``), so M = the valid windows x the 29 centres, and the mean is over those cells. A batch with no valid window gives 0.0."""
+    d2 = second_diff_02(traj30) - second_diff_02(gt.to(traj30.dtype))
+    sq = (d2 ** 2).sum(-1)                                   # [B, 29]: the squared L2 norm over the two axes
+    g = gok.to(sq.dtype)
+    return (sq.mean(1) * g).sum() / g.sum().clamp_min(1.0)
+
+
+# ------------------------------------------------------------------------------------------------ PREREG_V8F_LAUNCH_INTENT: the GT-launch mask and the up-weighted along-track term
+#: The GT-launch definition, one spelling (PREREG_V8F_HACC_MC section 5, `hmc_read.py`): the logged v0 below LAUNCH_V0_MAX (m/s) AND the GT chord speed over the LAST 0.2 s of the 6 s horizon
+#: (knots 29 -> 30, i.e. 5.8 -> 6.0 s) at least v0 + LAUNCH_DV. Label-side: the GT future and the LOGGED ego speed; nothing of it is read at inference.
+LAUNCH_V0_MAX, LAUNCH_DV, LAUNCH_DT = 6.0, 1.0, 0.2
+#: The executed horizon at m = 10 (PREREG_V8F_HACC_MC section 2): knots 1-12 of the 0.2 s grid (tau 0.2 ... 2.4 s), 1-based. As slice bounds into the 30-knot plan: [LAUNCH_KNOT_LO - 1 : LAUNCH_KNOT_HI].
+LAUNCH_KNOT_LO, LAUNCH_KNOT_HI = 1, 12
+
+
+def launch_mask(v0: Tensor, gt: Tensor, gok: Tensor) -> Tensor:
+    """``[B]`` bool: the GT-launch samples. ``v0`` [B] is the LOGGED ego speed at NOW (``kin3[:, 0]``), ``gt`` [B, 30, 2] the GT waypoints in the ego frame at NOW, ``gok`` [B] the GT-valid mask. A function of the
+    logged state and the GT future ONLY (the trainer calls it BEFORE any ego stage rebuilds ``kin3``). A NaN v0 gives False. ``>=`` is the registered inequality (a chord speed exactly v0 + 1 is a launch)."""
+    v6 = torch.linalg.norm((gt[:, 29] - gt[:, 28]).to(torch.float64), dim=-1) / LAUNCH_DT
+    v0 = v0.to(torch.float64)
+    return (gok.to(torch.float64) > 0.0) & (v0 < LAUNCH_V0_MAX) & (v6 >= v0 + LAUNCH_DV)
+
+
+def launch_along_term(traj30: Tensor, gt: Tensor, gok: Tensor, launch: Tensor) -> Tensor:
+    """The up-weighted term's value at unit weight: ``sum_b gok_b launch_b (1/30) sum_{k in 1..12} |traj_x - gt_x|_k / sum_b gok_b`` -- the ALONG-axis (x of the ego frame at NOW), knots 1-12 slice of the SAME per-knot
+    distance ``traj_terms`` averages (same 1e-9 smoothing, same 1/30, same denominator), restricted to the launch samples. In the total it enters as ``w_traj * W * term / 3`` (ADE's own scale), so on a launch sample
+    the along-axis slice of O's position loss carries weight 1 + W where the cross error is 0, and a NON-launch sample's loss is the tip's, bit for bit."""
+    lo, hi = LAUNCH_KNOT_LO - 1, LAUNCH_KNOT_HI
+    dx = traj30[:, lo:hi, 0] - gt[:, lo:hi, 0]
+    d = torch.sqrt(dx ** 2 + 1e-9)
+    per = d.sum(1) / float(traj30.shape[1])
+    g = gok * launch.to(gok.dtype)
+    return (per * g).sum() / gok.sum().clamp_min(1.0)
+
+
+# ------------------------------------------------------------------------------------------------ hard projection
+def project_speed(traj: Tensor, cap_ms: Tensor | None, mu: float = 0.7, dt: float = 0.1, g: float = 9.81) -> Tensor:
+    """HARD inference projection of a path ``[B, N, 2]`` (dt s per step) onto speed <= cap (the R1 cap, from the
+    max-speed INPUT) and the Kamm circle (|v^2 kappa| <= mu g). Geometry is preserved; only the timing changes:
+    each interval's speed is capped, then the path is re-sampled at the new arc-length positions of the old path."""
+    B, N, _ = traj.shape
+    P = torch.cat([traj.new_zeros(B, 1, 2), traj], 1)
+    seg = P[:, 1:] - P[:, :-1]
+    L = torch.sqrt((seg ** 2).sum(-1) + 1e-12)
+    v = L / dt
+    ang = torch.atan2(seg[..., 1], seg[..., 0])
+    dpsi = torch.zeros_like(ang)
+    dpsi[:, 1:] = wrap(ang[:, 1:] - ang[:, :-1])
+    kappa = dpsi.abs() / L.clamp_min(1e-3)
+    kappa = torch.where(L > 1e-3, kappa, torch.zeros_like(kappa))
+    v_kamm = torch.sqrt(mu * g / kappa.clamp_min(1e-6))
+    vcap = v_kamm if cap_ms is None else torch.minimum(v_kamm, cap_ms.reshape(B, 1).expand(B, N))
+    v_new = torch.minimum(v, vcap)
+    S_old = torch.cat([L.new_zeros(B, 1), torch.cumsum(L, 1)], 1)
+    S_new = torch.cumsum(v_new * dt, 1)
+    idx = (torch.searchsorted(S_old.contiguous(), S_new.contiguous(), right=True) - 1).clamp(0, N - 1)
+    L_i = torch.gather(L, 1, idx)
+    frac = (S_new - torch.gather(S_old, 1, idx)) / L_i.clamp_min(1e-9)
+    frac = torch.where(L_i > 1e-9, frac.clamp(0.0, 1.0), torch.zeros_like(frac))
+    P0 = torch.gather(P, 1, idx[..., None].expand(-1, -1, 2))
+    sg = torch.gather(seg, 1, idx[..., None].expand(-1, -1, 2))
+    return P0 + frac[..., None] * sg
+
+
+# ------------------------------------------------------------------------------------------------ penalties (torch)
+RULE_DB_DEG, TURN_MIN_OVERLAP, SPEED_TOL, STOP_V, STOP_PASS, LEAD_TOL, LEAD_VF = 1.0, 1.0, 0.5, 1.0, 2.0, 0.2, 1.0
+BAND_KNOT = 10
+
+
+def plan_kin_t(xy: Tensor) -> dict:
+    """Torch twin of ``v8f_consistency.plan_kinematics`` (xy [B, 30, 2] at 0.2 s)."""
+    B, K, _ = xy.shape
+    P = torch.cat([xy.new_zeros(B, 1, 2), xy], 1)
+    seg = P[:, 1:] - P[:, :-1]
+    L = torch.sqrt((seg ** 2).sum(-1) + 1e-12)
+    s = torch.cat([L.new_zeros(B, 1), torch.cumsum(L, 1)], 1)
+    cur = xy.new_zeros(B)
+    psi = [cur]
+    for j in range(K):
+        mov = (seg[:, j] ** 2).sum(-1) > 1e-12                     # == |seg| > 1e-6, the numpy rule's test
+        dx = torch.where(mov, seg[:, j, 0], torch.ones_like(cur))
+        dy = torch.where(mov, seg[:, j, 1], torch.zeros_like(cur))
+        ang = torch.atan2(dy, dx)
+        ang = cur + wrap(ang - cur)
+        cur = torch.where(mov, ang, cur)
+        psi.append(cur)
+    return {"s": s, "v": L / DT, "psi": torch.stack(psi, 1)}
+
+
+def _interp_t(vals: Tensor, tau: Tensor) -> Tensor:
+    x = (tau / DT).clamp(0.0, vals.shape[1] - 1.0)
+    i0 = x.floor().clamp(max=vals.shape[1] - 2).long()
+    f = x - i0.to(x.dtype)
+    a, b = torch.gather(vals, 1, i0[:, None])[:, 0], torch.gather(vals, 1, (i0 + 1)[:, None])[:, 0]
+    return a * (1 - f) + b * f
+
+
+def consistency_penalties(xy: Tensor, c: dict) -> dict:
+    """Hinge penalties (>= 0), one per rule, in the rule's own units, plus ``viol`` (bool) and ``active`` masks.
+    ``c``: tensors with the schema of ``v8f_consistency.violations`` (NaN = unknown). hinge > 0 <=> violated."""
+    kin = plan_kin_t(xy)
+    s, v, psi = kin["s"], kin["v"], kin["psi"]
+    B = xy.shape[0]
+    z = xy.new_zeros(B)
+    pen, viol, act = {}, {}, {}
+    # SPEED
+    cap = torch.fmin(c["limit_ms"], c["v_hi_ms"]) if hasattr(torch, "fmin") else torch.minimum(c["limit_ms"], c["v_hi_ms"])
+    a = torch.isfinite(cap)
+    vmax = v[:, BAND_KNOT:].amax(1)
+    h = F.relu(vmax - torch.where(a, cap, z) - SPEED_TOL)
+    pen["SPEED"], viol["SPEED"], act["SPEED"] = torch.where(a, h, z), a & (h > 0), a
+    # STOP
+    d, tstop = c["d_stop"], c["t_stop"]
+    a = c["stop_active"] & torch.isfinite(d) & (tstop <= 6.0 + 1e-9)
+    dd = torch.where(a, d, z)
+    s_end = s[:, -1]
+    reached = a & (s_end >= dd)
+    j = (torch.searchsorted(s.detach().contiguous(), dd[:, None].contiguous(), right=True)[:, 0] - 1).clamp(0, v.shape[1] - 1)
+    v_at = torch.gather(v, 1, j[:, None])[:, 0]
+    h1, h2 = F.relu(v_at - STOP_V), F.relu(s_end - (dd + STOP_PASS))
+    h = torch.where(reached, h1, z) + torch.where(a, h2, z)
+    pen["STOP"], viol["STOP"], act["STOP"] = h, a & (h > 0), a
+    # TURN
+    side = c["turn_side"]
+    t0 = torch.clamp(torch.nan_to_num(c["turn_t_start"], nan=float("inf")), min=0.0)
+    t1 = torch.clamp(torch.nan_to_num(c["turn_t_end"], nan=-float("inf")), max=6.0)
+    a = (side != 0) & ((t1 - t0) >= TURN_MIN_OVERLAP - 1e-9)
+    t0c, t1c = torch.where(a, t0, z), torch.where(a, t1, z)
+    dpsi = torch.rad2deg(_interp_t(psi, t1c) - _interp_t(psi, t0c))
+    h = F.relu(RULE_DB_DEG - side.to(dpsi.dtype) * dpsi)
+    pen["TURN"], viol["TURN"], act["TURN"] = torch.where(a, h, z), a & (h > 0), a
+    # LEAD
+    fin = torch.isfinite(c["lead_gap_h"])
+    gap = torch.nan_to_num(c["lead_gap_h"], nan=0.0) + torch.nan_to_num(c["s_h"], nan=0.0) - s[:, 1:]
+    tg = gap.clamp_min(0.0) / v.clamp_min(LEAD_VF)
+    tgm = torch.where(fin, tg, torch.full_like(tg, float("inf")))[:, BAND_KNOT - 1:].amin(1)
+    have = torch.isfinite(tgm)
+    a = torch.isfinite(c["lead_tg_min"]) & have
+    h = F.relu(torch.where(a, c["lead_tg_min"], z) - LEAD_TOL - torch.where(a, tgm, z))
+    pen["LEAD"], viol["LEAD"], act["LEAD"] = torch.where(a, h, z), a & (h > 0), a
+    return {"pen": pen, "viol": viol, "active": act}
+
+
+PEN_SCALE = {"SPEED": 1.0, "STOP": 1.0, "TURN": 10.0, "LEAD": 0.5}
+RULES = ("SPEED", "STOP", "TURN", "LEAD")
+
+
+def limit_ms_from_onehot(limit: Tensor, ok: Tensor) -> Tensor:
+    lim = (limit * limit.new_tensor(LIMITS_MS)).sum(-1)
+    return torch.where(ok, lim, torch.full_like(lim, float("nan")))
+
+
+def gt_constraints_t(lab: dict, limit_ms: Tensor, lead_gap_h: Tensor, s_h: Tensor) -> dict:
+    """Torch twin of ``constraints_from_v9`` on a collated label pack (batch row = current frame)."""
+    y = lab["goal_y"] * lab["goal_w"]
+    tl, tr = y[:, TURN_L_I] > 0.5, y[:, TURN_R_I] > 0.5
+    cons = lab["cons"]
+    has = lab["has"]
+    side = torch.where(tl, 1, torch.where(tr, -1, 0)) * has.long()
+    nan = torch.full_like(limit_ms, float("nan"))
+    lead = torch.where((lab["lead_valid"] == 1) & has, cons[:, CI["lead_tg_min_s"]], nan)
+    return {"limit_ms": limit_ms, "v_hi_ms": torch.where(has, cons[:, CI["v_hi_ms"]], nan),
+            "stop_active": (y[:, STOP_I] > 0.5) & has, "d_stop": cons[:, CI["lon_d_reach_m"]],
+            "t_stop": cons[:, CI["lon_t_reach_s"]], "turn_side": side, "turn_t_start": cons[:, CI["turn_t_start_s"]],
+            "turn_t_end": cons[:, CI["turn_t_end_s"]], "lead_tg_min": lead, "lead_gap_h": lead_gap_h, "s_h": s_h}
+
+
+def pred_constraints_t(out: dict, limit_ms: Tensor, lead_gap_h: Tensor, s_h: Tensor) -> dict:
+    """The model's OWN constraints (detached) -- the self-consistency target."""
+    gp = out["goal_prob"].detach()
+    cons = out["cons_pred"].detach()
+    tl = (gp[:, TURN_L_I] > 0.5) & (gp[:, TURN_L_I] >= gp[:, TURN_R_I])
+    tr = (gp[:, TURN_R_I] > 0.5) & ~tl
+    follow = out["lon_logits"].detach().argmax(-1) == LON_FOLLOW
+    nan = torch.full_like(limit_ms, float("nan"))
+    return {"limit_ms": limit_ms, "v_hi_ms": cons[:, CI["v_hi_ms"]], "stop_active": gp[:, STOP_I] > 0.5,
+            "d_stop": cons[:, CI["lon_d_reach_m"]], "t_stop": cons[:, CI["lon_t_reach_s"]],
+            "turn_side": torch.where(tl, 1, torch.where(tr, -1, 0)), "turn_t_start": cons[:, CI["turn_t_start_s"]],
+            "turn_t_end": cons[:, CI["turn_t_end_s"]],
+            "lead_tg_min": torch.where(follow, cons[:, CI["lead_tg_min_s"]], nan),
+            "lead_gap_h": lead_gap_h, "s_h": s_h}
+
+
+# ------------------------------------------------------------------------------------------------ modules
+class Reader(nn.Module):
+    """Learned queries cross-attend [cond tokens ; scene tokens]. ``uses_scene=False`` BUILDS no scene path."""
+
+    def __init__(self, d, n_q, heads, ff, depth, uses_scene: bool):
+        super().__init__()
+        self.uses_scene = bool(uses_scene)
+        self.q = nn.Parameter(torch.randn(n_q, d) * 0.02)
+        layer = nn.TransformerDecoderLayer(d, heads, ff, dropout=0.0, batch_first=True, norm_first=True)
+        self.dec = nn.TransformerDecoder(layer, depth)
+        self.norm = nn.LayerNorm(d)
+
+    def forward(self, cond: Tensor, scene: Tensor | None, pad: Tensor | None) -> Tensor:
+        B = cond.shape[0]
+        if self.uses_scene and scene is not None:
+            mem = torch.cat([cond, scene], 1)
+            mp = torch.cat([torch.zeros(B, cond.shape[1], dtype=torch.bool, device=cond.device), pad], 1)
+        else:
+            mem, mp = cond, None
+        q = self.q[None].expand(B, -1, -1) + cond.mean(1, keepdim=True)
+        return self.norm(self.dec(q, mem, memory_key_padding_mask=mp))
+
+
+def _mlp(d_in, d_hid, d_out, zero_last=False):
+    m = nn.Sequential(nn.Linear(d_in, d_hid), nn.GELU(), nn.Linear(d_hid, d_out))
+    if zero_last:
+        nn.init.zeros_(m[2].weight)
+        nn.init.zeros_(m[2].bias)
+    return m
+
+
+class WMAux(nn.Module):
+    """M2: the H-JEPA world-model auxiliary (``tanitad.models.hjepa``), levels z1 / z2 / z3 on the O / T / S cycles
+    (0.2 s / 0.4 s / 0.8 s on the cache grid -- the nearest multiples to 0.1 / 0.5 / 1.0 s). a = without IDM
+    (gamma 0), b = with IDM (beta 0.08, gamma 100).
+
+    PREREG_V8F_MRATE, ``cfg.wm_k`` = K. K = 1 (default) is every earlier build, bit for bit: no module and no state-dict key is added. K > 1 (W1): level 1's state reads the adapter tokens of
+    frames t, t-1, .., t-K+1 (``enc1``, an MLP over the K concatenated projections, oldest first, the first frame's projection repeated before the window start); levels 2 and 3 read K states of
+    the level below, ``wm_strides[l-2]`` of them apart (a ``LevelConfig`` with ``window=K, dilation=stride, causal_pad=True``), so every state reads only its own time and earlier ones.
+    ``enc1`` is built LAST, on a private RNG stream derived from the run seed: W0 and W1 built under one seed share every other parameter bit for bit."""
+
+    def __init__(self, cfg: V8FMiniConfig):
+        super().__init__()
+        from tanitad.models.hjepa import HJEPAStack, LevelConfig, LevelEncoder   # S3's module; absent => this arm cannot be built
+        gamma = cfg.wm_gamma if cfg.wm == "b" else 0.0
+        mk = lambda **kw: LevelConfig(latent_dim=cfg.wm_dim, beta=cfg.wm_beta, gamma=gamma, pred_width=128,
+                                      pred_depth=2, pred_heads=4, enc_hidden=128, macro_hidden=32, **kw)
+        K = int(cfg.wm_k)
+        up = lambda i: dict(window=K, dilation=cfg.wm_strides[i], causal_pad=True) if K > 1 else {}      # K = 1: LevelConfig's defaults, i.e. the earlier build
+        lad = lambda i: dict(context=int(cfg.wm_ctx[i]), rollout_k=int(cfg.wm_rollout_k[i]), rollout_stride=int(cfg.wm_rollout_stride[i]), rollout_w=float(cfg.wm_rollout_w))   # noqa: E731  PREREG_V8F_LADDER: (3, 3, 3) / (1, 1, 1) = LevelConfig's defaults, i.e. the earlier build
+        lv = [mk(action_dim=2, act_embed_dim=32, **lad(0)),
+              mk(action_dim=32, stride=cfg.wm_strides[0], **up(0), **lad(1)), mk(action_dim=32, stride=cfg.wm_strides[1], **up(1), **lad(2))]
+        self.stack = HJEPAStack(lv, sigreg_projections=256)
+        self.proj = nn.Sequential(nn.LayerNorm(cfg.d), nn.Linear(cfg.d, cfg.wm_dim))
+        self.gamma = gamma
+        self.ch1_scale = CH1_SCALE[cfg.kin_mode]
+        self.enc1 = None
+        if K > 1:                                                              # PREREG_V8F_MRATE: built after everything else, on a private stream (the global RNG is the W0 build's)
+            with torch.random.fork_rng(devices=[]):
+                torch.manual_seed((torch.initial_seed() * 1_000_003 + 101) % (2 ** 63 - 1))
+                self.enc1 = LevelEncoder(cfg.wm_dim, cfg.wm_dim, 128, K)
+
+    def built_k(self) -> dict:
+        """What the BUILT modules read (the G-DVB reader): per level the window, the dilation and whether the window is causally padded. Level 1's window is ``enc1``'s (1 when absent)."""
+        st = self.stack
+        ks = [self.enc1.window if self.enc1 is not None else 1] + [st.encoders[i].window for i in range(2)]
+        return {"k": ks, "dilation": [1] + [st.cfg[i + 1].dilation for i in range(2)],
+                "causal_pad": [self.enc1 is not None] + [bool(st.cfg[i + 1].causal_pad) for i in range(2)]}
+
+    def built_strides(self) -> dict:
+        """PREREG_V8F_LFS, the G-DVB reader for ``--wm-strides``: what the BUILT modules use, three ways, never the config that built them. ``stride``: the ``LevelConfig`` stride of levels 2 and 3 (the one ``HJEPAStack`` slides its
+        windows by and groups the lower-level action embeddings by); ``macro_stride``: the macro-action encoder's attribute; ``macro_shape_stride``: the stride its first Linear's INPUT WIDTH carries (the parameter shapes, which a
+        loaded or mis-built module cannot fake). ``dilation``: the levels' window dilation (equal to the stride when ``wm_k`` > 1, 1 otherwise)."""
+        st = self.stack
+        macs = list(st.macro_encoders)
+        return {"stride": [int(st.cfg[i + 1].stride) for i in range(2)], "macro_stride": [int(m.stride) for m in macs],
+                "macro_shape_stride": [int(m.net[0].in_features // m.embed_dim) for m in macs], "dilation": [int(st.cfg[i + 1].dilation) for i in range(2)]}
+
+    def level_states(self, n_frames: int) -> list:
+        """PREREG_V8F_LFS: how many states each level holds for a window of ``n_frames`` frames -- MEASURED by running the BUILT stack's ``encode`` on zeros (no gradient, no randomness), not computed from the strides. Transitions per
+        level = states - 1. ``HJEPAStack.encode`` raises when a level holds fewer than 2 states; this returns that as a count of 1 instead (the gate turns it into a refusal with the number)."""
+        st = self.stack
+        dev = next(st.parameters()).device
+        z = torch.zeros(1, int(n_frames), st.cfg[0].latent_dim, device=dev)
+        a = torch.zeros(1, int(n_frames) - 1, st.cfg[0].action_dim, device=dev)
+        with torch.no_grad():
+            try:
+                enc = st.encode(z, a)
+            except ValueError:
+                n = [int(n_frames)]
+                for lv in (2, 3):
+                    c = st.cfg[lv - 1]
+                    n.append(max((n[-1] - 1) // c.stride + 1, 1) if n[-1] >= 2 else 1)
+                return n
+        return [int(t.shape[1]) for t in enc.z]
+
+    def z1(self, adapt: Tensor) -> Tensor:
+        """Level-1 latent of every cached frame: the mean-pooled adapter token, projected. ``adapt`` [B, F, n_tok, d] -> [B, F, D].
+        ONE spelling: ``forward`` (training) and rung beta's planner (``tanitad.models.v8f_beta``) both call it.
+        With ``wm_k`` K > 1 (PREREG_V8F_MRATE) frame j's latent is ``enc1`` of the projections of frames j-K+1 .. j (oldest first); frames before the window's first are the first frame's projection."""
+        return self.z1_from_mean(adapt.mean(2))
+
+    def z1_from_mean(self, am: Tensor) -> Tensor:
+        """PREREG_V8F_LADDER: ``z1`` from the adapter tokens already mean-pooled over the token axis (``am`` [B, F, d]) -- the ONLY thing the WM reads of the adapter. ``z1(adapt)`` is this applied to ``adapt.mean(2)``."""
+        p = self.proj(am)
+        if self.enc1 is None:
+            return p
+        from tanitad.models.hjepa import _windows
+        K = self.enc1.window
+        return self.enc1(_windows(torch.cat([p[:, :1].expand(-1, K - 1, -1), p], dim=1), K, 1, 1))
+
+    def scale_actions(self, act: Tensor) -> Tensor:
+        """Raw action channels ``act`` [..., 2] = (a [m/s^2], ch1) -> the WM's action units. ch1 = the recorded steer (kin_mode steer) or
+        the MEASURED yaw rate (kin_mode yaw, PI ruling D-PI-YAWRATE-1). ONE spelling for training and for the beta planner."""
+        return torch.stack([act[..., 0] / WM_ACC_SCALE, act[..., 1] / self.ch1_scale], -1)
+
+    def forward(self, adapt: Tensor, act: Tensor) -> dict:
+        z1 = self.z1(adapt)                                                     # [B, F, D]
+        a = self.scale_actions(act)[:, :-1]                                     # action of the transition j -> j+1
+        return self.stack.loss(z1, a)
+
+    def forward_mean(self, am: Tensor, act: Tensor) -> dict:
+        """PREREG_V8F_LADDER: :meth:`forward` from the token-pooled adapter output ``am`` [B, F, d] (the frozen-adapter pooled path); the same ops after the pooling."""
+        return self.stack.loss(self.z1_from_mean(am), self.scale_actions(act)[:, :-1])
+
+    def built_ladder(self, n_frames: int) -> dict:
+        """PREREG_V8F_LADDER, the G-DVB reader for the ladder levers: the BUILT stack's own measurements (``HJEPAStack.built_rollout``: predictor calls inside the free run, anchors, the context handed to ``rollout``, the
+        predictor's parameter-shape context, the weight the loss gives the term) for a window of ``n_frames`` frames, plus the cumulative stride of each level."""
+        r = self.stack.built_rollout(int(n_frames))
+        st = self.built_strides()["stride"]
+        r["cum_stride"] = [1, int(st[0]), int(st[0]) * int(st[1])]
+        return r
+
+
+class V8FMini(nn.Module):
+    def __init__(self, cfg: V8FMiniConfig, prior: P10Prior, cons_mu=None, cons_sd=None):
+        super().__init__()
+        self.cfg = cfg
+        d = cfg.d
+        self.prior = prior
+        self.register_buffer("cons_mu", torch.zeros(N_CONS) if cons_mu is None else torch.as_tensor(cons_mu, dtype=torch.float32))
+        self.register_buffer("cons_sd", torch.ones(N_CONS) if cons_sd is None else torch.as_tensor(cons_sd, dtype=torch.float32))
+        self.register_buffer("ck_nom", torch.tensor([[a, 0.0, 0.0] for a in CKPT_ARCS]))
+        self.register_buffer("ck_scale", torch.tensor([10.0, 10.0, 0.5]))
+        self.register_buffer("hacc_w", None)       # PREREG_V8F_HACC post-map weights [30, 2]: ABSENT by default (a None buffer is not in the state dict: every earlier checkpoint loads and runs bit for bit)
+        # scene adapter (shared) -- the only place frozen features meet trainable weights
+        self.adapter = nn.Sequential(nn.LayerNorm(cfg.d_feat), nn.Linear(cfg.d_feat, d))
+        self.pos = nn.Parameter(torch.randn(cfg.n_tok, d) * 0.02)
+        self.time = nn.Parameter(torch.randn(cfg.hist, d) * 0.02)
+        # conditioning tokens
+        self.e_ego, self.e_nav, self.e_lim = nn.Linear(8, d), nn.Linear(5, d), nn.Linear(5, d)
+        self.e_age = nn.Linear(2, d)
+        self.e_ck, self.e_code = nn.Linear(12, d), nn.Linear(CODE_DIM, d)
+        sc = not cfg.navonly
+        self.read_s = Reader(d, cfg.n_q, cfg.heads, cfg.ff, cfg.depth_s, uses_scene=sc)
+        self.read_t = Reader(d, cfg.n_q, cfg.heads, cfg.ff, cfg.depth_t, uses_scene=sc)
+        self.read_o = Reader(d, cfg.n_q, cfg.heads, cfg.ff, cfg.depth_o, uses_scene=True)
+        fl = cfg.n_q * d
+        self.head_s = _mlp(fl, 2 * d, 9)
+        self.trunk_t = _mlp(fl, 2 * d, d)
+        self.h_goal, self.h_lat, self.h_lon, self.h_cons = (nn.Linear(d, N_GOAL), nn.Linear(d, N_LAT),
+                                                            nn.Linear(d, N_LON), nn.Linear(d, N_CONS))
+        self.head_o = _mlp(fl, 2 * d, 2 * cfg.nb, zero_last=True)         # zero-init: the residual STARTS at P10
+        i = torch.arange(N60, dtype=torch.float32)
+        basis = torch.stack([torch.cos(k * math.pi * (i + 0.5) / N60) for k in range(cfg.nb)], 1)    # [60, nb]
+        self.register_buffer("basis", basis * ((i + 1) / N60)[:, None])       # ramp: the residual vanishes at tau -> 0
+        self.wm = WMAux(cfg) if cfg.wm != "off" else None
+        self.lvl_head = None
+        self.e_level = None
+        self.lead_head = None
+        self.e_lead = None
+        self.e_aux = None
+        if cfg.level_head == "on":                                         # PREREG_V8F_LEVEL: built LAST (the global RNG stream of every module above is the off model's)
+            self.lvl_head = _mlp(d, d, 1)
+            if cfg.aux_cond == "add":                                      # PREREG_LEVELHEAD_A2: the ``token`` wiring replaces the additive path (e_level is not built: an unused module would be an untrained one)
+                self.e_level = nn.Linear(1, d)
+                nn.init.zeros_(self.e_level.weight)                        # zero-init: O's cond at step 0 is the off model's, bit for bit (x + 0.0 == x)
+                nn.init.zeros_(self.e_level.bias)
+        if cfg.lead_head == "on":                                          # PREREG_LEVELHEAD_A2: after the level head (its draws are the level-only model's)
+            self.lead_head = _mlp(d, d, 2)
+            if cfg.aux_cond == "add":
+                self.e_lead = nn.Linear(2, d)
+                nn.init.zeros_(self.e_lead.weight)
+                nn.init.zeros_(self.e_lead.bias)
+        if cfg.aux_cond == "token" and (self.lvl_head is not None or self.lead_head is not None):
+            self.e_aux = nn.Linear(AUX_TOKEN_DIM, d)                       # default (non-zero) init: the extra token must carry signal from step 0
+        self.p_gt = 1.0
+
+    # ---- helpers -------------------------------------------------------------------------------------------
+    def _ego(self, f8):
+        return self.e_ego(self.prior.standardise(f8))
+
+    @staticmethod
+    def _at(x: Tensor, idx: Tensor) -> Tensor:                     # x [B, F, ...] -> x[b, idx[b]]
+        return x[torch.arange(x.shape[0], device=x.device), idx]
+
+    def _scene(self, adapt: Tensor, ok: Tensor, last: Tensor):
+        """tokens [B, hist*n_tok, d] (+ pad mask) of the `hist` frames ending at index `last` [B]."""
+        cfg = self.cfg
+        pos = last[:, None] - (cfg.hist - 1 - torch.arange(cfg.hist, device=adapt.device))[None]
+        g = torch.gather(adapt, 1, pos[:, :, None, None].expand(-1, -1, adapt.shape[2], adapt.shape[3]))
+        g = g + self.time[None, :, None, :]
+        pad = ~torch.gather(ok, 1, pos)
+        return g.flatten(1, 2), pad[:, :, None].expand(-1, -1, adapt.shape[2]).flatten(1)
+
+    def _code_pred(self, out: dict) -> Tensor:
+        return torch.cat([out["goal_prob"], F.softmax(out["lat_logits"], -1), F.softmax(out["lon_logits"], -1),
+                          out["cons_std"]], -1)
+
+    def _code_gt(self, lab: dict) -> Tensor:
+        y, w = lab["goal_y"], lab["goal_w"]
+        g = y * w + 0.5 * (1 - w)
+        def al(m, n):
+            m = m.float()
+            s = m.sum(-1, keepdim=True)
+            return torch.where(s > 0, m / s.clamp_min(1.0), torch.full_like(m, 1.0 / n))
+        c = torch.nan_to_num((lab["cons"] - self.cons_mu) / self.cons_sd, nan=0.0)
+        return torch.cat([g, al(lab["lat_al"], N_LAT), al(lab["lon_al"], N_LON), c], -1)
+
+    def _ck_cond(self, ck: Tensor, ok: Tensor) -> Tensor:
+        x = torch.cat([ck[..., :2] / 50.0, ck[..., 2:3], ok[..., None].to(ck.dtype)], -1)
+        return self.e_ck(x.flatten(1))
+
+    def _level(self, b, adapt: Tensor, last: Tensor):
+        """PREREG_V8F_LEVEL: ``(v_hat [B] float32 in m/s, v_in [B])``. The head reads the mean of the adapted tokens of the frame at ``last`` -- VISION ONLY (no ego, nav, limit, code or label: pinned by
+        :func:`assert_level_head_vision_only`). ``v_in`` is what O is handed: ``v_hat.detach() / LEVEL_SCALE``, 0 where that frame is not a real frame."""
+        tok = self._at(adapt, last)
+        v_hat = self.lvl_head(tok.mean(1)).squeeze(-1).float()
+        ok = self._at(b["frame_ok"], last)
+        v_in = torch.where(ok, v_hat.detach(), torch.zeros_like(v_hat)) / LEVEL_SCALE
+        return v_hat, v_in
+
+    def _lead(self, b, adapt: Tensor, last: Tensor):
+        """PREREG_LEVELHEAD_A2: ``(logit [B], gap_hat [B], lead_in [B, 2])``, float32. The head reads the mean of the adapted tokens of the frame at ``last`` -- VISION ONLY (no ego, nav, limit, code or label: pinned by
+        :func:`assert_lead_head_vision_only`). ``gap_hat`` is sigmoid of the second output = gap / 40 m in [0, 1]. ``lead_in`` is what O is handed: ``[sigmoid(logit), gap_hat]`` DETACHED, zeros where that frame is not a real frame."""
+        tok = self._at(adapt, last)
+        o = self.lead_head(tok.mean(1)).float()
+        logit, gap_hat = o[:, 0], torch.sigmoid(o[:, 1])
+        ok = self._at(b["frame_ok"], last)
+        lead_in = torch.where(ok[:, None], torch.stack([torch.sigmoid(logit.detach()), gap_hat.detach()], -1), torch.zeros_like(o))
+        return logit, gap_hat, lead_in
+
+    def _aux_in(self, b, adapt: Tensor, last: Tensor) -> Tensor:
+        """PREREG_LEVELHEAD_A2 (``--aux-cond token``): the [B, 3] input of ``e_aux`` = ``[v_hat / LEVEL_SCALE (0 without the level head), sigmoid(presence logit), gap_hat (both 0 without the lead head)]``, detached,
+        VISION ONLY (it reads ``_level`` / ``_lead`` and nothing else: pinned by :func:`aux_source_problems` and :func:`assert_aux_vision_only`)."""
+        z = torch.zeros(adapt.shape[0], device=adapt.device, dtype=torch.float32)
+        lv = self._level(b, adapt, last)[1] if self.lvl_head is not None else z
+        ld = self._lead(b, adapt, last)[2] if self.lead_head is not None else torch.stack([z, z], -1)
+        return torch.cat([lv[:, None], ld], -1)
+
+    # ---- the three layers -----------------------------------------------------------------------------------
+    def run_s(self, b, adapt, last_s, age_rel=None):
+        cfg = self.cfg
+        i = last_s
+        cond = torch.stack([self._ego(self._at(b["p10f"], i)), self.e_nav(self._at(b["nav"], i)),
+                            self.e_lim(torch.cat([b["limit"], b["limit_ok"][:, None].float()], -1))], 1)
+        sc, pad = (self._scene(adapt, b["frame_ok"], i) if not cfg.navonly else (None, None))
+        h = self.read_s(cond, sc, pad).flatten(1)
+        o = self.head_s(h).reshape(-1, 3, 3)
+        ck = self.ck_nom[None] + o.float() * self.ck_scale
+        return ck                                                          # [B, 3, 3] in S's tick-frame
+
+    def run_t(self, b, adapt, last_t, ck_t, ck_ok):
+        cfg = self.cfg
+        i = last_t
+        cond = torch.stack([self._ego(self._at(b["p10f"], i)), self.e_nav(self._at(b["nav"], i)),
+                            self.e_lim(torch.cat([b["limit"], b["limit_ok"][:, None].float()], -1)),
+                            self._ck_cond(ck_t, ck_ok)], 1)
+        sc, pad = (self._scene(adapt, b["frame_ok"], i) if not cfg.navonly else (None, None))
+        h = F.gelu(self.trunk_t(self.read_t(cond, sc, pad).flatten(1)))
+        cs = self.h_cons(h).float()
+        out = {"goal_logits": self.h_goal(h).float(), "lat_logits": self.h_lat(h).float(),
+               "lon_logits": self.h_lon(h).float(), "cons_std": cs}
+        out["goal_prob"] = torch.sigmoid(out["goal_logits"])
+        out["cons_pred"] = cs * self.cons_sd + self.cons_mu
+        return out
+
+    def run_o(self, b, adapt, last_o, ck_o, ck_ok, code):
+        cfg = self.cfg
+        i = last_o
+        ages = torch.stack([b["a_t"].float() * DT, b["a_s"].float() * DT], -1)
+        ego_tok = self._ego(self._at(b["p10f"], i))
+        if self.e_level is not None:                                    # PREREG_V8F_LEVEL: O reads e_level(v_hat.detach() / 10), ADDED to its ego conditioning token (zero-init: x + 0.0 == x, so the step-0 forward is the off model's;
+            # an APPENDED token cannot be: it changes cond.mean(1), the query, and adds a softmax key). ``run_o`` keeps its six-argument signature (the trainer's probes, the T1 sub-eval and the tests wrap it) and computes
+            # the level itself from ``adapt`` -- the same value ``_forward`` computes for the loss, so every caller of ``run_o`` gets the lever.
+            ego_tok = ego_tok + self.e_level(self._level(b, adapt, i)[1][:, None])
+        if self.e_lead is not None:                                     # PREREG_LEVELHEAD_A2 (--aux-cond add): the same form for the lead head, e_lead([sigmoid(logit), gap_hat].detach()) ADDED to the ego token, zero-init
+            ego_tok = ego_tok + self.e_lead(self._lead(b, adapt, i)[2])
+        toks = [ego_tok, self.e_nav(self._at(b["nav"], i)),
+                self.e_lim(torch.cat([b["limit"], b["limit_ok"][:, None].float()], -1)),
+                self._ck_cond(ck_o, ck_ok), self.e_code(code), self.e_age(ages)]
+        if self.e_aux is not None:                                      # PREREG_LEVELHEAD_A2 (--aux-cond token): ONE extra conditioning token built from both heads' detached outputs (default init: the step-0 forward differs from the init's by construction)
+            toks.append(self.e_aux(self._aux_in(b, adapt, i)))
+        cond = torch.stack(toks, 1)
+        sc, pad = self._scene(adapt, b["frame_ok"], i)
+        h = self.read_o(cond, sc, pad).flatten(1)
+        with torch.autocast(device_type=h.device.type, enabled=False):          # geometry + the prior stay fp32
+            coef = self.head_o(h.float()).reshape(-1, 2, cfg.nb) * cfg.res_scale_m      # [B, 2, nb]
+            res = torch.einsum("tk,bck->btc", self.basis, coef)                # [B, 60, 2]
+            p30 = self.prior(self._at(b["p10f"], i).float(), b["base"].float())
+            return upsample_prior(p30) + res, p30
+
+    # ---- forward ---------------------------------------------------------------------------------------------
+    def _encode(self, b):
+        adapt = self.adapter(b["feats"].float()) + self.pos[None, None]            # [B, F, n_tok, d]
+        return adapt
+
+    def pooled_adapt_mean(self, nm: Tensor) -> Tensor:
+        """PREREG_V8F_LADDER, the frozen-adapter pooled path. ``nm`` [..., d_feat] is the token-mean of the PARAMETER-FREE layer-normalised features (``tanitad.data.v8f_wm_windows.norm_mean_tokens``). The adapter is
+        ``Linear(LayerNorm(f)) + pos`` and both are affine in the normalised feature, so ``adapter(f).mean(tokens) + pos.mean(tokens)`` = ``Linear(g * mean(norm(f)) + b) + pos.mean(0)``: the same numbers (fp32 round-off) from a
+        [B, F, d_feat] tensor instead of a [B, F, n_tok, d] one. Equal to ``_encode(b).mean(2)`` to 1e-6 (pytest-pinned). Use with a FROZEN adapter: the result carries no adapter gradient path of interest."""
+        ln, lin = self.adapter[0], self.adapter[1]
+        return lin(nm * ln.weight + ln.bias) + self.pos.mean(0)
+
+    def pooled_adapt_mean_from_feats(self, feats: Tensor, chunk: int = 8) -> Tensor:
+        """PREREG_V8F_LADDER: the same pooled tensor from the cached tokens ``feats`` [B, F, n_tok, d_feat], computed per ``chunk`` frames under no-grad -- peak memory chunk x n_tok x d_feat instead of F x n_tok x d_feat."""
+        with torch.no_grad():
+            out = [self.adapter(feats[:, i:i + chunk].float()).mean(2) + self.pos.mean(0) for i in range(0, feats.shape[1], chunk)]
+        return torch.cat(out, 1)
+
+    def _code_mix_mask(self, has: Tensor, p_gt: float, gen=None) -> Tensor:
+        """PREREG_V8F_MIXO, ``code_mix = kind``: [B, CODE_DIM] bool, True where O reads the GT code's value instead of T's own. ONE Bernoulli(p_gt) draw per sample AND per
+        unit of :data:`CODE_MIX_UNITS` (a [B, N_CODE_UNITS] draw, independent), broadcast to the unit's indices through :data:`CODE_UNIT_OF`; a window with no T label
+        (``has`` False) reads T's own code in every unit. Every cell's marginal GT probability is p_gt (``whole``'s); only the joint changes."""
+        draw = torch.rand(has.shape[0], N_CODE_UNITS, generator=gen, device=has.device) < p_gt
+        unit = torch.as_tensor(CODE_UNIT_OF, dtype=torch.long, device=has.device)
+        return (draw & has[:, None])[:, unit]
+
+    def _forward(self, b, p_gt: float, use_labels: bool, gen=None, code_override: Tensor | None = None):
+        cfg = self.cfg
+        B = b["feats"].shape[0]
+        dev = b["feats"].device
+        Fn = b["feats"].shape[1]
+        adapt = self._encode(b)
+        last_now = torch.full((B,), Fn - 1, dtype=torch.long, device=dev)
+        last_t, last_s = last_now - b["a_t"], last_now - b["a_s"]
+        out = {}
+        if self.lvl_head is not None:                                   # PREREG_V8F_LEVEL: v_hat from the CURRENT tick frame's vision tokens (for the loss); O recomputes the same value inside run_o and reads v_hat.detach() / 10
+            out["level_v"] = self._level(b, adapt, last_now)[0]
+        if self.lead_head is not None:                                  # PREREG_LEVELHEAD_A2: (presence logit, gap_hat) from the CURRENT tick frame's vision tokens (for the loss); O recomputes the same values inside run_o
+            out["lead_logit"], out["lead_gap"] = self._lead(b, adapt, last_now)[:2]
+        # ---- S at its tick
+        ck_s = self.run_s(b, adapt, last_s)
+        out["ckpt"] = ck_s
+        ck_ok_pred = torch.ones(B, 3, device=dev)
+        ck_src, ck_ok = ck_s, ck_ok_pred
+        if use_labels and p_gt > 0:
+            use = (torch.rand(B, generator=gen, device=dev) < p_gt)[:, None] & b["lab_s"]["rc_ok"] & b["lab_s"]["has"][:, None]
+            ck_src = torch.where(use[..., None], b["lab_s"]["rc"], ck_s)
+        if cfg.detach_upper:
+            ck_src = ck_src.detach()
+        ck_for_t = transform_ckpt(ck_src, b["pose_s"], b["pose_t"])
+        # ---- T at its tick
+        tout = self.run_t(b, adapt, last_t, ck_for_t, ck_ok)
+        out.update(tout)
+        code = self._code_pred(tout)
+        if use_labels and p_gt > 0:
+            if cfg.code_mix == "kind":                                  # PREREG_V8F_MIXO: an independent GT-or-own switch per sample AND per unit
+                code = torch.where(self._code_mix_mask(b["lab_t"]["has"], p_gt, gen), self._code_gt(b["lab_t"]), code)
+            else:                                                       # whole: the pre-MIXO lines, verbatim (the RNG stream is B's)
+                use_t = (torch.rand(B, generator=gen, device=dev) < p_gt) & b["lab_t"]["has"]
+                code = torch.where(use_t[:, None], self._code_gt(b["lab_t"]), code)
+        if code_override is not None:                                   # forward_diag only (PREREG_V8F_TAC)
+            if code_override.shape != code.shape:
+                raise ValueError(f"code_override {tuple(code_override.shape)} != T's code {tuple(code.shape)}")
+            code = code_override.to(device=code.device, dtype=code.dtype)
+        if cfg.detach_upper:
+            code = code.detach()
+        out["code"] = code                                               # the code O actually read (o_interface full); under cut, the code OFFERED to the interface (T's, after every override): O reads zeros there
+        ck_for_o = transform_ckpt(ck_src, b["pose_s"], b["pose_now"])
+        if cfg.o_interface == "cut":                                     # PREREG_V8F_FLAT: O reads a CONSTANT for both of its hierarchical inputs; T has already read S (run_t above), so only the wires INTO O are cut
+            ck_for_o = self.ck_nom[None].expand(B, -1, -1)               # S's checkpoints for O = the nominal arcs ...
+            ck_ok = torch.zeros_like(ck_ok)                              # ... flagged absent (ok = 0)
+            code = torch.zeros_like(code)                                # T's code = zeros, AFTER every override (the teacher forcing and forward_diag's code_override)
+        traj60, p30 = self.run_o(b, adapt, last_now, ck_for_o, ck_ok, code)
+        out["traj60"], out["traj30"], out["p10"] = traj60, subsample_02(traj60), p30
+        out["adapt"] = adapt
+        return out
+
+    def forward_infer(self, batch: dict) -> dict:
+        """INFERENCE: reads only :data:`INFERENCE_INPUT_KEYS` -- no label, no GT, no situation classifier.
+
+        With the HACC post-map set (:meth:`set_hacc_weights`; ``hacc_w`` ABSENT by default) the plan is ``P + w * (O - P)`` per 0.2 s step and per axis (:meth:`_hacc_post_map`); with
+        it absent the outputs are bit-identical to a model that has no such buffer. Inference stays vision + ego-dynamics only: see :meth:`_hacc_post_map`."""
+        g = _KeyGuard(batch)
+        out = self._forward(g, 0.0, False)
+        out["_keys_read"] = set(g.read)
+        return self._hacc_post_map(out)
+
+    def _hacc_post_map(self, out: dict) -> dict:
+        """PREREG_V8F_HACC, the deployed post-map: with ``hacc_w`` set, ``traj60`` becomes ``P + w * (O - P)`` on the 0.1 s grid (:func:`hacc_apply` with :func:`hacc_w_midpoints`' weights),
+        ``traj30`` its odd rows (so ``traj30 == traj60[:, 1::2]`` still holds), and O's own plan is kept as ``traj60_o`` / ``traj30_o``. P is the prior the model already computed
+        (``out["p10"]``: the DEPLOYED P10 from the measured ego history, as in HBLEND) and ``w`` is a constant -- a fixed function of the step index, fitted offline on TRAINING windows -- so
+        inference stays VISION + ego-dynamics only: the map reads no new batch key, no label and no situation-classifier output, and every other output is untouched. With ``hacc_w`` absent
+        ``out`` is returned as is. It is applied by :meth:`forward_infer` AND :meth:`forward_diag` (whose identity with ``forward_infer`` under T's own code must hold, and a TAC read
+        compares the two) and NEVER in ``_forward``: training and the loss read O's raw plan."""
+        if self.hacc_w is None:
+            return out
+        w30 = self.hacc_w.to(device=out["traj60"].device, dtype=out["traj60"].dtype)
+        out["traj60_o"], out["traj30_o"] = out["traj60"], out["traj30"]
+        out["traj60"] = hacc_apply(out["traj60"], upsample_prior(out["p10"]), hacc_w_midpoints(w30))
+        out["traj30"] = subsample_02(out["traj60"])
+        return out
+
+    # ---- HACC post-map (inference only) ------------------------------------------------------------------------
+    @property
+    def hacc_active(self) -> bool:
+        """True iff the HACC post-map weights are set (``forward_infer`` then returns the HACC plan)."""
+        return self.hacc_w is not None
+
+    def set_hacc_weights(self, w) -> None:
+        """Set the post-map: ``w`` is a ``[30, 2]`` table (0.2 s step x [along, cross]), validated by :func:`hacc_check_weights` (shape, finite, in [0, 1]); REFUSED with ``ValueError`` otherwise, and
+        the model is left unchanged. Stored as a float32 buffer, so it follows ``.to(device)`` and is saved / loaded with the state dict."""
+        t = torch.as_tensor(hacc_check_weights(w), dtype=torch.float32, device=self.basis.device)
+        self.register_buffer("hacc_w", t)
+
+    def load_hacc_weights(self, src) -> None:
+        """:meth:`set_hacc_weights` from a ``weights_HACC_<model>.json`` (a path or its parsed dict; :func:`read_hacc_weights`)."""
+        self.set_hacc_weights(read_hacc_weights(src))
+
+    def clear_hacc_weights(self) -> None:
+        """Back to the plain O plan: the buffer is removed (so it leaves the state dict)."""
+        self.hacc_w = None
+
+    def _load_from_state_dict(self, state_dict, prefix, local_metadata, strict, missing_keys, unexpected_keys, error_msgs):
+        """A state dict that CARRIES ``hacc_w`` is validated (:func:`hacc_check_weights`: a wrong shape or an entry outside [0, 1] is REFUSED) and loads into a model that has none yet (the buffer is
+        created first); one that does not carry it loads as before."""
+        key = prefix + "hacc_w"
+        if key in state_dict:
+            hacc_check_weights(state_dict[key])
+            if self.hacc_w is None:
+                self.register_buffer("hacc_w", torch.zeros(K30, 2, device=self.basis.device))
+        super()._load_from_state_dict(state_dict, prefix, local_metadata, strict, missing_keys, unexpected_keys, error_msgs)
+
+    def forward_diag(self, batch: dict, code_override: Tensor) -> dict:
+        """DIAGNOSTIC ONLY (PREREG_V8F_TAC): inference exactly as :meth:`forward_infer`, except that O reads ``code_override``
+        [B, CODE_DIM] in place of T's held output: a DONOR window's predicted code (TAC-USED: does O use T at all?) or the GT code
+        (TAC-HEADROOM: what a perfect tactical layer would buy; a T0 oracle, never a result). The batch is read through the same
+        key guard, so the model still sees only :data:`INFERENCE_INPUT_KEYS`; any label in the override was read by the EVALUATOR.
+        Never called by training or by :meth:`forward_infer`."""
+        g = _KeyGuard(batch)
+        out = self._forward(g, 0.0, False, code_override=code_override)
+        out["_keys_read"] = set(g.read)
+        return self._hacc_post_map(out)                      # the same post-map as forward_infer (absent => out as is), so the identity under T's own code survives
+
+    def forward(self, batch: dict, p_gt: float | None = None, gen=None) -> dict:
+        return self._forward(batch, self.p_gt if p_gt is None else p_gt, True, gen)
+
+    # ---- losses ----------------------------------------------------------------------------------------------
+    def loss(self, batch: dict, p_gt: float | None = None, gen=None) -> dict:
+        cfg = self.cfg
+        out = self.forward(batch, p_gt, gen)
+        T = {}
+        B = batch["feats"].shape[0]
+        # S: L1 on position + heading, at S's tick frame
+        ls, lt = batch["lab_s"], batch["lab_t"]
+        ok = (ls["rc_ok"] & ls["has"][:, None]).float()
+        e = (out["ckpt"] - ls["rc"]).abs() / self.ck_scale
+        e = torch.cat([e[..., :2].sum(-1, keepdim=True), e[..., 2:3]], -1).sum(-1)
+        T["ckpt"] = (e * ok).sum() / ok.sum().clamp_min(1.0)
+        # T: masked BCE / partial-label CE / Huber at T's tick frame
+        w = lt["goal_w"] * lt["has"][:, None].float()
+        bce = F.binary_cross_entropy_with_logits(out["goal_logits"], lt["goal_y"], reduction="none")
+        T["goal"] = (bce * w).sum() / w.sum().clamp_min(1.0)
+        T["lat"] = self._partial_ce(out["lat_logits"], lt["lat_al"], lt["has"])
+        T["lon"] = self._partial_ce(out["lon_logits"], lt["lon_al"], lt["has"])
+        tgt = (lt["cons"] - self.cons_mu) / self.cons_sd
+        if cfg.cons_absent == "zero":                # PREREG_V8F_CZ: an absent constraint's target is the 0 O reads under teacher forcing
+            m = lt["has"][:, None].expand_as(tgt)
+            tgt = torch.where(torch.isfinite(tgt), tgt, torch.zeros_like(tgt))
+        else:
+            m = torch.isfinite(tgt) & lt["has"][:, None]
+        hub = F.huber_loss(out["cons_std"], torch.nan_to_num(tgt), reduction="none", delta=1.0)
+        T["cons"] = (hub * m).sum() / m.sum().clamp_min(1.0)
+        # O: ADE / FDE on the 0.2 s knots
+        gt, gok = batch["gt"], batch["gt_ok"].float()
+        T["ade"], T["fde"] = traj_terms(out["traj30"], gt, gok)      # the same two lines as before, now ONE spelling that PREREG_V8F_OACC's w_acc rule also calls
+        aux = batch.get("aux_ok")                                    # PREREG_T2_DAGGER: [B] bool, False on a T2-bank row (its ONLY supervision is the target law: ade / fde); ABSENT = every row carries every term = the tip, bit for bit
+        T["acc"] = accel_term(out["traj30"], gt, gok if aux is None else gok * aux.to(gok.dtype))                # PREREG_V8F_OACC: always LOGGED (the G-LIVE probe and the reader read it); in the total only when w_acc > 0
+        if cfg.launch_intent_w > 0.0:                                # PREREG_V8F_LAUNCH_INTENT: computed ONLY when declared (0.0 = no new tensor op, no new T key = the tip, bit for bit)
+            if "launch" not in batch:
+                raise ValueError("launch_intent_w > 0 but the batch carries no `launch` mask: the trainer computes it from the LOGGED state before any ego stage (v8f_mini_train.py launch stage)")
+            T["launch_along"] = launch_along_term(out["traj30"], gt, gok, batch["launch"])
+        if cfg.level_head == "on":                                   # PREREG_V8F_LEVEL: computed ONLY when the head is built (off = no new tensor op, no new T key = the tip, bit for bit)
+            if "level_y" not in batch or "level_ok" not in batch:
+                raise ValueError("level_head on but the batch carries no `level_y` / `level_ok`: the trainer computes them from the LOGGED speed before any ego stage (v8f_mini_train.py level_stage)")
+            ly = torch.nan_to_num(batch["level_y"].float())
+            lok = (batch["level_ok"] & batch["frame_ok"][:, -1]).float()
+            T["level"] = (F.huber_loss(out["level_v"], ly, reduction="none", delta=LEVEL_HUBER_DELTA) * lok).sum() / lok.sum().clamp_min(1.0)
+        if cfg.lead_head == "on":                                    # PREREG_LEVELHEAD_A2: computed ONLY when the head is built (off = no new tensor op, no new T key = the tip, bit for bit)
+            if "lead_y" not in batch or "lead_has" not in batch or "lead_near" not in batch:
+                raise ValueError("lead_head on but the batch carries no `lead_y` / `lead_has` / `lead_near`: the trainer computes them from the lead labels before any ego stage (v8f_mini_train.py lead_stage)")
+            fok = batch["frame_ok"][:, -1]
+            lhas = (batch["lead_has"] & fok).float()                                   # frames with a lead label: the presence BCE (positives AND negatives)
+            lnear = (batch["lead_near"] & batch["lead_has"] & fok).float()            # frames with a lead label AND a lead within LEAD_RANGE_M: the gap Huber
+            bce = F.binary_cross_entropy_with_logits(out["lead_logit"], batch["lead_near"].float(), reduction="none")
+            hub = F.huber_loss(out["lead_gap"], torch.nan_to_num(batch["lead_y"].float()), reduction="none", delta=LEAD_HUBER_DELTA)
+            T["lead_bce"] = (bce * lhas).sum() / lhas.sum().clamp_min(1.0)
+            T["lead_huber"] = (hub * lnear).sum() / lnear.sum().clamp_min(1.0)
+            T["lead"] = T["lead_bce"] + T["lead_huber"]
+        # consistency penalties
+        lim = limit_ms_from_onehot(batch["limit"], batch["limit_ok"])
+        if cfg.consistency:
+            cg = gt_constraints_t(batch["lab"], lim, batch["lead_gap_h"], batch["s_h"])
+            pg = consistency_penalties(out["traj30"], cg)
+            cs = pred_constraints_t(out, lim, batch["lead_gap_h"], batch["s_h"])
+            ps = consistency_penalties(out["traj30"], cs)
+            for r in RULES:
+                if aux is None:
+                    T[f"pen_{r}"] = (pg["pen"][r] / PEN_SCALE[r]).mean()
+                    T[f"pens_{r}"] = (ps["pen"][r] / PEN_SCALE[r]).mean()
+                else:                                                # PREREG_T2_DAGGER: the mean over the rows that carry the term (a bank row contributes exactly 0.0)
+                    af = aux.to(pg["pen"][r].dtype)
+                    T[f"pen_{r}"] = ((pg["pen"][r] / PEN_SCALE[r]) * af).sum() / af.sum().clamp_min(1.0)
+                    T[f"pens_{r}"] = ((ps["pen"][r] / PEN_SCALE[r]) * af).sum() / af.sum().clamp_min(1.0)
+            out["viol"] = pg["viol"]
+        if self.wm is not None:
+            if aux is None:
+                wm = self.wm(out["adapt"], batch["act"])
+                T["wm"] = wm["total"]
+            elif bool(aux.any()):                                    # PREREG_T2_DAGGER: the auxiliary sees only the rows that carry it (a bank row is not in its computation: exactly 0.0 gradient)
+                wm = self.wm(out["adapt"][aux], batch["act"][aux])
+                T["wm"] = wm["total"]
+            else:
+                T["wm"] = out["adapt"].sum() * 0.0
+        total = (cfg.w_ckpt * T["ckpt"] + cfg.w_tac * (T["goal"] + 0.5 * (T["lat"] + T["lon"]) + cfg.w_cons * T["cons"])
+                 + cfg.w_traj * (T["ade"] / 3.0 + 0.5 * T["fde"] / 6.0))
+        total = total + cfg.w_acc * T["acc"] if cfg.w_acc > 0.0 else total          # PREREG_V8F_OACC: ONE line (a mutation deletes it); w_acc 0 adds nothing: B's total, bit for bit
+        total = total + cfg.w_traj * cfg.launch_intent_w * T["launch_along"] / 3.0 if cfg.launch_intent_w > 0.0 else total      # PREREG_V8F_LAUNCH_INTENT: ONE line (a mutation deletes it); W 0 adds nothing: the tip's total
+        total = total + cfg.w_level * T["level"] if cfg.level_head == "on" else total          # PREREG_V8F_LEVEL: ONE line (a mutation deletes it); head off adds nothing: the tip's total
+        total = total + cfg.w_lead * T["lead"] if cfg.lead_head == "on" else total             # PREREG_LEVELHEAD_A2: ONE line (a mutation deletes it); head off adds nothing: the tip's total
+        if cfg.consistency:
+            total = total + cfg.w_pen * sum(T[f"pen_{r}"] for r in RULES) + cfg.w_pen_self * sum(T[f"pens_{r}"] for r in RULES)
+        if self.wm is not None:
+            total = total + cfg.w_wm * T["wm"]
+        T["total"] = total
+        out["terms"] = T
+        return out
+
+    def wm_only_loss(self, batch: dict) -> dict:
+        """PREREG_V8F_MRATE, the WM-only mode: ONLY the world model's loss terms, on a FROZEN adapter. ``adapt`` is detached, so the adapter (and ``pos``) receive exactly 0.0 even if they are trainable; the readers,
+        the heads and the planner are never run. ``terms``: ``wm`` (the stack's total), ``wm/<stack term>`` per level, ``total`` = ``w_wm`` x ``wm``."""
+        if self.wm is None:
+            raise ValueError("wm_only_loss needs a world model (wm a or b)")
+        if "zmean" in batch:                                                    # PREREG_V8F_LADDER: the cached mean adapter token (box-2 zcache): exactly ``_encode(b).mean(2)``, read from disk
+            wm = self.wm.forward_mean(batch["zmean"].float().detach(), batch["act"])
+        elif "pool" in batch:                                                   # PREREG_V8F_LADDER: a world-model-only batch with the frozen adapter's pooled path (no [B, F, n_tok, d] tensor is ever built)
+            wm = self.wm.forward_mean(self.pooled_adapt_mean(batch["pool"].float()).detach(), batch["act"])
+        else:
+            wm = self.wm(self._encode(batch).detach(), batch["act"])
+        T = {"wm": wm["total"]}
+        T.update({f"wm/{k}": v for k, v in wm.items() if k != "total"})
+        T["total"] = self.cfg.w_wm * wm["total"]
+        return {"terms": T}
+
+    @staticmethod
+    def _partial_ce(logits: Tensor, allowed: Tensor, has: Tensor) -> Tensor:
+        """-log sum_{c in allowed} p_c ; rows with an empty allowed set (IGNORE) or no label are masked."""
+        valid = allowed.any(-1) & has
+        lse = torch.logsumexp(logits, -1)
+        lsa = torch.logsumexp(logits.masked_fill(~allowed, float("-inf")), -1)
+        l = torch.where(valid, lse - lsa, torch.zeros_like(lse))
+        return l.sum() / valid.float().sum().clamp_min(1.0)
+
+    # ---- bookkeeping ------------------------------------------------------------------------------------------
+    def trainable_groups(self) -> dict:
+        g = {"adapter": [self.adapter, self.pos, self.time], "cond": [self.e_ego, self.e_nav, self.e_lim, self.e_age,
+             self.e_ck, self.e_code], "S": [self.read_s, self.head_s], "T": [self.read_t, self.trunk_t, self.h_goal,
+             self.h_lat, self.h_lon, self.h_cons], "O": [self.read_o, self.head_o]}
+        if self.wm is not None:
+            g["WM"] = [self.wm]
+        if self.lvl_head is not None:
+            g["LEVEL"] = [self.lvl_head] + ([self.e_level] if self.e_level is not None else [])      # token wiring: e_level is not built
+        if self.lead_head is not None:                                              # PREREG_LEVELHEAD_A2
+            g["LEAD"] = [self.lead_head] + ([self.e_lead] if self.e_lead is not None else [])
+        if self.e_aux is not None:
+            g["AUX"] = [self.e_aux]
+        return g
+
+    def built_levers(self) -> dict:
+        """What the BUILT model does (the G-DVB 'built' side)."""
+        cfg = self.cfg
+        gp = lambda mods: int(sum(p.numel() for m in mods for p in (m.parameters() if isinstance(m, nn.Module) else [m])
+                                  if p.requires_grad))
+        lv = {"navonly": (not self.read_s.uses_scene) and (not self.read_t.uses_scene) and self.read_o.uses_scene,
+                "consistency": bool(cfg.consistency), "wm": "off" if self.wm is None else ("b" if self.wm.gamma > 0 else "a"),
+                "cons_absent": cfg.cons_absent, "code_mix": cfg.code_mix,        # PREREG_V8F_MIXO: the teacher-forcing granularity the BUILT model's _forward reads
+                "o_interface": cfg.o_interface,                                # PREREG_V8F_FLAT: what the BUILT model's _forward hands O (full: S's checkpoints + T's code; cut: constants)
+                "w_acc": cfg.w_acc,                                            # PREREG_V8F_OACC: the weight the BUILT loss gives the acceleration term (0.0 = not in the total)
+                "launch_intent_w": cfg.launch_intent_w,                       # PREREG_V8F_LAUNCH_INTENT: the extra along-track weight the BUILT loss gives GT-launch samples (0.0 = not in the total)
+                "wm_idm_gamma": 0.0 if self.wm is None else float(self.wm.gamma),
+                "kin_mode": self.cfg.kin_mode, "wm_ch1_scale": None if self.wm is None else float(self.wm.ch1_scale),
+                "p_gt_start": cfg.p_gt_start, "p_gt_end": cfg.p_gt_end,      # PREREG_V8F_PGT: the scheduled-sampling schedule the train loop reads
+                "hist": int(self.time.shape[0]), "hmax": cfg.hmax,           # PREREG_V8F_HIST (F-3): the BUILT history (the per-frame time table's rows) and batch depth
+                "window_start": cfg.window_start_effective,                  # Amendment 1: the EFFECTIVE first-window step (hist - 1 when the flag is absent)
+                "prior_frozen": not any(p.requires_grad for p in self.prior.parameters()),
+                "residual_zero_init": bool(float(self.head_o[2].weight.detach().abs().sum()) == 0.0),
+                "params": {k: gp(v) for k, v in self.trainable_groups().items()},
+                "n_params_trainable": int(sum(p.numel() for p in self.parameters() if p.requires_grad)),
+                "w": {"w_pen": cfg.w_pen if cfg.consistency else 0.0, "w_pen_self": cfg.w_pen_self if cfg.consistency else 0.0,
+                      "w_wm": cfg.w_wm if self.wm is not None else 0.0,
+                      "w_tac": cfg.w_tac, "w_cons": cfg.w_cons}}                       # PREREG_V8F_WC: T's constraint term is w_tac x w_cons
+        if self.wm is not None and any(k > 1 for k in self.wm.built_k()["k"]):      # PREREG_V8F_MRATE: present ONLY with a multi-frame WM built (a W0 model keeps its key set); the gate reads built.get("wm_k", 1)
+            bk = self.wm.built_k()
+            lv["wm_k"], lv["wm_k_levels"], lv["wm_dilation_levels"], lv["wm_causal_pad_levels"] = max(bk["k"]), bk["k"], bk["dilation"], bk["causal_pad"]
+        if self.wm is not None and tuple(self.wm.built_strides()["stride"]) != tuple(V8FMiniConfig.__dataclass_fields__["wm_strides"].default):      # PREREG_V8F_LFS: present ONLY with non-default strides built (a (2, 2) model keeps its key set); the gate reads built.get("wm_strides", [2, 2])
+            lv["wm_strides"] = list(self.wm.built_strides()["stride"])
+        if self.wm is not None:                                            # PREREG_V8F_LADDER: present ONLY when moved (a default model keeps its key set); the config echo of the BUILT LevelConfigs / predictors -- the gate's reader is WMAux.built_ladder (the loss's own loop)
+            cf = self.wm.stack.cfg
+            if any(c.rollout_k > 1 for c in cf):
+                lv["wm_rollout_k"], lv["wm_rollout_stride"], lv["wm_rollout_w"] = [c.rollout_k for c in cf], [c.rollout_stride for c in cf], cf[0].rollout_w
+            if any(int(p.pos.shape[0]) != 3 for p in self.wm.stack.predictors):
+                lv["wm_ctx"] = [int(p.pos.shape[0]) for p in self.wm.stack.predictors]
+        if self.lvl_head is not None:                                     # PREREG_V8F_LEVEL: present ONLY with the head built (a flag-off model keeps its key set); the gate reads built.get("level_head", "off")
+            lv["level_head"], lv["w_level"] = "on", cfg.w_level
+            if self.e_level is not None:                                   # PREREG_LEVELHEAD_A2: absent under --aux-cond token (the additive path is not built)
+                lv["level_token_zero_init"] = bool(float(self.e_level.weight.detach().abs().sum()) == 0.0 and float(self.e_level.bias.detach().abs().sum()) == 0.0)
+            lv["level_vision_only_source"] = not level_head_source_problems()
+        if self.lead_head is not None:                                     # PREREG_LEVELHEAD_A2: present ONLY with the head built (a flag-off model keeps its key set); the gate reads built.get("lead_head", "off")
+            lv["lead_head"], lv["w_lead"] = "on", cfg.w_lead
+            lv["lead_vision_only_source"] = not lead_head_source_problems()
+            if self.e_lead is not None:
+                lv["lead_token_zero_init"] = bool(float(self.e_lead.weight.detach().abs().sum()) == 0.0 and float(self.e_lead.bias.detach().abs().sum()) == 0.0)
+        if self.lead_head is not None or self.e_aux is not None:           # the BUILT wiring, read back by the gate (absent = the additive default with no head: a token declared with no head builds nothing and is refused)
+            lv["aux_cond"] = "token" if self.e_aux is not None else "add"
+            lv["aux_vision_only_source"] = not aux_source_problems()
+            if self.e_aux is not None:
+                lv["aux_token_dim"] = int(self.e_aux.in_features)
+        return lv
+
+
+class _KeyGuard(dict):
+    """A dict that records which keys the model reads (the signature test for the admissibility rule)."""
+
+    def __init__(self, d):
+        super().__init__(d)
+        self.read = set()
+
+    def __getitem__(self, k):
+        self.read.add(k)
+        return super().__getitem__(k)
+
+    def __contains__(self, k):
+        self.read.add(k)
+        return super().__contains__(k)
+
+
+def p_gt_schedule(step: int, total: int, p0: float = 1.0, p1: float = 0.2) -> float:
+    """Scheduled sampling: linear p_GT from `p0` to `p1` over the run (PREREG: 1.0 -> 0.2)."""
+    return float(p0 + (p1 - p0) * min(max(step / max(total, 1), 0.0), 1.0))
+
+
+def cons_stats(join: dict) -> tuple:
+    """Mean / std of the 26 constraint cells over labelled rows (finite entries only), for the standardised head."""
+    import warnings
+    c = join["cons"][join["has"]].astype(np.float64)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", RuntimeWarning)                   # all-NaN columns -> mu 0, sd 1 below
+        mu = np.nanmean(c, 0)
+        sd = np.nanstd(c, 0)
+    return np.where(np.isfinite(mu), mu, 0.0).astype(np.float32), np.where(np.isfinite(sd) & (sd > 1e-6), sd, 1.0).astype(np.float32)
+
+
+# ------------------------------------------------------------------------------------------------ admissibility
+_FORBIDDEN_TOKENS = ("situation", "sitclf", "scenario_cls", "head_img")
+
+
+def scan_source_for_forbidden(src: str) -> list:
+    """Forbidden tokens among the identifiers / attributes / arguments / string subscripts of the CODE in ``src``
+    (docstrings and comments are not code)."""
+    names = set()
+    for n in ast.walk(ast.parse(src)):
+        if isinstance(n, ast.Name):
+            names.add(n.id.lower())
+        elif isinstance(n, ast.Attribute):
+            names.add(n.attr.lower())
+        elif isinstance(n, ast.arg):
+            names.add(n.arg.lower())
+        elif isinstance(n, ast.Subscript) and isinstance(getattr(n, "slice", None), ast.Constant) and isinstance(n.slice.value, str):
+            names.add(n.slice.value.lower())
+    return sorted(t for t in _FORBIDDEN_TOKENS if any(t in nm for nm in names if nm != "_forbidden_tokens"))
+
+
+def assert_no_situation_classifier_input(model: V8FMini | None = None, batch: dict | None = None) -> dict:
+    """Binding rule of 2026-08-03: the goal path and the situation path are information-disjoint at inference.
+
+    Checks (raises AssertionError): (1) this module's CODE (not its docstrings/comments) names no situation
+    classifier; (2) ``forward_infer`` takes exactly one data argument, ``batch``; (3) if a model + batch are given,
+    the keys ``forward_infer`` actually READS are a subset of :data:`INFERENCE_INPUT_KEYS`, and none of them is a
+    label key (``lab*``) or contains a forbidden token."""
+    bad = scan_source_for_forbidden(inspect.getsource(inspect.getmodule(V8FMini)))
+    assert not bad, f"situation-classifier tokens in code: {bad}"
+    sig = list(inspect.signature(V8FMini.forward_infer).parameters)
+    assert sig == ["self", "batch"], f"forward_infer signature {sig}"
+    keys = set()
+    if model is not None and batch is not None:
+        was = model.training
+        model.eval()
+        with torch.no_grad():
+            keys = model.forward_infer(batch)["_keys_read"]
+        model.train(was)
+        extra = keys - INFERENCE_INPUT_KEYS
+        assert not extra, f"inference reads keys outside the admissible set: {sorted(extra)}"
+        assert not any(k.startswith("lab") or any(t in k for t in _FORBIDDEN_TOKENS) for k in keys)
+    return {"allowed": sorted(INFERENCE_INPUT_KEYS), "read": sorted(keys)}
+
+
+def level_head_source_problems(fn=None) -> list:
+    """PREREG_V8F_LEVEL admissibility, STATIC half: the identifiers / attributes / arguments / string subscripts of ``V8FMini._level``'s CODE (not its docstring) that name an ego, nav, limit, code or label input
+    (:data:`LEVEL_FORBIDDEN_NAMES`) -- empty = the head's code reads vision only. The head is fed ``adapt`` (the adapted tokens) and ``b["frame_ok"]`` and nothing else."""
+    import textwrap
+    tree = ast.parse(textwrap.dedent(inspect.getsource(V8FMini._level if fn is None else fn)))
+    fn = tree.body[0]
+    body = ast.Module(body=[st for st in fn.body if not (isinstance(st, ast.Expr) and isinstance(getattr(st, "value", None), ast.Constant) and isinstance(st.value.value, str))], type_ignores=[])
+    names = set()
+    for n in ast.walk(body):
+        if isinstance(n, ast.Name):
+            names.add(n.id)
+        elif isinstance(n, ast.Attribute):
+            names.add(n.attr)
+        elif isinstance(n, ast.Subscript) and isinstance(getattr(n, "slice", None), ast.Constant) and isinstance(n.slice.value, str):
+            names.add(n.slice.value)
+    return sorted(names & set(LEVEL_FORBIDDEN_NAMES))
+
+
+def assert_level_head_vision_only(model: V8FMini, batch: dict) -> dict:
+    """PREREG_V8F_LEVEL admissibility (binding: labels may use ego, inference is vision-only): the level head's v_hat is a function of the VISION tokens alone. Raises AssertionError unless
+      (1) :func:`level_head_source_problems` is empty;
+      (2) running ``model._level`` on a key-guarded batch READS only :data:`LEVEL_ALLOWED_KEYS`;
+      (3) v_hat is IDENTICAL (bit for bit) when every non-vision batch key (ego history, nav, limit, actions, poses, base, kin3, ages, labels) is replaced by a different value, and DIFFERENT when ``feats`` is.
+    Returns the record the launch gate carries."""
+    if model.lvl_head is None:
+        raise AssertionError("assert_level_head_vision_only: the model has no level head")
+    src = level_head_source_problems(type(model)._level)               # the code of the model's OWN class (a subclass that rewires the head is read, not the base)
+    if src:
+        raise AssertionError(f"the level head's code names non-vision inputs: {src}")
+    was = model.training
+    model.eval()
+    try:
+        with torch.no_grad():
+            Fn = batch["feats"].shape[1]
+            last = torch.full((batch["feats"].shape[0],), Fn - 1, dtype=torch.long, device=batch["feats"].device)
+            g = _KeyGuard(batch)
+            adapt = model._encode(g)
+            g.read.clear()
+            v0, _ = model._level(g, adapt, last)
+            extra = g.read - LEVEL_ALLOWED_KEYS
+            if extra:
+                raise AssertionError(f"the level head READS batch keys {sorted(extra)} (only {sorted(LEVEL_ALLOWED_KEYS)} are admissible)")
+            other = {}
+            for k, v in batch.items():
+                if k in ("feats", "frame_ok") or not torch.is_tensor(v):
+                    other[k] = v
+                elif v.is_floating_point():
+                    other[k] = torch.randn_like(v) * 3.0 + 1.0
+                elif v.dtype == torch.bool:
+                    other[k] = ~v
+                else:
+                    other[k] = v + 1
+            v1, _ = model._level(other, model._encode(other), last)
+            if not torch.equal(v0, v1):
+                raise AssertionError(f"v_hat moved by {float((v0 - v1).abs().max())} when only non-vision inputs changed: the level head reads a non-vision input")
+            moved = dict(batch)
+            moved["feats"] = batch["feats"] + torch.randn(batch["feats"].shape, generator=torch.Generator().manual_seed(3)).to(batch["feats"].dtype) * 0.5
+            v2, _ = model._level(moved, model._encode(moved), last)
+            if torch.equal(v0, v2):
+                raise AssertionError("v_hat did not move when the vision features changed: the head does not read the frame")
+    finally:
+        model.train(was)
+    return {"keys_read": sorted(g.read), "source_problems": src, "vision_sensitivity": float((v0 - v2).abs().max())}
+
+
+def _forbidden_in(fn, forbidden) -> list:
+    """The identifiers / attributes / string subscripts of ``fn``'s CODE (not its docstring) that are in ``forbidden`` (sorted)."""
+    import textwrap
+    tree = ast.parse(textwrap.dedent(inspect.getsource(fn)))
+    fdef = tree.body[0]
+    body = ast.Module(body=[st for st in fdef.body if not (isinstance(st, ast.Expr) and isinstance(getattr(st, "value", None), ast.Constant) and isinstance(st.value.value, str))], type_ignores=[])
+    names = set()
+    for n in ast.walk(body):
+        if isinstance(n, ast.Name):
+            names.add(n.id)
+        elif isinstance(n, ast.Attribute):
+            names.add(n.attr)
+        elif isinstance(n, ast.Subscript) and isinstance(getattr(n, "slice", None), ast.Constant) and isinstance(n.slice.value, str):
+            names.add(n.slice.value)
+    return sorted(names & set(forbidden))
+
+
+def lead_head_source_problems(fn=None) -> list:
+    """PREREG_LEVELHEAD_A2 admissibility, STATIC half: the identifiers of ``V8FMini._lead``'s CODE that name an ego, nav, limit, code or label input (:data:`LEAD_FORBIDDEN_NAMES`) -- empty = the head's code reads vision only."""
+    return _forbidden_in(V8FMini._lead if fn is None else fn, LEAD_FORBIDDEN_NAMES)
+
+
+def aux_source_problems(fn=None) -> list:
+    """The same static half for the aux-token assembly ``V8FMini._aux_in`` (it may read only what ``_level`` / ``_lead`` return)."""
+    return _forbidden_in(V8FMini._aux_in if fn is None else fn, LEAD_FORBIDDEN_NAMES)
+
+
+def _vision_only_run(model: V8FMini, batch: dict, call, allowed, what: str) -> dict:
+    """Shared body of the two runtime guards: ``call(b, adapt, last)`` -> a tensor. It must read only ``allowed`` batch keys, be bit-identical when every non-vision key changes, and move when ``feats`` does."""
+    was = model.training
+    model.eval()
+    try:
+        with torch.no_grad():
+            Fn = batch["feats"].shape[1]
+            last = torch.full((batch["feats"].shape[0],), Fn - 1, dtype=torch.long, device=batch["feats"].device)
+            g = _KeyGuard(batch)
+            adapt = model._encode(g)
+            g.read.clear()
+            v0 = call(g, adapt, last)
+            extra = g.read - allowed
+            if extra:
+                raise AssertionError(f"the {what} READS batch keys {sorted(extra)} (only {sorted(allowed)} are admissible)")
+            other = {}
+            for k, v in batch.items():
+                if k in ("feats", "frame_ok") or not torch.is_tensor(v):
+                    other[k] = v
+                elif v.is_floating_point():
+                    other[k] = torch.randn_like(v) * 3.0 + 1.0
+                elif v.dtype == torch.bool:
+                    other[k] = ~v
+                else:
+                    other[k] = v + 1
+            v1 = call(other, model._encode(other), last)
+            if not torch.equal(v0, v1):
+                raise AssertionError(f"the {what} moved by {float((v0 - v1).abs().max())} when only non-vision inputs changed: it reads a non-vision input")
+            moved = dict(batch)
+            moved["feats"] = batch["feats"] + torch.randn(batch["feats"].shape, generator=torch.Generator().manual_seed(3)).to(batch["feats"].dtype) * 0.5
+            v2 = call(moved, model._encode(moved), last)
+            if torch.equal(v0, v2):
+                raise AssertionError(f"the {what} did not move when the vision features changed: it does not read the frame")
+    finally:
+        model.train(was)
+    return {"keys_read": sorted(g.read), "vision_sensitivity": float((v0 - v2).abs().max())}
+
+
+def assert_lead_head_vision_only(model: V8FMini, batch: dict) -> dict:
+    """PREREG_LEVELHEAD_A2 admissibility (binding: labels may use ego, inference is vision-only): the lead head's outputs (logit, gap_hat, and the [B, 2] input O is handed) are a function of the VISION tokens alone. Raises
+    AssertionError unless (1) :func:`lead_head_source_problems` is empty; (2) running ``model._lead`` on a key-guarded batch READS only :data:`LEAD_ALLOWED_KEYS`; (3) its outputs are IDENTICAL (bit for bit) when every non-vision
+    batch key (ego history, nav, limit, actions, poses, base, kin3, ages, labels) is replaced by a different value, and DIFFERENT when ``feats`` is. Returns the record the launch gate carries."""
+    if model.lead_head is None:
+        raise AssertionError("assert_lead_head_vision_only: the model has no lead head")
+    src = lead_head_source_problems(type(model)._lead)                 # the code of the model's OWN class (a subclass that rewires the head is read, not the base)
+    if src:
+        raise AssertionError(f"the lead head's code names non-vision inputs: {src}")
+    def call(b, adapt, last):
+        lg, _, li = model._lead(b, adapt, last)
+        return torch.cat([lg[:, None], li], -1)
+
+    rec = _vision_only_run(model, batch, call, LEAD_ALLOWED_KEYS, "lead head")
+    return {**rec, "source_problems": src}
+
+
+def assert_aux_vision_only(model: V8FMini, batch: dict) -> dict:
+    """PREREG_LEVELHEAD_A2 admissibility for ``--aux-cond token``: the [B, 3] vector ``e_aux`` reads is a function of the VISION tokens alone (same three conditions as :func:`assert_lead_head_vision_only`)."""
+    if model.e_aux is None:
+        raise AssertionError("assert_aux_vision_only: the model has no aux token")
+    src = aux_source_problems(type(model)._aux_in)
+    if src:
+        raise AssertionError(f"the aux token's assembly names non-vision inputs: {src}")
+    rec = _vision_only_run(model, batch, lambda b, adapt, last: model._aux_in(b, adapt, last), LEAD_ALLOWED_KEYS | LEVEL_ALLOWED_KEYS, "aux token input")
+    return {**rec, "source_problems": src}
