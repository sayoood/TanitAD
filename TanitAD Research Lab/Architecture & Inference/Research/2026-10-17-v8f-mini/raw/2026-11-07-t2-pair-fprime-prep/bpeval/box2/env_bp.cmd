@echo off
rem env for the B-prime evals on box 2: box 2's env.cmd settings (safe mode: 4 threads, AVX2, below-normal, affinity FF) with the code tree, TEMP and bytecode on C: (D: is reserved for T2 stages)
set "HF_HOME=D:/tanitad/hf"
set "HF_HUB_OFFLINE=1"
set "TRANSFORMERS_OFFLINE=1"
set "PYTHONPATH=C:/lorapod_eval/code/stack;C:/lorapod_eval/code/taniteval"
set "PYTHONIOENCODING=utf-8"
set "PYTHONUTF8=1"
set "PYTHONDONTWRITEBYTECODE=1"
set "PY=D:\tanitad\venv\Scripts\python.exe"
set "OMP_NUM_THREADS=4"
set "MKL_NUM_THREADS=4"
set "OPENBLAS_NUM_THREADS=4"
set "NUMEXPR_NUM_THREADS=4"
set "ATEN_CPU_CAPABILITY=avx2"
set "ONEDNN_MAX_CPU_ISA=AVX2"
set "DNNL_MAX_CPU_ISA=AVX2"
set "MKL_ENABLE_INSTRUCTIONS=AVX2"
set "NPY_DISABLE_CPU_FEATURES=AVX512F AVX512CD AVX512_SKX AVX512_CLX AVX512_CNL AVX512_ICL"
set "TEMP=C:\lorapod_eval\tmp"
set "TMP=C:\lorapod_eval\tmp"
set "RUNSAFE=start "" /b /wait /belownormal /affinity FF"
