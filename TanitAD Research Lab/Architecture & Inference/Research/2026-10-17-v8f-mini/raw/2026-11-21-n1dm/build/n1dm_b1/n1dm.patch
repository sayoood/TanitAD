+def set_branches(m, scale=0.05, seed=13):
+    with torch.no_grad():
+        for k, br in enumerate(m.route_br):
+            br.weight.copy_(torch.randn(br.weight.shape, generator=torch.Generator().manual_seed(seed + k)) * scale)
