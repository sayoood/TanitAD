+def o_inputs(m, b):
+    adapt = m._encode(b)
+    B = b["feats"].shape[0]
+    last = torch.full((B,), b["feats"].shape[1] - 1, dtype=torch.long)
+    ck = m.ck_nom[None].expand(B, -1, -1)
+    return (b, adapt, last, ck, torch.ones(B, 3), torch.rand(B, M.CODE_DIM, generator=torch.Generator().manual_seed(1)))
