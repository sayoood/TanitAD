#!/bin/bash
# rk_env.sh -- sourced by the RK pod scripts (rh_rk_chain.sh, rk_arm.sh, chk_arm_rk.sh, rk_gsuite.sh, rk_tree_prep.sh) IN PLACE OF rh_env.sh. KINLAB, card PREREG_V8F_KINLAB (frozen, sha256 7db5d7aa).
# It sources rh_env.sh unchanged, then moves exactly the code of record: RK runs at the KINLAB commit 0ca6f49d (= df250a00 + the `--dagger-label kin_v1` labeller: 3 modified and 3 added blobs) in its OWN tree (tree_rk),
# so RA (tree_ra), RL (tree_cf27) and RH / B0 / RHp3 / RHK (tree_cdb) keep theirs as they are. Everything else (R, PY, DS, S1, the readout functions) is rh_env.sh's.
# COMMIT is the 40-hex KINLAB commit; every script that sources this file refuses unless it is 40 lowercase hex.
_RKHERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. $_RKHERE/rh_env.sh
TREE=$R/tree_rk
COMMIT=0ca6f49dd076c035c1cd42da5e4e89a6f6961b9a
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || { echo "rk_env.sh: COMMIT is '$COMMIT', not a filled 40-hex commit"; exit 1; }
BLOBS=$_RKHERE/all_blobs_rk.txt            # the kit folder (= /root/rollhist when shipped)
GSUITE_RK=$R/gsuite_result_rk.json
