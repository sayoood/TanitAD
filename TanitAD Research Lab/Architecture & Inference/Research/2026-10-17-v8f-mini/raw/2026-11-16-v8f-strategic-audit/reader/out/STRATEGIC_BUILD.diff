+def _k_world(side_name="TURN_L", d=30.0, flag=0, theta0=False):
+    """40 windows over 8 episodes; the logged path turns left for 6 s after a straight first step, so HOLD (a0 repeated: straight) never turns and the logged path always does."""
+    from test_strategic_cells import synthetic_table
+    n, eps = 40, 8
+    eid = np.array([f"e{i % eps}" for i in range(n)])
+    now = np.array([(i // eps) * 4 for i in range(n)])
+    A = np.zeros((n, 31, 2))
+    A[:, 1:, 1] = 0.3
+    ws = types.SimpleNamespace(eid=eid, now=now, n=n, A=A, v0=np.full(n, 10.0))
+    tab = synthetic_table(eid, side_name, d, flag)
+    if theta0:
+        tab["theta"] = np.zeros_like(tab["theta"])
+    ws.nav_table = tab
+    turn = np.zeros((n, 30, 2)); turn[:, :, 1] = 0.3
+    plans = {"hold": H.hold_plan(A[:, 0], 30), "hwm_oracle": turn}
+    return ws, plans
+
+
+def test_k_strategic_cells_through_metrics_of_hold_zero_and_oracle_turn():
+    ws, plans = _k_world()
+    M = E.metrics_of(plans, ws)
+    f = lambda arm, m, b="full6s": M[arm][b][m]
+    assert np.all(f("hold", "s_adh") == 0.0) and np.all(f("hold", "s_adh_deg") == 0.0)              # HOLD reads exactly 0.0, finite on every window
+    assert np.all(f("hwm_oracle", "s_adh") == 1.0) and np.all(f("hwm_oracle", "s_adh_deg") > 25)
+    assert np.all(f("hold", "_s_adh_l") == 1.0)                                                   # the logged path is the ceiling of the cell
+    assert np.all(np.isnan(f("hold", "s_adh", "0-2s"))) and np.all(np.isnan(f("hwm_oracle", "s_false", "2-6s")))   # the other bands are empty by construction
+    assert ws.text["text_ok"].all() and ws.text["side"][0] == 1
+
