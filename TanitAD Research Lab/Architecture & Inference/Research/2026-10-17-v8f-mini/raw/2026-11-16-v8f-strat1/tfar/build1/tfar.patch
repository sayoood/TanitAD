+#!/usr/bin/env python
+"""tfar_reach.py -- K-REACH-e of PREREG_V8F_TFAR: the POST-TRAINING reachability gate for the TFAR parameters.
+
+Study wrapper over ``ckpt120_reach`` (itself a wrapper over ``zerograd_gate.analyze``; neither file is touched). The Adam-state method: a parameter with NO optimizer state never received a gradient; one whose state is exactly zero only ever
+received exact-zero gradients. This wrapper SCOPES the verdict to the parameters PREREG_V8F_TFAR names: CKPT120's ``s_far_out.*`` (always), ``e_ck_far.*`` (``--t-far on``; with ``--t-far-input zero`` the BIAS only: the weight receives exactly 0.0 by
+construction and is declared dead), ``e_nav_s_t.*`` (``--nav-strat-t on``), and ``e_nav_s.*`` (``--expect-nav-s on``). Each must be uniquely named, TRAINED, and absent iff its lever is off.
+
+NAMING. The v8f trainer writes ``param_names`` (the optimiser's parameter names in registration order) into the checkpoint of a TFAR-lever arm, so every id is named EXACTLY (the shape alignment is ambiguous for the [d] biases). A checkpoint without it falls
+back to the shape alignment, and an ambiguous key is INCONCLUSIVE, never PASS.
+
+VERDICTS (a missing or unreadable result is never a PASS)
+  PASS          every expected key is uniquely named, TRAINED, and every control reads as required
+  HEAD-DEAD     an expected key has no optimizer state (case a) or only exact-zero state (case b): build defect, nothing is read   (exit 1)
+  INCONCLUSIVE  an expected key cannot be uniquely named, the checkpoint has no optimizer state, or a control could not be evaluated   (exit 2)
+
+CONTROLS (the same breath, in the JSON)
+  positive   >= 1 uniquely named TRAINED parameter matches ``--control`` (default ``head_s\\..*``): excludes a probe that reads nothing.
+  negative   for EVERY new layer weight the optimizer-state entry of the id named that key is deleted IN MEMORY and the gate re-run; each MUST read HEAD-DEAD (a planted dead layer): a gate that cannot see it is no evidence about the real one.
+
+usage: python tfar_reach.py --ckpt CKPT --out reach.json [--t-far on|off] [--t-far-input pred|zero] [--nav-strat-t on|off] [--expect-nav-s on|off] [--control REGEX]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+import ckpt120_reach as R  # noqa: E402
+import zerograd_gate as Z  # noqa: E402
+
+SCHEMA = "tfar-reach-gate-v1"
+PREFIXES = {"far": "s_far_out.", "nav_s": "e_nav_s.", "t_far": "e_ck_far.", "nav_s_t": "e_nav_s_t."}
+DEFAULT_CONTROL = R.DEFAULT_CONTROL
+EXIT = R.EXIT
+
+
+def expected_keys(sd, t_far=False, t_far_input="pred", nav_s_t=False, expect_nav_s=True):
+    """({"far": [...], "nav_s": [...]}, problems) in the interface ``ckpt120_reach.analyze`` reads: ``far`` = CKPT120's far head + the TFAR far layer, ``nav_s`` = e_nav_s + e_nav_s_t. Presence is checked both ways."""
+    bad = []
+    s_far = sorted(k for k in sd if k.startswith(PREFIXES["far"]))
+    e_far = sorted(k for k in sd if k.startswith(PREFIXES["t_far"]))
+    e_nav = sorted(k for k in sd if k.startswith(PREFIXES["nav_s"]))
+    e_nav_t = sorted(k for k in sd if k.startswith(PREFIXES["nav_s_t"]))
+    if not s_far:
+        bad.append("no s_far_out.* key in the checkpoint's model state dict")
+    if t_far and set(e_far) != {"e_ck_far.weight", "e_ck_far.bias"}:
+        bad.append(f"--t-far on but the checkpoint's e_ck_far keys are {e_far}")
+    if not t_far and e_far:
+        bad.append("--t-far off but the checkpoint carries e_ck_far.* keys")
+    if nav_s_t and set(e_nav_t) != {"e_nav_s_t.weight", "e_nav_s_t.bias"}:
+        bad.append(f"--nav-strat-t on but the checkpoint's e_nav_s_t keys are {e_nav_t}")
+    if not nav_s_t and e_nav_t:
+        bad.append("--nav-strat-t off but the checkpoint carries e_nav_s_t.* keys")
+    if expect_nav_s and not e_nav:
+        bad.append("--expect-nav-s on but the checkpoint has no e_nav_s.* key")
+    if not expect_nav_s and e_nav:
+        bad.append("--expect-nav-s off but the checkpoint carries e_nav_s.* keys")
+    if t_far and t_far_input == "zero":
+        e_far = [k for k in e_far if k.endswith(".bias")]             # TZ: the weight receives EXACTLY 0.0 by construction (declared dead); the bias must train
+    return {"far": s_far + (e_far if t_far else []), "nav_s": e_nav + (e_nav_t if nav_s_t else [])}, bad
+
+
+def analyze(ck, t_far=False, t_far_input="pred", nav_s_t=False, expect_nav_s=True, control=DEFAULT_CONTROL, _mutate=None):
+    """The scoped verdict of one loaded checkpoint dict (``ckpt120_reach.analyze`` with TFAR's expected keys and the checkpoint's own ``param_names``)."""
+    real = R.expected_keys
+    R.expected_keys = lambda sd, e: expected_keys(sd, t_far, t_far_input, nav_s_t, e)
+    try:
+        return R.analyze(ck, expect_nav_s, control, ck.get("param_names"), _mutate=_mutate)
+    finally:
+        R.expected_keys = real
+
+
+def gate(ck, t_far=False, t_far_input="pred", nav_s_t=False, expect_nav_s=True, control=DEFAULT_CONTROL):
+    """The full gate: the scoped verdict + the positive control + a negative control per new layer weight (a planted dead layer must read HEAD-DEAD). ``verdict`` is the exit class."""
+    rep = analyze(ck, t_far, t_far_input, nav_s_t, expect_nav_s, control)
+    ts = rep.pop("_trained_set", [])
+    c = {"positive": {"pattern": control, "trained_matches": sum(1 for n in ts if re.fullmatch(control, n))}}
+    c["positive"]["ok"] = c["positive"]["trained_matches"] > 0
+    rep["schema"] = SCHEMA
+    if rep["verdict"] != "PASS":
+        rep["controls"] = c
+        return rep
+    targets = ["s_far_out.weight"] + ([("e_ck_far.bias" if t_far_input == "zero" else "e_ck_far.weight")] if t_far else []) + (["e_nav_s_t.weight"] if nav_s_t else [])
+    c["negative"] = {}
+    for tg in targets:
+        neg = analyze(ck, t_far, t_far_input, nav_s_t, expect_nav_s, control, _mutate=tg)
+        neg.pop("_trained_set", None)
+        c["negative"][tg] = {"verdict": neg["verdict"], "ok": neg["verdict"] == "HEAD-DEAD"}
+    rep["controls"] = c
+    if not (c["positive"]["ok"] and all(v["ok"] for v in c["negative"].values())):
+        rep["verdict"] = "INCONCLUSIVE"
+        rep["reasons"].append(f"a control did not read as required: {c}")
+    return rep
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="K-REACH-e: every TFAR parameter must have trained (see module docstring).")
+    ap.add_argument("--ckpt", required=True)
+    ap.add_argument("--out", required=True, help="the verdict JSON, written atomically; its absence is the evidence that the gate did not run")
+    ap.add_argument("--t-far", choices=("on", "off"), default="off")
+    ap.add_argument("--t-far-input", choices=("pred", "zero"), default="pred")
+    ap.add_argument("--nav-strat-t", choices=("on", "off"), default="off")
+    ap.add_argument("--expect-nav-s", choices=("on", "off"), default="on")
+    ap.add_argument("--control", default=DEFAULT_CONTROL)
+    a = ap.parse_args(argv)
+    try:
+        ck, how = Z.load_ckpt(a.ckpt)
+        rep = gate(ck, a.t_far == "on", a.t_far_input, a.nav_strat_t == "on", a.expect_nav_s == "on", a.control)
+        rep["ckpt"], rep["load"] = a.ckpt.replace("\\", "/"), how
+        rep["named_by"] = "param_names (exact)" if ck.get("param_names") is not None else "shape alignment"
+    except Exception as e:                                              # noqa: BLE001
+        rep = {"schema": SCHEMA, "verdict": "INCONCLUSIVE", "reasons": [f"{type(e).__name__}: {e}"]}
+    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
+    tmp = a.out + ".part"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(rep, f, indent=1, ensure_ascii=True)
+    os.replace(tmp, a.out)
+    print(f"K-REACH-e (TFAR) {rep['verdict']}: " + "; ".join(rep.get("reasons", [])))
+    return EXIT[rep["verdict"]]
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/b/stack/scripts/v8f_mini_eval_tfar.py b/b/stack/scripts/v8f_mini_eval_tfar.py
new file mode 100644
index 0000000..fc28828
--- /dev/null
+++ b/b/stack/scripts/v8f_mini_eval_tfar.py
@@ -0,0 +1,175 @@
+#!/usr/bin/env python3
+"""v8f_mini_eval_tfar.py -- PREREG_V8F_TFAR: the T0 evaluator with the four FAR-TOKEN VARIANTS of T (card section 6: real / donor / zero / ORACLE).
+
+Layers over ``v8f_mini_eval_far.py`` (itself a wrapper of the pinned ``v8f_mini_eval.py``; BOTH files are untouched and BOTH pins are checked here before anything runs). Every patch is undone in ``finally``. Added, in ONE call:
+
+  1. ``run --t-far off|on`` and ``--nav-strat-t off|on`` (default off), each REFUSED when it disagrees with the checkpoint's cfg (``t_far`` / ``nav_strat_t``): a flag that names a layer the checkpoint lacks, or a cfg that carries a layer the flag drops, would silently
+     skip (or invent) the variant.
+  2. ``--far-token real|donor|zero|oracle`` (default real; T0 DIAGNOSTICS, never a driving-performance claim), set through the MODEL attribute ``set_t_far_eval`` (never a batch key: K-KEYS):
+       real    S's own far point (nothing is overridden: the run is the tool's, plus the dump below).
+       donor   S's far point taken from the DONOR window (``donor_indices`` seed 0 over the run's window list, the CKPT120 donor map), read from ``--far-token-donor-npz`` = the real run's ``eval_<tag>_far.npz`` (its ``ckpt_far`` rows, S's tick frame).
+               This swaps T's far token ONLY: S's nav and S's own outputs are untouched. REFUSED unless that dump's window list is this run's.
+       zero    T's four far features are 0.0 (ok 0).
+       oracle  RC-A120 (the eval split of ``--rc120-npz`` / ``--rc120-sha256``, read as a LABEL by this evaluator only) where ``rc120_ok & has``, else S's own point; the windows where it was substituted are flagged (``oracle_valid``).
+  3. ``eval_<tag>_tfar.npz`` beside the tool's dumps: the window index arrays, the variant record, T's lat / lon / goal logits of the SAME forward that produced the plan, the far token T was handed (``t_far_in`` [N, 3] / ``t_far_ok`` [N], in T's tick frame)
+     and, for donor / oracle, ``donor_index`` / ``oracle_valid``.
+With neither layer built nothing is patched: the run is the tool's (and v8f_mini_eval_far's), bit for bit.
+Scope refusals (one forward per window is what makes the capture exact): those of ``v8f_mini_eval_far`` (``--tac`` other than pred, ``--plan beta``).
+
+usage:  python v8f_mini_eval_tfar.py run --ckpt CK ... --far-out on --nav-strat on --nav-strat-npz T --nav-strat-sha256 S --t-far on --far-token zero      (any other argv: the tool's / v8f_mini_eval_far's)
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+import v8f_mini_eval as E  # noqa: E402
+import v8f_mini_eval_far as W0  # noqa: E402
+from tanitad.data import v8f_mini_data as D  # noqa: E402
+from tanitad.models import v8f_mini as M  # noqa: E402
+
+FAR_TOKENS = ("real", "donor", "zero", "oracle")
+
+
+def own_parser():
+    p = argparse.ArgumentParser(add_help=False, allow_abbrev=False)      # no abbreviations: `--nav-strat` (the far wrapper's flag) must never be read as `--nav-strat-t`
+    p.add_argument("--t-far", choices=("off", "on"), default="off")
+    p.add_argument("--nav-strat-t", choices=("off", "on"), default="off")
+    p.add_argument("--far-token", choices=FAR_TOKENS, default="real")
+    p.add_argument("--far-token-donor-npz", default="")
+    p.add_argument("--rc120-npz", default="")
+    p.add_argument("--rc120-sha256", default="")
+    return p
+
+
+def refusals(own, cfg):
+    """The problems of a (flags, checkpoint cfg) pair. [] = admissible."""
+    bad = []
+    if own.t_far != cfg.t_far:
+        bad.append(f"--t-far {own.t_far} but the checkpoint's cfg has t_far={cfg.t_far!r}: the evaluator would silently skip (or invent) the far token")
+    if own.nav_strat_t != cfg.nav_strat_t:
+        bad.append(f"--nav-strat-t {own.nav_strat_t} but the checkpoint's cfg has nav_strat_t={cfg.nav_strat_t!r}: the evaluator would silently skip (or invent) T's route-text token")
+    if own.far_token != "real" and own.t_far != "on":
+        bad.append(f"--far-token {own.far_token} needs --t-far on: there is no far token to vary")
+    if own.far_token == "donor" and not own.far_token_donor_npz:
+        bad.append("--far-token donor needs --far-token-donor-npz (the real run's eval_<tag>_far.npz)")
+    if own.far_token != "donor" and own.far_token_donor_npz:
+        bad.append("--far-token-donor-npz is read only with --far-token donor")
+    if own.far_token == "oracle" and not (own.rc120_npz and own.rc120_sha256):
+        bad.append("--far-token oracle needs --rc120-npz and --rc120-sha256 (the RC-A120 table, eval split)")
+    if own.far_token != "oracle" and (own.rc120_npz or own.rc120_sha256):
+        bad.append("--rc120-npz / --rc120-sha256 are read only with --far-token oracle")
+    return bad
+
+
+def make_cmd_run(tool_cmd_run, own):
+    def cmd_run(a):
+        import torch
+        ck = torch.load(a.ckpt, map_location="cpu", weights_only=False)
+        cfg = M.V8FMiniConfig(**ck["cfg"])
+        bad = refusals(own, cfg)
+        if bad:
+            raise SystemExit("REFUSED: " + "; ".join(bad))
+        if own.t_far == "off" and own.nav_strat_t == "off":
+            return tool_cmd_run(a)
+        st = {"windows": None, "off": 0, "far_fed": [], "ok_fed": [], "valid": [], "didx": [], "lat": [], "lon": [], "goal": []}
+        cur = {"load_join": D.load_join, "init": D.V8FMiniWindows.__init__, "fi": M.V8FMini.forward_infer, "rt": M.V8FMini.run_t}
+        donor = None
+        if own.far_token == "donor":
+            donor = np.load(own.far_token_donor_npz)
+            if "ckpt_far" not in donor.files:
+                raise SystemExit("REFUSED: --far-token-donor-npz has no ckpt_far (it must be the real run's eval_<tag>_far.npz, made with --far-out on)")
+
+        def load_join(path):
+            J = cur["load_join"](path)
+            if own.far_token == "oracle" and "rc120" not in J:
+                J["rc120"], J["rc120_ok"], st["rc120_rec"] = D.rc120_arrays(J, own.rc120_npz, own.rc120_sha256, "eval", "off")
+            return J
+
+        def init(self, *args, **kw):
+            cur["init"](self, *args, **kw)
+            st["windows"] = self.windows
+            if donor is not None:
+                w = np.asarray([[x[0], x[1]] for x in self.windows])
+                if len(w) != len(donor["win_ci"]) or not (w[:, 0] == donor["win_ci"]).all() or not (w[:, 1] == donor["win_t"]).all():
+                    raise SystemExit("REFUSED: the donor dump's window list is not this run's (the donor far points would belong to other windows)")
+                from tanitad.models.hjepa import donor_indices
+                st["perm"] = donor_indices(len(w), episode_ids=torch.as_tensor(w[:, 0]), seed=0).numpy()
+
+        def run_t(self, *aa, **kk):
+            if "far" in kk:
+                st["far_fed"].append(kk["far"].detach().float().cpu().numpy())
+                st["ok_fed"].append(kk["far_ok"].detach().float().cpu().numpy())
+            return cur["rt"](self, *aa, **kk)
+
+        def forward_infer(self, batch):
+            n = int(batch["pose_s"].shape[0])
+            i0 = st["off"]
+            st["off"] += n
+            dev = batch["pose_s"].device
+            try:
+                if own.t_far == "on" and own.far_token == "zero":
+                    self.set_t_far_eval("zero")
+                elif own.t_far == "on" and own.far_token == "donor":
+                    idx = st["perm"][i0:i0 + n]
+                    self.set_t_far_eval("set", torch.as_tensor(donor["ckpt_far"][idx], dtype=torch.float32, device=dev), torch.ones(n, device=dev))
+                    st["didx"].append(idx)
+                elif own.t_far == "on" and own.far_token == "oracle":
+                    ls = batch["lab_s"]
+                    valid = (ls["rc120_ok"] & ls["has"]).bool()
+                    self.set_t_far_eval("oracle", ls["rc120"].float(), valid)
+                    st["valid"].append(valid.cpu().numpy())
+                out = cur["fi"](self, batch)
+            finally:
+                if own.t_far == "on":
+                    self.clear_t_far_eval()
+            st["lat"].append(out["lat_logits"].float().cpu().numpy())
+            st["lon"].append(out["lon_logits"].float().cpu().numpy())
+            st["goal"].append(out["goal_prob"].float().cpu().numpy())
+            return out
+        D.load_join, D.V8FMiniWindows.__init__, M.V8FMini.forward_infer, M.V8FMini.run_t = load_join, init, forward_infer, run_t
+        try:
+            rc = tool_cmd_run(a)
+        finally:
+            D.load_join, D.V8FMiniWindows.__init__, M.V8FMini.forward_infer, M.V8FMini.run_t = cur["load_join"], cur["init"], cur["fi"], cur["rt"]
+        w = st["windows"]
+        out = {"win_ci": np.asarray([x[0] for x in w], np.int64), "win_t": np.asarray([x[1] for x in w], np.int64), "t_far": np.asarray(own.t_far), "nav_strat_t": np.asarray(own.nav_strat_t),
+               "far_token": np.asarray(own.far_token), "lat_logits": np.concatenate(st["lat"]), "lon_logits": np.concatenate(st["lon"]), "goal_prob": np.concatenate(st["goal"])}
+        if own.t_far == "on":
+            out["t_far_in"], out["t_far_ok"] = np.concatenate(st["far_fed"]), np.concatenate(st["ok_fed"])
+        if st["didx"]:
+            out["donor_index"] = np.concatenate(st["didx"]).astype(np.int64)
+            out["donor_npz_far"] = np.asarray(os.path.basename(own.far_token_donor_npz))
+        if st["valid"]:
+            out["oracle_valid"] = np.concatenate(st["valid"])
+            out["rc120_sha256"] = np.asarray(own.rc120_sha256)
+        if len(out["lat_logits"]) != len(w):
+            raise SystemExit(f"REFUSED: {len(out['lat_logits'])} logit rows for {len(w)} windows: the capture is not one forward per window")
+        os.makedirs(a.out_dir, exist_ok=True)
+        np.savez_compressed(os.path.join(a.out_dir, f"eval_{a.tag}_tfar.npz"), **out)
+        return rc
+    return cmd_run
+
+
+def main(argv=None):
+    got = W0.tool_sha256()
+    if got != W0.TOOL_SHA256:
+        raise SystemExit(f"REFUSED: the T0 tool {E.__file__} has sha256 {got}, the pin is {W0.TOOL_SHA256}: this wrapper (through v8f_mini_eval_far) patches the loader and forward_infer of THAT tool's run")
+    own, rest = own_parser().parse_known_args(argv)
+    cr = E.cmd_run
+    E.cmd_run = make_cmd_run(cr, own)                       # inner: v8f_mini_eval_far's wrapper (below) patches first, this one runs inside it
+    try:
+        return W0.main(rest)
+    finally:
+        E.cmd_run = cr
+
+
+if __name__ == "__main__":
+    sys.exit(main())
