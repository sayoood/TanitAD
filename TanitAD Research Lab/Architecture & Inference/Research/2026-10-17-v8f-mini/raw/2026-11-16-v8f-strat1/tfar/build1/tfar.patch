+def test_layers_on_at_step_0_are_bit_identical_to_h2_and_draw_the_same_rng(world):
+    """K-REACH-a2 + K-RNG: zero init, ADDED token, no extra draw."""
+    tip = tip_module()
+    b, J = make_batch(world)
+    mt = build(J, mod=tip, **H2)
+    for kw in ({"t_far": "on"}, {"nav_strat_t": "on"}, {"t_far": "on", "nav_strat_t": "on"}, {"t_far": "on", "t_far_input": "zero"}, {"t_far": "on", "t_far_variant": "roll"}, {"t_far": "on", "t_far_tf": "off"}):
