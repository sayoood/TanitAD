+# ------------------------------------------------------------------------------------------------ K-REACH-a: off = aedf8716, bit for bit
+def test_defaults_off_is_the_tip_bit_for_bit_with_the_h2_levers_on(world):
+    tip = tip_module()
+    b, J = make_batch(world)
+    mt, mn = build(J, mod=tip, **H2), build(J, mod=M, **H2)
+    sdt, sdn = mt.state_dict(), mn.state_dict()
+    assert list(sdt) == list(sdn) and all(torch.equal(sdt[k], sdn[k]) for k in sdt)
+    ot, on = run_loss(mt, b), run_loss(mn, b)
+    assert set(ot["terms"]) == set(on["terms"])
+    for k in ot["terms"]:
