+    elif mut == "tree":
+        open(os.path.join(rig["root"], "stack", "tanitad", "m.py"), "ab").write(b"z = 3\n")
+    elif mut == "checker_schema":
+        tok = json.load(open(tp, encoding="utf-8"))
+        tok["schema"] = "ckpt120-gate-token-v1"
+        json.dump(tok, open(tp, "w", encoding="utf-8"))
+    assert T.run_arm(r["tag"], kind, r["a"]) == 2
+    assert not os.path.exists(os.path.join(r["out"], "ran_argv.json"))
+
+
+def test_a_ckpt120_token_is_not_a_tfar_token(rig):
