+    "far weight grad 0 (the layer is unreachable)": _set(P + ["far_weight_grad"], 0.0), "input-zero weight control reads 1e-9": _set(P + ["control_far_weight_grad_input_zero"], 1e-9),
+    "input-zero weight control key deleted": _del(P + ["control_far_weight_grad_input_zero"]), "bias dead under input zero": _set(P + ["control_far_bias_grad_input_zero"], 0.0),
