+def good_selfcheck(kind, toks):
+    """A selfcheck.json that satisfies every read of the gate for this arm kind (the shape the trainer writes)."""
+    spec = T.SPEC[kind]
+    sc = c120_good("H2", toks)
+    lv, live = sc["levers"], sc["live"]
+    live["declared_dead"] = []
+    if spec[5] == "on":
+        lv["s_adapter_detach"] = "on"
+    if spec[0] is None:
+        return sc
+    probe = {"zero_init": True, "step0_identical": True, "rng_state_identical": True, "t_iso_up_s_grad": 0.0, "t_iso_up_positive_control": 3.1, "pass": True}
+    if spec[0] == "on":
+        lv.update(t_far="on", t_far_input=spec[1], t_far_variant=spec[2], t_far_tf=spec[3], t_far_zero_init=True, t_far_in=4)
+        probe.update(far_weight_grad=1.2, control_far_weight_grad_input_zero=0.0, control_far_bias_grad_input_zero=0.8, t_reads_far=True, t_iso_o_ck_token_identical=True, clock_max_abs_err=3e-8, clock_nontrivial=21.0, keys_read_labels=[])
+        if spec[1] == "zero":
+            live["declared_dead"] = ["e_ck_far.weight"]
+    if spec[4] == "on":
+        lv["nav_strat_t"] = "on"
+        probe.update(nav_s_t_weight_grad=0.4, control_nav_s_t_weight_grad_nav_s_zero=0.0)
+    sc["tfar_probe"] = probe
+    return sc
