+        toks[toks.index("--steps") + 1] = "2999"
+        json.dump(toks, open(os.path.join(r["rd"], "argv.json"), "w", encoding="utf-8"))
+    elif mut == "tfar_flag":                                          # the argv of a TZ arm under TF's token
+        toks[toks.index("--t-far-input") + 1] = "zero"
+        json.dump(toks, open(os.path.join(r["rd"], "argv.json"), "w", encoding="utf-8"))
+    elif mut == "kind":
