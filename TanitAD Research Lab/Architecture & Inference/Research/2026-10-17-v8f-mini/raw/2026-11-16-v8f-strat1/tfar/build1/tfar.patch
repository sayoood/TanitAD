+    assert M.T_FAR_KEY_PREFIXES == ("e_ck_far.",) and M.NAV_S_T_KEY_PREFIXES == ("e_nav_s_t.",)
+    assert set(M.T_FAR_KEY_PREFIXES + M.NAV_S_T_KEY_PREFIXES) <= set(M.NEW_LEVER_KEY_PREFIXES)
+    assert M.CKPT_ARCS == (30.0, 50.0, 80.0) and M.FAR_ARC == 120.0 and "nav_s" not in M.INFERENCE_INPUT_KEYS
+
+
+def test_hygiene_refuses_bad_values():
