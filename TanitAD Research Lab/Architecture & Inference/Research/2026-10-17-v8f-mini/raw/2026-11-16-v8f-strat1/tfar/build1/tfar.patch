+def test_moved_identity_mutations_are_red():
+    init, fin = _sds("TF", weight=0.0)
+    assert T.moved_identity(init, fin, "TF"), "TF whose weight never left zero"
+    init, fin = _sds("TF", bias=0.0)
+    assert T.moved_identity(init, fin, "TF"), "TF whose bias never moved"
+    init, fin = _sds("TZ", weight=1.0)
+    assert T.moved_identity(init, fin, "TZ"), "TZ whose weight moved: it was given information"
+    init, fin = _sds("TF")
+    assert T.moved_identity(init, fin, "TN"), "a TF checkpoint in a TN arm (no e_nav_s_t, a stray e_ck_far)"
