+def test_end_to_end_tf_tz_r3_tn_tfnt_reach_the_loss_through_the_real_trainer(world):
+    root = Path(world["root"])
+    assert TR.main(_argv(world, "base", ["--steps", "3", *FAR(world)])) == 0
+    init = ["--init-ckpt", str(root / "base" / "ckpt_last.pt")]
+    arms = {"tf": TFAR(), "tz": TFAR(["--t-far-input", "zero"]), "r3": TFAR(["--t-far-variant", "roll"]), "tn": ["--nav-strat-t", "on", "--nav-strat-t-lr-mult", "10"], "tfnt": TFAR(["--t-far-tf", "off"])}
+    for tag, extra in arms.items():
+        assert TR.main(_argv(world, tag, ["--steps", "3", *init, *FAR(world), *extra])) == 0, tag
+        sc = _sc(root / tag)
+        assert sc["declared_vs_built"] == "PASS" and sc["tfar_probe"]["pass"] is True and sc["ckpt120_probe"]["pass"] is True, tag
+        p = sc["tfar_probe"]
+        if tag != "tn":
+            assert p["far_weight_grad"] > 0.0 and p["control_far_weight_grad_input_zero"] == 0.0 and p["control_far_bias_grad_input_zero"] > 0.0
+            assert p["t_iso_up_s_grad"] == 0.0 and p["step0_identical"] is True and p["rng_state_identical"] is True and p["t_reads_far"] is True and p["t_iso_o_ck_token_identical"] is True
+            assert p["clock_max_abs_err"] <= 1e-6 and p["keys_read_labels"] == []
+        else:
+            assert p["nav_s_t_weight_grad"] > 0.0 and p["control_nav_s_t_weight_grad_nav_s_zero"] == 0.0
+        ck = torch.load(root / tag / "ckpt_last.pt", weights_only=False)
+        import tfar_reach as TRR                                           # K-REACH-e on the REAL checkpoint: param_names written by the trainer, every TFAR key trained
+        assert len(ck["param_names"]) == sum(len(g_["params"]) for g_ in ck["opt"]["param_groups"])
+        rep = TRR.gate(ck, t_far=(tag != "tn"), t_far_input=("zero" if tag == "tz" else "pred"), nav_s_t=(tag == "tn"), expect_nav_s=True)
+        assert rep["verdict"] == "PASS" and all(v["ok"] for v in rep["controls"]["negative"].values()), (tag, rep["verdict"], rep["reasons"])
+        names = {g.get("name") for g in ck["opt"]["param_groups"]}
+        mult = {g_["name"]: g_["lr_mult"] for g_ in ck["opt"]["param_groups"] if g_.get("name")}
+        if tag == "tn":
+            assert {"navst", "navst_nd"} <= names and "tfar" not in names and all(abs(mult[k] - 10.0) < 1e-12 for k in ("navst", "navst_nd"))
+            assert float(ck["model"]["e_nav_s_t.weight"].abs().sum()) > 0.0 and ck["cfg"]["nav_strat_t"] == "on"
+            continue
+        assert {"tfar", "tfar_nd", "sfar", "sfar_nd"} <= names and "navst" not in names and all(abs(mult[k] - 10.0) < 1e-12 for k in ("tfar", "tfar_nd"))
+        assert set(k for k in ck["model"] if k.startswith(M.T_FAR_KEY_PREFIXES)) == {"e_ck_far.weight", "e_ck_far.bias"} and ck["cfg"]["t_far"] == "on"
+        assert ck["cfg"]["t_far_input"] == ("zero" if tag == "tz" else "pred") and ck["cfg"]["t_far_variant"] == ("roll" if tag == "r3" else "real") and ck["cfg"]["t_far_tf"] == ("off" if tag == "tfnt" else "same")
+        assert float(ck["model"]["e_ck_far.bias"].abs().sum()) > 0.0, "the bias trained in every arm"
+        if tag == "tz":
+            assert float(ck["model"]["e_ck_far.weight"].abs().sum()) == 0.0, "TZ: the weight received no information: it stays at its zero init"
+        else:
+            assert float(ck["model"]["e_ck_far.weight"].abs().sum()) > 0.0, "the weight MOVED from its zero init: it trained"
+    assert "tfar_probe" not in _sc(root / "base")
+
+
+def test_end_to_end_illegal_argvs_are_refused_by_the_gate(world):
+    for extra, needle in ((["--t-far", "on", "--detach-upper", "--s-far", "off"], "--s-far off"), (["--t-far", "on", "--s-far", "on", "--w-ckpt-far", "0.3333", "--rc120-npz", str(world["rc120"]), "--rc120-sha256", sha(world["rc120"])], "without --detach-upper")):
+        with pytest.raises(SystemExit) as e:
+            TR.main(_argv(world, "ill", ["--steps", "1", "--selfcheck-only", *extra]))
+        assert "ZZDVB-REFUSEDZZ" in str(e.value) and needle in str(e.value), extra
+
+
+def test_mutation_deleting_the_make_config_line_turns_the_gate_red(world):
+    mod = mutant_trainer("                           t_far=a.t_far, t_far_input=a.t_far_input, t_far_variant=a.t_far_variant, t_far_tf=a.t_far_tf, nav_strat_t=a.nav_strat_t,", "                           ", "tmc")
+    with pytest.raises(SystemExit) as e:
+        mod.main(_argv(world, "mut_tmc", ["--steps", "1", "--selfcheck-only", *FAR(world), *TFAR()]))
+    assert "ZZDVB-REFUSEDZZ" in str(e.value)
+
+
+def test_mutation_putting_the_far_layer_in_decay_too_turns_the_optimiser_check_red(world):
+    mod = mutant_trainer("    decay, nodecay = [p for p in decay if id(p) not in tfar_ids | navst_ids], [p for p in nodecay if id(p) not in tfar_ids | navst_ids]", "    pass", "tfo")
+    with pytest.raises((SystemExit, ValueError, Exception)):
+        mod.main(_argv(world, "mut_tfo", ["--steps", "1", "--selfcheck-only", *FAR(world), *TFAR()]))
