+++ b/b/stack/tests/test_tfar_eval.py
@@ -0,0 +1,186 @@
+"""PREREG_V8F_TFAR (card section 6), end to end on the synthetic world (CPU): the TFAR evaluator wrappers run the REAL shared tools (through the CKPT120 far wrappers) and
+
+  * T0 ``v8f_mini_eval_tfar``: the four FAR-TOKEN variants real / donor / zero / ORACLE through the MODEL attribute (never a batch key), T's logits of the same forward, the token T was handed, the donor map and the oracle flags,
+  * T1 ``v8f_t1_eval_tfar``: ``t_far_in`` per tick = the far point T read, equal to S's raw far point re-expressed with ``transform_ckpt``,
+  * both refuse a flag that disagrees with the checkpoint's cfg, and leave every output of the layer-off run bit-identical.
+"""
+from __future__ import annotations
+
+import dataclasses
+import hashlib
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+HERE = os.path.dirname(os.path.abspath(__file__))
+for p in (os.path.join(HERE, "..", "scripts"), os.path.join(HERE, ".."), os.path.join(HERE, "..", "..", "taniteval"), HERE):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+import test_v8f_t1 as T1T  # noqa: E402
+from test_v8f_t1 import world  # noqa: E402,F401  (the synthetic-world fixture of the T1 suite)
+from test_ckpt120_eval_e2e import _nav_s_table, _sha_f, _t0_args, _t1_args  # noqa: E402
+import v8f_mini_eval as E  # noqa: E402
+import v8f_mini_eval_far as W0  # noqa: E402
+import v8f_mini_eval_tfar as X0  # noqa: E402
+import v8f_t1_eval_far as W1  # noqa: E402
+import v8f_t1_eval_tfar as X1  # noqa: E402
+from tanitad.models import v8f_mini as M  # noqa: E402
+
+
+def _tfar_ckpt(world, path, t_far=True, nav_s_t=False):
+    tracks, J, store, wins = T1T.setup(world)
+    mu, sd = M.cons_stats(J)
+    torch.manual_seed(0)
+    prior = M.P10Prior.synthetic(0)
+    with torch.no_grad():
+        for q in prior.parameters():
+            q.mul_(0.02)
+    cfg = M.V8FMiniConfig(**T1T.TINY, s_far="on", w_ckpt_far=0.3333, nav_strat="on", detach_upper=True, **({"t_far": "on"} if t_far else {}), **({"nav_strat_t": "on"} if nav_s_t else {}))
+    model = M.V8FMini(cfg, prior, mu, sd).eval()
+    with torch.no_grad():
+        torch.nn.init.normal_(model.head_o[2].weight, std=0.02)
+        torch.nn.init.normal_(model.s_far_out.weight, std=0.05)
+        if t_far:
+            torch.nn.init.normal_(model.e_ck_far.weight, std=0.3)
+        if nav_s_t:
+            torch.nn.init.normal_(model.e_nav_s_t.weight, std=0.3)
+    torch.save({"cfg": dataclasses.asdict(cfg), "model": model.state_dict(), "grid": "pool4x10"}, path)
+    return J
+
+
+def _rc120_eval_table(root, J):
+    N = int(J["off"][-1] + J["n"][-1])
+    rng = np.random.default_rng(3)
+    rc = np.stack([J["rc"][:, 2, 0] * 1.5 + 1.0, J["rc"][:, 2, 1] * 1.5 + rng.normal(0, 0.1, N), J["rc"][:, 2, 2] * 1.2], -1).astype(np.float32)
+    ok = np.asarray(J["rc_ok"][:, 2]).copy()
+    p = str(Path(root) / "rc120_eval.npz")
+    np.savez(p, eval_clip=np.asarray(J["clip"]).astype(str), eval_off=np.asarray(J["off"]), eval_n=np.asarray(J["n"]), eval_rc120=rc, eval_rc120_ok=ok)
+    return p
+
+
+def _far_flags(tbl):
+    return ["--far-out", "on", "--nav-strat", "on", "--nav-strat-npz", tbl, "--nav-strat-sha256", _sha_f(tbl)]
+
+
+def test_t0_tfar_wrapper_variants_real_zero_donor_oracle(world, tmp_path):
+    ck = str(tmp_path / "ck.pt")
+    J = _tfar_ckpt(world, ck)
+    tbl, _ = _nav_s_table(tmp_path, J)
+    rc = _rc120_eval_table(tmp_path, J)
+    args = _t0_args(world, ck) + _far_flags(tbl)
+    assert X0.main(args + ["--tag", "r", "--out-dir", str(tmp_path / "r"), "--t-far", "on"]) == 0
+    r, far = np.load(tmp_path / "r" / "eval_r_tfar.npz"), np.load(tmp_path / "r" / "eval_r_far.npz")
+    N = len(r["win_ci"])
+    assert str(r["far_token"]) == "real" and r["t_far_in"].shape == (N, 3) and (r["t_far_ok"] == 1).all() and r["lon_logits"].shape[0] == N and np.isfinite(r["t_far_in"]).all()
+    assert (r["win_ci"] == far["win_ci"]).all()
+    # zero: the four features are 0.0, and T's logits move (the layer is non-zero)
+    assert X0.main(args + ["--tag", "z", "--out-dir", str(tmp_path / "z"), "--t-far", "on", "--far-token", "zero"]) == 0
+    z = np.load(tmp_path / "z" / "eval_z_tfar.npz")
+    assert (z["t_far_in"] == 0).all() and (z["t_far_ok"] == 0).all() and not np.array_equal(z["lon_logits"], r["lon_logits"])
+    # S's own outputs are untouched by the variant
+    np.testing.assert_array_equal(np.load(tmp_path / "z" / "eval_z_far.npz")["ckpt_far"], far["ckpt_far"])
+    # donor: S's far point of the donor window (the CKPT120 donor map), T's token only
+    assert X0.main(args + ["--tag", "d", "--out-dir", str(tmp_path / "d"), "--t-far", "on", "--far-token", "donor", "--far-token-donor-npz", str(tmp_path / "r" / "eval_r_far.npz")]) == 0
+    d = np.load(tmp_path / "d" / "eval_d_tfar.npz")
+    from tanitad.models.hjepa import donor_indices
+    perm = donor_indices(N, episode_ids=torch.as_tensor(far["win_ci"]), seed=0).numpy()
+    np.testing.assert_array_equal(d["donor_index"], perm)
+    assert (perm != np.arange(N)).all() and not np.array_equal(d["t_far_in"], r["t_far_in"]) and not np.array_equal(d["lon_logits"], r["lon_logits"])
+    np.testing.assert_array_equal(np.load(tmp_path / "d" / "eval_d_far.npz")["ckpt_far"], far["ckpt_far"])          # S's own output is the real one: only T's token moved
+    # oracle: RC-A120 where valid (flagged), S's own point elsewhere
+    assert X0.main(args + ["--tag", "o", "--out-dir", str(tmp_path / "o"), "--t-far", "on", "--far-token", "oracle", "--rc120-npz", rc, "--rc120-sha256", _sha_f(rc)]) == 0
+    o = np.load(tmp_path / "o" / "eval_o_tfar.npz")
+    v = o["oracle_valid"]
+    assert v.shape == (N,) and v.any()
+    assert not np.array_equal(o["t_far_in"][v], r["t_far_in"][v]) and np.array_equal(o["t_far_in"][~v], r["t_far_in"][~v])
+
+
+def test_t0_tfar_wrapper_refusals_and_the_layer_off_run_is_the_far_wrappers_bit_for_bit(world, tmp_path):
+    ck = str(tmp_path / "ck.pt")
+    J = _tfar_ckpt(world, ck)
+    tbl, _ = _nav_s_table(tmp_path, J)
+    base = _t0_args(world, ck) + _far_flags(tbl)
+    for extra, why in (([], "layer on, flag off"), (["--t-far", "on", "--nav-strat-t", "on"], "nav_s_t declared, absent"), (["--t-far", "on", "--far-token", "donor"], "donor without a dump"),
+                       (["--t-far", "on", "--far-token", "oracle"], "oracle without a table"), (["--t-far", "on", "--rc120-npz", "x", "--rc120-sha256", "y"], "table without oracle")):
+        with pytest.raises(SystemExit, match="REFUSED"):
+            X0.main(base + ["--tag", "q", "--out-dir", str(tmp_path / "c")] + extra)
+    ck2 = str(tmp_path / "ck2.pt")
+    _tfar_ckpt(world, ck2, t_far=False)
+    a2 = _t0_args(world, ck2) + _far_flags(tbl)
+    with pytest.raises(SystemExit, match="REFUSED"):
+        X0.main(a2 + ["--tag", "q", "--out-dir", str(tmp_path / "c"), "--t-far", "on"])
+    with pytest.raises(SystemExit, match="REFUSED"):
+        X0.main(a2 + ["--tag", "q", "--out-dir", str(tmp_path / "c"), "--far-token", "zero"])
+    assert W0.main(a2 + ["--tag", "p", "--out-dir", str(tmp_path / "a")]) == 0
+    assert X0.main(a2 + ["--tag", "p", "--out-dir", str(tmp_path / "b")]) == 0
+    a, b = np.load(tmp_path / "a" / "eval_p.npz"), np.load(tmp_path / "b" / "eval_p.npz")
+    assert sorted(a.files) == sorted(b.files)
+    for k in a.files:
+        np.testing.assert_array_equal(a[k], b[k], err_msg=k)
+    assert not (tmp_path / "b" / "eval_p_tfar.npz").exists()
+
+
+def test_the_wrappers_patch_nothing_after_the_call(world, tmp_path):
+    ck = str(tmp_path / "ck.pt")
+    J = _tfar_ckpt(world, ck)
+    tbl, _ = _nav_s_table(tmp_path, J)
+    fi, rt, lj, cr = M.V8FMini.forward_infer, M.V8FMini.run_t, E.D.load_join, E.cmd_run
+    assert X0.main(_t0_args(world, ck) + _far_flags(tbl) + ["--tag", "r", "--out-dir", str(tmp_path / "r"), "--t-far", "on", "--far-token", "zero"]) == 0
+    assert (M.V8FMini.forward_infer, M.V8FMini.run_t, E.D.load_join, E.cmd_run) == (fi, rt, lj, cr)
+
+
+def test_t1_tfar_wrapper_records_the_far_point_T_read_per_tick(world, tmp_path):
