+    assert W1.main(_t1_args(world, ck, ["--tag", "p", "--out-dir", str(tmp_path / "oa"), "--dump-ticks", str(tmp_path / "a"), *_far_flags(tbl)])) == 0
+    assert X1.main(_t1_args(world, ck, ["--tag", "p", "--out-dir", str(tmp_path / "ob"), "--dump-ticks", str(tmp_path / "b"), *_far_flags(tbl)])) == 0
+    a, b = np.load(tmp_path / "a" / "ticks_p.npz"), np.load(tmp_path / "b" / "ticks_p.npz")
