diff --git a/b/stack/scripts/v8f_t1_eval_tfar.py b/b/stack/scripts/v8f_t1_eval_tfar.py
new file mode 100644
index 0000000..d921441
--- /dev/null
+++ b/b/stack/scripts/v8f_t1_eval_tfar.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""v8f_t1_eval_tfar.py -- PREREG_V8F_TFAR: the T1 (action-closed-loop, kinematic) evaluator for a model whose T reads S's 120 m point (``--t-far on``) and/or the raw route text (``--nav-strat-t on``).
+
+Layers over ``v8f_t1_eval_far.py`` (itself a wrapper of the pinned ``v8f_t1_eval.py``; BOTH files are untouched and the pin is checked before anything runs). The far point is already held and re-expressed per tick by the model like the 30 / 50 / 80 m
+checkpoints, and ``nav_s`` is already dead-reckoned per tick by ``v8f_t1_eval_far`` (``--nav-strat on``), so T reads both through the tool's own tick loop. Added, in ONE call (every patch undone in ``finally``):
+
+  1. ``run --t-far off|on`` and ``--nav-strat-t off|on`` (default off), each REFUSED when it differs from the checkpoint's cfg (``t_far`` / ``nav_strat_t``); ``--nav-strat-t on`` also needs ``--nav-strat on`` (its source channel).
+  2. With ``--dump-ticks`` and ``--t-far on``, the tick recorder adds ``t_far_in`` [N, 3] (the far point T was handed at the tick, in T's tick frame, from the SAME ``forward_infer`` call that produced the plan) and ``t_far_ok`` [N]: what T READ per tick,
+     the input the reader's TN comparison and the echo share need. The T lon / lat logits ride with ``--dump-heads`` (the tool's own ``t_lon_logits`` / ``t_lat_logits``).
+With both layers off nothing of this wrapper is patched: the run is ``v8f_t1_eval_far``'s, bit for bit.
+
+usage:  python v8f_t1_eval_tfar.py run --ckpt CK ... --far-out on --nav-strat on --nav-strat-npz T --nav-strat-sha256 S --t-far on --dump-ticks DIR --dump-heads      (any other argv: the tool's / v8f_t1_eval_far's)
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+import v8f_t1_eval_far as F1  # noqa: E402
+
+T = F1.T
+
+
+def add_flags(p):
+    p.add_argument("--t-far", choices=("off", "on"), default="off", help="must equal the checkpoint's cfg t_far (a mismatch is refused)")
+    p.add_argument("--nav-strat-t", choices=("off", "on"), default="off", help="must equal the checkpoint's cfg nav_strat_t (a mismatch is refused)")
+
+
+def build_parser(base=None):
+    p = F1.build_parser(base)
+    sub = next(a for a in p._actions if isinstance(a, argparse._SubParsersAction))
+    add_flags(sub.choices["run"])
+    return p
+
+
+def refusals(a, cfg):
+    bad = []
+    if a.t_far != cfg.t_far:
+        bad.append(f"--t-far {a.t_far} but the checkpoint's cfg has t_far={cfg.t_far!r}: the evaluator would silently skip (or invent) the far token")
+    if a.nav_strat_t != cfg.nav_strat_t:
+        bad.append(f"--nav-strat-t {a.nav_strat_t} but the checkpoint's cfg has nav_strat_t={cfg.nav_strat_t!r}: the evaluator would silently skip (or invent) T's route-text token")
+    if a.nav_strat_t == "on" and a.nav_strat != "on":
+        bad.append("--nav-strat-t on needs --nav-strat on (T reads the dead-reckoned nav_s channel)")
+    if a.t_far == "on" and a.far_out != "on":
+        bad.append("--t-far on needs --far-out on (T reads S's far point)")
+    return bad
+
+
+def make_cmd_run(tool_cmd_run):
+    def cmd_run(a):
+        import torch
+        ck = torch.load(a.ckpt, map_location="cpu", weights_only=False)
+        cfg = T.M.V8FMiniConfig(**ck["cfg"])
+        bad = refusals(a, cfg)
+        if bad:
+            raise SystemExit("REFUSED: " + "; ".join(bad))
+        if a.t_far == "off" and a.nav_strat_t == "off":
+            return tool_cmd_run(a)
+        held = {}
+        rt0 = T.M.V8FMini.run_t
+
+        def run_t(self, *aa, **kk):
+            if "far" in kk:
+                held["far"], held["ok"] = kk["far"].detach().float().cpu().numpy(), kk["far_ok"].detach().float().cpu().numpy()
+            return rt0(self, *aa, **kk)
+        base_rec = T.TickRecorder
+        far_on = a.t_far == "on"
+
+        class TfarRec(base_rec):
+            """The recorder of the layers below (the tool's, with v8f_t1_eval_far's columns), plus ``t_far_in`` / ``t_far_ok`` per tick."""
+
+            def __init__(self, planner, store, J, heads=False, nav=False, ctx=False):
+                super().__init__(planner, store, J, heads=heads, nav=nav, ctx=ctx)
+                if far_on:
+                    self.rows["t_far_in"], self.rows["t_far_ok"] = [], []
+
+            def __call__(self, n, batch, plan, states):
+                super().__call__(n, batch, plan, states)
+                if far_on:
+                    if "far" not in held or len(held["far"]) < len(states):
+                        raise RuntimeError("t_far on but the tick's forward_infer handed T no far token: the recorder would write a placeholder")
+                    for b in range(len(states)):
+                        self.rows["t_far_in"].append(held["far"][b])
+                        self.rows["t_far_ok"].append(held["ok"][b])
+        T.M.V8FMini.run_t, T.TickRecorder = run_t, TfarRec
+        try:
+            return tool_cmd_run(a)
+        finally:
+            T.M.V8FMini.run_t, T.TickRecorder = rt0, base_rec
+    return cmd_run
+
+
+def main(argv=None):
+    got = F1.tool_sha256()
+    if got != F1.TOOL_SHA256:
+        raise SystemExit(f"REFUSED: the T1 tool {T.__file__} has sha256 {got}, the pin is {F1.TOOL_SHA256}: this wrapper (through v8f_t1_eval_far) patches the recorder and run_t of THAT tool's run")
+    bp, cr = T.build_parser, T.cmd_run
+    T.build_parser, T.cmd_run = (lambda: build_parser(bp)), F1.make_cmd_run(make_cmd_run(cr))      # F1's wrapper outermost: it sets its recorder and states first, this one runs inside it
+    try:
+        return T.main(argv)
+    finally:
+        T.build_parser, T.cmd_run = bp, cr
+
+
+if __name__ == "__main__":
+    sys.exit(main())
