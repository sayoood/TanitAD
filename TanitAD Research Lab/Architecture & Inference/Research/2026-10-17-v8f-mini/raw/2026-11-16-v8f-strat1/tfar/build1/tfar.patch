+    toks = T.render(kind, seed, rig["inp"], out, rig["nav"], rig["rc"], rig["ns"], base_argvs=rig["frozen"], cache_dir=rig["cache"], h2_init=os.path.join(rig["inp"], "tfar", f"h2_init_{seed}.pt"))
+    rd = os.path.join(rig["runs"], tag)
+    os.makedirs(os.path.join(rd, "gate"), exist_ok=True)
+    json.dump(toks, open(os.path.join(rd, "argv.json"), "w", encoding="utf-8"))
+    sc = os.path.join(rd, "gate", "selfcheck.json")
+    json.dump(good_selfcheck(kind, toks), open(sc, "w", encoding="utf-8"))
+    b, bad = T.binding(kind, toks, rig["root"], COMMIT, rig["suite"], nav_s_report=rig["nsr"])
+    assert bad == [], bad
+    T.write_token(os.path.join(rd, "gate", "gate_token.json"), b, {c: {"pass": True} for c in T.REQUIRED_CHECKS}, S1.sha_file(sc))
+    a = argparse.Namespace(runs=rig["runs"], inputs=rig["inp"], root=rig["root"], commit=COMMIT, suite=rig["suite"], trainer="", py=sys.executable, gpu="")
+    return dict(tag=tag, rd=rd, toks=toks, a=a, out=out)
