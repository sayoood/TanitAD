@@ -0,0 +1,521 @@
+"""PREREG_V8F_TFAR study checker (the pattern of ``ckpt120_check.py``; this file imports it and ``strat1_check.py`` and adds nothing to them). It maps the launch-gate checks onto the trainer's own selfcheck for the TFAR arms
+(``PREREG_V8F_TFAR.md`` sections 5, 7, 9; the base of record is CKPT120's H2 = N1 + the far head + ``--nav-strat on`` + ``--detach-upper``):
+
+  TF_s0 TF_s1 TF_rep TF_s10 TF_s11   H2 + --t-far on --t-far-lr-mult 10 --t-far-input pred --t-far-variant real --t-far-tf same   (rep = seed 2, s10 / s11 = the 4-seed rule's pair)
+  R3_s0                              TF + --t-far-variant roll   (the deliberate regression: must fail the read)
+  TZ_s0                              TF + --t-far-input zero     (token off: the path is built and trained, receives no information)
+  TN_s0 TN_s1                        H2 + --nav-strat-t on --nav-strat-t-lr-mult 10     (attribution: T reads the raw route text)
+  TFnt_s0 TFnt_s1                    TF + --t-far-tf off                                (branch: T always reads S's predicted point)
+  TFd_s0 TFd_s1                      TF + --s-adapter-detach on                         (branch: a STRATEGIC cost)
+  TFc_s0 TFc_s1 / H2c_s0 H2c_s1      TF / H2 initialised from the banked H2 checkpoint, + 3,000 steps (matched continuation; the checkpoint is ``<inputs>/tfar/h2_init_<seed>.pt``)
+  H2_s10 H2_s11                      CKPT120's own SEEDS-DISAGREE comparators (H2's argv, the TFAR flags NOT named: the lever is not part of them)
+
+  G-HYG    V8FMiniConfig refuses every bad TFAR value / unknown key                  -> ``hyg``
+  G-DVB    trainer ``declared_vs_built`` (bad_tfar and the inherited bad_sfar / STRAT1) + every argv lever == ``selfcheck.levers``  -> ``gate_problems``
+  G-LIVE   ``tfar_probe`` (every key with the value it must read: non-zero where the lever is on, EXACTLY 0.0 for each control, T-ISO-UP, K-RNG, G-CLOCK-TFAR) + the inherited probes  -> ``gate_problems``
+  G-CLOCK  G-CLOCK-NAV-S for the nav_s arms (the builder report), G-CLOCK-TFAR (in the probe: the far point T reads equals ``transform_ckpt`` of S's point)
+  G-EVAL   strict load through the evaluator's build path, built levers == selfcheck levers, a cfg that drops ``t_far`` / ``nav_strat_t`` is REFUSED  -> ``geval``
+  G-CKPT   save / load round trip bit-equal, resume, the new layer MOVED from its zero init (TZ: its weight did NOT, its bias did)  -> ``moved_identity``
+  G-SUITE  pytest on a clean export of the commit, 0 regressions vs the base commit  -> ``suite`` (junit compare) + ``suite_problems``
+
+The token ``tfar-gate-token-v1`` binds the commit, the argv sha256, EVERY data sha256 (the RC-A120 table, the nav_s table, the nav, the init checkpoint and the other STRAT1 inputs), the tree manifest, the trainer, this checker and the G-SUITE result.
+``run`` REFUSES (rc 2) unless the token still binds exactly what is on disk. The data sha256s are PARAMETERS (RC-A120 ``0f122570...``, nav_s ``0f7431a1...`` are what the MM passes; nothing here pins them).
+
+Subcommands: ``argv KIND SEED``, ``gate KIND --selfcheck F --argv-json J``, ``post KIND --init I --final F``, ``geval --ckpt C``, ``hyg``, ``suite``, ``mint KIND SEED``, ``run KIND SEED``.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
+for p in (os.path.join(REPO, "stack"), HERE):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import ckpt120_check as C  # noqa: E402
+import strat1_check as S1  # noqa: E402
+
+TOKEN_SCHEMA = "tfar-gate-token-v1"
+WRITTEN_BY = "tfar_check.py mint"
+SUITE_SCHEMA = "tfar-gsuite-result-v1"
+SUITE_WRITER = "tfar_check.py suite"
+RUN_STEPS = S1.RUN_STEPS
+T_FAR_LR_MULT = "10"
+NAV_STRAT_T_LR_MULT = "10"
+#: the seven TFAR flags; EVERY one is named in EVERY arm that tests a TFAR lever (a flag whose default disables it must be named, or the arm did not test it)
+TFAR_FLAGS = ("--t-far", "--t-far-lr-mult", "--t-far-input", "--t-far-variant", "--t-far-tf", "--nav-strat-t", "--nav-strat-t-lr-mult")
+ARMS = {"TF": ("s0", "s1", "rep", "s10", "s11"), "R3": ("s0",), "TZ": ("s0",), "TN": ("s0", "s1"), "TFnt": ("s0", "s1"), "TFd": ("s0", "s1"), "TFc": ("s0", "s1"), "H2c": ("s0", "s1"), "H2": ("s10", "s11")}
+KINDS = tuple(ARMS)
+#: per kind: (t_far, t_far_input, t_far_variant, t_far_tf, nav_strat_t, s_adapter_detach, init_from_h2)
+SPEC = {"TF": ("on", "pred", "real", "same", "off", "off", False), "R3": ("on", "pred", "roll", "same", "off", "off", False), "TZ": ("on", "zero", "real", "same", "off", "off", False),
+        "TN": ("off", "pred", "real", "same", "on", "off", False), "TFnt": ("on", "pred", "real", "off", "off", "off", False), "TFd": ("on", "pred", "real", "same", "off", "on", False),
+        "TFc": ("on", "pred", "real", "same", "off", "off", True), "H2c": (None, None, None, None, None, "off", True), "H2": (None, None, None, None, None, "off", False)}
+NAMES_TFAR_FLAGS = lambda kind: SPEC[kind][0] is not None      # H2 / H2c are the lever-free comparators
+REQUIRED_CHECKS = S1.REQUIRED_CHECKS
+TRAINER_REL = S1.TRAINER_REL
+NAV_S_REPORT = C.NAV_S_REPORT
+H2_KIND = "H2"                                                                        # the CKPT120 kind the base argv, the inherited gate reads and the inherited post check come from
+
+
+def arm_tag(kind, seed, steps=RUN_STEPS):
+    return f"{kind}_{seed}" if steps == RUN_STEPS else f"pilot{steps}_{kind}_{seed}"
+
+
+def check_arm(kind, seed):
+    if kind not in ARMS or seed not in ARMS[kind]:
+        raise ValueError(f"{kind}_{seed} is not an arm of PREREG_V8F_TFAR (arms: {[f'{k}_{s}' for k, v in ARMS.items() for s in v]})")
+
+
+def render(kind, seed, root, out, nav_npz="", rc120_npz="", nav_s_npz="", base_argvs=S1.BASE_ARGVS, cache_dir=None, h2_init=""):
+    """The frozen argv of an arm: H2's argv of that seed (``ckpt120_check.render``) plus, for every lever-testing kind, ALL seven TFAR flags. TFd flips ``--s-adapter-detach`` to on; TFc / H2c replace ``--init-ckpt`` by the banked H2 checkpoint."""
+    check_arm(kind, seed)
+    spec = SPEC[kind]
+    was = C.ARMS["H2"]
+    C.ARMS["H2"] = tuple(dict.fromkeys(was + (seed,)))              # CKPT120's H2 kind accepts the 4-seed rule's seeds ONLY for this call (its own table is restored: its tests pin the card's seeds)
+    try:
+        t = list(C.render(H2_KIND, seed, root, out, nav_npz, rc120_npz, nav_s_npz, base_argvs=base_argvs, cache_dir=cache_dir))
+    finally:
+        C.ARMS["H2"] = was
+    t[t.index("--s-adapter-detach") + 1] = spec[5]
+    if spec[6]:
+        t[t.index("--init-ckpt") + 1] = h2_init or "<banked H2 checkpoint of this seed>"
+    if NAMES_TFAR_FLAGS(kind):
+        t += ["--t-far", spec[0], "--t-far-lr-mult", T_FAR_LR_MULT if spec[0] == "on" else "1", "--t-far-input", spec[1], "--t-far-variant", spec[2], "--t-far-tf", spec[3],
+              "--nav-strat-t", spec[4], "--nav-strat-t-lr-mult", NAV_STRAT_T_LR_MULT if spec[4] == "on" else "1"]
+    return t
+
+
+def argv_sha(toks):
+    return S1.argv_sha(toks)
+
+
+def _eq(a, b):
+    return C._eq(a, b)
+
+
+def _argv_for_inherited(kind, toks):
+    """The inherited CKPT120 read compares ``--s-adapter-detach`` with off: TFd's argv is read with that flag flipped (its own value is checked below)."""
+    t = list(toks)
+    if "--s-adapter-detach" in t:
+        t[t.index("--s-adapter-detach") + 1] = "off"
+    return t
+
+
+def gate_problems(kind, toks, sc, steps=RUN_STEPS):
+    """The G-DVB + G-LIVE read of a selfcheck.json against its argv. [] = pass. Every ``tfar_probe`` key is read with the value it must have."""
+    spec = SPEC[kind]
+    bad = [x for x in C.gate_problems(H2_KIND, _argv_for_inherited(kind, toks), sc, steps) if not (spec[5] == "on" and "s_adapter_detach" in x)]
+    lv, live = sc.get("levers", {}), sc.get("live", {})
+    if S1.flag_value(toks, "--s-adapter-detach") != spec[5] or lv.get("s_adapter_detach", "off") != spec[5]:
+        bad.append(f"arm {kind} needs --s-adapter-detach {spec[5]}: argv {S1.flag_value(toks, '--s-adapter-detach')!r}, built {lv.get('s_adapter_detach', 'off')!r}")
+    if not NAMES_TFAR_FLAGS(kind):
+        named = [f for f in TFAR_FLAGS if f in toks]
+        if named:
+            bad.append(f"comparator arm {kind} names TFAR flags {named}: the lever is not part of it")
+        for k in ("t_far", "t_far_input", "t_far_variant", "t_far_tf", "nav_strat_t", "t_far_zero_init", "t_far_in"):
+            if k in lv:
+                bad.append(f"comparator arm {kind}: built lever {k} is present")
+        if "tfar_probe" in sc:
+            bad.append(f"comparator arm {kind} carries a tfar_probe")
+        return bad
+    miss = [f for f in TFAR_FLAGS if f not in toks]
+    if miss:
+        bad.append(f"the argv does not name {miss}: a flag whose default disables it must be named")
+    want = {"--t-far": spec[0], "--t-far-input": spec[1], "--t-far-variant": spec[2], "--t-far-tf": spec[3], "--nav-strat-t": spec[4]}
+    for f, v in want.items():
+        if S1.flag_value(toks, f) != v:
+            bad.append(f"argv {f} is {S1.flag_value(toks, f)!r}, arm {kind} needs {v!r}")
+    for f, on, mult in (("--t-far-lr-mult", spec[0] == "on", T_FAR_LR_MULT), ("--nav-strat-t-lr-mult", spec[4] == "on", NAV_STRAT_T_LR_MULT)):
+        if not _eq(S1.flag_value(toks, f), mult if on else "1"):
+            bad.append(f"argv {f} is {S1.flag_value(toks, f)!r}, arm {kind} needs {mult if on else '1'}")
+    if "--detach-upper" not in toks or "--s-far" not in toks or S1.flag_value(toks, "--s-far") != "on" or S1.flag_value(toks, "--nav-strat") != "on":
+        bad.append("a TFAR arm needs --detach-upper, --s-far on and --nav-strat on in its argv")
+    # the BUILT levers: present ONLY when the lever is on (an off model emits no new key)
+    if spec[0] == "on":
+        for k, v in (("t_far", "on"), ("t_far_input", spec[1]), ("t_far_variant", spec[2]), ("t_far_tf", spec[3])):
+            if lv.get(k) != v:
+                bad.append(f"built lever {k} {lv.get(k)!r} differs from the declared {v!r}")
+        if lv.get("t_far_zero_init") is not True or lv.get("t_far_in") != 4:
+            bad.append(f"built t_far_zero_init {lv.get('t_far_zero_init')!r} / t_far_in {lv.get('t_far_in')!r}: the layer is not the zero-initialised Linear(4, d)")
+    else:
+        for k in ("t_far", "t_far_input", "t_far_variant", "t_far_tf", "t_far_zero_init", "t_far_in"):
+            if k in lv:
+                bad.append(f"built lever {k} present with --t-far off")
+    if (lv.get("nav_strat_t") == "on") != (spec[4] == "on") or (spec[4] != "on" and "nav_strat_t" in lv):
+        bad.append(f"built lever nav_strat_t {lv.get('nav_strat_t')!r} differs from the declared {spec[4]!r}")
+    p = sc.get("tfar_probe")
+    if not isinstance(p, dict) or p.get("skipped") or not p.get("pass"):
+        bad.append("tfar_probe is missing, skipped or not pass")
+        return bad
+    if p.get("zero_init") is not True or p.get("step0_identical") is not True or p.get("rng_state_identical") is not True:
+        bad.append(f"tfar_probe: zero_init {p.get('zero_init')!r} / step0_identical {p.get('step0_identical')!r} / rng_state_identical {p.get('rng_state_identical')!r} must all be True (K-REACH-a2, K-RNG)")
+    if p.get("t_iso_up_s_grad") != 0.0 or not (isinstance(p.get("t_iso_up_positive_control"), (int, float)) and p["t_iso_up_positive_control"] > 0.0):
+        bad.append(f"tfar_probe T-ISO-UP: S gradient must read EXACTLY 0.0 (read {p.get('t_iso_up_s_grad')!r}) with a positive control > 0 (read {p.get('t_iso_up_positive_control')!r})")
+    if spec[0] == "on":
+        if not (isinstance(p.get("far_weight_grad"), (int, float)) and p["far_weight_grad"] > 0.0):
+            bad.append(f"tfar_probe far_weight_grad must read > 0, read {p.get('far_weight_grad')!r}")
+        if p.get("control_far_weight_grad_input_zero") != 0.0:
+            bad.append(f"tfar_probe control_far_weight_grad_input_zero must read EXACTLY 0.0, read {p.get('control_far_weight_grad_input_zero')!r}")
+        if not (isinstance(p.get("control_far_bias_grad_input_zero"), (int, float)) and p["control_far_bias_grad_input_zero"] > 0.0):
+            bad.append(f"tfar_probe control_far_bias_grad_input_zero must read > 0 (the bias trains), read {p.get('control_far_bias_grad_input_zero')!r}")
+        for k in ("t_reads_far", "t_iso_o_ck_token_identical"):
+            if p.get(k) is not True:
+                bad.append(f"tfar_probe {k} must be True, read {p.get(k)!r}")
+        if not (isinstance(p.get("clock_max_abs_err"), (int, float)) and p["clock_max_abs_err"] <= 1e-6) or p.get("keys_read_labels") != []:
+            bad.append(f"tfar_probe G-CLOCK-TFAR err {p.get('clock_max_abs_err')!r} / K-KEYS label keys {p.get('keys_read_labels')!r}")
+        zdead = "e_ck_far.weight" in (live.get("declared_dead") or [])
+        if zdead != (spec[1] == "zero"):
+            bad.append(f"G-LIVE declared_dead e_ck_far.weight is {zdead}: only the token-off arm TZ may declare it (and must)")
+    elif any(k.startswith("far_weight") or k.startswith("control_far") for k in p):
+        bad.append("a t_far-off arm carries far-layer probe keys")
+    if spec[4] == "on":
+        if not (isinstance(p.get("nav_s_t_weight_grad"), (int, float)) and p["nav_s_t_weight_grad"] > 0.0) or p.get("control_nav_s_t_weight_grad_nav_s_zero") != 0.0:
+            bad.append(f"tfar_probe nav_s_t gradient {p.get('nav_s_t_weight_grad')!r} must be > 0 and its nav_s-zero control {p.get('control_nav_s_t_weight_grad_nav_s_zero')!r} EXACTLY 0.0")
+    elif any(k.startswith("nav_s_t") or k.startswith("control_nav_s_t") for k in p):
+        bad.append("an nav_strat_t-off arm carries nav_s_t probe keys")
+    return bad
+
+
+def moved_identity(init_sd, fin_sd, kind):
+    """The post check: CKPT120's (the STRAT1 groups moved, the far head and e_nav_s left their inits) plus the TFAR layers: ``e_ck_far.*`` exists iff the arm has it and its weight left zero (TZ: it did NOT, the bias did); ``e_nav_s_t.*`` iff TN."""
+    bad = list(C.moved_identity(init_sd, fin_sd, H2_KIND))
+    spec = SPEC[kind]
+    fk = {k: v for k, v in fin_sd.items() if k.startswith("e_ck_far.")}
+    if spec[0] == "on":
+        if set(fk) != {"e_ck_far.weight", "e_ck_far.bias"}:
+            bad.append(f"{kind} checkpoint e_ck_far keys {sorted(fk)}")
+        else:
+            w, b = float(fk["e_ck_far.weight"].abs().sum()), float(fk["e_ck_far.bias"].abs().sum())
+            if spec[1] == "zero":
+                if w != 0.0 or not b > 0.0:
+                    bad.append(f"TZ: e_ck_far.weight must stay EXACTLY 0.0 (read {w}) and the bias must move (read {b})")
+            elif not (w > 0.0 and b > 0.0):
+                bad.append(f"e_ck_far did not move from its zero init (weight {w}, bias {b})")
+    elif fk:
+        bad.append(f"e_ck_far keys {sorted(fk)} in a {kind} checkpoint")
+    nk = {k: v for k, v in fin_sd.items() if k.startswith("e_nav_s_t.")}
+    if spec[4] == "on":
+        if set(nk) != {"e_nav_s_t.weight", "e_nav_s_t.bias"} or not float(nk.get("e_nav_s_t.weight", fin_sd["e_nav_s.weight"] * 0).abs().sum()) > 0.0:
+            bad.append("e_nav_s_t is missing or did not move from its zero init")
+    elif nk:
+        bad.append(f"e_nav_s_t keys {sorted(nk)} in a {kind} checkpoint")
+    return bad
+
+
+TFAR_LEVER_KEYS = ("t_far", "t_far_input", "t_far_variant", "t_far_tf", "nav_strat_t")
+
+
+def geval(ckpt_path, selfcheck_levers=None):
+    """G-EVAL: CKPT120's strict load + lever read, plus the TFAR levers (built == selfcheck's; absent when off); the deliberate-regression arms (a cfg that drops ``t_far`` / ``nav_strat_t`` while the checkpoint carries the layer) must be REFUSED."""
+    import torch
+    from tanitad.models import v8f_mini as M
+    bad, rec = C.geval(ckpt_path, selfcheck_levers)
+    if bad and any("strict load failed" in x for x in bad):
+        return bad, rec
+    ck = torch.load(ckpt_path, map_location="cpu", weights_only=False)
+
+    def build(cfgd):
+        m = M.V8FMini(M.V8FMiniConfig(**cfgd), M.P10Prior(torch.zeros(8), torch.ones(8), torch.zeros(2 * M.K30)))
+        m.load_state_dict(ck["model"])
+        return m
+    lv = build(ck["cfg"]).built_levers()
+    rec["built_levers_tfar"] = {k: lv[k] for k in TFAR_LEVER_KEYS if k in lv}
+    if selfcheck_levers is not None:
+        for k in TFAR_LEVER_KEYS:
+            if lv.get(k) != selfcheck_levers.get(k):
+                bad.append(f"built lever {k}: evaluator {lv.get(k)!r} vs selfcheck {selfcheck_levers.get(k)!r}")
+    for name, drop in (("t_far", {"t_far": "off", "t_far_input": "pred", "t_far_variant": "real", "t_far_tf": "same"}), ("nav_strat_t", {"nav_strat_t": "off"})):
+        if ck["cfg"].get(name) == "on":
+            try:
+                build({**ck["cfg"], **drop})
+                bad.append(f"regression arm: a cfg that drops {name} was NOT refused (the evaluator would silently skip the layer)")
+            except Exception:                                           # noqa: BLE001
+                rec[f"regression_arm_drop_{name}_refused"] = True
+    return bad, rec
+
+
+def hyg():
+    from tanitad.models import v8f_mini as M
+    n = 0
+    bads = (dict(t_far="maybe"), dict(t_far_input="x"), dict(t_far_variant="x"), dict(t_far_tf="x"), dict(nav_strat_t="x"))
+    for kw in bads:
+        try:
+            M.V8FMiniConfig(**kw)
+        except ValueError:
+            n += 1
+    try:
+        M.V8FMiniConfig(t_farz="on")
+    except TypeError:
+        n += 1
+    return [] if n == len(bads) + 1 else [f"only {n} of {len(bads) + 1} bad TFAR configs were refused"]
+
+
+# ---- the token ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+def argv_kind_problems(kind, toks):
+    """The argv on disk must be the argv of THIS arm kind (the lever values the kind fixes), so a token cannot start a different arm than it was minted for."""
+    spec = SPEC[kind]
+    if not NAMES_TFAR_FLAGS(kind):
+        return [f"argv names {f}: arm {kind} is a lever-free comparator" for f in TFAR_FLAGS if f in toks]
+    got = {f: S1.flag_value(toks, f) for f in ("--t-far", "--t-far-input", "--t-far-variant", "--t-far-tf", "--nav-strat-t", "--s-adapter-detach")}
+    want = {"--t-far": spec[0], "--t-far-input": spec[1], "--t-far-variant": spec[2], "--t-far-tf": spec[3], "--nav-strat-t": spec[4], "--s-adapter-detach": spec[5]}
+    return [f"argv {f} is {got[f]!r}, arm {kind} needs {want[f]!r}" for f in want if got[f] != want[f]]
+
+
+def data_binding(toks):
+    """CKPT120's data binding (STRAT1's, plus the RC-A120 and nav_s tables, each re-hashed against the sha256 the argv declares); ``--init-ckpt`` is among STRAT1's data flags, so TFc / H2c's banked H2 checkpoint is bound too."""
+    return C.data_binding(toks)
+
+
+def suite_problems(path, commit):
+    """The G-SUITE result file written by ``suite``: 0 regressions of the new tree against the base, for this commit. Returns (sha256 of the file or None, problems)."""
+    try:
+        r = json.load(open(path, encoding="utf-8"))
+    except (OSError, ValueError):
+        return None, ["no G-SUITE result file"]
+    bad = []
+    if r.get("schema") != SUITE_SCHEMA or r.get("written_by") != SUITE_WRITER:
+        bad.append("the G-SUITE result file was not written by the checker")
+    if r.get("n_regressions") != 0 or r.get("regressions"):
+        bad.append(f"G-SUITE has {r.get('n_regressions')} regressions")
+    if not r.get("new", {}).get("n_tests") or not r.get("base", {}).get("n_tests"):
+        bad.append("the G-SUITE result has an empty side")
+    if r.get("new_commit") != commit:
+        bad.append(f"the G-SUITE result is for commit {r.get('new_commit')}, not {commit}")
+    return S1.sha_file(path), bad
+
+
+def suite_compare(base_dir, new_dir, new_commit, base_commit):
+    r = S1.suite_compare(base_dir, new_dir, new_commit, base_commit)
+    r["schema"], r["written_by"] = SUITE_SCHEMA, SUITE_WRITER
+    return r
+
+
+def binding(kind, toks, root, commit, suite_path, trainer=None, nav_s_report=""):
+    """Everything the token binds, recomputed NOW. Returns (dict, problems)."""
+    d, bad = data_binding(toks)
+    tr = trainer or os.path.join(root, TRAINER_REL)
+    grid = os.path.join(root, *S1.EVAL_GRID_REL)
+    if os.path.isfile(grid):
+        d["eval_grid_windows.json"] = {"path": grid, **S1.hash_entry(grid)}
+    ssha, sbad = suite_problems(suite_path, commit)
+    bad = list(bad) + sbad
+    if nav_s_report:
+        bad += C.nav_s_report_problems(H2_KIND, S1.flag_value(toks, "--nav-strat-npz"), nav_s_report)
+    b = {"kind": kind, "commit": commit, "argv_sha256": argv_sha(toks), "data": d, "tree_manifest_sha256": S1.tree_manifest_sha(root),
+         "trainer_sha256": S1.sha_file(tr) if os.path.isfile(tr) else None, "gsuite_result_sha256": ssha, "checker_sha256": S1.sha_file(os.path.abspath(__file__)),
+         "nav_s_report_sha256": S1.sha_file(nav_s_report) if nav_s_report and os.path.isfile(nav_s_report) else None}
+    if b["trainer_sha256"] is None:
+        bad.append("trainer not found")
+    return b, bad
+
+
+def body_sha(tok):
+    return S1.body_sha(tok)
+
+
+def write_token(path, b, checks, selfcheck_sha):
+    """The ONLY writer of a token (called by ``mint`` after every required check read PASS)."""
+    miss = [c for c in REQUIRED_CHECKS if not (checks.get(c) or {}).get("pass")]
+    if miss:
+        raise ValueError(f"refusing to write a token: checks not PASS: {miss}")
+    tok = {"schema": TOKEN_SCHEMA, "written_by": WRITTEN_BY, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "selfcheck_sha256": selfcheck_sha, "checks": checks, **b}
+    tok["body_sha256"] = body_sha(tok)
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = path + ".part"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(tok, f, indent=1, sort_keys=True)
+    os.replace(tmp, path)
+    return tok
+
+
+def token_problems(token_path, kind, toks, root, commit, suite_path, selfcheck_path="", trainer=None, nav_s_report=""):
+    """[] iff a token written by ``mint`` still binds this arm kind, commit, argv, every data file, the tree, the trainer, the checker and the G-SUITE result. Each differing key is named."""
+    try:
+        tok = json.load(open(token_path, encoding="utf-8"))
+    except (OSError, ValueError):
+        return ["no gate token"]
+    p = []
+    if tok.get("schema") != TOKEN_SCHEMA or tok.get("written_by") != WRITTEN_BY:
+        p.append("token not written by the checker")
+    if tok.get("body_sha256") != body_sha(tok):
+        p.append("token body was edited (body_sha256)")
+    miss = [c for c in REQUIRED_CHECKS if not (tok.get("checks", {}).get(c) or {}).get("pass")]
+    if miss:
+        p.append(f"token checks not PASS: {miss}")
+    p += argv_kind_problems(kind, toks)
+    want, bad = binding(kind, toks, root, commit, suite_path, trainer, nav_s_report)
+    p += list(bad)
+    for k, v in want.items():
+        if k == "data":
+            for name in sorted(set(v) | set(tok.get("data", {}))):
+                if v.get(name) != tok.get("data", {}).get(name):
+                    p.append(f"token data {name} differs from the current file")
+        elif tok.get(k) != v:
+            p.append(f"token {k} differs from the current {k}")
+    if selfcheck_path and (not os.path.isfile(selfcheck_path) or S1.sha_file(selfcheck_path) != tok.get("selfcheck_sha256")):
+        p.append("selfcheck.json differs from the token's")
+    return p
+
+
+# ---- mint and run ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+def _inputs(a, kind, seed, out):
+    frozen = os.path.join(a.inputs, "frozen", "argvs_obd.json")
+    h2_init = os.path.join(a.inputs, "tfar", f"h2_init_{seed}.pt")
+    toks = render(kind, seed, a.inputs, out, os.path.join(a.inputs, "strat1", "navtext_nav.npz"), os.path.join(a.inputs, "ckpt120", "rc120_table.npz"),
+                  os.path.join(a.inputs, "ckpt120", "navtext_nav_s.npz"), base_argvs=frozen, cache_dir=a.cache_dir, h2_init=h2_init)
+    if a.steps != RUN_STEPS:
+        toks = S1._with(toks, steps=a.steps)
+    return toks, frozen, os.path.join(a.inputs, "ckpt120", NAV_S_REPORT)
+
+
+def mint(tag, kind, seed, a):
+    """Mint ``<runs>/<tag>/gate/gate_token.json``. Returns the list of problems (empty = token written)."""
+    rd = os.path.join(a.runs, tag)
+    gd = os.path.join(rd, "gate")
+    out = os.path.join(rd, "train")
+    os.makedirs(gd, exist_ok=True)
+    toks, frozen, nsr = _inputs(a, kind, seed, out)
+    json.dump(toks, open(os.path.join(rd, "argv.json"), "w", encoding="utf-8"))
+    b, bad = binding(kind, toks, a.root, a.commit, a.suite, nav_s_report=nsr)
+    if bad:
+        return ["binding: " + x for x in bad]
+    trainer = os.path.join(a.root, TRAINER_REL)
+    env = {"PYTHONPATH": os.path.join(a.root, "stack") + os.pathsep + a.root, "CUDA_VISIBLE_DEVICES": a.gpu, "HF_HUB_DISABLE_XET": "1"}
+    checks = {"G-SUITE": {"pass": True, "result_sha256": b["gsuite_result_sha256"]}, "frozen_argvs_sha256": {"pass": True, "sha256": S1.sha_file(frozen)}}
+    h = hyg() + C.hyg() + S1.hyg()
+    checks["G-HYG"] = {"pass": not h, "problems": h}
+    checks["G-CLOCK"] = {"pass": True, "nav_s_report_sha256": b["nav_s_report_sha256"], "note": "G-CLOCK-NAV-S read from the builder report; G-CLOCK-TFAR is read from tfar_probe (G-LIVE); the RC-A120 label clock is K-LABEL (the table's own report, bound by its sha256)"}
+    gsc = os.path.join(gd, "selfcheck_run")
+    shutil.rmtree(gsc, ignore_errors=True)
+    glog = os.path.join(gd, "gate.log")
+    rc = S1._run(a.py, trainer, S1._with(toks, out=gsc) + ["--selfcheck-only"], a.root, env, glog)
+    scp = os.path.join(gsc, "selfcheck.json")
+    if rc != 0 or not os.path.isfile(scp):
+        return [f"the trainer's --selfcheck-only exited rc={rc} and {'wrote' if os.path.isfile(scp) else 'did not write'} selfcheck.json (log {glog})"]
+    shutil.copy2(scp, os.path.join(gd, "selfcheck.json"))
+    sc = json.load(open(scp, encoding="utf-8"))
+    gp = gate_problems(kind, toks, sc, a.steps)
+    checks["G-DVB"] = {"pass": sc.get("declared_vs_built") == "PASS" and not gp, "declared_vs_built": sc.get("declared_vs_built"), "problems": gp}
+    checks["G-LIVE"] = {"pass": bool((sc.get("live") or {}).get("pass")) and not gp, "problems": gp, "groups_grad": (sc.get("live") or {}).get("groups_grad"), "tfar_probe": sc.get("tfar_probe"), "ckpt120_probe": sc.get("ckpt120_probe")}
+    short = os.path.join(gd, "short")
+    shutil.rmtree(short, ignore_errors=True)
+    st = S1._with(toks, out=short, steps=4, ckpt_every=2, log_every=1)
+    slog = os.path.join(gd, "short.log")
+    import torch
+    rc1 = S1._run(a.py, trainer, st, a.root, {**env, "V8F_TRAIN_CRASH_AT": "3"}, slog)
+    ck = os.path.join(short, "ckpt_last.pt")
+    ok1 = rc1 != 0 and os.path.isfile(ck)
+    step1 = torch.load(ck, map_location="cpu", weights_only=False).get("step") if ok1 else None
+    rc2 = S1._run(a.py, trainer, st, a.root, env, slog) if ok1 else -1
+    ckrec = {"crash_rc": rc1, "resume_rc": rc2, "step_at_crash_ckpt": step1}
+    if ok1 and rc2 == 0:
+        c1 = torch.load(ck, map_location="cpu", weights_only=False)
+        ckrec["final_step"] = c1.get("step")
+        sd = c1["model"]
+        torch.save(sd, os.path.join(gd, "rt.pt"))
+        rt = torch.load(os.path.join(gd, "rt.pt"), map_location="cpu", weights_only=False)
+        eq = set(rt) == set(sd) and all(torch.equal(rt[k], sd[k]) for k in sd)
+        os.remove(os.path.join(gd, "rt.pt"))
+        ckrec["roundtrip_bit_equal"] = bool(eq)
+        init_sd = torch.load(S1.flag_value(toks, "--init-ckpt"), map_location="cpu", weights_only=False)["model"]
+        mv = moved_identity(init_sd, sd, kind)
+        ckrec["moved_identity_problems"] = mv
+        ge, rec = geval(ck, sc.get("levers"))
+        checks["G-EVAL"] = {"pass": not ge, "problems": ge, **rec, "scope": "strict load through the evaluator build path, built TFAR levers == selfcheck levers, regression arms (cfg drops t_far / nav_strat_t) refused; the window-batch parity of the TFAR wrappers is their own test"}
+        checks["G-CKPT"] = {"pass": bool(eq) and not mv and ckrec.get("final_step") is not None and step1 is not None and int(ckrec["final_step"]) > int(step1), **ckrec}
+    else:
+        checks["G-EVAL"] = {"pass": False, "problems": ["no checkpoint to load"]}
+        checks["G-CKPT"] = {"pass": False, **ckrec, "problems": ["the crash run did not leave a checkpoint, or the resume run failed (logs in the gate folder)"]}
+    shutil.rmtree(short, ignore_errors=True)                                  # own temporary data
+    shutil.rmtree(gsc, ignore_errors=True)
+    failed = [c for c in REQUIRED_CHECKS if not (checks.get(c) or {}).get("pass")]
+    json.dump(checks, open(os.path.join(gd, "checks.json"), "w", encoding="utf-8"), indent=1)
+    if failed:
+        return [f"check {c} did not pass: {json.dumps(checks.get(c))[:600]}" for c in failed]
+    write_token(os.path.join(gd, "gate_token.json"), b, checks, S1.sha_file(os.path.join(gd, "selfcheck.json")))
+    return []
+
+
+def run_arm(tag, kind, a):
+    """The runner: REFUSE unless the token binds exactly the argv on disk, the commit, every data file and the tree; then start the trainer under the same argv. Returns the process return code (2 = refused)."""
+    import subprocess
+    rd = os.path.join(a.runs, tag)
+    try:
+        toks = json.load(open(os.path.join(rd, "argv.json"), encoding="utf-8"))
+    except (OSError, ValueError):
+        print(f"REFUSED {tag}: no argv.json")
+        return 2
+    nsr = os.path.join(a.inputs, "ckpt120", NAV_S_REPORT)
+    trainer = a.trainer or os.path.join(a.root, TRAINER_REL)
+    bad = token_problems(os.path.join(rd, "gate", "gate_token.json"), kind, toks, a.root, a.commit, a.suite, os.path.join(rd, "gate", "selfcheck.json"), trainer, nsr)
+    if bad:
+        print(f"REFUSED {tag}: " + "; ".join(bad))
+        return 2
+    print(f"TOKEN-OK {tag}")
+    env = dict(os.environ)
+    env.update({"PYTHONPATH": os.path.join(a.root, "stack") + os.pathsep + a.root, "CUDA_VISIBLE_DEVICES": a.gpu, "HF_HUB_DISABLE_XET": "1"})
+    os.makedirs(os.path.join(rd, "logs"), exist_ok=True)
+    with open(os.path.join(rd, "logs", "train.log"), "ab") as lf:
+        return subprocess.run([a.py, trainer] + list(toks), cwd=a.root, env=env, stdout=lf, stderr=subprocess.STDOUT).returncode
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    seeds = sorted({s for v in ARMS.values() for s in v})
+    p = sub.add_parser("argv"); p.add_argument("kind", choices=KINDS); p.add_argument("seed", choices=seeds); p.add_argument("--root", required=True); p.add_argument("--out", required=True)
+    p.add_argument("--nav-npz", default=""); p.add_argument("--rc120-npz", default=""); p.add_argument("--nav-s-npz", default=""); p.add_argument("--h2-init", default="")
+    p = sub.add_parser("gate"); p.add_argument("kind", choices=KINDS); p.add_argument("--selfcheck", required=True); p.add_argument("--argv-json", required=True)
+    p = sub.add_parser("post"); p.add_argument("kind", choices=KINDS); p.add_argument("--init", required=True); p.add_argument("--final", required=True)
+    p = sub.add_parser("geval"); p.add_argument("--ckpt", required=True); p.add_argument("--selfcheck", default="")
+    sub.add_parser("hyg")
+    for nm in ("mint", "run"):
+        p = sub.add_parser(nm); p.add_argument("kind", choices=KINDS); p.add_argument("seed", choices=seeds)
+        p.add_argument("--root", required=True); p.add_argument("--inputs", required=True); p.add_argument("--cache-dir", required=True); p.add_argument("--runs", required=True)
+        p.add_argument("--commit", required=True); p.add_argument("--suite", required=True); p.add_argument("--steps", type=int, default=RUN_STEPS)
+        p.add_argument("--py", default=sys.executable); p.add_argument("--gpu", default="0"); p.add_argument("--trainer", default="")
+    p = sub.add_parser("suite"); p.add_argument("--base-junit", required=True); p.add_argument("--new-junit", required=True); p.add_argument("--base-commit", required=True); p.add_argument("--new-commit", required=True); p.add_argument("--out", required=True)
+    a = ap.parse_args(argv)
+    if a.cmd in ("argv", "mint", "run"):
+        try:
+            check_arm(a.kind, a.seed)
+        except ValueError as e:
+            print("REFUSED: " + str(e))
+            return 1
+    if a.cmd == "argv":
+        print(json.dumps(render(a.kind, a.seed, a.root, a.out, a.nav_npz, a.rc120_npz, a.nav_s_npz, h2_init=a.h2_init)))
+        return 0
+    if a.cmd == "gate":
+        bad = gate_problems(a.kind, json.load(open(a.argv_json, encoding="utf-8")), json.load(open(a.selfcheck, encoding="utf-8")))
+    elif a.cmd == "post":
+        import torch
+        bad = moved_identity(torch.load(a.init, map_location="cpu", weights_only=False)["model"], torch.load(a.final, map_location="cpu", weights_only=False)["model"], a.kind)
+    elif a.cmd == "suite":
+        r = suite_compare(a.base_junit, a.new_junit, a.new_commit, a.base_commit)
+        json.dump(r, open(a.out, "w", encoding="utf-8"), indent=1)
+        print(json.dumps({k: r[k] for k in ("base", "new", "n_regressions", "n_new_only")}))
+        return 0 if r["n_regressions"] == 0 else 1
+    elif a.cmd == "mint":
+        tag = arm_tag(a.kind, a.seed, a.steps)
+        bad = mint(tag, a.kind, a.seed, a)
+        print("TOKEN-WRITTEN " + tag if not bad else "REFUSED: " + "; ".join(bad))
+        return 0 if not bad else 1
+    elif a.cmd == "run":
+        return run_arm(arm_tag(a.kind, a.seed, a.steps), a.kind, a)
+    elif a.cmd == "geval":
+        bad, rec = geval(a.ckpt, json.load(open(a.selfcheck, encoding="utf-8"))["levers"] if a.selfcheck else None)
+        print(json.dumps(rec))
+    else:
+        bad = hyg()
+    print("PASS" if not bad else "REFUSED: " + "; ".join(bad))
+    return 0 if not bad else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
