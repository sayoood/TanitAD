+# ------------------------------------------------------------------------------------------------ post: the moved identity
+def _sds(kind, weight=1.0, bias=1.0, nav_w=1.0):
+    import torch
+    spec = T.SPEC[kind]
+    init = {"adapter.w": torch.zeros(2), "read_s.w": torch.zeros(2), "head_s.w": torch.zeros(2), "read_t.w": torch.zeros(2), "trunk_t.w": torch.zeros(2), "h_goal.w": torch.zeros(2), "h_lat.w": torch.zeros(2),
+            "h_lon.w": torch.zeros(2), "h_cons.w": torch.zeros(2), "read_o.w": torch.zeros(2), "head_o.w": torch.zeros(2)}
+    fin = {k: v + 1 for k, v in init.items()}
+    fin["s_far_out.weight"] = torch.ones(3, 4)
+    fin["s_far_out.bias"] = torch.ones(3)
+    fin["e_nav_s.weight"] = torch.full((8, 5), 3.0)
+    fin["e_nav_s.bias"] = torch.full((8,), 3.0)
+    if spec[0] == "on":
+        fin["e_ck_far.weight"], fin["e_ck_far.bias"] = torch.full((8, 4), weight), torch.full((8,), bias)
+    if spec[4] == "on":
+        fin["e_nav_s_t.weight"], fin["e_nav_s_t.bias"] = torch.full((8, 5), nav_w), torch.full((8,), 1.0)
+    return init, fin
+
