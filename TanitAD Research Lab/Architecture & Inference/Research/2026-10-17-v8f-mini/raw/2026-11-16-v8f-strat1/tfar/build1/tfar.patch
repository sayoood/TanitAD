+"""PREREG_V8F_TFAR (card section 4, 7, 9): ``--t-far`` / ``--t-far-lr-mult`` / ``--t-far-input`` / ``--t-far-variant`` / ``--t-far-tf`` / ``--nav-strat-t`` / ``--nav-strat-t-lr-mult`` in ``v8f_mini.py`` and ``v8f_mini_train.py``.
+
+Every default DISABLES the lever (the aedf8716 build, bit for bit, ``built_levers()`` keys included). THIS file proves reachability from the real caller (CLAUDE.md "built, tested and unreachable from its caller"): argv -> make_config -> cfg -> the BUILT
+model / optimiser groups -> declared_vs_built (bad_tfar) -> tfar_probe (selfcheck.json) -> the loss -> backward. Each mechanism has a MUTATION (ONE edit of a copy of the source) that must turn its check RED (K-REACH-c).
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+import types
+from pathlib import Path
+
+import numpy as np
+import pytest
+import torch
+
+REPO = Path(__file__).resolve().parents[2]
+for p in (REPO / "stack", REPO / "taniteval", REPO / "stack" / "scripts"):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+from tanitad.data import v8f_mini_data as D  # noqa: E402
+from tanitad.models import v8f_mini as M  # noqa: E402
+import v8f_mini_train as TR  # noqa: E402
+
+torch.set_num_threads(1)
+TINY = dict(d=32, ff=64, heads=4, n_q=2, depth_s=1, depth_t=1, depth_o=1, nb=6)
+SNAP = Path(__file__).with_name("v8f_mini_tip_snapshot_tfar.txt")
+SNAP_SHA_FILE = Path(__file__).with_name("v8f_mini_tip_snapshot_tfar.sha256")
+MODEL_P, TRAIN_P = REPO / "stack" / "tanitad" / "models" / "v8f_mini.py", REPO / "stack" / "scripts" / "v8f_mini_train.py"
+RUN = ["--synthetic", "--batch", "16", "--d", "32", "--n-q", "2", "--log-every", "1", "--warmup", "2", "--ckpt-every", "100", "--threads", "1", "--kin-mode", "yaw", "--seed", "5", "--arm", "M2b"]
+H2 = dict(s_far="on", w_ckpt_far=0.3333, nav_strat="on", detach_upper=True)           # the base of record (card section 5)
+OUT = ("ckpt", "traj30", "traj60", "goal_logits", "lat_logits", "lon_logits", "code")
+NEW_KEYS = {"e_ck_far.weight", "e_ck_far.bias", "e_nav_s_t.weight", "e_nav_s_t.bias"}
+
+
+# ------------------------------------------------------------------------------------------------ fixtures
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def write_rc120_table(path, J, seed=0):
+    N = int(J["off"][-1] + J["n"][-1])
+    rng = np.random.default_rng(seed)
+    rc = np.stack([J["rc"][:, 2, 0] * 1.5 + 1.0, J["rc"][:, 2, 1] * 1.5 + rng.normal(0, 0.1, N), J["rc"][:, 2, 2] * 1.2], -1).astype(np.float32)
+    ok = np.asarray(J["rc_ok"][:, 2]).copy()
+    np.savez(path, train_clip=np.asarray(J["clip"]).astype(str), train_off=np.asarray(J["off"]), train_n=np.asarray(J["n"]), train_rc120=rc, train_rc120_ok=ok)
+    return path
+
+
+def write_nav_s_npz(path, J, seed=1):
+    rng = np.random.default_rng(seed)
+    N = int(J["off"][-1] + J["n"][-1])
+    nav = np.zeros((N, 5), np.float32)
+    nav[np.arange(N), rng.integers(0, 3, N)] = 1.0
+    nav[:, 3] = rng.uniform(0, 3, N).astype(np.float32)
+    nav[:, 4] = 1.0
+    np.savez(path, train_clip=np.asarray(J["clip"]).astype(str), train_off=np.asarray(J["off"]), train_n=np.asarray(J["n"]), train_nav=nav, train_nav_d=(nav[:, 3] * 100).astype(np.float32))
+    return path
+
+
+@pytest.fixture(scope="module")
+def world(tmp_path_factory):
+    root = tmp_path_factory.mktemp("tfarworld")
+    w = D.make_synthetic_world(root, n_train=6, n_eval=2, T=60, seed=0)
+    J = D.load_join(Path(root) / "join_train.npz")
+    return {"root": root, "rc120": write_rc120_table(root / "rc120.npz", J), "navs": write_nav_s_npz(root / "navs.npz", J), **w}
+
+
+def joined(world, perm="off", variant="real"):
+    J = D.load_join(Path(world["root"]) / "join_train.npz")
+    J["rc120"], J["rc120_ok"], _ = D.rc120_arrays(J, world["rc120"], sha(world["rc120"]), "train", perm)
+    J["nav_s"], _ = D.nav_strat_arrays(J, world["navs"], sha(world["navs"]), "train", variant)
+    return J
+
+
+def make_batch(world, n=16, seed=0, hmax=10):
+    J = joined(world)
+    store = D.ClipStore(world["root"], "train", lru=8)
+    wins = D.train_windows(store, J, world["names"]["train"])
+    ds = D.V8FMiniWindows(store, J, wins, hmax=hmax)
+    idx = np.random.default_rng(seed).choice(len(wins), n, replace=False)
+    return D.collate([ds.item(wins[i][0], wins[i][1], 1, 3) for i in idx]), J
+
+
+def build(J, mod=M, seed=0, wake=True, **kw):
+    cfg = mod.V8FMiniConfig(**{**TINY, **kw})
+    mu, sd = M.cons_stats(J)
+    torch.manual_seed(seed)
+    m = mod.V8FMini(cfg, mod.P10Prior.synthetic(0), mu, sd)
+    if wake:
+        with torch.no_grad():
+            w = m.head_o[2].weight
+            w.copy_(torch.randn(w.shape, generator=torch.Generator().manual_seed(11)) * 0.05)
+    return m
+
+
+def run_loss(m, b, seed=3):
+    torch.manual_seed(seed)
+    return m.loss(b, p_gt=0.5, gen=torch.Generator().manual_seed(seed))
+
+
+def t_loss(m, b, seed=3):
+    """T's own loss terms alone (goal + lat + lon + cons)."""
+    T = run_loss(m, b, seed)["terms"]
+    return T["goal"] + 0.5 * (T["lat"] + T["lon"]) + m.cfg.w_cons * T["cons"]
+
+
+def gsum(y, ps):
+    g = torch.autograd.grad(y, list(ps), retain_graph=True, allow_unused=True)
+    return float(sum(float(x.abs().sum()) for x in g if x is not None))
+
+
+def S_PARAMS(m):
+    return [p for n, p in m.named_parameters() if n.startswith(("s_far_out.", "head_s.", "read_s.", "e_nav_s."))]
+
+
+def wake_layers(m, v=0.05):
+    with torch.no_grad():
+        if m.e_ck_far is not None:
+            m.e_ck_far.weight.add_(v)
+        if m.e_nav_s_t is not None:
+            m.e_nav_s_t.weight.add_(v)
+        if m.s_far_out is not None:
+            m.s_far_out.weight.add_(v)
+    return m
+
+
+def mod_from_text(text, name, path):
+    mod = types.ModuleType(name)
+    mod.__file__ = str(path)
+    sys.modules[name] = mod
+    exec(compile(text, str(path), "exec"), mod.__dict__)
+    return mod
+
+
+def tip_module():
+    return sys.modules.get("v8f_mini_tip_snapshot_tfar") or mod_from_text(SNAP.read_text(encoding="utf-8"), "v8f_mini_tip_snapshot_tfar", SNAP)
+
+
+def mutant(old, new, name="v8f_mini_mut_tfar", path=MODEL_P):
+    text = path.read_text(encoding="utf-8")
+    assert text.count(old) == 1, (old[:60], text.count(old))
+    return mod_from_text(text.replace(old, new), name, path)
+
+
+def mutant_trainer(old, new, tag):
+    text = TRAIN_P.read_text(encoding="utf-8")
+    assert text.count(old) == 1, (old[:60], text.count(old))
+    p = TRAIN_P.with_name(f"_mut_{tag}.py")
+    p.write_text(text.replace(old, new), encoding="utf-8")
+    try:
+        import importlib.util
+        spec = importlib.util.spec_from_file_location(f"_mut_{tag}", p)
+        mod = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = mod
+        spec.loader.exec_module(mod)
+        return mod
+    finally:
+        p.unlink()
+
+
+def _argv(world, tag, extra):
+    return ["--out", str(Path(world["root"]) / tag), *RUN, *extra]
+
+
+def _sc(out):
+    return json.loads((Path(out) / "selfcheck.json").read_text(encoding="utf-8"))
+
+
+def FAR(world):
+    return ["--s-far", "on", "--w-ckpt-far", "0.3333", "--s-far-lr-mult", "10", "--rc120-npz", str(world["rc120"]), "--rc120-sha256", sha(world["rc120"]),
+            "--nav-strat", "on", "--nav-strat-npz", str(world["navs"]), "--nav-strat-sha256", sha(world["navs"]), "--detach-upper"]
+
+
+def TFAR(extra=()):
+    return ["--t-far", "on", "--t-far-lr-mult", "10", *extra]
+
+
+def args(extra=()):
+    return TR.build_parser().parse_args(["--out", "x", "--d", "32", "--n-q", "2", *extra])
+
+
+def capture_far(m, b, train=True, seed=3):
+    """The ``far`` / ``far_ok`` run_t is handed (a wrapper on the instance; removed afterwards)."""
+    cap = {}
+    r = m.run_t
+    m.run_t = lambda *aa, **kk: (cap.update({k: v.detach().clone() for k, v in kk.items() if k in ("far", "far_ok")}), r(*aa, **kk))[1]
+    try:
+        if train:
+            torch.manual_seed(seed)
+            m.train()
+            cap["out_far"] = m(b, p_gt=1.0, gen=torch.Generator().manual_seed(seed))["ckpt_far"].detach().clone()
+        else:
+            m.eval()
+            with torch.no_grad():
+                cap["out_far"] = m.forward_infer(b)["ckpt_far"].detach().clone()
+    finally:
+        m.__dict__.pop("run_t", None)
+    return cap
+
