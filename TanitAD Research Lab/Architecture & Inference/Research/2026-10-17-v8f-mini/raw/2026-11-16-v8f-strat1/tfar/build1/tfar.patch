+    sys.path.insert(0, os.path.join(HERE, ".."))
+    from tanitad.models import v8f_mini as M
+    cfg = M.V8FMiniConfig(s_far="on", w_ckpt_far=0.3333, nav_strat="on", detach_upper=True, t_far="on", nav_strat_t="on")
