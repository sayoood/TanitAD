+    assert T.run_arm(r["tag"], "TF", r["a"]) == 0
+    assert json.load(open(os.path.join(r["out"], "ran_argv.json"), encoding="utf-8")) == r["toks"]
+
+
+@pytest.mark.parametrize("mut", ["argv", "kind", "commit", "data", "token_body", "tree", "checker_schema", "tfar_flag"])
+def test_the_runner_refuses_when_the_token_does_not_bind_what_is_on_disk(rig, mut):
