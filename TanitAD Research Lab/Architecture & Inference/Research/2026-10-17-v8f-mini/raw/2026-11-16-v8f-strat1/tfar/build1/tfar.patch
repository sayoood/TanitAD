+def _set(path, val):
+    def f(sc, toks):
+        d = sc
+        for k in path[:-1]:
+            d = d[k]
+        d[path[-1]] = val
+        return sc, toks
+    return f
+
+
+def _del(path):
+    def f(sc, toks):
+        d = sc
+        for k in path[:-1]:
+            d = d[k]
+        d.pop(path[-1])
+        return sc, toks
+    return f
+
+
+def _argv_set(flag, val):
+    def f(sc, toks):
+        toks = list(toks)
+        toks[toks.index(flag) + 1] = val
+        return sc, toks
+    return f
+
+
+def _argv_drop(flag):
+    def f(sc, toks):
+        toks = list(toks)
+        i = toks.index(flag)
+        return sc, toks[:i] + toks[i + 2:]
+    return f
+
