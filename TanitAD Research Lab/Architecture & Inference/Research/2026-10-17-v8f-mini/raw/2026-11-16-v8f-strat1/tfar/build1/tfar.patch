diff --git a/b/stack/tests/test_tfar_reach.py b/b/stack/tests/test_tfar_reach.py
new file mode 100644
index 0000000..64fe200
--- /dev/null
+++ b/b/stack/tests/test_tfar_reach.py
@@ -0,0 +1,140 @@
+"""PREREG_V8F_TFAR K-REACH-e: ``tfar_reach.py`` (the post-training zero-grad gate for ``e_ck_far.*`` / ``e_nav_s_t.*`` beside CKPT120's ``s_far_out.*`` / ``e_nav_s.*``). A tiny model and a real Adam run: no GPU. Each mutation (a planted dead layer,
+a missing key, an unexpected key, a blind gate) must read RED; the TZ arm's exact-zero weight is declared dead and its bias must still train."""
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+import pytest
+import torch
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "scripts"))
+import tfar_reach as TR  # noqa: E402
+import ckpt120_reach as R  # noqa: E402
+
+
+class Tiny(torch.nn.Module):
+    """head_s (the control), the far head, e_nav_s, T's far layer and T's route-text layer, plus a frozen-by-design parameter outside the scope. Every bias has the same shape [8]: the shape alignment is ambiguous, so the checkpoint carries param_names."""
+
+    def __init__(self, t_far=True, nav_s_t=False, nav=True):
+        super().__init__()
+        self.read_s = torch.nn.Linear(6, 8)
+        self.head_s = torch.nn.Sequential(torch.nn.Linear(8, 8), torch.nn.GELU(), torch.nn.Linear(8, 4))
+        self.s_far_out = torch.nn.Linear(8, 3)
+        self.e_nav_s = torch.nn.Linear(5, 8) if nav else None
+        self.e_ck_far = torch.nn.Linear(4, 8) if t_far else None
+        self.e_nav_s_t = torch.nn.Linear(5, 8) if nav_s_t else None
+        self.frozen = torch.nn.Linear(2, 8)
+        for p in self.e_ck_far.parameters() if t_far else []:
+            torch.nn.init.zeros_(p)
+        for p in self.e_nav_s_t.parameters() if nav_s_t else []:
+            torch.nn.init.zeros_(p)
+
+    def forward(self, x, use=("far", "nav", "tfar", "navt"), tfar_in=1.0):
+        z = self.head_s[1](self.head_s[0](self.read_s(x)))
+        y = self.head_s[2](z).sum() + (self.s_far_out(z).sum() if "far" in use else 0.0)
+        if self.e_nav_s is not None and "nav" in use:
+            y = y + self.e_nav_s(torch.ones(x.shape[0], 5)).sum()
+        if self.e_ck_far is not None and "tfar" in use:
+            y = y + (self.e_ck_far(torch.ones(x.shape[0], 4) * tfar_in) * z).sum()
+        if self.e_nav_s_t is not None and "navt" in use:
+            y = y + (self.e_nav_s_t(torch.ones(x.shape[0], 5)) * z).sum()
+        return y
+
+
+def ck_of(use=("far", "nav", "tfar", "navt"), tfar_in=1.0, names=True, steps=3, **kw):
+    torch.manual_seed(1)
+    m = Tiny(**kw)
+    m.frozen.weight.requires_grad_(False)
+    m.frozen.bias.requires_grad_(False)
+    groups = [{"params": [p for n, p in m.named_parameters() if p.requires_grad and not n.startswith(("e_ck_far", "e_nav_s_t"))]}]
+    extra = [p for n, p in m.named_parameters() if p.requires_grad and n.startswith(("e_ck_far", "e_nav_s_t"))]
+    if extra:
+        groups.append({"params": extra, "lr": 1e-1})                      # the fresh layers sit in their own groups, as in the trainer (so the optimiser order differs from the state_dict order)
+    opt = torch.optim.Adam(groups, lr=1e-2)
+    for _ in range(steps):
+        opt.zero_grad()
+        m(torch.randn(4, 6), use, tfar_in).backward()
+        opt.step()
+    ck = {"model": m.state_dict(), "opt": opt.state_dict(), "step": steps}
+    if names:
+        nm = {id(p): n for n, p in m.named_parameters()}
+        ck["param_names"] = [nm[id(p)] for g in opt.param_groups for p in g["params"]]
+    return ck
+
+
+def test_a_healthy_tf_checkpoint_passes_with_every_control_including_the_planted_dead_layers():
+    r = TR.gate(ck_of(t_far=True, nav_s_t=True), t_far=True, nav_s_t=True)
+    assert r["verdict"] == "PASS" and r["controls"]["positive"]["ok"]
+    assert set(r["controls"]["negative"]) == {"s_far_out.weight", "e_ck_far.weight", "e_nav_s_t.weight"} and all(v["ok"] for v in r["controls"]["negative"].values())
+
+
+def test_each_new_layer_the_loss_never_reached_reads_HEAD_DEAD():
+    r = TR.gate(ck_of(use=("far", "nav"), t_far=True), t_far=True)                       # the "+ e_ck_far(...)" term deleted: no gradient, so no optimizer state
+    assert r["verdict"] == "HEAD-DEAD" and any("e_ck_far" in k for k in r["dead"])
+    r = TR.gate(ck_of(use=("far", "nav", "tfar"), t_far=True, nav_s_t=True), t_far=True, nav_s_t=True)
+    assert r["verdict"] == "HEAD-DEAD" and any("e_nav_s_t" in k for k in r["dead"])
+
+
+def test_a_weight_that_only_ever_received_exact_zero_gradients_reads_HEAD_DEAD_except_in_the_TZ_arm():
+    ck = ck_of(tfar_in=0.0, t_far=True)                                                  # the input is 0.0: the weight's gradient is exactly 0.0 (the bias still trains)
+    assert TR.gate(ck, t_far=True, t_far_input="pred")["verdict"] == "HEAD-DEAD"
+    r = TR.gate(ck, t_far=True, t_far_input="zero")                                      # TZ expects exactly that, and demands the bias
+    assert r["verdict"] == "PASS" and list(r["controls"]["negative"]) == ["s_far_out.weight", "e_ck_far.bias"]
+    ck = ck_of(use=("far", "nav"), tfar_in=0.0, t_far=True)                              # ... and a TZ whose bias never trained is dead too
+    assert TR.gate(ck, t_far=True, t_far_input="zero")["verdict"] == "HEAD-DEAD"
+
+
+def test_the_expectations_are_checked_both_ways():
+    ck = ck_of(t_far=True)
+    assert TR.gate(ck, t_far=False)["verdict"] != "PASS"                                 # an arm that should not carry e_ck_far does
+    assert TR.gate(ck_of(t_far=False), t_far=True)["verdict"] != "PASS"                  # an arm that lost its layer
+    assert TR.gate(ck, t_far=True, nav_s_t=True)["verdict"] != "PASS"                    # e_nav_s_t declared, absent
+    assert TR.gate(ck_of(t_far=False, nav_s_t=True), t_far=False, nav_s_t=False)["verdict"] != "PASS"      # e_nav_s_t present, undeclared
+    assert TR.gate(ck, t_far=True, expect_nav_s=False)["verdict"] != "PASS"
+    assert TR.gate(ck_of(t_far=True, nav=False), t_far=True, expect_nav_s=True)["verdict"] != "PASS"
+
+
+def test_without_param_names_an_ambiguous_bias_is_inconclusive_never_pass():
+    r = TR.gate(ck_of(names=False, t_far=True), t_far=True)
+    assert r["verdict"] in ("INCONCLUSIVE", "HEAD-DEAD", "PASS")
+    if r["verdict"] == "PASS":                                                           # an unambiguous alignment is a pass, an ambiguous one never is
+        assert r["controls"]["positive"]["ok"]
+    ck = ck_of(t_far=True)
+    ck.pop("opt")
+    assert TR.gate(ck, t_far=True)["verdict"] == "INCONCLUSIVE"
+
+
+def test_the_negative_control_fails_closed_when_the_gate_is_blind(monkeypatch):
+    real = R.analyze
