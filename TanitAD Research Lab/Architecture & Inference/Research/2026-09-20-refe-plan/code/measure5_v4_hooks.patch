@@ -54,6 +54,21 @@ t3 = [t for r in v3 for t in r["targets"]]
 nc = [t["navsim_comfort"] for t in t3 if t.get("navsim_comfort") is not None]
 tc = [(t["teacher_comfort.Comfort.reward"], t["navsim_comfort"]) for t in t3
       if t.get("teacher_comfort.Comfort.reward") is not None and t.get("navsim_comfort") is not None]
+# label_version 4 (measure 5): sets carrying slowed copies, and the copies' labels beside their own sets' originals
+v4 = [r for (rk, r) in best.values() if rk[1] >= 4]
+v4c = [r for r in v4 if (r.get("slow") or {}).get("carries")]
+cp = [r["targets"][s] for r in v4c for s in r["slow"]["slots"]]
+og = [t for r in v4c for j, t in enumerate(r["targets"]) if j not in set(r["slow"]["slots"])]
+v4_src = {}
+for r in v4c:
+    v4_src[r["slow"].get("sources")] = v4_src.get(r["slow"].get("sources"), 0) + 1
+
+
+def _rate(ts, k, pos=lambda v: v > 0):
+    vals = [t.get(k) for t in ts if t.get(k) is not None]
+    return round(sum(1 for v in vals if pos(v)) / max(len(vals), 1), 4)
+
+
 ps = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True).stdout
 switched = any(l.startswith("/workspace/venv-teacher/bin/python train.py") and "--scorer-mode onpolicy" in l
                for l in ps.splitlines())
@@ -72,5 +87,12 @@ print(json.dumps({"sets": len(best), "v2": len(v2), "proposals_v2": n,
                   "teacher_comfort_mean": sum(a for a, _ in tc) / max(len(tc), 1),
                   "teacher_comfort_values": sorted({round(a, 3) for a, _ in tc})[:8],
                   "comfort_agree": sum((a >= 0.5) == (b >= 0.5) for a, b in tc) / max(len(tc), 1),
+                  "v4": len(v4), "v4_carrying": len(v4c), "v4_copies": len(cp), "v4_sources": v4_src,
+                  "v4_copy_navsim_dac_viol": _rate(cp, "navsim_dac.violation"),
+                  "v4_orig_navsim_dac_viol": _rate(og, "navsim_dac.violation"),
+                  "v4_copy_teacher_collision": _rate(cp, "collision.NuPlanCollision.info"),
+                  "v4_orig_teacher_collision": _rate(og, "collision.NuPlanCollision.info"),
+                  "v4_copy_navsim_comfortable": _rate(cp, "navsim_comfort", lambda v: v >= 0.5),
+                  "labeller_v4_running": "onpolicy_label_v4.py" in ps, "dump_emits_logits": "--emit-logits" in ps,
                   "rate_per_h": recent, "switched": switched, "switch_step": sw_step, "switch_at_utc": sw_at,
                   "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}))
