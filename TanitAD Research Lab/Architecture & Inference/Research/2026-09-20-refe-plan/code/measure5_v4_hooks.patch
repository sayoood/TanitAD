# MEASURE 5 (label_version 4) -- hooks into EXISTING files, as a patch (never edited in place: the pod's pipeline
# copies are what run, and other agents import the package). Apply from the package root:
#     git apply -p1 --check code/measure5_v4_hooks.patch && git apply -p1 code/measure5_v4_hooks.patch
# Every hook is DEFAULT OFF and byte-identical in behaviour when off:
#   refe/onpolicy_dump.py  --emit-logits : each props line also carries the scorer's [64][6] logits (the v4 labeller's
#                                          scorer_top sources); without the flag every line is unchanged
#   code/op_pipeline.sh    OP_SLOW=1     : the dump gets --emit-logits, the labellers run onpolicy_label_v4.py
#                                          --slow-copies $OP_SLOW_ARGS under the SAME worker names; OP_SLOW unset = today
#   code/op_status.py                    : ADDS v4 counters; every existing key is unchanged (tested on real v4 lines)
# Base blobs (the index at authoring time): onpolicy_dump.py d8b04f1c, op_pipeline.sh 32eed31f, op_status.py eab71534.
# Applied to pristine copies of those blobs it reproduces the patched files byte-for-byte (verified 2026-09-27).
diff --git a/code/op_pipeline.sh b/code/op_pipeline.sh
index 32eed31..0512b88 100644
--- a/code/op_pipeline.sh
+++ b/code/op_pipeline.sh
@@ -13,23 +13,36 @@ source /workspace/refe-op/code/op_env.sh
 ROOT=/workspace/data/refe_navtrain/onpolicy
 RUN=/workspace/data/refe_runs/vitl16_navtrain10_grow_tau0.3
 W0=${W0:-2}; W1=${W1:-2}
+# ⭐ MEASURE 5 (label_version 4: slowed copies of the set's own proposals) -- OFF unless OP_SLOW=1. ON: the dump also
+# writes the scorer's logits (--emit-logits) and the labellers run refe/onpolicy_label_v4.py --slow-copies $OP_SLOW_ARGS
+# under the SAME worker names, so each resumes its own in-flight chunk. The trainer is NOT touched: it reads the v4
+# sets at its next epoch boundary. Validity: eval/validate_slow_labels_v4.py; effectiveness: eval/PREREG_MEASURE5.md.
+OP_SLOW=${OP_SLOW:-0}; OP_SLOW_ARGS=${OP_SLOW_ARGS:-}
 MEM_HIGH=${MEM_HIGH:-38654705664}; MEM_LOW=${MEM_LOW:-35433480192}   # 36 / 33 GiB non-reclaimable
 mkdir -p "$OP_QUEUE" "$OP_OUT" "$ROOT/logs" "$ROOT/pids"
 say() { echo "$(date -u +%FT%TZ) $*" >> "$ROOT/logs/supervisor.log"; }
 alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
 # children are started WITHOUT setsid: nohup and nice exec, so $! IS the python's pid
 start_dump() {
+  local extra=""; [ "$OP_SLOW" = 1 ] && extra="--emit-logits"
+  # shellcheck disable=SC2086
   nohup nice -n 19 "$OP_PY" "$PKG/refe/onpolicy_dump.py" --run-dir "$RUN" --targets "$OP_BANK" \
     --images /workspace/data/navtrain_pixels --calib "$OP_BANK/calib_table.json" --queue "$OP_QUEUE" \
-    --chunk 16 --max-pending 2 >> "$ROOT/logs/dump.log" 2>&1 < /dev/null &
-  echo $! > "$ROOT/pids/dump.pid"; say "started dump pid $!"
+    --chunk 16 --max-pending 2 $extra >> "$ROOT/logs/dump.log" 2>&1 < /dev/null &
+  echo $! > "$ROOT/pids/dump.pid"; say "started dump pid $! $extra"
 }
 start_lab() {
-  nohup nice -n 19 "$OP_PY" "$PKG/refe/onpolicy_label.py" --queue "$OP_QUEUE" --out "$OP_OUT" \
-    --rank "$1" --worker "$2" >> "$ROOT/logs/label_r$1_$2.log" 2>&1 < /dev/null &
-  echo $! > "$ROOT/pids/label_r$1_$2.pid"; say "started label r$1 $2 pid $!"
+  if [ "$OP_SLOW" = 1 ]; then
+    # shellcheck disable=SC2086
+    nohup nice -n 19 "$OP_PY" "$PKG/refe/onpolicy_label_v4.py" --queue "$OP_QUEUE" --out "$OP_OUT" \
+      --rank "$1" --worker "$2" --slow-copies $OP_SLOW_ARGS >> "$ROOT/logs/label_r$1_$2.log" 2>&1 < /dev/null &
+  else
+    nohup nice -n 19 "$OP_PY" "$PKG/refe/onpolicy_label.py" --queue "$OP_QUEUE" --out "$OP_OUT" \
+      --rank "$1" --worker "$2" >> "$ROOT/logs/label_r$1_$2.log" 2>&1 < /dev/null &
+  fi
+  echo $! > "$ROOT/pids/label_r$1_$2.pid"; say "started label r$1 $2 pid $! (measure 5 $([ "$OP_SLOW" = 1 ] && echo "ON $OP_SLOW_ARGS" || echo OFF))"
 }
-say "supervisor up (pid $$): W0=$W0 W1=$W1 MEM_HIGH=$MEM_HIGH"
+say "supervisor up (pid $$): W0=$W0 W1=$W1 MEM_HIGH=$MEM_HIGH OP_SLOW=$OP_SLOW OP_SLOW_ARGS=$OP_SLOW_ARGS"
 held=0
 while [ ! -f "$ROOT/STOP" ]; do
   mem=$(awk '$1=="anon"||$1=="shmem"||$1=="kernel" {s+=$2} END {printf "%d", s}' /sys/fs/cgroup/memory.stat)
