# Scoped to this package. Pods receive these scripts by SHIPPING, not git clone, and the dev box
# runs core.autocrlf=true -- so without this, the next Windows checkout turns *.sh into CRLF and a
# shipped script dies on Linux with a carriage-return "command not found" error before it runs.
*.sh text eol=lf
*.py text eol=lf
# patches are applied with git apply on Linux pods and here; CRLF would break them (2026-09-27, measures_hooks.patch)
*.patch text eol=lf
# P7-WIRE-INTEGRATE 2026-10-22: the session reserve is sha256-pinned (launch_gate.P7_RESERVE_SHA256 == session_reserve.RESERVE_FILE_SHA256 over the LF bytes); a CRLF checkout fails the GATE's pin (closed)
# though session_reserve.load_reserve accepts it.  Keep it LF on every checkout.
refe/fixtures/p7_reserve_sessions.json text eol=lf
