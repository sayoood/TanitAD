+# ⭐ TF-N2 re-roll protocol knobs (reroll/TFN2_REROLL_HANDOFF.md). EMPTY BY DEFAULT => build_planner is bit-identical to
+# the registered teacher protocol. Keys (all optional): route_goal_min_speed_mps, route_goal_horizon_s, policy_interval_s,
+# positive_jerk_limit_when_nonnegative_acc. Set by eval/tfn2_reroll_roll.py from explicit CLI flags, never by default.
+TEACHER_OVERRIDES: dict = {}
+_PLANNER_CFG_KEYS = ("route_goal_horizon_s", "route_goal_min_speed_mps", "policy_interval_s")
+
+
+def effective_knobs(planner) -> dict:
+    """The knob values the BUILT planner will hand the engine (read from the object, not from the request)."""
+    c = planner.config
+    return {"route_goal_min_speed_mps": float(planner._feature_builder.config.route_goal_min_speed_mps),
+            "route_goal_horizon_s": float(planner._feature_builder.config.route_goal_horizon_s),
+            "policy_interval_s": float(c.policy_interval_s),
+            "positive_jerk_limit_when_nonnegative_acc": float(c.positive_jerk_limit_when_nonnegative_acc),
+            "max_jerk_long": float(c.max_jerk_long)}
+
+
+def _install_post_init_overrides(planner, ov: dict) -> None:
+    """`DriveRLNuPlanPlanner.initialize` OVERWRITES `config.positive_jerk_limit_when_nonnegative_acc` (and max_jerk_long) from the
+    release yaml on its first call (planner.py:136-147), so a build-time set is silently lost. Re-apply AFTER every initialize.
+    The controller reads the value from the trajectory's `engine_action_config` (controller.py:236-243), i.e. from this config."""
+    key = "positive_jerk_limit_when_nonnegative_acc"
+    if key not in ov:
+        return
+    orig = planner.initialize
+
+    def initialize(initialization):
+        orig(initialization)
+        setattr(planner.config, key, float(ov[key]))
+    planner.initialize = initialize
+
+
