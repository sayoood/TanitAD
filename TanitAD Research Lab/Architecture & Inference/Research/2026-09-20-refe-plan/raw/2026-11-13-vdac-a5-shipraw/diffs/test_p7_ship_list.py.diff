+def run_tool(tool: Path, *a):
+    r = subprocess.run([sys.executable, str(tool), *map(str, a)], capture_output=True, text=True, encoding="utf-8", errors="replace")
+    return r.returncode, r.stdout + r.stderr
+
+
+def mutant(tmp: Path, name: str, old: str, new: str) -> Path:
+    """A copy of the tool with ONE line changed (the old text must occur exactly once)."""
+    src = TOOL.read_text(encoding="utf-8")
+    assert src.count(old) == 1, (name, src.count(old))
+    p = tmp / f"mut_{name}" / "p7_ship_list.py"
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(src.replace(old, new), encoding="utf-8")
+    return p
