+def _stat_lines(dirpath: str, rel_prefix: str, names: list) -> tuple:
+    """([`relpath\\tsize\\n`...], total bytes) of `names` in `dirpath`.  os.stat FOLLOWS symlinks, like Path.stat() did; it raises the same errors."""
