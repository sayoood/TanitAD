+def pair_refusals(a):
+    """SCORER1 levers named inconsistently never start (the trainer's own refusals, like epo_refusals)"""
+    out = []
+    names = [h for h in a.pair_heads.split(",") if h]
+    bad = [h for h in names if h not in PAIR_HEADS]
+    if bad:
