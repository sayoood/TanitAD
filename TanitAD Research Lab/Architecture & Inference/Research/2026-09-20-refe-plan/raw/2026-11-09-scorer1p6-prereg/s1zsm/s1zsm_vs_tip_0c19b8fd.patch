+HEADS = ("NC", "DAC", "TTC")
+NOISE = {"sigma": 0.0, "gen": None}      # seeded additive noise on the score logits of EVERY forward pass (unused here: sigma 0)
+SPEEDS = [8.3, 7.7, 8.0, 8.0, 8.0, 8.2, 8.0, 8.0]
+LAT = [0.0, 0.0, 0.1, 0.2, 0.3, 0.4, 0.15, 30.0]
