+    return L.profile_refusals(prof, argv)
+
+
+def has(rs, needle):
+    return any(needle in r for r in rs)
+
+
+def swap(argv, flag, *vals):
+    out, i, done = [], 0, False
+    while i < len(argv):
+        if argv[i] == flag:
+            out += [flag] + list(vals)
+            done = True
+            i += 1
+            while i < len(argv) and not argv[i].startswith("--"):
+                i += 1
+            continue
+        out.append(argv[i])
+        i += 1
+    return out if done else out + [flag] + list(vals)
+
+
+def drop(argv, flag):
+    out, i = [], 0
+    while i < len(argv):
+        if argv[i] == flag:
+            i += 1
+            while i < len(argv) and not argv[i].startswith("--"):
+                i += 1
+            continue
+        out.append(argv[i])
+        i += 1
+    return out
+
