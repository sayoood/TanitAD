+(0.0 * S.TwinLoss(["NC"], BIG, 8, speed_neutral=True).term(scorer(feat), tg, cxy, cm, torch.tensor([10.0]))).backward()
+assert float(scorer.weight.grad.abs().sum()) == 0.0 and float(scorer.bias.grad.abs().sum()) == 0.0, "weight 0: EXACTLY 0.0"
+print("T4(iii,iv) ok")
