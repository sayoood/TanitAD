+print("R3 ok (refe_s1z_p6 = %s..., refe_scorer1p6 = %s..., rep_p6 = %s..., rep_s1z_p6 = %s...)" % (fp("refe_s1z_p6")[:16], fp("refe_scorer1p6")[:16], fp("refe_rep_p6")[:16], fp("refe_rep_s1z_p6")[:16]))
