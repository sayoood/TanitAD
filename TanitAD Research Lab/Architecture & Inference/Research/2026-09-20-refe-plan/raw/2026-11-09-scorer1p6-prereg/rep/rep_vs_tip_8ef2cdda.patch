+[ "$FAM" = s1z ] && NEED="$NEED refe/s1z_pod.sh refe/s1z_layer.py refe/test_s1z_loss.py refe/test_s1z_gate.py refe/test_s1z_preflight.py refe/test_s1z_layer.py"
