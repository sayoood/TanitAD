+    def save_partial(self, path):
+        """Scratch Stage 0: a crash-safe snapshot of the rows so far (written beside, then renamed over)."""
+        tmp = path + ".tmp.npz"
+        np.savez(tmp, log=np.asarray([k[0] for k in self.keys]), token=np.asarray([k[1] for k in self.keys]),
+                 step=np.asarray([k[2] for k in self.keys], np.int64), rank=np.asarray([k[3] for k in self.keys], np.int64),
+                 ckpt_step=np.asarray(self.ckpts, np.int64), **{"scores_" + arm: np.concatenate(self.chunks[arm], 0) for arm in self.ARMS})
+        os.replace(tmp, path)
+
+    def load_partial(self, path):
+        """-> rows restored; the inverse of save_partial."""
+        with np.load(path, allow_pickle=False) as z:
+            self.keys = [(str(l), str(t), int(s), int(r)) for l, t, s, r in zip(z["log"], z["token"], z["step"], z["rank"])]
+            self.ckpts = [int(c) for c in z["ckpt_step"]]
+            self.chunks = {arm: [z["scores_" + arm].astype(np.float64)] for arm in self.ARMS}
+        return len(self.keys)
+
 
