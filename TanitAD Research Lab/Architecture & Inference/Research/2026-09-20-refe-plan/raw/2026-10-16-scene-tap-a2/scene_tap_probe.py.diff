+def parse_filter(text, cast, name: str):
+    """'V,S' -> ('V','S'); None / '' -> None (= no filter).  A malformed or unknown value is refused loudly, never skipped."""
+    if text is None or str(text).strip() == "":
+        return None
+    out = []
+    for tok in str(text).split(","):
+        tok = tok.strip()
+        try:
+            out.append(cast(tok))
+        except (ValueError, TypeError):
+            raise GuardFailed(f"--{name}: cannot parse {tok!r}")
+    if len(set(out)) != len(out):
+        raise GuardFailed(f"--{name}: duplicate entries in {text!r}")
+    return tuple(out)
+
+
+def filter_units(order, arms=None, seeds=None):
+    """The units of `order` whose arm is in `arms` AND whose seed is in `seeds` (None = no restriction), original order kept."""
+    return [u for u in order if (arms is None or u[0] in arms) and (seeds is None or u[1] in seeds)]
+
+
+def guard_unit_plan(sel, order, arms, seeds) -> None:
+    """The selection is re-derived INDEPENDENTLY (arm x seed x fold product over the declared ARMS / SEEDS) and must equal `sel`: same set, no duplicates, `order`'s relative order,
+    non-empty; no filter at all must give `order` itself.  An unknown arm, or a seed that selects nothing, is refused."""
+    if arms is not None:
+        bad = [a for a in arms if a not in ARMS]
+        if bad:
+            raise GuardFailed(f"--arms: unknown arm(s) {bad}; known {sorted(ARMS)}")
+    want = {(a, s, f) for a in (arms if arms is not None else tuple(ARMS)) for s in SEEDS[a] if (seeds is None or s in seeds) for f in range(K_FOLDS)}
+    if not want:
+        raise GuardFailed(f"the filter --arms {arms} --seeds {seeds} selects no unit")
+    if len(sel) != len(set(sel)):
+        raise GuardFailed("the unit plan has duplicate units")
+    if set(sel) != want:
+        raise GuardFailed(f"the unit plan ({len(sel)} units) is not the filter's {len(want)}-unit product (extra {sorted(set(sel) - want)[:2]}, missing {sorted(want - set(sel))[:2]})")
+    if list(sel) != [u for u in order if u in want]:
+        raise GuardFailed("the unit plan does not keep the committed unit order")
+    if arms is None and seeds is None and list(sel) != list(order):
+        raise GuardFailed("no filter must give the full committed grid, unchanged")
+
+
+def plan_units(arms=None, seeds=None, order=None):
+    """-> the list of (arm, seed, fold) units to run.  Default (no filter) = UNIT_ORDER (the 35-unit grid)."""
+    order = UNIT_ORDER if order is None else order
+    sel = filter_units(order, arms, seeds)
+    guard_unit_plan(sel, order, arms, seeds)
+    return sel
+
