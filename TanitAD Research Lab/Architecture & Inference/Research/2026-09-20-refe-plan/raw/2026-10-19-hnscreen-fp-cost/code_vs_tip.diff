+        rc, out = cli("verify", PFc, ["--token", str(token or w.tokp), "--args-file", str(argf or w.argf), "--pkg", str(pkg), "--key-file", str(keyf), "--json", str(rec)] + (w.ctx if ctx is None else ctx))
