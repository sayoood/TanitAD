+        anc = {"doc": doc, "sha256": sha}
+        fp = {"path": cache, **GT.anchor_fingerprint(cache, anc)}
+        if end == "void":
+            p = os.path.join(cache, "units", "u0.bin")
+            st = os.stat(p)
+            with open(p, "r+b") as f:
