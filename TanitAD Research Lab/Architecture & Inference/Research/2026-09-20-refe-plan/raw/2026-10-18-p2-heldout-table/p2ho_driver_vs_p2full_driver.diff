+def pick_from_logits(logits, dtype=np.float64):
+    x = np.asarray(logits, dtype)
+    p = 1.0 / (1.0 + np.exp(-x))
+    agg = p[..., 0] * p[..., 1] * (5 * p[..., 2] + 5 * p[..., 3] + 2 * p[..., 4]) / 12.0
+    return agg.argmax(-1)
