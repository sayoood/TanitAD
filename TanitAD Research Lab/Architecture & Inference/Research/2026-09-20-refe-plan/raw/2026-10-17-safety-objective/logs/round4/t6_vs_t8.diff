+def resolve(flips, cases):
+    """the set of case names a mutation must flip: the markers expand against the cases (and every explicit name must be a case, so a typo cannot hide a missing flip)."""
+    names = {c.name for c in cases}
+    out = set()
+    for f in ({flips} if isinstance(flips, str) else flips):
+        if f == OPEN:
+            out |= {c.name for c in cases if c.want}
+        elif f == GENUINENESS:
+            out |= {c.name for c in cases if c.need}
+        elif f == STALE:
+            out |= {c.name for c in cases if c.need == {R_STALE}}
+        else:
+            assert f in names, f"unknown case {f!r} in a mutation's expected flips"
+            out.add(f)
+    return out
+
+
+def flipped(case, ok, why, mode):
+    if ok is not case.want:
+        return True
+    return mode == "outcome" and not ok and classes_of(why) != case.need
+
+
+def keys_of(o):
+    """every dict key anywhere in a JSON value"""
+    if isinstance(o, dict):
+        return set(o) | set().union(*(keys_of(v) for v in o.values())) if o else set()
+    if isinstance(o, list):
+        return set().union(*(keys_of(v) for v in o)) if o else set()
+    return set()
