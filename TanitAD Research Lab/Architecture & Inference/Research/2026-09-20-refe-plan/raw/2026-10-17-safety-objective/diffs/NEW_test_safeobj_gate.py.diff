+def judge(case, ok, why):
+    """-> the list of ways this outcome differs from what the case exists for (empty = as designed)."""
+    out = []
+    if ok is not case.want:
+        out.append(f"{'opened' if ok else 'refused'} (wanted {'open' if case.want else 'refusal'}): {why[:200]}")
+    elif not case.want:
+        if classes_of(why) != case.need:
+            out.append(f"refused for the WRONG reason class(es): got {sorted(classes_of(why))}, wanted {sorted(case.need)}: {why[:300]}")
+        out.extend(f"reason lacks {s!r}: {why[:300]}" for s in case.says if s not in why)
+    return out
+
+
+# ---------------------------------------------------------------------------------------------------------------------------------------------- the mutations of the gate / reader
+G_TOOL, G_HASH = '        if rec.get("tool") != SO.TOOL:\n', '        if rec.get("record_sha256") != SO.record_digest(rec):\n'
+G_SHA, G_MISSING = "            elif SO.sha256_file(fp) != want:\n", '                why.append(f"input {name!r} is missing")\n'
+G_REQ, G_INS = "            if name not in ins:\n", '            why.append("inputs_sha256 is missing or not an object")\n'
+G_REREAD = "            diff = SO.differing_fields(rec, SO.read_arm(d))\n"
+R_STAMP = '    out["record_sha256"] = record_digest(out)                                # stamped last; the gate recomputes it with the same function\n'
+R_VOL = "VOLATILE_FIELDS = ()"
+OPEN, GENUINENESS, STALE = "<every case the real gate opens>", "<every case refused in the genuineness layer>", "<every case refused as stale>"      # markers, resolved against the cases
+MUTATIONS = [   # (name, gate edits, reader edits, mode, the cases that must FLIP and nothing else)
+    # mode "verdict": a flip is a change of the gate's verdict.  mode "outcome": a flip is a change of the verdict OR of the reason class(es) -- for the barriers the re-read now backs up (the re-read refuses
+    # what the removed specific check used to refuse, so the verdict alone does not move, but the REASON does: it becomes "stale")
+    ("the gate looks at S alone (the old gate)", [("            why = safeobj_not_genuine(d, rec)\n", '            why = ""\n')], [], "verdict", GENUINENESS),
+    ("`tool` is not compared", [(G_TOOL, "        if False:\n")], [], "outcome", {"tool_changed_stamp_recomputed", "hand_written_S_PASS"}),
+    ("record_sha256 is not recomputed", [(G_HASH, "        if False:\n")], [], "outcome", {"fail_edited_to_PASS", "hand_written_S_PASS"}),
+    ("the listed input sha256s are not compared", [(G_SHA, "            elif False:\n")], [], "outcome",
+     {"input_modified_after_read", "scores_modified_after_read", "record_copied_into_another_arms_dir",
+      "verification_raises"}),            # the last one only because its poison IS sha256_file: with the call gone there is nothing left to raise there (the re-read then refuses it as stale)
+    ("a missing input file is tolerated", [(G_MISSING, "                pass\n")], [], "outcome", {"input_missing_rlval", "input_missing_scores"}),
+    ("the inputs every PASS read has are not demanded", [(G_REQ, "            if False:\n")], [], "outcome", {"hand_written_S_PASS", "forged_stamp_no_inputs", "PASS_with_inputs_not_an_object"}),
+    ("an exception while verifying opens the gate", [("        return f\"cannot verify the record ({type(e).__name__}: {str(e)[:120]})\"\n", '        return ""\n')], [], "verdict",
+     {"verification_raises", "reader_reread_raises"}),
+    ("a reader that cannot be loaded opens the gate", [("        return f\"the reader eval/safeobj_read.py cannot be loaded ({type(e).__name__}: {str(e)[:120]})\"\n", '        return ""\n')], [], "verdict", {"reader_not_on_disk"}),
+    ("S is judged by `== FAIL` instead of `!= PASS`", [('        if s != "PASS":\n', '        if s == "FAIL":\n')], [], "outcome",
+     {"genuine_NOT_READ_record", "PASS_with_a_trailing_space"}),            # the NOT_READ record is genuine and opens; the stamped "PASS " no longer stops at the S layer and is refused by the re-read instead
+    ("the gate keeps its OWN canonicalisation and it has drifted (default separators)",
+     [(G_HASH, '        if rec.get("record_sha256") != __import__("hashlib").sha256(json.dumps({k: v for k, v in rec.items() if k != "record_sha256"}, sort_keys=True).encode("utf-8")).hexdigest():\n')],
+     [], "verdict", OPEN),
+    ("the READER's canonicalisation changes (the gate follows it: one definition)",
+     [], [('    body = json.dumps({k: v for k, v in rec.items() if k != "record_sha256"}, sort_keys=True, separators=(",", ":"))\n',
+           '    body = json.dumps({k: v for k, v in rec.items() if k != "record_sha256"}, sort_keys=True, separators=(", ", ": "))\n')], "verdict", OPEN),
+    ("the reader no longer names its REQUIRED_INPUTS", [], [('REQUIRED_INPUTS = ("kill_replay.json", "rlval_vs_A0.json")', "REQUIRED_INPUTS = ()")], "outcome",
+     {"hand_written_S_PASS", "forged_stamp_no_inputs", "PASS_with_inputs_not_an_object"}),
+    # ---- round 4: the re-read
+    ("the gate does not re-read the directory (rounds 1-3 only)", [(G_REREAD, "            diff = []\n")], [], "verdict", {STALE, "reader_reread_raises"}),
+    ("the re-read compares only S", [(G_REREAD, '            diff = ["S"] if rec.get("S") != SO.read_arm(d).get("S") else []\n')], [], "verdict",
+     {"forger_edits_only_the_notes", "forger_edits_only_the_registered_bar", "monitor_rows_appear_after_the_read", "scores_appear_after_the_read"}),
+    ("the re-read compares only inputs_sha256", [(G_REREAD, '            diff = ["inputs_sha256"] if rec.get("inputs_sha256") != SO.read_arm(d).get("inputs_sha256") else []\n')], [], "verdict",
+     {"forger_PASS_for_an_arm_the_reader_judges_FAIL", "forger_rewrites_the_whole_record_and_hashes_the_inputs", "forger_edits_only_the_notes", "forger_edits_only_the_registered_bar"}),
+    ("VOLATILE_FIELDS is widened to the verdict fields", [], [(R_VOL, 'VOLATILE_FIELDS = ("S", "breaches", "problems", "notes", "bar")')], "verdict",
+     {"forger_PASS_for_an_arm_the_reader_judges_FAIL", "forger_edits_only_the_notes", "forger_edits_only_the_registered_bar"}),
+    ("the reader stamps a clock field that VOLATILE_FIELDS does not name", [], [(R_STAMP, '    out["read_at"] = 1.0\n' + R_STAMP)], "verdict", OPEN),
+]
+# every specific layer of (a)-(c) removed: the re-read ALONE
+LAYERS_OFF = [(G_TOOL, "        if False:\n"), (G_HASH, "        if False:\n"), (G_SHA, "            elif False:\n"), (G_MISSING, "                pass\n"), (G_REQ, "            if False:\n"),
+              (G_INS, "            pass\n")]
+
+
+def resolve(flips, cases):
+    """the set of case names a mutation must flip: the markers expand against the cases (and every explicit name must be a case, so a typo cannot hide a missing flip)."""
+    names = {c.name for c in cases}
+    out = set()
+    for f in ({flips} if isinstance(flips, str) else flips):
+        if f == OPEN:
+            out |= {c.name for c in cases if c.want}
+        elif f == GENUINENESS:
+            out |= {c.name for c in cases if c.need}
+        elif f == STALE:
+            out |= {c.name for c in cases if c.need == {R_STALE}}
+        else:
+            assert f in names, f"unknown case {f!r} in a mutation's expected flips"
+            out.add(f)
+    return out
+
+
+def flipped(case, ok, why, mode):
+    if ok is not case.want:
+        return True
+    return mode == "outcome" and not ok and classes_of(why) != case.need
+
+
+def keys_of(o):
+    """every dict key anywhere in a JSON value"""
+    if isinstance(o, dict):
+        return set(o) | set().union(*(keys_of(v) for v in o.values())) if o else set()
+    if isinstance(o, list):
+        return set().union(*(keys_of(v) for v in o)) if o else set()
+    return set()
+
+
+CLOCKISH = {"read_at", "time", "timestamp", "utc", "date", "host", "hostname", "pid", "cwd", "path", "dir", "argv", "at", "now"}
