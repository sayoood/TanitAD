+    def _member_set(self, zp: str) -> set:
+        if zp not in self._members:
+            z = self._open(zp)
+            try:
+                self._members[zp] = set(z.namelist()) if z is not None else set()
+            except Exception:
+                self._members[zp] = set()
+        return self._members[zp]
