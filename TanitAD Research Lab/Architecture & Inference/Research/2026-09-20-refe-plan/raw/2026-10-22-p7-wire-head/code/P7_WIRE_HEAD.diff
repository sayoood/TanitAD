+        if self._index is None:
+            idx: dict[str, str] = {}
+            if self.root and os.path.isdir(self.root):
+                for dp, _dn, fns in os.walk(self.root):
+                    for fn in fns:
+                        if fn.endswith((".jpg", ".jpeg", ".png")):
+                            idx.setdefault(fn, os.path.join(dp, fn))
+            self._index = idx
+        return self._index
