# refcv7 -- THE LAUNCH MANIFEST for stack/ops/sup_refcv7.sh (template; fill every <...>).
# ⛔ Sourced ONCE by the supervisor at startup. To change a run: a new argv is a NEW GATE RUN and a
#    new token; kill the SUPERVISOR first, then the trainer (explicit pid), then start a fresh one.
# ⛔ No TRAIN_CMD here: the supervisor REFUSES a manifest that defines one. The trainer is started
#    only as `launch_gate.py exec` on the argv the token binds.
# ⛔ OUT_DIR and STEPS are READ FROM THE GATED ARGV (--out / --steps). Do not set them here unless
#    you want the supervisor to cross-check them (a disagreement refuses the launch).
export CODE=/home/nvidia/refcv7_run/<commit10>          # git archive of COMMIT, md5-verified ship
export COMMIT=<40-char sha>                              # must equal the token's commit
PYTHON=/home/nvidia/venvs/tanitad-train/bin/python
GATE_TOKEN=/home/nvidia/refcv7_run/gate/refcv7-r101-s0/PASS_<commit12>.json
# the CANONICAL argv ships IN the commit (stack/ops/runs.d/); the token binds its `argv`
GATE_ARGV_FILE=${CODE}/stack/ops/runs.d/refcv7-r101-s0.argv.json
# GATE_KEY_FILE=<only if the gate ran with a non-default --key-file>
export OMP_NUM_THREADS=8
MAX_RELAUNCH=4
POLL_S=300
