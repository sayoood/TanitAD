                    f"the run looked healthy, first attempt ~1.8 h in (E5).")
            added = [p for p in roots if p not in sys.path]
            sys.path[:0] = [str(_REPO / "taniteval")] if added else []
            try:
                problems = T.preflight(a)
            finally:
                if added:
                    sys.path.pop(0)
