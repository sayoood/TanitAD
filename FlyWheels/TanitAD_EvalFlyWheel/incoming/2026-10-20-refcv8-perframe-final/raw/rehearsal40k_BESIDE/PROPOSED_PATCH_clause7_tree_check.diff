+def clause7_pf(pp, tree: str) -> dict:
+    """B.clause7 + the TREE check it lacks: PRIOR_PARITY.json is the one lane artifact whose name carries no tree tag, and lane() skips a stage whose
+    artifact exists, so a pf package reused across trees would hand clause (7) another tree's parity.  Every panel must be <tree>|s<seed>."""
+    c = B.clause7(pp)
+    panels = (c.get("evidence") or {}).get("panels") or []
+    foreign = sorted({str(q.get("panel", "")).split("|")[0] for q in panels} - {tree})
+    if c.get("status") == "PASS" and (not panels or foreign):
+        c = {**c, "status": "INCOMPLETE", "reason": f"PRIOR_PARITY.json covers {foreign or 'no named panel'}, not the tree {tree} (INCOMPLETE, not PASS)"}
+    return c
+
