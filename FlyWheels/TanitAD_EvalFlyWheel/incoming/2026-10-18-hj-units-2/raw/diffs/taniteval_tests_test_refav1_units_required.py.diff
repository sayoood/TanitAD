+    mutated = "\n".join(ln for ln in text.split("\n") if ln.strip() != "--action-units steer \\")
+    assert mutated != text
+    n1, bad1 = _cli_census_text(mutated, "REFAV1_ARM.md")
+    assert n1 == n0 and len(bad1) == n0, (n1, bad1)
