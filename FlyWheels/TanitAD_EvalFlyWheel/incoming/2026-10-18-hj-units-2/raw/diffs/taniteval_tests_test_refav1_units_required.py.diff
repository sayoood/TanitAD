+class _ConstHead(torch.nn.Module):
+    def __init__(self, n: int, idx: int):
+        super().__init__()
+        self.n, self.idx = n, idx
+
+    def forward(self, x):
+        out = torch.full((x.shape[0], self.n), -10.0, device=x.device, dtype=x.dtype)
+        out[:, self.idx] = 10.0
+        return out
