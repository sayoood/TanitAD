+_CLI_NEEDLE = 'ap.add_argument("--action-units", choices=("kappa", "steer"), default=None,'
+_ROLLOUT = ["--ckpt", "c.pt", "--cache", "x", "--episodes", "x", "--dump-dir", "d", "--out", "o.json"]
