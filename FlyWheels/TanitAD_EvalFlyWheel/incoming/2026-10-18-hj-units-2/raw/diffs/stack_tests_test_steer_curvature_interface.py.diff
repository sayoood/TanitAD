+
+    class _Reached(Exception):
+        pass
+
+    def _sentinel(*_a, **_k):
+        raise _Reached
+
+    monkeypatch.setattr(arm, "preflight_analysis_imports", _sentinel)
+    rollout = ["--ckpt", "c.pt", "--cache", "x", "--episodes", "x", "--dump-dir", "d",
