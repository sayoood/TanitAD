+    the REAL batch splat (the merge's R2 fix #2)."""
+    out = list(argv)
+    dep: dict[str, Any] = {"overlay": {}, "dropped": {}}
+    for f, v in (prof.get("rehearsal_overlay") or {}).items():
+        old = flag_values(out, f)
+        out = set_flag(out, f, list(v))
+        dep["overlay"][f] = {"launch": old, "rehearsal": list(v)}
+    sub = flag_values(out, "--sigreg-subspaces")
