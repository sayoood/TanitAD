+def eval_identity_v6(ctx: Ctx, T, stack, args, parser, scratch: Path, *,
+                     freeze: dict | None = None) -> tuple[list[str], dict]:
+    """G-EVAL (v6): the eval loader `tanitad.eval.v6_probe_trunk.load_v6_from_ck` (rebuild from the
+    run's OWN config["args"] + STRICT load) applied to a checkpoint in the trainer's layout. The run
+    record is the TRAINER's: `_run_config(args, stack, freeze)` -- the very builder `train()` writes
+    config.json with -- for THIS argv, through a JSON round trip (the file). On a non-rehearsal host
+    the smoke's own config.json (when present) must carry the same built levers (a control that the
+    in-process record IS the file)."""
+    import torch
+    reasons: list[str] = []
+    det: dict[str, Any] = {}
+    with contextlib.redirect_stdout(io.StringIO()):
+        config = json.loads(json.dumps(T._run_config(args, stack, freeze or {}, None), default=str))
+    rec_args = dict(config.get("args") or {})
+    det["eval_stamps"] = {"source": "the trainer's own _run_config(args, stack, freeze) for THIS "
+                                    "argv, JSON round-tripped (what train() writes as config.json)",
+                          "sha256": sha256_bytes(canonical_json(config.get("args") or {}))}
+    smoke_cfg = latest_smoke_config_v6(ctx)
+    if smoke_cfg is not None and not ctx.options.get("rehearsal"):
+        file_args = dict(read_json(smoke_cfg).get("args") or {})
+        det["eval_stamps"]["smoke_config_json"] = str(smoke_cfg)
+        rec_args_file = file_args
+    # the record must be THIS argv's: every BUILT lever of the registry must agree
+    D6, _w = import_optional(ctx, "tanitad.train.declared_vs_built_v6", "missing_dvb_v6_module")
+    built_dests = sorted(d for d, lv in (getattr(D6, "REGISTRY_V6", {}) or {}).items()
+                         if lv.kind == "built") if D6 is not None else []
+    diff = [d for d in built_dests if d in rec_args and
+            json.loads(json.dumps(getattr(args, d, None), default=str)) != rec_args.get(d)]
+    if smoke_cfg is not None and not ctx.options.get("rehearsal"):
+        diff += [f"smoke-config:{d}" for d in built_dests if d in rec_args_file
+                 and rec_args_file.get(d) != rec_args.get(d)]
+    det["record_vs_argv_built_levers_differ"] = diff
+    if diff:
+        reasons.append(f"G-EVAL: the run record does not carry THIS argv's built levers ({diff[:8]}) "
+                       f"-- the eval rebuild would answer a different question")
+    ck_path = scratch / "g_eval_v6_trainer_layout.pt"
+    torch.save({"stack": stack.state_dict(), "opt": {}, "step": 0, "config": config}, ck_path)
+    from tanitad.eval import v6_probe_trunk as VPT
+    pat = _Patcher()
+    if arm_is(ctx, "v6_loader_drops_vocab_version"):
+        orig_ra = VPT._run_args
+
+        def ra(ck, ckpt_path=None, _o=orig_ra):
+            d = _o(ck, ckpt_path)
+            d.pop("tac_vocab_version", None)
+            return d
+        pat.set(VPT, "_run_args", ra)
+    try:
+        ck = torch.load(ck_path, map_location="cpu", weights_only=False)
+        trunk, _step = VPT.load_v6_from_ck(ck, "cpu", ckpt_path=str(ck_path), with_frame=True)
+        model_l = trunk.stack
+        det["loader"] = "tanitad.eval.v6_probe_trunk.load_v6_from_ck (strict=True)"
+    except (RuntimeError, SystemExit, KeyError) as e:
+        pat.restore()
+        return reasons + [f"the v6 eval loader FAILED to rebuild the trained model: "
+                          f"{type(e).__name__}: {str(e)[:500]}"], det
+    finally:
+        pat.restore()
+    dt, dl = state_digests(stack.state_dict()), state_digests(model_l.state_dict())
+    diff = sorted(k for k in set(dt) & set(dl) if dt[k] != dl[k])
+    det["state_dict"] = {"n_trainer": len(dt), "n_loader": len(dl), "n_differ": len(diff),
+                         "differ": diff[:12], "only_trainer": sorted(set(dt) - set(dl))[:12],
+                         "only_loader": sorted(set(dl) - set(dt))[:12]}
+    if set(dt) != set(dl) or diff:
+        reasons.append(f"state_dict: {len(diff)} tensor(s) differ, key sets "
+                       f"{'equal' if set(dt) == set(dl) else 'DIFFER'}")
+    cfg_t, cfg_l = stack.cfg.to_dict(), model_l.cfg.to_dict()
+    cdiff = sorted(k for k in set(cfg_t) | set(cfg_l) if cfg_t.get(k) != cfg_l.get(k))
+    det["v6_config_differ"] = cdiff[:20]
+    if cdiff:
+        reasons.append(f"the loader's V6Config differs from the trainer's on {cdiff[:8]} (a lever "
+                       f"that lives in the config, not in a tensor)")
+
+    def fwd(model):
+        was = model.training
+        model.eval()
+        try:
+            b = model.synthetic_batch(1, seed=1234)
+            with torch.random.fork_rng(devices=[]), torch.no_grad():
+                torch.manual_seed(1234)
+                return model(**b)
+        finally:
+            model.train(was)
+    t0 = time.time()
+    try:
+        o_t = output_digests(fwd(stack))
+        o_t2 = output_digests(fwd(stack))
+        o_l = output_digests(fwd(model_l))
+    except Exception as e:                                # noqa: BLE001
+        return reasons + [f"G-EVAL forward on the fixed batch raised {type(e).__name__}: {e}"], det
+    det["probe"] = {"batch": "V6Stack.synthetic_batch(1, seed=1234) -- the trainer's own forward "
+                             "contract (a real eval window is the Thor-stage upgrade)",
+                    "forward_s_each": round((time.time() - t0) / 3, 2)}
+    nd = sum(1 for k in o_t if o_t2.get(k) != o_t[k])
+    det["determinism_control_outputs_differing"] = nd
+    if nd:
+        reasons.append(f"control: the trainer model's own forward is NOT reproducible ({nd} outputs) "
+                       f"-- the trainer-vs-loader comparison is blind")
+    od = sorted(k for k in set(o_t) | set(o_l) if o_t.get(k) != o_l.get(k))
+    det["forward"] = {"n_outputs": len(o_t), "n_differ": len(od), "differ": od[:20]}
+    if od:
+        reasons.append(f"forward outputs differ on the fixed batch: {len(od)} of {len(o_t)} "
+                       f"(first: {od[:5]})")
+    if not any(not v.startswith(("py:", "type:")) for v in o_t.values()):
+        reasons.append("control: the forward produced no tensor outputs -- nothing was compared")
+    # ⚠️ NOT an emission weight: the emission's final layer is ZERO-initialised (the CV warm start,
+    # train_v58f_unicycle_head.py:205-206), so perturbing any weight UPSTREAM of it moves no output
+    # (MEASURED 2026-09-27: 0 of 52 outputs moved -- a blind control). The encoder's patch conv feeds
+    # every output.
+    p0 = next((p for n_, p in model_l.named_parameters() if n_ == "encoder.patch.weight"), None)
+    if p0 is None:
+        p0 = next(iter(model_l.parameters()))
+    with torch.no_grad():
+        saved = p0.detach().clone()
+        p0.add_(1e-2)
+    try:
+        o_p = output_digests(fwd(model_l))
+    finally:
+        with torch.no_grad():
+            p0.copy_(saved)
+    moved = sum(1 for k in o_l if o_p.get(k) != o_l[k])
+    det["negative_control_outputs_moved"] = moved
+    if moved == 0:
+        reasons.append("negative control: perturbing a planner parameter moved NO output -- the "
+                       "comparison is blind")
+    try:
+        ck_path.unlink()
+    except OSError:
+        pass
+    return reasons, det
+
+
+# ---- the smoke (G-LIVE run 1; G-CKPT runs 2 and 3) ------------------------------------------- #
+def run_smoke_v6(ctx: Ctx, T, argv: list[str], *, run_label: str, arms: bool = True) -> dict:
+    """Run the REAL `main(argv)` with OBSERVING hooks only (arms excepted, and only when `arms`):
+      * `build_trunk_optimizer` -- the trainable set, a digest of EVERY parameter at optimizer
+        construction (after --init-from and the freeze), and an `opt.step` wrapper that records, per
+        optimizer parameter, non-zero / non-finite gradients, and for `layer_str` whether `.grad` was
+        populated at all;
+      * `v6_loss_step` -- per TRAINING call: the returned term keys, finiteness, values, the bound
+        call arguments (signature defaults applied); at the FIRST call the per-term gradient reach
+        over the trainable set (`torch.autograd.grad`, retain_graph, under a forked RNG: no `.grad`
+        and no RNG side effect);
+      * `FlagshipWindowDataset.__getitem__` -- the (ep_idx, t_last) of every drawn window: the DATA
+        POSITION, per step;
+      * `load_resume` -- the post-load digests (G-CKPT)."""
+    import inspect
+    import torch
+    import train_flagship4b as TF4
+    rec: dict[str, Any] = {"label": run_label, "steps": [], "draws": [], "grads": {}, "exit": None,
+                           "layer_str_grad_populated": {}, "term_reach": None, "knobs": [],
+                           "post_load": None, "arm": None}
+    state: dict[str, Any] = {"stack": None, "opt": None, "trainable": [], "names": {},
+                             "pending": []}
+    pat = _Patcher()
+    orig_bto = T.build_trunk_optimizer
+    orig_loss = T.v6_loss_step
+    sig = inspect.signature(orig_loss)
+    orig_getitem = TF4.FlagshipWindowDataset.__getitem__
+    orig_resume = T.load_resume
+    orig_freeze = T.apply_stage_freeze
+
+    def freeze_wrap(stack, stage):
+        rep = orig_freeze(stack, stage)
+        if arms and arm_is(ctx, "v6_strategic_leaf_trainable"):
+            # the coordinator's arm: ONE layer_str leaf the S-T plan loss reaches (through
+            # goal_head_tac(cond=e_g_str), v6.py:5938) is made trainable AFTER the freeze
+            names = dict(stack.named_parameters())
+            leaf = next((n for n in ("vocab_str.table.weight",) if n in names), None) or next(
+                (n for n in names if stack.group_of(n) == V6_STRATEGIC_GROUP
+                 and n.startswith("goal_head_str")), None)
+            if leaf is not None:
+                names[leaf].requires_grad_(True)
+            rec["arm"] = {"v6_strategic_leaf_trainable": leaf}
+        return rep
+
+    def bto_wrap(a, stack, trainable, _o=orig_bto):
+        opt, report = _o(a, stack, trainable)
+        state["stack"], state["opt"] = stack, opt
+        names = {id(p): n for n, p in stack.named_parameters()}
+        in_opt = [p for g in opt.param_groups for p in g["params"]]
+        state["trainable"] = [(names.get(id(p), f"?{i}"), p) for i, p in enumerate(in_opt)
+                              if p.requires_grad]
+        rec["at_opt_build"] = v6_group_digests(stack)
+        rec["requires_grad_at_opt_build"] = {n: bool(p.requires_grad)
+                                             for n, p in stack.named_parameters()}
+        rec["n_trainable_tensors"] = len(state["trainable"])
+        for n_, p_ in state["trainable"]:
+            rec["grads"][n_] = {"numel": int(p_.numel()), "steps": 0, "nz_steps": 0,
+                                "nonfinite": False, "none_steps": 0,
+                                "group": stack.group_of(n_) if not n_.startswith("?") else "?"}
+        strat = [(n, p) for n, p in stack.named_parameters()
+                 if stack.group_of(n) == V6_STRATEGIC_GROUP]
+        orig_step = opt.step
+
+        def step_wrap(_self, *aa, **kk):
+            # a BOUND method: torch's LRScheduler re-wraps `opt.step.__func__` (MEASURED: a plain
+            # function attribute crashed build_lr_scheduler with "no attribute '__func__'")
+            with torch.no_grad():
+                for n_, p_ in state["trainable"]:
+                    r = rec["grads"][n_]
+                    r["steps"] += 1
+                    g = p_.grad
+                    if g is None:
+                        r["none_steps"] += 1
+                        continue
+                    if bool(torch.count_nonzero(g) > 0):
+                        r["nz_steps"] += 1
+                    if not bool(torch.isfinite(g).all()):
+                        r["nonfinite"] = True
+                for n_, p_ in strat:
+                    if p_.grad is not None:
+                        e = rec["layer_str_grad_populated"].setdefault(n_, {"steps": 0, "nz": 0})
+                        e["steps"] += 1
+                        e["nz"] += int(bool(torch.count_nonzero(p_.grad) > 0))
+            if state["pending"]:
+                rec["draws"].append(list(state["pending"]))
+                state["pending"] = []
+            return orig_step(*aa, **kk)
+        import types as _types
+        opt.step = _types.MethodType(step_wrap, opt)
+        return opt, report
+
+    def loss_wrap(stack, batch, *aa, **kk):
+        bound = sig.bind(stack, batch, *aa, **kk)
+        bound.apply_defaults()
+        if rec["post_load"] is None and state.get("resumed"):
+            rec["post_load"] = {"model": state_digests(stack.state_dict()),
+                                "opt": optimizer_digests(state["opt"].state_dict())
+                                if state["opt"] is not None else None}
+        L = orig_loss(stack, batch, *aa, **kk)
+        term_keys = [k for k in L if k not in ("loss", "log", "out")]
+        if arms and arm_is(ctx, "v6_drop_term") and term_keys:
+            # the F3-whitelist class: a term the registry declares in force silently leaves the loss
+            drop = "t1" if "t1" in term_keys else sorted(term_keys)[0]
+            L = dict(L)
+            L["loss"] = L["loss"] - L.pop(drop)
+            L["log"] = dict(L["log"], terms=sorted(k for k in term_keys if k != drop))
+            term_keys = [k for k in term_keys if k != drop]
+            rec["arm"] = {"v6_drop_term": drop}
+        vals, nonfin = {}, []
+        for k in term_keys + ["loss"]:
+            v = L[k]
+            f = float(v.detach()) if torch.is_tensor(v) else float(v)
+            vals[k] = f
+            if not math.isfinite(f):
+                nonfin.append(k)
+        rec["steps"].append({"keys": sorted(term_keys), "vals": vals, "nonfinite": sorted(nonfin)})
+        rec["knobs"].append({k: bound.arguments.get(k) for k in V6_LOSS_KNOBS})
+        if rec["term_reach"] is None and state["trainable"]:
+            rec["term_reach"] = _v6_term_reach(stack, L, term_keys, state["trainable"])
+        return L
+
+    def getitem_wrap(self, i, _o=orig_getitem):
+        item = _o(self, i)
+        try:
+            state["pending"].append((int(item["ep_idx"]), int(item["t_last"])))
+        except Exception:                                 # noqa: BLE001 -- recorded as absent
+            state["pending"].append((None, int(i)))
+        return item
+
+    def resume_wrap(stack, opt, ckpt_path, *, stage=None, _o=orig_resume):
+        if arms and arm_is(ctx, "v6_resume_drops_opt"):
+            rec["arm"] = {"v6_resume_drops_opt": "load_resume(..., opt=None)"}
+            n = _o(stack, None, ckpt_path, stage=stage)
+        else:
+            n = _o(stack, opt, ckpt_path, stage=stage)
+        state["resumed"] = True
+        rec["resumed_at"] = int(n)
+        return n
+    if arms and arm_is(ctx, "v6_nav_unbound_wm"):
+        # F7 re-introduced: the WM-loss helpers (stage_a_losses, both rollout_transitions) get the BARE
+        # operative predictor again, as before the merge's `_NavBoundPredictor` -- the operative nav
+        # path then receives no gradient in S-W (MEASURED before the fix)
+        if not hasattr(T, "_NavBoundPredictor"):
+            rec["exit"] = ("arm v6_nav_unbound_wm cannot be installed: this trainer has no "
+                           "_NavBoundPredictor (the F7 fix, the arm's premise, is absent)")
+            return rec
+        pat.set(T, "_NavBoundPredictor", lambda predictor, nav_cond: predictor)
+        rec["arm"] = {"v6_nav_unbound_wm": "train_v6_staged._NavBoundPredictor -> the bare predictor_op "
+                                           "(the pre-fix WM-loss call sites)"}
+    pat.set(T, "apply_stage_freeze", freeze_wrap)
+    pat.set(T, "build_trunk_optimizer", bto_wrap)
+    pat.set(T, "v6_loss_step", loss_wrap)
+    pat.set(T, "load_resume", resume_wrap)
+    pat.set(TF4.FlagshipWindowDataset, "__getitem__", getitem_wrap)
+    refusals: list[str] = []
+    orig_refusal = T._print_refusal
+    pat.set(T, "_print_refusal", lambda p: (refusals.append(str(p)), orig_refusal(p))[1])
+    t0 = time.time()
+    try:
+        rc = T.main(list(argv))
+        if rc not in (0, None):
+            rec["exit"] = f"main() returned {rc}: " + " | ".join(r[:300] for r in refusals[:4])
+    except SystemExit as e:
+        rec["exit"] = f"SystemExit: {str(e)[:800]}"
+    except BaseException as e:                            # noqa: BLE001 -- the verdict records it
+        rec["exit"] = f"{type(e).__name__}: {e}\n" + "".join(traceback.format_exc()[-2500:])
+    finally:
+        pat.restore()
+    rec["elapsed_s"] = round(time.time() - t0, 1)
+    if state["stack"] is not None:
+        rec["final"] = {"model": state_digests(state["stack"].state_dict()),
+                        "opt": optimizer_digests(state["opt"].state_dict()),
+                        "groups": v6_group_digests(state["stack"])}
+        rec["group_of"] = {n: state["stack"].group_of(n) for n, _ in state["stack"].named_parameters()}
+    return rec
+
+
+def _v6_term_reach(stack, L: dict, keys: list[str], trainable: list) -> dict:
+    """Per term: which trainable GROUPS its gradient reaches (autograd.grad, allow_unused; no `.grad`
+    write, forked RNG). A term that reaches nothing trainable is declared-but-inert."""
+    import torch
+    out: dict[str, Any] = {}
+    names = [n for n, _ in trainable]
+    ps = [p for _, p in trainable]
+    with torch.random.fork_rng(devices=[]):
+        for k in keys:
+            t = L[k]
+            if not (torch.is_tensor(t) and t.requires_grad):
+                out[k] = {"groups": [], "n_params": 0, "why": "no autograd graph"}
+                continue
+            gs = torch.autograd.grad(t, ps, retain_graph=True, allow_unused=True)
+            hit = [n for n, g in zip(names, gs) if g is not None and bool(torch.count_nonzero(g) > 0)]
+            out[k] = {"groups": sorted({stack.group_of(n) for n in hit}), "n_params": len(hit)}
+    return out
+
+
+def smoke_step_count_v6(T, base_argv: list[str], configured: int) -> tuple[int, int]:
+    """-> (steps, log_every). At least 2 x the LAUNCH's --log-every (a periodic row that is not the
+    final row must exist -- the refcv6 reach off-by-one), rounded UP to a multiple of it so the final
+    step writes a row (train_log.jsonl rows land at `step % log_every == 0`, :7699)."""
+    le = int(getattr(v6_parser(T).parse_args(list(base_argv)), "log_every", 1) or 1)
+    n = max(int(configured), 2 * le)
+    return int(math.ceil(n / le) * le), le
+
+
+def _v6_train_rows(run_dir: Path) -> list[dict]:
+    return [r for r in read_metrics(run_dir / "train_log.jsonl") if "loss" in r and "step" in r
+            and "run_start" not in r]
+
+
+def judge_live_v6(prof: dict, args, T, run1: dict, *, expect_steps: int, rows: list[dict],
+                  summary: dict | None, grad_reach_file: dict | None,
+                  ckpt: dict | None) -> tuple[list[str], dict]:
+    """The G-LIVE verdict for the v6 trainer (DESIGN.md §3 G-LIVE, items 1-8)."""
+    import torch
+    reasons: list[str] = []
+    det: dict[str, Any] = {"n_train_steps_seen": len(run1["steps"]), "expect_steps": expect_steps}
+    stage = str(args.stage)
+    if run1.get("exit"):
+        reasons.append(f"the smoke did not complete: {str(run1['exit'])[:600]}")
+    if not (summary and summary.get("done") is True and int(summary.get("steps", -1)) == expect_steps
+            and int(summary.get("resumed_from_step", -1)) == 0):
+        reasons.append(f"summary.json does not say done at {expect_steps} steps from step 0 (got "
+                       f"{ {k: (summary or {}).get(k) for k in ('done', 'steps', 'resumed_from_step')} })"
+                       f" -- the artifact, not an exit code, is the verdict")
+    steps = run1["steps"]
+    if len(steps) != expect_steps:
+        reasons.append(f"{len(steps)} training loss calls observed, expected {expect_steps}")
+    # (2) declared terms = the trainer's OWN effective-weight registry -------------------------
+    rows_ew, _src = T.effective_weight_rows(args)
+    decl = []
+    for r in rows_ew:
+        if r.term not in V6_TERM_KEYS:
+            reasons.append(f"the trainer's effective-weight registry has term `{r.term}` and G-LIVE "
+                           f"has no rule for it -- a new loss term cannot ship unchecked")
+            continue
+        key = V6_TERM_KEYS[r.term]
+        decl.append({"term": r.term, "key": key, "builds_graph": bool(r.builds_graph),
+                     "effective": float(r.effective), "status": r.status})
+    det["declared_terms"] = decl
+    n = max(len(steps), 1)
+    in_force = sorted({d["key"] for d in decl if d["builds_graph"] and d["key"]})
+    silent = sorted({d["key"] for d in decl if not d["builds_graph"] and d["key"]} - set(in_force))
+    per = []
+    for k in in_force:
+        present = sum(1 for s in steps if k in s["keys"])
+        bad = sum(1 for s in steps if k in s["nonfinite"])
+        per.append({"key": k, "present_steps": present, "nonfinite_steps": bad})
+        if present != len(steps) or not steps:
+            reasons.append(f"declared term `{k}` (the registry says it builds a graph at {stage}) is "
+                           f"present on only {present}/{len(steps)} training steps")
+        if bad:
+            reasons.append(f"declared term `{k}` was non-finite on {bad} step(s)")
+    for k in silent:
+        hits = sum(1 for s in steps if k in s["keys"])
+        if hits:
+            reasons.append(f"term `{k}` is in the loss on {hits} step(s) but the registry says it "
+                           f"builds NO graph at {stage} -- the declaration and the loss disagree")
+    extra = sorted({k for s in steps for k in s["keys"]} - set(in_force))
+    if extra:
+        reasons.append(f"the loss carries term(s) {extra} that no registry row declares in force")
+    det["terms"] = per
+    # the terms train() adds after v6_loss_step: their log keys on the final row
+    last_row = next((r for r in reversed(rows) if int(r.get("step", -1)) == expect_steps), None)
+    for dest, key in V6_TRAIN_ADDED_TERMS.items():
+        if float(getattr(args, dest, 0.0) or 0.0) > 0 and (last_row is None or key not in last_row):
+            reasons.append(f"--{dest.replace('_', '-')} > 0 but the final log row carries no `{key}`")
+    # (8) R6 at the loss level
+    strat = sorted({k for s in steps for k in s["keys"] if k in V6_STRATEGIC_TERMS})
+    det["strategic_terms_seen"] = strat
+    if strat:
+        reasons.append(f"R6: strategic term(s) {strat} are in the loss (the strategic layer is OFF "
+                       f"for v7F)")
+    # (3) per-term gradient reach at step 1 -------------------------------------------------------
+    tr = run1.get("term_reach") or {}
+    det["term_reach"] = tr
+    if not tr and steps:
+        reasons.append("the per-term gradient-reach probe never ran (no trainable set captured)")
+    for k, e in tr.items():
+        if not e.get("groups"):
+            reasons.append(f"term `{k}` is in force but its gradient reaches NO trainable parameter "
+                           f"at {stage} -- a term advertised in the launch line that trains nothing")
+    # (4) leaf gradients, the argv's own --allow-unreached honoured; control vs grad_reach.json ---
+    gr = run1.get("grads") or {}
+    allow = tuple(getattr(args, "allow_unreached", ()) or ())
+    leaves: dict[str, dict] = {}
+    for name, r in gr.items():
+        leaf = name.rsplit(".", 1)[0] if "." in name else name
+        e = leaves.setdefault(leaf, {"leaf": leaf, "group": r.get("group"), "params": 0, "nz": 0})
+        e["params"] += 1
+        e["nz"] += int(r["nz_steps"] > 0)
+    dead = sorted(e["leaf"] for e in leaves.values() if e["nz"] == 0)
+    ack = [d for d in dead if any(d == x or d.startswith(x + ".") for x in allow)]
+    det["grads"] = {"n_trainable_tensors": len(gr), "n_leaf_modules": len(leaves),
+                    # the top-level modules with at least one live leaf (e.g. `nav` once nav is fed)
+                    "live_top_modules": sorted({e["leaf"].split(".", 1)[0] for e in leaves.values()
+                                                if e["nz"]}),
+                    # per leaf module: [tensors with a non-zero gradient on >= 1 step, tensors]
+                    "leaf_live": {e["leaf"]: [e["nz"], e["params"]] for e in
+                                  sorted(leaves.values(), key=lambda x: x["leaf"])},
+                    "dead_leaves": dead[:40], "acknowledged_by_allow_unreached": ack,
+                    "nonfinite": sorted(n for n, r in gr.items() if r["nonfinite"])[:20]}
+    if not gr:
+        reasons.append("no trainable parameter was observed at opt.step -- the capture missed")
+    if sorted(set(dead) - set(ack)):
+        reasons.append(f"{len(set(dead) - set(ack))} declared-trainable leaf module(s) received ZERO "
+                       f"gradient over the whole smoke and are not on --allow-unreached: "
+                       f"{sorted(set(dead) - set(ack))[:10]}")
+    if det["grads"]["nonfinite"]:
+        reasons.append(f"non-finite gradients on {det['grads']['nonfinite'][:5]}")
+    if grad_reach_file is not None:
+        mine = sorted(n for n, r in gr.items() if r["none_steps"] == r["steps"] and r["steps"])
+        theirs = sorted(grad_reach_file.get("unreached_tensors") or [])
+        first_none = sorted(n for n, r in gr.items() if r.get("none_steps", 0) and r["steps"] and
+                            r["none_steps"] >= 1)
+        det["control_trainer_grad_reach"] = {"trainer_unreached": theirs[:20],
+                                             "gate_never_reached": mine[:20]}
+        if set(theirs) - set(first_none):
+            reasons.append(f"control: the trainer's grad_reach.json names unreached tensors the gate "
+                           f"saw a gradient on at step 1 ({sorted(set(theirs) - set(first_none))[:5]}) "
+                           f"-- the two instruments disagree about the same backward")
+    else:
+        reasons.append("the trainer wrote no grad_reach.json (its own P1 census) -- the control "
+                       "cannot be read")
+    # (5) R6 -- DECISIVE: every layer_str parameter bit-identical; (6) the other frozen groups -----
+    before = run1.get("at_opt_build") or {}
+    after = (run1.get("final") or {}).get("groups") or {}
+    trains = set(V6_STAGE_TRAINS.get(stage, ()))
+    extra_frozen = {g for g, f in (("encoder", "freeze_encoder"), ("readout", "freeze_readout"))
+                    if bool(getattr(args, f, False))}
+    moved_str = sorted(n for n, d in (before.get(V6_STRATEGIC_GROUP) or {}).items()
+                       if (after.get(V6_STRATEGIC_GROUP) or {}).get(n) != d)
+    ck_str_moved = []
+    if ckpt is not None and isinstance(ckpt.get("stack"), dict):
+        for n, d in (before.get(V6_STRATEGIC_GROUP) or {}).items():
+            t = ckpt["stack"].get(n)
+            if t is None or tensor_digest(t) != d:
+                ck_str_moved.append(n)
+    populated = run1.get("layer_str_grad_populated") or {}
+    det["r6"] = {"n_layer_str_tensors": len(before.get(V6_STRATEGIC_GROUP) or {}),
+                 "moved_in_memory": moved_str[:20], "differs_in_saved_ckpt": sorted(ck_str_moved)[:20],
+                 "grad_populated_tensors": len(populated),
+                 "grad_populated_nonzero": sum(1 for e in populated.values() if e["nz"]),
+                 "grad_populated_sample": sorted(populated)[:13],
+                 "_read": "(a) decisive: bit-identity at optimizer construction vs end of smoke and vs "
+                          "the smoke's own ckpt.pt; (b) reported: .grad populated (not gated)"}
+    if not before.get(V6_STRATEGIC_GROUP):
+        reasons.append("R6: no layer_str parameter was digested at optimizer construction -- the check "
+                       "read nothing")
+    if moved_str:
+        mech = ["EMA" if any(n.startswith(x) for x in V6_EMA_SUBTREES) else "optimizer"
+                for n in moved_str]
+        reasons.append(f"R6: {len(moved_str)} layer_str parameter(s) CHANGED over the smoke "
+                       f"({moved_str[:4]}; mechanism {sorted(set(mech))}) -- the strategic layer must "
+                       f"receive NO update in any v7F phase")
+    if ckpt is not None and ck_str_moved:
+        reasons.append(f"R6: the smoke's own ckpt.pt carries {len(ck_str_moved)} layer_str tensor(s) "
+                       f"different from their value at optimizer construction")
+    moved_frozen, ema_moved = [], []
+    for g, dig in before.items():
+        if g in trains and g not in extra_frozen or g == V6_STRATEGIC_GROUP:
+            continue
+        for n, d in dig.items():
+            if (after.get(g) or {}).get(n) != d:
+                (ema_moved if any(n.startswith(x) for x in V6_EMA_SUBTREES)
+                 else moved_frozen).append(f"{g}:{n}")
+    det["frozen_groups"] = {"moved": moved_frozen[:20], "ema_teacher_moved_reported": ema_moved[:20],
+                            "extra_frozen_by_flag": sorted(extra_frozen)}
+    if moved_frozen:
+        reasons.append(f"{len(moved_frozen)} parameter(s) of FROZEN groups changed over the smoke "
+                       f"({moved_frozen[:4]}) -- a frozen trunk quietly moved")
+    # (7) the loss is live and the run record agrees with the captured calls -------------------
+    losses = [s["vals"].get("loss") for s in steps if "loss" in s["vals"]]
+    det["loss_first_last"] = [losses[0], losses[-1]] if losses else None
+    if len(losses) >= 2 and len({round(float(x), 8) for x in losses}) < 2:
+        reasons.append("the total loss is CONSTANT across the smoke -- a disconnected graph")
+    det["final_row_present"] = last_row is not None
+    if last_row is None:
+        reasons.append(f"train_log.jsonl has no row at step {expect_steps}")
+    elif steps:
+        last = steps[-1]
+        if sorted(last_row.get("terms") or []) != last["keys"]:
+            reasons.append(f"the final log row's `terms` {last_row.get('terms')} != the terms the last "
+                           f"step computed {last['keys']} -- the run record would not show them")
+        a_, b_ = float(last_row.get("loss", float("nan"))), float(last["vals"].get("loss", float("nan")))
+        if not (math.isfinite(a_) and abs(a_ - b_) <= 1e-5 * max(1.0, abs(b_))):
+            reasons.append(f"control: train_log.jsonl loss {a_} vs captured {b_} -- the gate observed "
+                           f"different calls than the log")
+    # the loss-call ARGUMENTS as called vs argv (the dry-run-vs-train knob class) ----------------
+    kd = []
+    for i, kn in enumerate(run1.get("knobs") or []):
+        for k, fn in V6_LOSS_KNOBS.items():
+            want = fn(args)
+            got = kn.get(k)
+            if isinstance(got, list):
+                got = tuple(got)
+            if isinstance(want, float) or isinstance(got, float):
+                ok = got is not None and abs(float(got) - float(want)) <= 1e-12 * max(1.0, abs(float(want)))
+            else:
+                ok = got == want
+            if not ok:
+                kd.append(f"step {i + 1}: {k} called with {got!r}, argv says {want!r}")
+    det["loss_knobs_disagree"] = kd[:12]
+    if kd:
+        reasons.append(f"v6_loss_step was CALLED with arguments that differ from the argv: {kd[:3]}")
+    return reasons, det
+
+
+def judge_ckpt_v6(run1: dict, run2: dict | None, run3: dict | None, *, n: int, extra: int,
+                  ckpt: dict | None, run2_summary: dict | None, run2_config: dict | None
+                  ) -> tuple[list[str], dict]:
+    """G-CKPT (v6): save == in-memory; post-load == saved; the resumed data stream and final state ==
+    an UNINTERRUPTED run's (the data position, measured -- the v6 checkpoint carries none)."""
+    reasons: list[str] = []
+    det: dict[str, Any] = {}
+
+    def cmp(name, a, b):
+        ka, kb = set(a), set(b)
+        diff = sorted(k for k in ka & kb if a[k] != b[k])
+        det[name] = {"n": len(ka), "n_differ": len(diff), "differ": diff[:10],
+                     "only_first": sorted(ka - kb)[:10], "only_second": sorted(kb - ka)[:10]}
+        if ka != kb or diff:
+            reasons.append(f"{name}: key sets or tensors differ ({len(diff)} differ, "
+                           f"{len(ka - kb)}/{len(kb - ka)} one-sided)")
+    if ckpt is None:
+        return [f"the smoke wrote no ckpt.pt at step {n}"], det
+    det["ckpt_keys"] = sorted(ckpt)
+    miss = sorted({"stack", "opt", "step", "config"} - set(ckpt))
+    if miss:
+        reasons.append(f"ckpt.pt lacks {miss}")
+    if int(ckpt.get("step", -1)) != n:
+        reasons.append(f"ckpt.pt step {ckpt.get('step')} != {n}")
+    fin = run1.get("final")
+    if not fin:
+        return reasons + ["run 1 produced no in-memory final state"], det
+    cmp("save_model_vs_memory", fin["model"], state_digests(ckpt.get("stack") or {}))
+    ck_opt = optimizer_digests(ckpt.get("opt") or {})
+    cmp("save_opt_state_vs_memory", fin["opt"]["state"], ck_opt["state"])
+    if fin["opt"]["param_groups"] != ck_opt["param_groups"]:
+        reasons.append("save: optimizer param_groups differ from the in-memory optimizer")
+    rng_keys = sorted(k for k in ckpt if "rng" in k.lower() or "data_pos" in k.lower()
+                      or "sampler" in k.lower())
+    det["ckpt_rng_or_data_position_keys"] = rng_keys
+    if run2 is None:
+        return reasons + ["the resume run did not happen"], det
+    det["resume_exit"] = run2.get("exit")
+    if run2.get("exit"):
+        reasons.append(f"the resume run failed: {str(run2['exit'])[:400]}")
+    det["resumed_at"] = run2.get("resumed_at")
+    if run2.get("resumed_at") != n:
+        reasons.append(f"the resume run resumed at {run2.get('resumed_at')}, not at {n}")
+    pl = run2.get("post_load")
+    if not pl:
+        reasons.append("the resume run never reached a training step after load_resume")
+    else:
+        cmp("resume_model_vs_saved", fin["model"], pl["model"])
+        if pl.get("opt"):
+            cmp("resume_opt_state_vs_saved", fin["opt"]["state"], pl["opt"]["state"])
+            g1 = [{k: v for k, v in g.items() if k != "lr"} for g in fin["opt"]["param_groups"]]
+            g2 = [{k: v for k, v in g.items() if k != "lr"} for g in pl["opt"]["param_groups"]]
+            if g1 != g2:
+                reasons.append("resume: optimizer param_groups (lr excepted) differ from the saved")
+    if not (run2_summary and run2_summary.get("done") is True
+            and int(run2_summary.get("steps", -1)) == n + extra
+            and int(run2_summary.get("resumed_from_step", -1)) == n):
+        reasons.append(f"the resume run's summary.json is not done at {n + extra} resumed from {n}: "
+                       f"{ {k: (run2_summary or {}).get(k) for k in ('done', 'steps', 'resumed_from_step')} }")
+    lm = ((run2_config or {}).get("launch_mode") or {}).get("mode")
+    det["resume_config_launch_mode"] = lm
+    if lm != "resume":
+        reasons.append(f"the resume run's config.json launch_mode is {lm!r}, not 'resume'")
+    # ⭐ the data position and the continuation, MEASURED against an uninterrupted run
+    if run3 is None or run3.get("exit"):
+        reasons.append(f"the uninterrupted reference run failed: {(run3 or {}).get('exit')}")
+        return reasons, det
+    d2 = run2.get("draws") or []
+    d3 = (run3.get("draws") or [])[n:n + extra]
+    det["draws_resumed"] = d2[:extra]
+    det["draws_uninterrupted_same_steps"] = d3
+    det["draws_uninterrupted_first_steps"] = (run3.get("draws") or [])[:extra]
+    if len(d2) != extra or len(d3) != extra:
+        reasons.append(f"the draw capture read {len(d2)}/{len(d3)} steps, expected {extra} -- the "
+                       f"data-position check read nothing")
+    elif d2 != d3:
+        replay = d2 == (run3.get("draws") or [])[:extra]
+        reasons.append("resume: the batches drawn after the resume are NOT the ones an uninterrupted "
+                       "run draws at the same steps" + (
+                           " -- they are the uninterrupted run's FIRST batches: the sampler/RNG "
