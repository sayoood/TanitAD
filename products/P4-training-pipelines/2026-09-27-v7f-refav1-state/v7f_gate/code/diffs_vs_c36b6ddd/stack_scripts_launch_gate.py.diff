+def job_clock_v6(ctx: Ctx, checks: list[str]) -> dict[str, dict]:
+    """G-CLOCK (v6) -- NOT IMPLEMENTED for the v6 family yet (DESIGN.md §3 G-CLOCK: the trainer's own
+    label time `V72WindowSupervision._t_now_s` / `NavEmitter` against an independent measurement of
+    the v7F cache's clock, which does not exist yet). An unimplemented check is ERROR, never a PASS."""
+    ev = new_evidence(ctx, "G-CLOCK")
+    finish_evidence(ev, "ERROR", [
+        "G-CLOCK is not implemented for the v6 family: it needs (a) an INDEPENDENT clock reference "
+        "for the v7F cache (…-w120-256x640cyl; the refcv6 q4c reference was measured on another "
+        "extraction) and (b) the arithmetic over the trainer's own label time "
+        "(train_v6_staged.py:2563-2566 `_t_now_s`, v7_labels.py:1309 NavEmitter) -- DESIGN.md §3"])
+    return {"G-CLOCK": ev}
+
