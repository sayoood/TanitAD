+def job_model_v6(ctx: Ctx, checks: list[str]) -> dict[str, dict]:
+    """G-HYG, G-DVB, G-EVAL on the model `train()` BUILDS for this argv (stopped at the corpus seam)."""
+    import torch
+    T = load_trainer_v6(ctx)
+    out_dir = Path(ctx.out_dir)
+    scratch = out_dir / "scratch"
+    scratch.mkdir(parents=True, exist_ok=True)
+    evs = {c: new_evidence(ctx, c) for c in checks}
+    reh = bool(ctx.options.get("rehearsal"))
+    argv, arec = _v6_sentinel_argv(ctx, scratch)
+    if reh and _v6_stage(argv) == "S-T":
+        argv, prec = _v6_rehearsal_predecessor(ctx, T, argv, scratch)
+        arec["rehearsal_predecessor"] = prec
+    parser = v6_parser(T, arm=ctx.arm)
+    for ev in evs.values():
+        if reh:
+            ev["rehearsal"] = arec.get("rehearsal") or {"note": "rehearsal"}
+            ev["inputs_read"]["gate:rehearsal"] = {"kind": "rehearsal",
+                                                   "why": "tiny config + synthetic corpus (CPU host)"}
+    t0 = time.time()
+    hooks: dict[str, Any] = {}
+    pat_pf = _Patcher()
+    if reh:
+        # the trainer's preflight demands host paths the rehearsal dropped (--speed-max-sidecar-v6,
+        # --s2-labels, ...): a problem that NAMES a dropped flag is EXPECTED here and recorded; every
+        # other problem is REAL and still refuses
+        dropped = sorted(set((arec.get("rehearsal") or {}).get("dropped") or {}))
+        orig_pf = T.preflight
+
+        def pf(a_, _o=orig_pf):
+            probs = list(_o(a_))
+            exp = [p for p in probs if any(f in p for f in dropped)]
+            arec["rehearsal_preflight_expected"] = [p[:300] for p in exp]
+            return [p for p in probs if p not in exp]
+        pat_pf.set(T, "preflight", pf)
+    if arm_is(ctx, "v6_candidates_not_built"):
+        hooks["on_freeze"] = _v6_arm_candidates_not_built
+    if arm_is(ctx, "v6_undeclared_attribute"):
+        hooks["on_cfg"] = _v6_arm_undeclared
+    if arm_is(ctx, "v6_nav_not_mapped"):
+        hooks["on_cfg"] = _v6_arm_nav_not_mapped
+    try:
+        cap = run_v6_until_model(ctx, T, argv, **hooks)
+        crash = None
+    except SystemExit as e:
+        cap, crash = {"refusals": []}, f"the trainer REFUSED this argv while building: {e}"
+    except BaseException as e:                              # noqa: BLE001 -- a crash IS the verdict
+        cap, crash = {"refusals": []}, (f"the trainer CRASHED building this argv: "
+                                        f"{type(e).__name__}: {str(e)[:600]}")
+        arec["traceback"] = traceback.format_exc()[-2500:]
+    pat_pf.restore()
+    build_s = round(time.time() - t0, 1)
+    rules = v6_profile_rules(ctx.prof, list(ctx.argv))
+    if crash is None and cap.get("rc") == 2:
+        crash = ("the trainer's PREFLIGHT refused this argv: "
+                 + " | ".join(r[:300] for r in cap.get("refusals", [])[:6]))
+    if crash is None and "stack" not in cap:
+        crash = f"train() returned (rc {cap.get('rc')}) without building a stack -- the capture missed"
+    if crash is not None:
+        for c, ev in evs.items():
+            ev["details"]["argv_local"] = arec
+            finish_evidence(ev, "FAIL", ([*rules] if c == "G-DVB" else []) + [crash])
+        return evs
+    cfg, stack, args = cap["cfg"], cap["stack"], cap["args"]
+    stage = str(args.stage)
+    common = {"argv_local": arec, "build_s": build_s, "stage": stage,
+              "model_params": int(sum(p.numel() for p in stack.parameters())),
+              "freeze": {k: cap["freeze"].get(k) for k in ("trainable_groups", "n_trainable",
+                                                          "n_frozen")}}
+    # ---- G-HYG --------------------------------------------------------------------------- #
+    if "G-HYG" in evs:
+        ev = evs["G-HYG"]
+        ev["details"].update(common)
+        H, why = import_optional(ctx, "tanitad.train.config_hygiene", "missing_hygiene_module")
+        if H is None:
+            reasons, det = [f"tanitad.train.config_hygiene is not importable ({why})"], {}
+        else:
+            reasons, det = judge_hygiene(H, cfg)
+        if "on_cfg" in cap:
+            det["arm"] = cap["on_cfg"]
+        try:
+            clo = import_closure(Path(ctx.tree), ctx.prof["trainer"])
+            ir, idet = judge_import_closure(clo, ban=_arm_import_ban(ctx))
+        except Exception as e:                            # noqa: BLE001
+            ir, idet = [f"G-HYG import closure crashed: {type(e).__name__}: {e}"], {}
+        det["import_closure"] = idet
+        reasons += ir
+        ev["details"].update(det)
+        finish_evidence(ev, "FAIL" if reasons else "PASS", reasons)
+    # ---- G-EVAL -------------------------------------------------------------------------- #
+    if "G-EVAL" in evs:
+        ev = evs["G-EVAL"]
+        ev["details"].update(common)
+        try:
+            reasons, det = eval_identity_v6(ctx, T, stack, args, parser, scratch,
+                                            freeze=cap.get("freeze"))
+        except Exception as e:                            # noqa: BLE001
+            reasons, det = [f"G-EVAL crashed: {type(e).__name__}: {e}"], {
+                "traceback": traceback.format_exc()[-2500:]}
+        ev["details"].update(det)
+        finish_evidence(ev, "FAIL" if reasons else "PASS", reasons)
+    # ---- G-DVB --------------------------------------------------------------------------- #
+    if "G-DVB" in evs:
+        ev = evs["G-DVB"]
+        ev["details"].update(common)
+        for f in ("--anchor-table", "--fallback-calibration", "--init-from", "--prev-gate"):
+            if f in ctx.prof["model_input_flags"]:
+                ev["inputs_read"].update({k: v for k, v in _inputs_read(ctx, (f,)).items()})
+        reasons: list[str] = list(rules)
+        det: dict[str, Any] = {"profile_rules": rules}
+        D6, why = import_optional(ctx, "tanitad.train.declared_vs_built_v6", "missing_dvb_v6_module")
+        if D6 is None:
+            reasons.append(f"tanitad.train.declared_vs_built_v6 is not importable -- the v6 G-DVB "
+                           f"registry is not in this tree => the gate FAILS ({why})")
+        else:
+            w_stage = T._weights_from_args(args).for_stage(stage)
+            if not callable(getattr(D6, "check_all", None)) or \
+                    not callable(getattr(D6, "uncovered_v6", None)):
+                reasons.append("declared_vs_built_v6 has no check_all / uncovered_v6 (the gate-time "
+                               "API) -- API drift")
+            else:
+                try:
+                    mism = D6.check_all(stack, args, weights_in_force=w_stage, parser=parser)
+                    det["mismatches"] = [str(m)[:300] for m in mism]
+                    det["coverage_uncovered"] = list(D6.uncovered_v6(parser))
+                    det["registry_size"] = len(getattr(D6, "REGISTRY_V6", {}) or {})
+                    if hasattr(D6, "kinds_census"):
+                        det["kinds_census"] = D6.kinds_census(parser)
+                    if mism:
+                        reasons.append(f"declared_vs_built_v6: {len(mism)} mismatch(es): "
+                                       + " | ".join(str(m)[:240] for m in mism[:10]))
+                    cr, cd = v6_dvb_positive_control(D6, stack, args, parser, len(mism), w_stage)
+                    det["positive_control"] = cd
+                    reasons += cr
+                except TypeError as e:
+                    reasons.append(f"declared_vs_built_v6.check_all(stack, args, weights_in_force=, "
+                                   f"parser=) -- API drift: {e}")
+        tr, td = v6_trainability_probe(stack, stage)
+        det["trainability_probe"] = td
+        reasons += [f"G-DVB stage probe: {r}" for r in tr]
+        br, bd = v6_behaviour_probe(stack, args)
+        det["behaviour_probe"] = bd
+        reasons += [f"G-DVB behaviour probe: {r}" for r in br]
+        if "on_freeze" in cap:
+            det["arm"] = cap["on_freeze"]
+        ev["details"].update(det)
+        finish_evidence(ev, "FAIL" if reasons else "PASS", reasons)
+    del stack
+    return evs
