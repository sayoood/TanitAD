+def v6_synthetic_episodes(args, *, n_eps: int = V7F_REHEARSAL_N_EPS, seed: int = 20260927) -> list:
+    """Seeded ToyEpisodes with the trainer's episode contract (`tanitad/data/_contract.py`): uint8
+    frames [T, C, H, W] at the ENCODER's frame, a unicycle-consistent (x, y, yaw, v) pose track and
+    (steer, accel) actions. A DEDICATED generator: the run's global RNG stream is not touched."""
+    import torch
+    from tanitad.data.toy_driving import ToyEpisode
+    g = torch.Generator().manual_seed(int(seed))
+    c = int(args.in_channels)
+    h, w = int(args.frame_h), int(args.frame_w)
+    need = max(int(getattr(args, "plan_steps", 60) or 60), int(args.o1_k), int(args.o5_k),
+               int(getattr(args, "max_horizon", 0) or 0), 20,
+               int(getattr(args, "s1_multi_k", 2)) * 20)
+    n_t = int(args.window) + need + 24
+    dt = float(getattr(args, "dt", 0.1) or 0.1)
+    eps = []
+    for e in range(n_eps):
+        v = 6.0 + 4.0 * float(torch.rand((), generator=g))
+        yaw = x = y = 0.0
+        poses, acts = [], []
+        for t in range(n_t):
+            steer = 0.02 * math.sin(0.1 * t + e)
+            acc = 0.5 * math.cos(0.07 * t + 2 * e)
+            poses.append((x, y, yaw, v))
+            acts.append((steer, acc))
+            x += v * math.cos(yaw) * dt
+            y += v * math.sin(yaw) * dt
+            yaw += v * steer / 2.9 * dt
+            v = max(0.0, v + acc * dt)
+        frames = (torch.rand(n_t, c, h, w, generator=g) * 255).to(torch.uint8)
+        eps.append(ToyEpisode(frames=frames, actions=torch.tensor(acts, dtype=torch.float32),
+                              poses=torch.tensor(poses, dtype=torch.float32),
+                              episode_id=1_000_000 + e))
+    return eps
+
