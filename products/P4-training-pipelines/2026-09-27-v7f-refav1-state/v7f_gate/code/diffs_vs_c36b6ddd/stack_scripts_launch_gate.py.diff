+def _v6_rehearsal_predecessor(ctx: Ctx, T, st_argv: list[str], scratch: Path) -> tuple[list[str], dict]:
+    """REHEARSAL, S-T: the ladder seam needs a predecessor (`--init-from` + `--prev-gate`,
+    `assert_stage_precondition`). The launch's are Thor paths; the rehearsal trains its OWN tiny S-W
+    predecessor (same geometry, 1 step, synthetic corpus) and points S-T at it, with the trainer's
+    recorded INCONCLUSIVE override. Cached per argv sha in the gate dir."""
+    key = sha12(json.dumps(st_argv))
+    pdir = Path(ctx.out_dir) / "rehearsal_predecessor" / key
+    ck, gate = pdir / "ckpt.pt", pdir / "stage_gate.json"
+    argv_rec = pdir / "gate_predecessor_argv.json"
+    rec: dict[str, Any] = {"dir": str(pdir)}
+    if ck.is_file() and gate.is_file() and argv_rec.is_file():
+        rec["sw_argv"] = json.loads(argv_rec.read_text(encoding="utf-8"))   # the cached one's argv
+        rec["cached"] = True
+    if not (ck.is_file() and gate.is_file()):
+        sw = set_flag(set_flag(set_flag(_v6_predecessor_argv(st_argv), "--steps", ["1"]),
+                               "--out", [str(pdir)]), "--save-every", ["1"])
+        # ⛔ `--nav-cond` is KEPT: nav's shared embedding trains in S-W (predictor_op) and S-T may not
+        # INTRODUCE `nav.*` (STAGE_MAY_INTRODUCE) -- a nav-less predecessor is refused by the ladder
+        # seam (MEASURED on the merge, coordinator 2026-09-27)
+        sw, _ = v6_smoke_data_departure(sw)
+        rec["sw_argv"] = sw
+        corpus: dict = {}
+        with v6_corpus_seam(ctx, corpus):
+            try:
+                rc = T.main(list(sw))
+            except SystemExit as e:
+                rc = f"SystemExit: {e}"
+        rec.update(rc=rc, corpus=corpus)
+        if not (ck.is_file() and gate.is_file()):
+            raise GateError(f"the rehearsal S-W predecessor did not produce ckpt.pt + stage_gate.json "
+                            f"(rc {rc}) -- the S-T rehearsal has no ladder seam to stand on")
+        argv_rec.write_text(json.dumps(sw), encoding="utf-8")
+    out = set_flag(set_flag(st_argv, "--init-from", [str(ck)]), "--prev-gate", [str(gate)])
+    out = set_flag(out, "--allow-inconclusive-gate", [])
+    out = set_flag(out, "--gate-off-reason", ["launch-gate REHEARSAL: synthetic tiny S-W predecessor"])
+    rec["st_seam"] = {"--init-from": str(ck), "--prev-gate": str(gate),
+                      "override": "--allow-inconclusive-gate (the predecessor's gate is INCONCLUSIVE "
+                                  "by construction: no battery)"}
+    return out, rec
