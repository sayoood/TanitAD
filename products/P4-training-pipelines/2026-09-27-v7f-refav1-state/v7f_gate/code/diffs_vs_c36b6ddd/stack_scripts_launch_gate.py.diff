+# ---- G-DVB (v6): the gate's OWN behavioural probes, independent of the registry module ---------- #
+def v6_trainability_probe(stack, stage: str) -> tuple[list[str], dict]:
+    """After the trainer's freeze: the groups holding a trainable parameter must be EXACTLY the gate's
+    literal stage table (declared grad-unreachable subtrees excepted -- they are frozen by design)."""
+    from tanitad.models import v6 as V6
+    want = set(V6_STAGE_TRAINS.get(stage, ()))
+    unreach = V6.grad_unreachable_prefixes(stack) if hasattr(V6, "grad_unreachable_prefixes") else {}
+    per: dict[str, dict] = {}
+    for n, p in stack.named_parameters():
+        g = stack.group_of(n)
+        e = per.setdefault(g, {"trainable": 0, "frozen": 0})
+        e["trainable" if p.requires_grad else "frozen"] += int(p.numel())
+    got = {g for g, e in per.items() if e["trainable"] > 0}
+    det = {"stage": stage, "literal_table": sorted(want), "trainable_groups_built": sorted(got),
+           "per_group": per, "grad_unreachable_subtrees": sorted(unreach)}
+    reasons = []
+    if stage not in V6_STAGE_TRAINS:
+        reasons.append(f"stage {stage!r} has no row in the gate's literal table (R6: S-W/S-T only)")
+    if got - want:
+        reasons.append(f"the BUILT freeze leaves {sorted(got - want)} trainable in {stage}, which the "
+                       f"stage table freezes")
+    if want - got:
+        reasons.append(f"the BUILT freeze leaves NOTHING trainable in {sorted(want - got)}, which "
+                       f"{stage} is declared to train")
+    return reasons, det
+
+
+_NAV_KEYS = ("nav_token", "nav_args")
+
+
+def v6_behaviour_probe(stack, args) -> tuple[list[str], dict]:
+    """Two forwards on the trainer's own `synthetic_batch` (eval mode, forked RNG):
+      (1) the batch AS THE STACK MAKES IT (the merge draws nav keys when a conditioner is built): it must
+          RUN and emit a fan of exactly --n-candidates;
+      (2) the same batch WITHOUT nav keys: with --nav-cond it must RAISE `NavTokenMissing` (the channel
+          is mandatory once built -- `V6Stack.forward`), without it it must RUN."""
+    import torch
+    reasons: list[str] = []
+    det: dict[str, Any] = {}
+    nav = bool(getattr(args, "nav_cond", False))
+    was = stack.training
+    stack.eval()
+
+    def fwd(batch):
+        with torch.random.fork_rng(devices=[]), torch.no_grad():
+            torch.manual_seed(4321)
+            return stack(**batch)
+    try:
+        b = stack.synthetic_batch(1, seed=4321)
+        det["synthetic_batch_keys"] = sorted(b)
+        try:
+            out = fwd(b)
+            det["forward"] = "ran"
+            wp = (out.get("plan") or {}).get("waypoints") if isinstance(out, dict) else None
+            det["plan_waypoints_shape"] = list(wp.shape) if torch.is_tensor(wp) else None
+            if torch.is_tensor(wp) and wp.ndim == 4:
+                reasons += [] if int(wp.shape[1]) == int(args.n_candidates) else [
+                    f"--n-candidates {args.n_candidates} but the forward EMITS a fan of "
+                    f"{int(wp.shape[1])} (plan.waypoints {list(wp.shape)})"]
+            else:
+                reasons.append(f"the forward emitted no [B, N, S, 2] plan (got "
+                               f"{det['plan_waypoints_shape']}) -- the fan width is unreadable")
+        except Exception as e:                              # noqa: BLE001 -- judged here
+            det["forward"] = f"{type(e).__name__}: {str(e)[:160]}"
+            # ⛔ MEASURED 2026-09-27 (arm v6_candidates_not_built): a mis-built fan RAISES in the
+            # forward -- a silent probe would have passed it
+            reasons.append(f"the BUILT model's forward on the trainer's own synthetic_batch RAISED "
+                           f"{type(e).__name__}: {str(e)[:200]}")
+        b2 = {k: v for k, v in b.items() if k not in _NAV_KEYS}
+        try:
+            fwd(b2)
+            det["forward_without_nav_token"] = "ran"
+        except Exception as e:                              # noqa: BLE001 -- judged below
+            det["forward_without_nav_token"] = f"{type(e).__name__}: {str(e)[:160]}"
+        no_nav = str(det["forward_without_nav_token"])
+        if nav and no_nav == "ran":
+            reasons.append("--nav-cond is declared but a forward WITHOUT a nav token RAN: the BUILT "
+                           "model does not consume the nav command (the channel is mandatory once "
+                           "built -- V6Stack.forward raises NavTokenMissing)")
+        elif nav and not no_nav.startswith("NavTokenMissing"):
+            reasons.append(f"--nav-cond: a forward without a nav token raised {no_nav[:120]}, not "
+                           f"NavTokenMissing")
+        if not nav and no_nav.startswith("NavTokenMissing"):
+            reasons.append("no --nav-cond, yet the built model demands a nav token")
+    finally:
+        stack.train(was)
+    return reasons, det
+
+
+def v6_dvb_positive_control(D6, stack, args, parser, n_base: int, w_stage=None
+                             ) -> tuple[list[str], dict]:
+    """The registry must SEE a built change: rebuild `cand_queries` one row wider -- `check` must report
+    `--n-candidates` BUILT at exactly the new width (restored afterwards). ⚠️ Keyed on the VALUE, not
+    on a mismatch COUNT: MEASURED 2026-09-27, a count-based control read BLIND when the lever was
+    already mismatched (the count stays 1 whether the built width is 8 or 9)."""
+    import torch
+    cq = getattr(stack, "cand_queries", None)
+    if cq is None:
+        return [], {"control": "not applicable (no cand_queries)"}
+    width = int(cq.weight.shape[0]) + 1
+    try:
+        stack.cand_queries = torch.nn.Embedding(width, int(cq.weight.shape[1]))
+        ctl = D6.check_all(stack, args, weights_in_force=w_stage, parser=parser)
+    finally:
+        stack.cand_queries = cq
+    seen = [str(m)[:200] for m in ctl if getattr(m, "lever", None) == "--n-candidates"
+            and getattr(m, "built", None) == width]
+    det = {"control_widen_cand_queries_n_mismatches": len(ctl), "baseline": n_base,
+           "control_width": width, "control_seen": seen}
+    return ([] if seen else ["declared_vs_built_v6 is BLIND to a built lever: widening cand_queries "
+                             f"to {width} rows was not reported as --n-candidates BUILT {width} "
+                             "(control)"]), det
+
+
+def _v6_arm_candidates_not_built(stack) -> dict:
+    """Arm `v6_candidates_not_built`: the stack is BORN with an 8-wide fan while argv declares
+    another width (D-REFCV6-CONFIG-BUILD re-installed)."""
+    import torch
+    cq = getattr(stack, "cand_queries", None)
+    if cq is None:
+        return {"unbuilt": None, "why": "no cand_queries"}
+    n = 8 if int(cq.weight.shape[0]) != 8 else 7
+    stack.cand_queries = torch.nn.Embedding(n, int(cq.weight.shape[1]))
+    return {"cand_queries_rows_built": n, "declared": int(cq.weight.shape[0])}
