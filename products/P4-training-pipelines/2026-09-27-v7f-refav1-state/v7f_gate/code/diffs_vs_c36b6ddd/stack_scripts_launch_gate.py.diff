+def _v6_predecessor_argv(argv: list[str]) -> list[str]:
+    """A rehearsal S-T argv -> the tiny S-W argv that trains its predecessor (same geometry)."""
+    out = set_flag(argv, "--stage", ["S-W"])
+    for f in V6_SW_REFUSED:
+        out = set_flag(out, f, None)
+    return out
