+        # (:3141): an explicitly named EMPTY directory -> 0 cache clips, mode `clean` through the
+        # REAL resolution; the corpus itself comes from the synthetic seam
+        empty = Path(work) / "rehearsal_EMPTY_v2cache"
+        empty.mkdir(parents=True, exist_ok=True)
+        out = set_flag(out, "--v2-cache", [str(empty)])
+        dep["overlay"]["--v2-cache"] = {"launch": dep["dropped"].get("--v2-cache"),
+                                        "rehearsal": [str(empty)],
+                                        "why": "an EMPTY dir: the preflight requires the flag; the "
+                                               "corpus comes from the synthetic seam"}
+    dep["note"] = ("REHEARSAL: tiny geometry + synthetic corpus on a CPU host. Evidence produced "
+                   "under it NEVER counts toward a token (finalize refuses it by name).")
+    return out, dep
