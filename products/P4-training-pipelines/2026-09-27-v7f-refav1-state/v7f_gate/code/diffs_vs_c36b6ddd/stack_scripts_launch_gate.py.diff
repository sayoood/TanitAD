+def v6_smoke_data_departure(argv: list[str]) -> tuple[list[str], dict | None]:
+    """The rehearsal SMOKE removes the levers whose data the dev box cannot join to a synthetic corpus
+    (`V7F_SMOKE_DATA_LEVERS`: R1's sidecar-fed input + cap, R3's label loss). Recorded; the BUILD
+    checks keep them; their live terms are Thor's G-LIVE."""
+    hit = {f: flag_values(argv, f) for f in V7F_SMOKE_DATA_LEVERS if has_flag(argv, f)}
+    if not hit:
+        return argv, None
+    out = list(argv)
+    for f in hit:
+        out = set_flag(out, f, None)
+    return out, {"removed": hit, "why": "no labels / max-speed sidecar joinable to a synthetic "
+                                        "corpus on a CPU host: these terms are G-LIVE's on Thor"}
