+@contextlib.contextmanager
+def v6_corpus_seam(ctx: Ctx, rec: dict):
+    """REHEARSAL only -- the DATA seam. Replaced, each scoped to the rehearsal's own names:
+      * the corpus: `train_v58f_unicycle_head.build_train_episodes` (train() imports it at call time)
+        returns the synthetic episodes (parity and the geometry binding are NOT exercised -- Thor);
+      * the nav LABEL SOURCE: `join_clip_ids` on the rehearsal's EMPTY cache returns one synthetic clip
+        id per episode, and `v7_labels.load_v7_labels(V7F_REHEARSAL_NAV_LABELS)` returns one synthetic
+        record per clip (a real `LabelManifest`, `allow_oracle_nav` stamped, a token of the real nav
+        vocabulary). Everything DOWNSTREAM is the trainer's own: the count check (`assert_cache_join`),
+        the missing-clip refusal, the REAL `NavEmitter` (and its `oracle_nav` gate), the batch-dict
+        splat (the merge's R2 fix #2), the conditioner in the forward. Any other path or cache
+        falls through to the originals."""
+    import types as _types
+    import train_v58f_unicycle_head as tv58
+    import tanitad.data.v7_labels as V7L
+    T = load_trainer_v6(ctx)
+    pat = _Patcher()
+    orig_join, orig_load = T.join_clip_ids, V7L.load_v7_labels
+
+    def synth(a, *, cache_frame, train_frame):
+        eps = v6_synthetic_episodes(a)
+        rec["synthetic_corpus"] = {"n_episodes": len(eps), "frames_per_episode":
+                                   int(eps[0].frames.shape[0]), "frame_chw": list(eps[0].frames.shape[1:]),
+                                   "parity_and_geometry_binding": "NOT exercised (rehearsal)"}
+        return eps, {"rehearsal": "synthetic corpus"}
+
+    def join(a, cache_dir, _o=orig_join):
+        if Path(cache_dir).name == "rehearsal_EMPTY_v2cache":
+            return _v6_rehearsal_clip_ids()
+        return _o(a, cache_dir)
+
+    def load(path, *aa, _o=orig_load, **kk):
+        if not str(path).replace("\\", "/").endswith(V7F_REHEARSAL_NAV_LABELS):
+            return _o(path, *aa, **kk)
+        toks = tuple(V7L.NAV_TOKENS)
+        recs = [_types.SimpleNamespace(clip_id=c, _oracle={"nav_command": {
+                    "token": toks[i % len(toks)],
+                    "args": {"distance_m": 40.0 + 15.0 * i, "time_s": 4.0 + 2.0 * i}}})
+                for i, c in enumerate(_v6_rehearsal_clip_ids())]
+        man = V7L.LabelManifest(path=str(path), md5="gate-rehearsal-synthetic", n_records=len(recs),
+                                schema_version="gate-rehearsal-synthetic", vocab="v7",
+                                allow_oracle_nav=bool(kk.get("allow_oracle_nav", False)))
+        rec["synthetic_nav"] = {"n_records": len(recs), "tokens": [r._oracle["nav_command"]["token"]
+                                                                   for r in recs],
+                                "downstream": "REAL assert_cache_join / NavEmitter / oracle_nav / "
+                                              "batch splat / conditioner"}
+        return recs, man
+    pat.set(tv58, "build_train_episodes", synth)
+    pat.set(T, "join_clip_ids", join)
+    pat.set(V7L, "load_v7_labels", load)
+    try:
+        yield
+    finally:
+        pat.restore()
+
