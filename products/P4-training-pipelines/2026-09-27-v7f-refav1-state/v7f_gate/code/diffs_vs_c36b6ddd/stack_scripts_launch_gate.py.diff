+def v6_profile_rules(prof: dict, argv: list[str]) -> list[str]:
+    """The v7f profile's argv-only rules (R2, R6, SEL-1), each with its source. Re-derived in
+    `finalize` through `profile_argv_rules`."""
+    out: list[str] = []
+    name = prof["name"]
+    st = flag_values(argv, "--stage")
+    allowed = tuple(prof.get("stage_allowed", ()))
+    if not st:
+        out.append(f"--stage is required for a {name} launch")
+    elif allowed and st[0] not in allowed:
+        out.append(f"--stage {st[0]} is REFUSED for a {name} launch: {prof.get('stage_allowed_why')}")
+    stage = st[0] if st else None
+    req_on = {**(prof.get("required_on_v6") or {}),
+              **((prof.get("required_on_v6_stage") or {}).get(stage) or {})}
+    req_pos = {**(prof.get("required_positive_v6") or {}),
+               **((prof.get("required_positive_v6_stage") or {}).get(stage) or {})}
+    for f, why in req_on.items():
+        if not has_flag(argv, f):
+            out.append(f"{f} is REQUIRED ON for a {name} {stage} launch ({why}) and the argv does not "
+                       f"pass it")
+    for f, why in (prof.get("forbidden_flags_v6") or {}).items():
+        if has_flag(argv, f):
+            out.append(f"{f} is passed, but it is REFUSED for a {name} launch ({why})")
+    for f, (bad, why) in (prof.get("forbidden_values_v6") or {}).items():
+        v = flag_values(argv, f)
+        if v and v[0] in bad:
+            out.append(f"{f} {v[0]} is REFUSED for a {name} launch ({why})")
+    for f, why in req_pos.items():
+        v = flag_values(argv, f)
+        try:
+            ok = bool(v) and math.isfinite(float(v[0])) and float(v[0]) > 0.0
+        except ValueError:
+            ok = False
+        if not ok:
+            out.append(f"{f} must be passed with a value > 0 for a {name} launch ({why}); the argv "
+                       f"has {v}")
+    for f, why in (prof.get("forbidden_positive_v6") or {}).items():
+        v = flag_values(argv, f)
+        try:
+            pos = bool(v) and float(v[0]) > 0.0
+        except ValueError:
+            pos = True
+        if pos:
+            out.append(f"{f} {v} is REFUSED for a {name} launch ({why})")
+    return out
+
