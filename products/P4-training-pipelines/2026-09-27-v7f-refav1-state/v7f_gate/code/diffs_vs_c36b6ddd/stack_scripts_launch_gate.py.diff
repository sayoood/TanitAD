+def latest_smoke_config_v6(ctx: "Ctx") -> Path | None:
+    """The config.json the trainer wrote in THIS gate dir's newest v6 smoke (run 1 of
+    `job_smoke_v6`: `<out>/smoke/<ts>/run/config.json`)."""
+    d = Path(ctx.out_dir) / "smoke"
+    runs = sorted(d.glob("*/run/config.json"), key=lambda q: q.stat().st_mtime) if d.is_dir() else []
+    return runs[-1] if runs else None
