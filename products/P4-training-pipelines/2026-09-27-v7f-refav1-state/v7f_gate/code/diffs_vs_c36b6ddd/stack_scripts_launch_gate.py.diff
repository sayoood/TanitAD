+@contextlib.contextmanager
+def v6_capture(T, stop_at: str, *, on_freeze: Callable | None = None,
+               on_cfg: Callable | None = None, rehearsal: dict | None = None, ctx: Ctx | None = None):
+    """Run the REAL `main()` and capture what `train()` built. `stop_at`:
+      * "model" -- let the build COMPLETE (V6Stack, --init-from, encoder seed, the stage freeze, the
+        declared-freeze preflight, the frame lock) and stop at the corpus seam, before any data read;
+      * "none"  -- no stop (the smoke drives the whole run itself).
+    `on_freeze(stack)` runs right after the trainer's own `apply_stage_freeze` (an arm's hook);
+    `on_cfg(cfg)` right before `V6Stack.__init__` (G-HYG's arm). Refusals printed by the trainer are
+    recorded (`main` RETURNS 2 on a preflight refusal; it does not raise)."""
+    from tanitad.models import v6 as V6
+    cap: dict[str, Any] = {"refusals": []}
+    pat = _Patcher()
+    orig_init = V6.V6Stack.__init__
+    orig_train = T.train
+    orig_freeze = T.apply_stage_freeze
+    orig_refusal = T._print_refusal
+
+    def init_wrap(self, cfg, *a, **k):
+        if on_cfg is not None:
+            cap["on_cfg"] = on_cfg(cfg)
+        cap["cfg"] = cfg
+        orig_init(self, cfg, *a, **k)
+
+    def train_wrap(a):
+        cap["args"] = a
+        return orig_train(a)
+
+    def freeze_wrap(stack, stage):
+        rep = orig_freeze(stack, stage)
+        cap["stack"], cap["freeze"] = stack, rep
+        if on_freeze is not None:
+            cap["on_freeze"] = on_freeze(stack)
+        return rep
+
+    def refusal_wrap(problem):
+        cap["refusals"].append(str(problem))
+        return orig_refusal(problem)
+    pat.set(V6.V6Stack, "__init__", init_wrap)
+    pat.set(T, "train", train_wrap)
+    pat.set(T, "apply_stage_freeze", freeze_wrap)
+    pat.set(T, "_print_refusal", refusal_wrap)
+    if stop_at == "model":
+        import train_v58f_unicycle_head as tv58
+
+        def stop(*_a, **_k):
+            raise _Stop("model captured at the corpus seam")
+        pat.set(tv58, "build_train_episodes", stop)
+    try:
+        yield cap
+    finally:
+        pat.restore()
+
+
+def run_v6_until_model(ctx: Ctx, T, argv: list[str], **hooks) -> dict:
+    with v6_capture(T, "model", **hooks) as cap:
+        try:
+            cap["rc"] = T.main(list(argv))
+        except _Stop:
+            cap["rc"] = "stopped-at-corpus"
+    return cap
+
