+def vmax_by_clip_from_labels(path: str) -> tuple[dict, dict]:
+    """R1 (PI directive 2026-09-27): each clip's MAX SPEED, which the plan must never exceed.
+
+    Read from the clip's OWN label record -- ``g_tac.goals.SPEED_BAND.v_hi_ms`` -- through the corpus's ONE
+    quantizer (`tanitad.refs.refcv6_max_speed.speed_max_bin`: containing window over {30, 50, 100, 120}
+    km/h, > 120 clamps) and its ONE unit conversion (`limit_ms_of_bin`), so this can never disagree with
+    `refcv6_speed_max_v8_*.jsonl`, which is built from the same field by the same function.
+    Returns ``({clip_id: v_max_mps}, census)``.
+    """
+    import gzip
+    import json as _json
+    import torch as _t
+    from tanitad.refs.refcv6_max_speed import limit_ms_of_bin, speed_max_bin
+    out, n, missing, over = {}, 0, 0, 0
+    with gzip.open(path, "rt", encoding="utf-8") as f:
+        for line in f:
+            r = _json.loads(line)
+            n += 1
+            cid = r.get("clip_id")
+            sb = (((r.get("g_tac") or {}).get("goals") or {}).get("SPEED_BAND")) or {}
+            v = sb.get("v_hi_ms")
+            if cid is None or v is None:
+                missing += 1
+                continue
+            i, o = speed_max_bin(float(v))
+            over += int(bool(o))
+            out[str(cid)] = float(limit_ms_of_bin(_t.tensor([int(i)]))[0])
+    return out, {"n_records": n, "n_with_limit": len(out), "n_missing": missing,
+                 "n_over_ceiling_clamped": over}
+
