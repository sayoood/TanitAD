+    @staticmethod
+    def _speed_band_of(rec) -> tuple[float, float] | None:
+        """``(v_lo_ms, v_hi_ms)`` of a record's SPEED_BAND, or None when the
+        record carries none (or a non-finite one)."""
+        sb = (rec.tac_goal_meta or {}).get("SPEED_BAND") if rec is not None else None
+        if not isinstance(sb, dict):
+            return None
+        lo, hi = sb.get("v_lo_ms"), sb.get("v_hi_ms")
+        if lo is None or hi is None:
+            return None
+        lo, hi = float(lo), float(hi)
+        if not (math.isfinite(lo) and math.isfinite(hi)):
+            return None
+        return lo, hi
+
+    def _traj_window(self, nm: str, v: Tensor, kap: Tensor, t: int):
+        """R5, one window: ``(gt [K, 2], mask [K] bool, a0, kappa0)``."""
+        from tanitad.models.metric_dynamics import gt_ego_waypoints
+        P = self._poses[nm]
+        k = self._traj_k
+        f0 = 2 * t
+        if f0 < 2:
+            raise ValueError(f"{nm}: window t={t} has no closed step before t0 "
+                             "(a0 is the backward difference v[2t] - v[2t-2])")
+        fut = P[f0 + 2: f0 + 2 * k + 1: 2]
+        if fut.shape[0] < k:                       # the recording ends: mask
+            pad = torch.full((k - fut.shape[0], P.shape[1]), float("nan"),
+                             dtype=P.dtype)
+            fut = torch.cat([fut, pad], dim=0)
+        gt = gt_ego_waypoints(P[f0][None], fut[None], list(range(1, k + 1)))[0]
+        mask = torch.isfinite(gt).all(dim=-1)
+        # ⭐ EXACTLY `refav1_arm.hold_ext_controls`: every index <= 2t
+        a0 = (v[f0] - v[f0 - 2]) / self.dt
+        if self._kappa_src == "pose_past":
+            # refcv7's `ha0_ext_pose` curvature, through ITS function (one
+            # derivation): the two past poses 2t-2 and 2t at 0.2 s spacing
+            from tanitad.models.kinematic_prior import prior_controls
+            _a, k0 = prior_controls("ha0_ext_pose", P[f0 - 2: f0 + 1: 2][None],
+                                    n_past=2, dt=self.dt)
+            return gt, mask, a0, k0[0]
+        return gt, mask, a0, kap[f0]
+
+    def _r1r3_window(self, nm, t, v, kap, g_y, g_w, sb, sb_m, vm, vm_ok,
+                     tr_gt, tr_m, a0s, k0s) -> None:
+        """Append one window's PI 2026-09-27 emissions (no-op when all off)."""
+        if not (self._goal_on or self._sb_on or self._vmax_on or self._traj_k):
+            return
+        rec = self._v7rec.get(self.clip_id.get(nm)) if self._v7rec else None
+        if self._goal_on:
+            from tanitad.data.v7_labels import TAC_GOAL_TOKENS, tactical_goal_targets
+            if rec is None:                          # unlabelled clip: no evidence
+                n = len(TAC_GOAL_TOKENS)
+                y, w = (0.0,) * n, (0.0,) * n
+            else:
+                y, w = tactical_goal_targets(rec, t * self.dt,
+                                             negatives=self._goal_neg,
+                                             sidecar=self._goal_sidecar)
+            g_y.append(y), g_w.append(w)
+        band = self._speed_band_of(rec)
+        if self._sb_on:
+            row = self._lab.get(self.clip_id.get(nm)) if rec is not None else None
+            ok = (band is not None and row is not None
+                  and row[3] <= t * self.dt <= row[4])      # the lat/lon band rule
+            sb.append(band if ok else (0.0, 0.0)), sb_m.append(bool(ok))
+        if self._vmax_on:
+            # the clip's set speed: EVERY window of a labelled clip, RAW v_hi
+            vm.append(band[1] if band is not None else 0.0)
+            vm_ok.append(band is not None)
+        if self._traj_k:
+            gt, m, a0, k0 = self._traj_window(nm, v, kap, t)
+            tr_gt.append(gt), tr_m.append(m), a0s.append(a0), k0s.append(k0)
+
