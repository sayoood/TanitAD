+                                              region_pool)
+        cfg = self.cfg
+        b, dev = field_last.shape[0], field_last.device
+        v0_t = torch.as_tensor(v0, dtype=torch.float32, device=dev).reshape(-1)
+        a0_t = torch.as_tensor(a0, dtype=torch.float32, device=dev).reshape(-1)
+        k0_t = torch.as_tensor(kappa0, dtype=torch.float32,
+                               device=dev).reshape(-1)
+        for nm, t_ in (("v0", v0_t), ("a0", a0_t), ("kappa0", k0_t)):
+            if t_.shape[0] != b:
