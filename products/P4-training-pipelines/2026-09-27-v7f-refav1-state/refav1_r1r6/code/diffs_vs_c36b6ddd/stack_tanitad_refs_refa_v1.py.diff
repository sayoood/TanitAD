+        if self.goal_head is not None:
+            from tanitad.refs.tac_goal_head import tac_goal_loss
+            if not bool(self.goal_fitted):
+                raise RuntimeError(
+                    "w_goal > 0 but the goal head's pos_weight / class mask "
+                    "were never fitted from the split: call "
+                    "`set_goal_supervision` (the trainer does). The defaults "
+                    "would train the positives-only classes towards 1")
