+            y = torch.as_tensor(goal_y, device=lg.device).to(lg.dtype)
+            w = torch.as_tensor(goal_w, device=lg.device).to(lg.dtype)
+            loss, n_sup = tac_goal_loss(lg, y, w,
+                                        pos_weight=self.goal_pos_weight,
+                                        class_mask=self.goal_class_mask)
+            # the SAME per-cell arithmetic, kept per token: the reach test
+            # back-propagates each family's term on its own
+            w_eff = w * self.goal_class_mask.to(lg.dtype).view(1, -1)
+            per = F.binary_cross_entropy_with_logits(
+                lg, y, pos_weight=self.goal_pos_weight.to(lg.dtype),
+                reduction="none")
