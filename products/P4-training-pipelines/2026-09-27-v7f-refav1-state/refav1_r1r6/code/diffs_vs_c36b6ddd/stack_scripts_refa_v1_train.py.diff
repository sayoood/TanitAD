+          "--w-speed-band": float(getattr(a, "w_speed_band", 0.0) or 0.0) > 0.0,
+          "--w-traj": float(getattr(a, "w_traj", 0.0) or 0.0) > 0.0}
+    for f, dest in (("--w-goal", "w_goal"), ("--w-speed-band", "w_speed_band"),
+                    ("--w-traj", "w_traj")):
