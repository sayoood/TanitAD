+def test_the_R1_record_is_REFUSED_in_both_directions(tmp_path):
+    """Mutation, not inspection: drop the stamp -> refused; stamp a control -> refused; the cap
+    block likewise."""
+    from tanitad.refs.refcv6_max_speed import SpeedMaxStampError
+    from train_v6_staged import assert_r1r4_record, r1r4_config_block
+    s = _build(_cfg(max_speed_input_v6=True, plan_vmax_cap=True))
+    a = _tiny_args(tmp_path, "S-T", "--max-speed-input-v6", "--plan-vmax-cap")
+    blk = r1r4_config_block(a, s)
+    assert_r1r4_record(dict(blk), a)                                  # clean
+    with pytest.raises(SpeedMaxStampError):
+        assert_r1r4_record({k: v for k, v in blk.items()
+                            if k != "speed_max_derivation_v6"}, a)
+    with pytest.raises(SystemExit, match="limit source"):
+        assert_r1r4_record({k: v for k, v in blk.items() if k != "plan_vmax_cap"}, a)
+    off = _tiny_args(tmp_path, "S-T")
+    with pytest.raises(SpeedMaxStampError):
+        assert_r1r4_record({"speed_max_derivation_v6": blk["speed_max_derivation_v6"]}, off)
+    with pytest.raises(SystemExit, match="control stamped as capped"):
+        assert_r1r4_record({"plan_vmax_cap": blk["plan_vmax_cap"]}, off)
+    assert r1r4_config_block(off, _build(_cfg())) == {}, "the default record is untouched"
+
