+def test_G_DVB_v6_CATCHES_a_lever_declared_but_not_built(tmp_path):
+    """The regression arm: argv declares every lever, the stack was built WITHOUT them."""
+    from tanitad.train import declared_vs_built_v6 as dvb6
+    a = _tiny_args(tmp_path, "S-T", "--tac-op-cond", "e2e", "--max-speed-input-v6",
+                   "--plan-vmax-cap")
+    bad = dvb6.check(_build(_cfg()), a)
+    names = {m.lever for m in bad}
+    assert {"--tac-op-cond", "--max-speed-input-v6", "--plan-vmax-cap"} <= names
+    with pytest.raises(SystemExit, match="G-DVB-v6"):
+        dvb6.refuse_on_mismatch(_build(_cfg()), a)
+    # ...and the MIRROR: built, not declared
+    bad = dvb6.check(_build(_cfg(tac_op_cond="e2e")), _tiny_args(tmp_path, "S-T"))
+    assert {m.lever for m in bad} == {"--tac-op-cond"}
