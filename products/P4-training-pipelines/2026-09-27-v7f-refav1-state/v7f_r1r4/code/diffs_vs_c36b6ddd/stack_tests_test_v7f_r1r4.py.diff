+def test_R4_the_REAL_loss_step_makes_the_port_live_from_zero():
+    """⭐ Not a hand-woken surrogate: S-T's own objective (v6_loss_step, 4 Adam steps from a
+    zero emission and a zero port) moves the port off zero, and afterwards a behaviour swap
+    moves the emitted plan. Liveness ACQUIRED BY TRAINING."""
+    from train_v6_staged import V6LossWeights, synthetic_train_batch, v6_loss_step
+    s = _build(_cfg(tac_op_cond="e2e"), seed=4)
+    apply_stage_freeze(s, "S-T")
+    opt = torch.optim.Adam([p for p in s.parameters() if p.requires_grad], lr=1e-2)
+    for step in range(4):
+        b = synthetic_train_batch(s, batch=2, k=12, seed=10 + step)
+        L = v6_loss_step(s, b, stage="S-T", weights=V6LossWeights(lambda_plan=1.0),
+                         o1_k=10, o5_k=12)
+        opt.zero_grad(set_to_none=True)
+        L["loss"].backward()
+        opt.step()
+    assert float(s.tac_op_port.weight.abs().sum()) > 0.0
+    d_lat, d_lon, _ = _behaviour_counterfactual(s)
+    assert max(d_lat, d_lon) > 0.0, (d_lat, d_lon)
