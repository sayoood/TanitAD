+def _behaviour_counterfactual(s: V6Stack) -> tuple[float, float, float]:
+    """(max|dplan| for a LAT behaviour swap, for a LON swap, max|d a_lat probs|)."""
+    b = s.synthetic_batch(2, seed=1)
+    with torch.no_grad():
+        _force_token(s.act_head_lat, 0)
+        p0 = s.forward(**b)
+        _force_token(s.act_head_lat, 1)
+        p1 = s.forward(**b)
+        _force_token(s.act_head_lon, 0)
+        q0 = s.forward(**b)
+        _force_token(s.act_head_lon, 7)
+        q1 = s.forward(**b)
+    return (float((p0["plan"]["waypoints"] - p1["plan"]["waypoints"]).abs().max()),
+            float((q0["plan"]["waypoints"] - q1["plan"]["waypoints"]).abs().max()),
+            float((p0["a_lat"]["probs"] - p1["a_lat"]["probs"]).abs().max()))
