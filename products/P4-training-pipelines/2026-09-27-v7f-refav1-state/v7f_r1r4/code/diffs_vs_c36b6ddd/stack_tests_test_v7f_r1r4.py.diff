+def _cfg(**kw) -> V6Config:
+    """The test_v6_staged tiny geometry (plan_steps stays 60: §4b is part of the object)."""
+    base = dict(
+        encoder=EncoderConfig(in_channels=3, image_size=32, image_width=32,
+                              patch_size=16, d_model=32, depth=1, n_heads=2),
+        readout=ReadoutConfig(grid=4, d_readout=8),
+        predictor=PredictorConfig(d_model=32, depth=1, n_heads=2, window=4,
+                                  horizons=(1,), action_dim=3),
+        d_tac=32, d_str=16, d_goal_embed=16, adapter_hidden=32,
+        f_hidden_tac=32, f_hidden_str=32, d_plan_feat=16, emission_hidden=16,
+        n_candidates=4, aux_hidden=16, sigreg_slices=8)
+    base.update(kw)
+    return V6Config(**base)
+
+
+def _build(cfg: V6Config, seed: int = 0) -> V6Stack:
+    torch.manual_seed(seed)
+    return V6Stack(copy.deepcopy(cfg))
+
+
+def _wake(p: torch.nn.Parameter, std: float = 0.5, seed: int = 7) -> None:
+    g = torch.Generator().manual_seed(seed)
+    with torch.no_grad():
+        p.copy_(torch.randn(p.shape, generator=g) * std)
+
+
+def _wake_emission(s: V6Stack, seed: int = 3) -> None:
+    """Take the emission off its CV zero-init (train_v58f_unicycle_head.py:205-206): at init
+    NOTHING upstream of it can move the plan, so every liveness check needs this surrogate."""
+    _wake(s.emission.net[-1].weight, 0.5, seed)
+    _wake(s.emission.net[-1].bias, 0.5, seed + 1)
+
+
+def _force_token(head, tok: int, big: float = 40.0) -> None:
+    """A counterfactual DECISION: make the head emit token ``tok`` (one-hot posterior)."""
+    with torch.no_grad():
+        head.type_head.bias.zero_()
+        head.type_head.bias[tok] = big
+
+
+def _plan_wta(out: dict, seed: int = 5) -> torch.Tensor:
+    """The planner loss v6_loss_step uses (WTA ADE against a target)."""
+    fan = out["plan"]["waypoints"].float()
+    tgt = torch.randn(fan.shape[0], fan.shape[2], 2,
+                      generator=torch.Generator().manual_seed(seed))
+    err = (fan - tgt[:, None]).norm(dim=-1).mean(dim=-1)
+    return err[torch.arange(fan.shape[0]), err.argmin(dim=1)].mean()
+
+
+def _live(stack: V6Stack, loss: torch.Tensor) -> set:
+    names = [n for n, _ in stack.named_parameters()]
+    grads = torch.autograd.grad(loss, [p for _, p in stack.named_parameters()],
+                                allow_unused=True)
+    return {n for n, g in zip(names, grads) if g is not None and float(g.abs().max()) > 0}
+
+
+def _all_grad(stack: V6Stack) -> None:
+    for p in stack.parameters():
+        p.requires_grad_(True)
+
+
+def _same(x, y, path="out") -> list[str]:
+    """Recursive EXACT comparison -> the paths that differ."""
+    bad: list[str] = []
+    if isinstance(x, dict):
+        if set(x) != set(y):
+            return [f"{path}: keys {sorted(set(x) ^ set(y))}"]
+        for k in x:
+            bad += _same(x[k], y[k], f"{path}.{k}")
+    elif isinstance(x, (list, tuple)):
+        if len(x) != len(y):
+            return [f"{path}: len {len(x)} != {len(y)}"]
+        for i, (a, b) in enumerate(zip(x, y)):
+            bad += _same(a, b, f"{path}[{i}]")
+    elif torch.is_tensor(x):
+        if not (torch.is_tensor(y) and x.shape == y.shape and torch.equal(x, y)):
+            bad.append(path)
+    elif x != y:
+        bad.append(path)
+    return bad
