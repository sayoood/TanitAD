+class _Ep:
+    def __init__(self, sid):
+        self.episode_id = sid
+
+
+def _write_sidecar(tmp_path, rows, *, md5="abc"):
+    p = tmp_path / "vmax.jsonl"
+    p.write_text("\n".join(json.dumps(r) for r in rows) + "\n", encoding="utf-8")
+    (tmp_path / "vmax.jsonl.meta.json").write_text(json.dumps({"source_md5": md5}))
+    return p
+
+
+def test_the_sidecar_JOIN_is_per_episode_by_stable_id_and_refuses_zero_coverage(tmp_path):
+    from train_v6_staged import build_vmax_join, vmax_batch
+    p = _write_sidecar(tmp_path, [{"sid": 11, "v_hi_ms": 12.5, "valid": 1, "bin": 1},
+                                  {"sid": 22, "v_hi_ms": None, "valid": 0},
+                                  {"sid": 33, "v_hi_ms": 30.0, "valid": 1, "bin": 3}])
+    eps = [_Ep(33), _Ep(11), _Ep(99), _Ep(22)]
+    index = [(0, 0), (1, 5), (2, 0), (3, 1), (1, 9)]
+    j = build_vmax_join(p, eps, index, label_md5="abc")
+    assert j["v"].tolist() == [30.0, 12.5, 0.0, 0.0]
+    assert j["ok"].tolist() == [1.0, 1.0, 0.0, 0.0]
+    assert j["report"]["n_windows_fed"] == 3 and j["report"]["n_windows"] == 5
+    bt = vmax_batch(j, [4, 2, 0], index, "cpu")
+    assert bt["v_max_ms"].tolist() == [12.5, 0.0, 30.0]
+    assert bt["v_max_valid"].tolist() == [1.0, 0.0, 1.0]
+    with pytest.raises(SystemExit, match="NOT ONE"):
+        build_vmax_join(p, [_Ep(99)], [(0, 0)], label_md5="abc")
+    from tanitad.refs.refcv6_max_speed import SpeedMaxStampError
+    with pytest.raises(SpeedMaxStampError, match="md5"):
+        build_vmax_join(p, eps, index, label_md5="a-different-blob")
+
