+def _pre_change_module():
+    src, ref = None, None
+    env = os.environ.get("TANITAD_V6_PRE_R1R4")
+    if env and os.path.isfile(env):
+        src, ref = Path(env).read_bytes(), f"file:{env}"
+    else:
+        root = _STACK.parent
+        try:
+            log = subprocess.run(["git", "log", "--format=%H", "--", _V6_REL], cwd=root,
+                                 capture_output=True, timeout=180)
+            if log.returncode == 0:
+                for sha in log.stdout.decode().split():
+                    r = subprocess.run(["git", "show", f"{sha}:{_V6_REL}"], cwd=root,
+                                       capture_output=True, timeout=120)
+                    if r.returncode == 0 and r.stdout and _MARKER not in r.stdout:
+                        src, ref = r.stdout, sha
+                        break
+        except Exception:                                           # noqa: BLE001
+            src = None
+    if src is None or _MARKER in src:
+        return None
+    tmp = Path(tempfile.mkdtemp()) / "_v6_pre_r1r4.py"
+    tmp.write_bytes(src)
+    name = "tanitad.models._v6_pre_r1r4"          # parent package -> `.vocab_v7` resolves
+    spec = importlib.util.spec_from_file_location(name, tmp)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    mod._ref = ref
+    return mod
+
