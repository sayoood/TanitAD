+def test_cap_END_TO_END_the_uncapped_plan_exceeds_and_the_capped_plan_never_does():
+    """⭐ The discriminating control on the REAL forward (eval mode, as inference runs it):
+    v0 10 m/s, v_hi 12 m/s -> the 50 km/h bin -> limit 13.8889 m/s. Uncapped, +3 m/s^2 for
+    6 s reaches 28 m/s; capped, no candidate's speed ever exceeds 13.8889."""
+    s = _accelerating_stack(plan_vmax_cap=True)
+    s.eval()
+    b = s.synthetic_batch(2, seed=7)
+    b["v0"] = torch.tensor([10.0, 10.0])
+    lim = plan_limit_from_vhi(torch.tensor([12.0, 12.0]))
+    assert torch.allclose(lim, torch.full((2,), 50 / 3.6))
+    with torch.no_grad():
+        p = s.forward(**(b | {"plan_v_max_ms": lim}))["plan"]
+    unc = p["vmax_plan_max_speed_uncapped"]
+    assert float(unc.min()) > float(lim[0]) + 0.1, "the control must exceed or this is vacuous"
+    assert float(unc.max()) == pytest.approx(10.0 + 3.0 * 6.0, abs=1e-3)
+    vc = closing_speeds(p["a"], b["v0"], dt=DT)
+    assert float(vc.max()) <= float(lim[0]) + 1e-4
+    assert not bool(p["vmax_v0_over_limit"].any())
+    assert bool(p["vmax_binding"].all())
+    assert float(p["vmax_plan_excess_ms"].max()) <= 1e-4
+    # the emitted waypoints ARE the integration of the emitted (capped) controls
+    from train_v58f_unicycle_head import unicycle_rollout
+    wp, _ = unicycle_rollout(p["a"], p["kappa"], b["v0"], dt=DT)
+    assert torch.equal(wp, p["waypoints"])
+    assert torch.equal(p["controls"][..., 0], p["a"])
+
