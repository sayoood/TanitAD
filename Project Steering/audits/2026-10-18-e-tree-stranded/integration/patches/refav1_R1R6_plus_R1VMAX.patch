new file mode 100644
index 0000000..9359e6b
--- /dev/null
+++ b/stack/tanitad/refs/refav1_traj.py
@@ -0,0 +1,348 @@
+"""refav1 R5 -- ONE combined tactical+operative trajectory to 6 s, as a RESIDUAL over a
+model-free kinematic prior -- ``kdx`` by default, ``damp50`` / ``cv`` selectable
+(``TRAJ_PRIORS``) -- (PI directive 2026-09-27, requirements R1 / R4 / R5).
+
+WHY THIS EXISTS, MEASURED (``TanitAD Research Lab/Architecture & Inference/Research/
+2026-09-27-refav1-fullgrid-loncomb3/RESULT.md``): on the full 141-episode grid the iCEM
+planner adds nothing over t0 kinematics on either axis, the world model's lateral cost share is
+1.63e-10, and the proposal head was never trained. A model-free damped kinematic path, ``kd_x``,
+is the strongest do-nothing floor measured (``kd_x - ha0_ext`` ADE -0.2282 on 282 windows,
+-0.2638 on the 2,399-window stride-4 grid). The trunk probe
+(``.../2026-09-27-refav1-trunk-probe/RESULT.md``) found that a LINEAR readout of the
+mean-pooled trunk carries nothing beyond kinematics, and that a LEARNED kinematic readout beats
+``kd_x`` by -0.0558 on held-out episodes. So the head starts AT ``kd_x`` (zero-initialised
+output layer) and learns a residual from 4 x 10 REGION pooling of the token field + the t0
+kinematics + nav + max speed + the tactical decision.
+
+⭐ WHAT ``kd_x`` IS, EXACTLY (the definition this module reproduces, from
+``.../raw/analysis/explore/build_explore.py::retime`` and ``probe.py::kdx``):
+
+    ha0      = unicycle(controls (0, 0),        v0)            # constant speed, straight
+    ha0_ext  = unicycle(controls (a0, kappa0),  v0)            # the measured t0 state held
+    damp     = 0.5 * ha0 + 0.5 * ha0_ext                       # positions, float32
+    kd_x     = retime(damp, ha0_ext)   # damp's GEOMETRY at ha0_ext's travelled arclength
+
+with the programme's ONE integrator (``refa_v1_plan.unicycle_paths`` ->
+``kinematic.rollout_unicycle``: position advances on the speed at the START of the step, v is
+updated last and clamped at 0), at ``dt`` = 0.2 s, positions at k = 1..K. ``retime`` runs in
+float64 and returns float32 (as the reference does). At K = 30 this is the trunk probe's 6 s
+base (``kdx(ha0_6, ha0_ext_6)``); the banked 2 s ``kd_x`` is the K = 10 case.
+
+⛔ ADMISSIBILITY (PI 2026-09-02: the measured ego state at cycle time is a legal initial state;
+future dynamic information is not). Every input of the prior is a t0 measurement:
+  * ``v0``     = ``poses[2t, 3]`` -- the measured speed at the anchor frame;
+  * ``a0``     = ``(v[2t] - v[2t-2]) / 0.2`` -- a BACKWARD difference of two past speeds;
+  * ``kappa0`` = ``actions[2t, 0]`` -- the recorded curvature channel AT t0 (the egomotion
+    ``curvature`` signal stored as ``atan(2.9 * kappa)``), exactly what ``ha0_ext`` holds
+    (``taniteval/tools/refav1_arm.py::hold_ext_controls``). Every index is <= 2t.
+⚠️ UNITS, STATED BECAUSE THEY MATTER: the banked ``kd_x`` floor was measured with
+``--action-units kappa`` (the arm's default), i.e. ``kappa0`` -- a road-wheel angle ~2.9x the
+geometric curvature -- was integrated AS a curvature. ``units="kappa"`` (default) reproduces THAT
+floor bit-for-bit; ``units="steer"`` converts with ``kappa = tan(steer)/2.9`` first. Damping
+halves the lateral term, so the shipped floor effectively holds ~1.45x the geometric curvature.
+The residual head can learn the correction either way; which prior is the right BAR is a
+choice the result must name.
+"""
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from torch import Tensor
+
+from tanitad.refs.refa_v1_plan import unicycle_paths
+
+__all__ = ["TRAJ_PRIORS", "PRIOR_INPUTS", "kinematic_floor_paths", "retime_paths",
+           "kd_x_prior", "kinematic_prior", "region_pool", "kin_features",
+           "TrajResidualHead", "cap_path_speed", "path_speeds", "traj_loss", "N_KIN_FEATS"]
+
+#: ⭐ THE PRIORS THE HEAD MAY START FROM (coordinator 2026-09-27: "make its kinematic PRIOR a
+#: selectable flag, not hard-wired to kd_x"). Each is a model-free path from past measurements
+#: only, and each keeps the zero-init known-value control (the head's output at init IS it):
+#:   * ``kdx``    -- ``retime(damp50, ha0_ext)``: damp50's geometry at ha0_ext's timing. The
+#:     strongest 2 s floor measured (``kd_x - ha0_ext`` ADE -0.2282 on 282 windows).
+#:   * ``damp50`` -- ``0.5 * ha0 + 0.5 * ha0_ext`` (position average). EXPLORATORY, 6 s, 2,399
+#:     windows / 141 clusters (`C:/Users/Admin/refav1_probe/floors_6s_exploratory.json`):
+#:     ADE@6s 3.454 m vs kdx 3.558 (n.s.), FDE@6s 10.15 vs 11.22 m (kdx - damp50 FDE +1.066
+#:     [+0.617, +1.534], separated) -- the better 6 s prior on that read.
+#:   * ``cv``     -- ``ha0``: constant speed, straight (v0 only).
+#: ⛔ ``ha0_ext`` itself is NOT offered: holding (a0, kappa0) for 6 s reads ADE 5.36 / FDE 15.39.
+TRAJ_PRIORS = ("kdx", "damp50", "cv")
+#: what each prior is computed from (the admissibility statement travels with the name)
+PRIOR_INPUTS = {"kdx": ("v0", "a0", "kappa0"), "damp50": ("v0", "a0", "kappa0"),
+                "cv": ("v0",)}
+
+#: ``retime``'s own thresholds, copied as LITERALS from ``build_explore.py`` (a second copy of
+#: a threshold is a second convention, so they are named once here and pinned by the tests)
+_SEG_EPS = 1e-9
+_DEGENERATE_S = 1e-6
+_DIV_FLOOR = 1e-12
+
+
+def kinematic_floor_paths(v0: Tensor, a0: Tensor, kappa0: Tensor, steps: int, dt: float,
+                          units: str = "kappa") -> tuple[Tensor, Tensor]:
+    """``(ha0, ha0_ext)`` ``[B, steps, 2]`` float32 through the programme's ONE integrator.
+
+    ``ha0`` holds (0, 0) from ``v0``; ``ha0_ext`` holds the measured ``(a0, kappa0)``. Both are
+    exactly the arm's ``paths_from_controls`` rows (``hold_v0_controls`` / ``hold_ext_controls``
+    expanded over ``steps``), batched."""
+    v0 = torch.as_tensor(v0, dtype=torch.float32).reshape(-1)
+    a0 = torch.as_tensor(a0, dtype=torch.float32, device=v0.device).reshape(-1)
+    k0 = torch.as_tensor(kappa0, dtype=torch.float32, device=v0.device).reshape(-1)
+    if not (v0.shape == a0.shape == k0.shape):
+        raise ValueError(f"v0/a0/kappa0 must share one batch shape, got {tuple(v0.shape)} "
+                         f"{tuple(a0.shape)} {tuple(k0.shape)}")
+    b = v0.shape[0]
+    zero = torch.zeros(b, int(steps), 2, dtype=torch.float32, device=v0.device)
+    ext = torch.stack([a0, k0], dim=-1)[:, None, :].expand(b, int(steps), 2)
+    ha0 = unicycle_paths(zero, v0, float(dt))
+    ha0_ext = unicycle_paths(ext.contiguous(), v0, float(dt), action_units=units)
+    return ha0, ha0_ext
+
+
+def _arclen(p: Tensor):
+    """``p`` [B, K, 2] positions at k=1..K (origin implicit) -> (P [B,K+1,2], seg, L, S)."""
+    b = p.shape[0]
+    P = torch.cat([torch.zeros(b, 1, 2, dtype=p.dtype, device=p.device), p], dim=1)
+    seg = P[:, 1:] - P[:, :-1]
+    # np.linalg.norm(seg, axis=-1) == sqrt(x*x + y*y) for two components -- written out so the
+    # float64 result is the reference's to the bit
+    L = torch.sqrt(seg[..., 0] * seg[..., 0] + seg[..., 1] * seg[..., 1])
+    S = torch.cat([torch.zeros(b, 1, dtype=p.dtype, device=p.device),
+                   torch.cumsum(L, dim=1)], dim=1)
+    return P, seg, L, S
+
+
+def _gather(x: Tensor, idx: Tensor) -> Tensor:
+    """x [B, M] or [B, M, 2]; idx [B, K] -> [B, K] or [B, K, 2]."""
+    if x.dim() == 2:
+        return torch.gather(x, 1, idx)
+    return torch.gather(x, 1, idx[..., None].expand(*idx.shape, x.shape[-1]))
+
+
+def retime_paths(path: Tensor, lon_src: Tensor) -> Tensor:
+    """Batched, float64 ``build_explore.retime``: ``path``'s GEOMETRY at ``lon_src``'s own
+    travelled arclength, step by step. ``[B, K, 2]`` x2 -> ``[B, K, 2]`` float32.
+
+    Branches, exactly as the reference (per sample, per step):
+      * degenerate damped path (total length < 1e-6, or no segment > 1e-9): ``(s, 0)``;
+      * ``s <= S[-1]``: the segment ``j = clip(searchsorted(S, s, right) - 1)``, moved FORWARD
+        past zero-length segments, then ``P[j] + (s - S[j]) / max(L[j], 1e-12) * seg[j]``
+        (``P[j]`` when that segment is itself zero-length);
+      * ``s > S[-1]``: extrapolate along the LAST non-zero segment,
+        ``P[-1] + (s - S[-1]) * seg[jj] / L[jj]``.
+    The association order of every expression is the reference's, so float64 intermediates
+    agree to the bit."""
+    if path.shape != lon_src.shape or path.dim() != 3 or path.shape[-1] != 2:
+        raise ValueError(f"retime_paths needs two [B, K, 2] tensors, got {tuple(path.shape)} "
+                         f"and {tuple(lon_src.shape)}")
+    P, seg, L, S = _arclen(path.to(torch.float64))
+    s_src = _arclen(lon_src.to(torch.float64))[3][:, 1:]                 # [B, K]
+    b, k = L.shape
+    idx = torch.arange(k, device=L.device).expand(b, k)
+    nz = L > _SEG_EPS
+    # the reference's `while L[j] <= 1e-9 and j + 1 < len(L): j += 1`: the first index >= j with
+    # a non-zero segment, or the LAST index when none follows
+    cand = torch.where(nz, idx, torch.full_like(idx, k))
+    nxt = torch.flip(torch.cummin(torch.flip(cand, [1]), dim=1).values, [1])
+    nxt = torch.where(nxt >= k, torch.full_like(nxt, k - 1), nxt)
+    j0 = torch.searchsorted(S.contiguous(), s_src.contiguous(), right=True) - 1
+    j0 = j0.clamp(0, k - 1)
+    j = torch.gather(nxt, 1, j0)
+    Pj, Sj, Lj, segj = _gather(P, j), _gather(S, j), _gather(L, j), _gather(seg, j)
+    inner = torch.where((Lj > _SEG_EPS)[..., None],
+                        Pj + ((s_src - Sj) / Lj.clamp_min(_DIV_FLOOR))[..., None] * segj, Pj)
+    # extrapolation along the last non-zero segment
+    jj = torch.where(nz, idx, torch.full_like(idx, -1)).max(dim=1).values          # [B]
+    jj_c = jj.clamp_min(0)
+    seg_last = seg[torch.arange(b, device=L.device), jj_c]                          # [B, 2]
+    L_last = L[torch.arange(b, device=L.device), jj_c]                              # [B]
+    S_end, P_end = S[:, -1], P[:, -1]
+    extra = P_end[:, None, :] + ((s_src - S_end[:, None])[..., None] * seg_last[:, None, :]
+                                 ) / L_last.clamp_min(_DIV_FLOOR)[:, None, None]
+    out = torch.where((s_src <= S_end[:, None])[..., None], inner, extra)
+    degenerate = (S_end < _DEGENERATE_S) | (jj < 0)
+    straight = torch.stack([s_src, torch.zeros_like(s_src)], dim=-1)
+    out = torch.where(degenerate[:, None, None], straight, out)
+    return out.to(torch.float32)
+
+
+def kd_x_prior(v0: Tensor, a0: Tensor, kappa0: Tensor, *, steps: int = 30, dt: float = 0.2,
+               units: str = "kappa") -> dict:
+    """The ``kd_x`` floor ``[B, steps, 2]`` plus the two paths it is built from."""
+    ha0, ha0_ext = kinematic_floor_paths(v0, a0, kappa0, steps, dt, units)
+    damp = 0.5 * ha0 + 0.5 * ha0_ext
+    return {"kd_x": retime_paths(damp, ha0_ext), "ha0": ha0, "ha0_ext": ha0_ext,
+            "damp50": damp}
+
+
+def kinematic_prior(name: str, v0: Tensor, a0: Tensor, kappa0: Tensor, *, steps: int = 30,
+                    dt: float = 0.2, units: str = "kappa") -> Tensor:
+    """The named prior (``TRAJ_PRIORS``) ``[B, steps, 2]`` float32.
+
+    ``kdx`` / ``damp50`` are built from the SAME two integrated paths (``kd_x_prior``), so a
+    prior switch changes the combination and nothing upstream of it; ``cv`` is ``ha0``, whose
+    integration reads ``v0`` alone (``a0`` / ``kappa0`` still shape-checked, never used)."""
+    if name not in TRAJ_PRIORS:
+        raise ValueError(f"unknown R5 prior {name!r}; valid: {TRAJ_PRIORS}")
+    parts = kd_x_prior(v0, a0, kappa0, steps=steps, dt=dt, units=units)
+    return {"kdx": parts["kd_x"], "damp50": parts["damp50"], "cv": parts["ha0"]}[name]
+
+
+def region_pool(field: Tensor, grid: tuple[int, int], regions: tuple[int, int]) -> Tensor:
+    """``[B, N, d]`` row-major token field -> ``[B, R, d]`` region means.
+
+    At the shipped geometry (16 x 40 grid, 4 x 10 regions) each region is the mean of 4 x 4
+    tokens, exactly the trunk probe's ``x.reshape(4, 4, 10, 4, -1).mean(dim=(1, 3))`` (region
+    (a, e) = rows 4a..4a+3, columns 4e..4e+3), region index ``a * 10 + e``.
+    ⛔ NOT the global mean: the probe MEASURED that the mean-pooled state carries nothing
+    beyond kinematics."""
+    gh, gw = (int(x) for x in grid)
+    rh, rw = (int(x) for x in regions)
+    b, n, d = field.shape
+    if n != gh * gw:
+        raise ValueError(f"region_pool: {n} tokens is not a {gh} x {gw} grid")
+    if gh % rh or gw % rw:
+        raise ValueError(f"region_pool: {rh} x {rw} regions do not tile a {gh} x {gw} grid")
+    return field.reshape(b, rh, gh // rh, rw, gw // rw, d).mean(dim=(2, 4)).reshape(b, rh * rw, d)
+
+
+#: the trunk probe's kinematic design, (v, a, k, v^2, v a, v k, v^2 k, a k) -- here on FIXED
+#: scales (v/30 m/s, a/4 m/s^2, k/0.2), never on statistics of a split
+N_KIN_FEATS = 8
+_KIN_SCALE = (30.0, 4.0, 0.2)
+
+
+def kin_features(v0: Tensor, a0: Tensor, kappa0: Tensor) -> Tensor:
+    v = v0.reshape(-1).to(torch.float32) / _KIN_SCALE[0]
+    a = a0.reshape(-1).to(torch.float32) / _KIN_SCALE[1]
+    k = kappa0.reshape(-1).to(torch.float32) / _KIN_SCALE[2]
+    return torch.stack([v, a, k, v * v, v * a, v * k, v * v * k, a * k], dim=-1)
+
+
+class TrajResidualHead(nn.Module):
+    """``regions [B, R, d_state]`` + ``cond [B, d_cond]`` -> residual ``[B, steps, 2]`` (m).
+
+    ⭐ THE OUTPUT LAYER IS ZERO-INITIALISED, weight AND bias, so at step 0 the residual is
+    EXACTLY 0.0 and the head's trajectory IS the prior (the known-value control). ⚠️ The price,
+    stated: with ``out.weight == 0`` the gradient into every layer BELOW ``out`` is exactly zero
+    at the first step (``dL/dh = W^T dL/dy``); ``out`` itself receives ``dL/dW = dL/dy h^T != 0``,
+    so from the second optimizer step the gradient reaches the body and the region projection
+    (pinned by ``tests/test_refav1_r5_traj_head.py``). ReZero / zero-init residual branches pay
+    the same one-step delay; the refav1 predictors avoid it with a down-scaled init because
+    there the delta is added to a field that must move from step 0 -- here the prior is the
+    answer at step 0 by design."""
+
+    def __init__(self, d_state: int, n_regions: int, d_region: int, hidden: int, steps: int,
+                 d_cond: int):
+        super().__init__()
+        self.steps, self.n_regions, self.d_cond = int(steps), int(n_regions), int(d_cond)
+        self.reg_norm = nn.LayerNorm(d_state)
+        self.reg_proj = nn.Linear(d_state, d_region)
+        self.reg_pos = nn.Parameter(torch.zeros(1, n_regions, d_region))
+        nn.init.trunc_normal_(self.reg_pos, std=0.02)
+        self.mlp = nn.Sequential(nn.Linear(n_regions * d_region + d_cond, hidden), nn.GELU(),
+                                 nn.Linear(hidden, hidden), nn.GELU())
+        self.out = nn.Linear(hidden, self.steps * 2)
+        nn.init.zeros_(self.out.weight)
+        nn.init.zeros_(self.out.bias)
+
+    def forward(self, regions: Tensor, cond: Tensor) -> Tensor:
+        if regions.shape[1] != self.n_regions:
+            raise ValueError(f"TrajResidualHead: {regions.shape[1]} regions, built for "
+                             f"{self.n_regions}")
+        if cond.shape[-1] != self.d_cond:
+            raise ValueError(f"TrajResidualHead: cond width {cond.shape[-1]}, built for "
+                             f"{self.d_cond}")
+        r = self.reg_proj(self.reg_norm(regions)) + self.reg_pos
+        h = self.mlp(torch.cat([r.flatten(1), cond.to(r.dtype)], dim=-1))
+        return self.out(h).reshape(-1, self.steps, 2)
+
+
+def path_speeds(path: Tensor, dt: float) -> Tensor:
+    """``[B, K, 2]`` -> ``[B, K]`` the speed each SEGMENT implies (segment k = p_{k-1} -> p_k,
+    origin prepended). Under the unicycle this is the speed at the START of step k."""
+    P = torch.cat([torch.zeros_like(path[:, :1]), path], dim=1)
+    d = P[:, 1:] - P[:, :-1]
+    return torch.sqrt(d[..., 0] * d[..., 0] + d[..., 1] * d[..., 1]) / float(dt)
+
+
+@torch.no_grad()
+def cap_path_speed(path: Tensor, v_max: Tensor, dt: float, *, v0: Tensor | None = None,
+                   a_max: float = 4.0) -> tuple[Tensor, dict]:
+    """R1 on an emitted PATH: re-time it along its own geometry so no segment is driven faster
+    than the allowance, never getting AHEAD of the original path.
+
+    allowance of segment k (k = 1..K): ``u_k = v_max``, or -- when ``v0`` is given --
+    ``max(v_max, v0 - a_max * (k - 1) * dt)``: a car measured ABOVE the limit may only shed
+    speed at ``a_max`` (``refa_v1_plan._cap_speed``'s convention). The capped arclength is
+    ``s'_k = min(S_k, s'_{k-1} + u_k dt)`` and the point is the original polyline at ``s'_k``.
+    ⭐ NON-BINDING IS THE IDENTITY: wherever ``s'_k == S_k`` the ORIGINAL point is returned
+    (``torch.where``, not a re-interpolation), so a path that respects the limit is returned
+    bit-for-bit. Returns ``(capped, record)``; ``record`` counts capped steps and the residual
+    excess (> 0 only where ``v0`` itself exceeded the limit)."""
+    v_max = torch.as_tensor(v_max, dtype=torch.float64, device=path.device).reshape(-1)
+    b, k, _ = path.shape
+    if v_max.numel() == 1 and b > 1:
+        v_max = v_max.expand(b)
+    P, seg, L, S = _arclen(path.to(torch.float64))
+    steps = torch.arange(k, dtype=torch.float64, device=path.device)            # k-1 = 0..K-1
+    if v0 is None:
+        allow = v_max[:, None].expand(b, k)
+    else:
+        v0d = torch.as_tensor(v0, dtype=torch.float64, device=path.device).reshape(-1)
+        allow = torch.maximum(v_max[:, None], v0d[:, None] - float(a_max) * steps * float(dt))
+    s_cap = torch.zeros(b, k, dtype=torch.float64, device=path.device)
+    prev = torch.zeros(b, dtype=torch.float64, device=path.device)
+    for i in range(k):
+        prev = torch.minimum(S[:, i + 1], prev + allow[:, i] * float(dt))
+        s_cap[:, i] = prev
+    binding = s_cap < S[:, 1:]
+    # the capped arclength never exceeds S[-1], so only the interpolation branch is reachable
+    idx = torch.arange(k, device=path.device).expand(b, k)
+    nz = L > _SEG_EPS
+    cand = torch.where(nz, idx, torch.full_like(idx, k))
+    nxt = torch.flip(torch.cummin(torch.flip(cand, [1]), dim=1).values, [1])
+    nxt = torch.where(nxt >= k, torch.full_like(nxt, k - 1), nxt)
+    j0 = (torch.searchsorted(S.contiguous(), s_cap.contiguous(), right=True) - 1).clamp(0, k - 1)
+    j = torch.gather(nxt, 1, j0)
+    Pj, Sj, Lj, segj = _gather(P, j), _gather(S, j), _gather(L, j), _gather(seg, j)
+    interp = torch.where((Lj > _SEG_EPS)[..., None],
+                         Pj + ((s_cap - Sj) / Lj.clamp_min(_DIV_FLOOR))[..., None] * segj, Pj)
+    capped = torch.where(binding[..., None], interp.to(path.dtype), path)
+    sp = path_speeds(capped.to(torch.float64), dt)
+    excess = (sp - v_max[:, None]).clamp_min(0.0).max(dim=1).values             # [B]
+    if v0 is None:
+        over = torch.zeros(b, dtype=torch.bool, device=path.device)
+    else:
+        over = (torch.as_tensor(v0, dtype=torch.float64).reshape(-1).to(path.device)
+                > v_max + 1e-6)
+    ok_rows, bad_rows = excess[~over], excess[over]
+    # ⛔ R1 is a HARD constraint: on a row whose MEASURED v0 is within the limit the emitted
+    # path must never exceed it (`n_rows_over_limit` MUST be 0); a row that STARTS above the
+    # limit is a property of the input state and is counted apart, never hidden.
+    return capped, {"n_capped_steps": int(binding.sum()),
+                    "n_rows_capped": int(binding.any(dim=1).sum()),
+                    "n_rows_over_limit": int((ok_rows > 1e-4).sum()),
+                    "max_excess_mps": float(ok_rows.max()) if ok_rows.numel() else 0.0,
+                    "n_rows_v0_over_limit": int(over.sum()),
+                    "max_excess_mps_v0_over_limit": (float(bad_rows.max())
+                                                     if bad_rows.numel() else None)}
+
+
+def traj_loss(pred: Tensor, gt: Tensor, mask: Tensor, *, beta: float = 1.0
+              ) -> tuple[Tensor, int]:
+    """Masked Smooth-L1 (Huber, ``beta`` in metres) on the (x, y) waypoints, summed over the
+    two coordinates and averaged over the VALID steps. ``(loss, n_valid_steps)``.
+
+    ⛔ NaN-SAFE BY CONSTRUCTION: a masked GT step may be NaN (no recorded future) and
+    ``NaN * 0`` is NaN, so the masked cells are removed with ``torch.where`` BEFORE the sum.
+    ⛔ NO ``if n_valid:`` GUARD: an all-masked batch returns a REAL 0.0 that stays in the graph
+    (every parameter still receives a zeros gradient), and the caller reports ``n_valid``
+    beside it -- a bare 0.0 would read as "supervised, and perfect"."""
+    m = mask.to(torch.bool)
+    g = torch.where(m[..., None], gt, torch.zeros_like(gt))
+    per = F.smooth_l1_loss(pred, g.to(pred.dtype), reduction="none", beta=float(beta)).sum(-1)
+    per = torch.where(m, per, torch.zeros_like(per))
+    n = m.sum()
+    return per.sum() / n.clamp_min(1).to(per.dtype), int(n.detach())
diff --git a/stack/tanitad/train/declared_vs_built_refav1.py b/stack/tanitad/train/declared_vs_built_refav1.py
new file mode 100644
index 0000000..257e093
--- /dev/null
+++ b/stack/tanitad/train/declared_vs_built_refav1.py
@@ -0,0 +1,365 @@
+"""G-DVB for ``refa_v1_train.py`` -- every argv lever equals the BUILT ``RefAV1``, or the run
+refuses (PI directive 2026-09-27, item 4; the refav1 counterpart of
+``tanitad.train.declared_vs_built``, which is written for ``refc_v3_train.py`` / ``RefCV3Model``).
+
+⭐ WHY A SEPARATE REGISTRY AND NOT ENTRIES IN THE SHARED ONE. ``declared_vs_built.check`` runs
+EVERY ``built`` / ``loss`` lever of its global ``REGISTRY`` on the model it is handed. A refav1
+lever registered there would run its reader on a ``RefCV3Model`` at every refcv7 launch and FAIL
+it ("the built value could not be read") -- a refav1 entry would break the binding refcv7 gate.
+So this module keeps its OWN registry with the SAME contract (``Lever`` / ``Mismatch`` are
+imported, not re-declared) and the SAME API names::
+
+    from tanitad.train import declared_vs_built_refav1 as dvb1
+    dvb1.check(model, args, parser=None)          # -> list[Mismatch]; [] == clean
+    dvb1.refuse_on_mismatch(model, args, parser)  # SystemExit naming EVERY mismatch
+    dvb1.coverage(parser)                         # dests with NO entry ([] == covered)
+
+⛔ A TRAINER FLAG WITHOUT AN ENTRY IS REFUSED (the SPEC_REFCV7 §2 rule, applied to refav1):
+``refa_v1_train.main`` calls :func:`refuse_on_mismatch` with its own parser before the first
+step, so a new flag cannot land without saying how its built counterpart is read.
+
+⛔ EXPECTATIONS ARE LITERALS FROM ``args``. Every expected value is written here from argv by a
+rule stated in this file -- never by calling ``refa_v1_train.build_model`` /
+``r1r6_cfg_kwargs`` (the functions under test). The BUILT side is read off modules first
+(``model.traj_head is not None``, a Linear's ``in_features``); ``model.cfg`` is read only for
+weights the loss itself reads from the config (``kind='loss'``), which IS the built value.
+
+⚠️ SCOPE, STATED: this is the G-DVB entry set for refav1, not a refav1 PROFILE of the binding
+launch gate (``stack/scripts/launch_gate.py``). The gate's G-LIVE / G-CKPT / G-EVAL / G-CLOCK
+machinery drives ``refc_v3_train.py``'s internals (``trainer_capture`` patches that trainer's
+functions), so a refav1 profile is a separate build -- delivered as a PROPOSAL with this module.
+"""
+from __future__ import annotations
+
+from typing import Any, Callable
+
+from tanitad.train.config_hygiene import undeclared_attributes
+from tanitad.train.declared_vs_built import KINDS, Lever, Mismatch
+
+__all__ = ["REGISTRY", "register", "check", "refuse_on_mismatch", "coverage", "NEW_2026_09_27"]
+
+REGISTRY: dict[str, Lever] = {}
+
+#: the flags the PI 2026-09-27 R1/R3/R5/R6 build added (listed so a test can require that every
+#: one of them is a checked lever, not merely a covered name)
+NEW_2026_09_27: tuple[str, ...] = ("strategic_off", "vmax_input", "w_goal", "goal_negatives",
+                                   "cot_negative_sidecar", "w_speed_band", "w_traj", "r5_prior",
+                                   "r5_kappa_source")
+
+
+def register(dest: str, kind: str, check: Callable | None = None, reason: str = "") -> None:
+    if kind not in KINDS or kind == "drivort":
+        raise ValueError(f"refav1 G-DVB kind {kind!r} not in {KINDS} (drivort is refc-only)")
+    if kind in ("built", "loss") and check is None:
+        raise ValueError(f"refav1 G-DVB `{dest}` is a {kind} lever and has no check")
+    if kind not in ("built", "loss") and not reason:
+        raise ValueError(f"refav1 G-DVB `{dest}` ({kind}) needs a reason a reader can verify")
+    REGISTRY[dest] = Lever(dest, kind, check, reason)
+
+
+def _a(args, name, default=None):
+    return getattr(args, name, default)
+
+
+def _flag(dest: str) -> str:
+    return "--" + dest.replace("_", "-")
+
+
+def _eq(dest, declared, built, where, why="") -> list:
+    return [] if declared == built else [Mismatch(_flag(dest), declared, built, where, why)]
+
+
+def _near(dest, declared, built, where, why="", tol=1e-12) -> list:
+    try:
+        ok = abs(float(declared) - float(built)) <= tol
+    except (TypeError, ValueError):
+        ok = False
+    return [] if ok else [Mismatch(_flag(dest), declared, built, where, why)]
+
+
+def _hier(args) -> bool:
+    return not bool(_a(args, "no_hierarchy", False))
+
+
+# ============================================================================
+# readers -- the BUILT side
+# ============================================================================
+
+def _c_no_hierarchy(m, a):
+    want = _hier(a)
+    return _eq("no_hierarchy", want, m.tactical_policy is not None,
+               "model.tactical_policy is not None",
+               "the hierarchy argv asks for is not the one built")
+
+
+def _c_strategic_off(m, a):
+    off = bool(_a(a, "strategic_off", False))
+    out = []
+    if not _hier(a):
+        return out                            # refused by the trainer before this
+    out += _eq("strategic_off", not off, m.strategic_policy is not None,
+               "model.strategic_policy is not None",
+               "R6: the strategic POLICY must be absent iff --strategic-off")
+    out += _eq("strategic_off", not off, m.strategic is not None,
+               "model.strategic is not None",
+               "R6: the strategic SUBSPACE predictor must be absent iff --strategic-off")
+    if off:
+        out += _eq("strategic_off", True, m.tactical_policy is not None,
+                   "model.tactical_policy is not None",
+                   "R6 KEEPS the tactical layer (that is what separates it from --no-hierarchy)")
+        out += _eq("strategic_off", True, getattr(m, "nav_inj_emb", None) is not None,
+                   "model.nav_inj_emb is not None", "R6 KEEPS nav")
+        for w in ("w_feat_str", "w_feat_str_ext", "w_str_label"):
+            out += _near("strategic_off", 0.0, getattr(m.cfg, w, None), f"model.cfg.{w}",
+                         "a strategic weight on a term that no longer exists")
+    return out
+
+
+def _c_vmax_input(m, a):
+    want = bool(_a(a, "vmax_input", False))
+    ctx, itn = getattr(m, "vmax_to_ctx", None), getattr(m, "vmax_to_intent", None)
+    out = _eq("vmax_input", want, ctx is not None and itn is not None,
+              "model.vmax_to_ctx / model.vmax_to_intent are not None",
+              "R1: the max-speed input path argv declares is not built")
+    if want and ctx is not None:
+        out += _eq("vmax_input", 4, int(ctx.in_features), "model.vmax_to_ctx.in_features",
+                   "the refcv6 4-way ladder")
+        out += _eq("vmax_input", 4, int(itn.in_features), "model.vmax_to_intent.in_features",
+                   "the refcv6 4-way ladder")
+    traj = getattr(m, "traj_head", None)
+    if want and traj is not None:
+        # the R5 condition must carry the 4 max-speed slots (R1 reaches the trajectory too)
+        out += _eq("vmax_input", int(m.traj_cond_dim()), int(traj.d_cond),
+                   "model.traj_head.d_cond", "R1 must reach the R5 head")
+    return out
+
+
+def _c_loss_head(dest, attr, width_fn=None):
+    def chk(m, a):
+        w = float(_a(a, dest, 0.0) or 0.0)
+        head = getattr(m, attr, None)
+        out = _eq(dest, w > 0.0, head is not None, f"model.{attr} is not None",
+                  "a loss weight > 0 with no head is inert; a head with weight 0 is untrained")
+        out += _near(dest, w, getattr(m.cfg, dest, None), f"model.cfg.{dest} (read by the loss)")
+        if head is not None and width_fn is not None:
+            want_w, got_w, where = width_fn(m, head)
+            out += _eq(dest, want_w, got_w, where)
+        return out
+    return chk
+
+
+def _goal_width(m, head):
+    from tanitad.data.v7_labels import TAC_GOAL_TOKENS
+    return len(TAC_GOAL_TOKENS), int(head[-1].out_features), "model.goal_head[-1].out_features"
+
+
+def _sb_width(m, head):
+    return 2, int(head[-1].out_features), "model.speed_band_head[-1].out_features"
+
+
+def _traj_width(m, head):
+    return int(m.cfg.traj_steps) * 2, int(head.out.out_features), "model.traj_head.out.out_features"
+
+
+def _c_r5_prior(m, a):
+    want = str(_a(a, "r5_prior", "kdx"))
+    if getattr(m, "traj_head", None) is None:
+        # the trainer refuses a non-default prior without --w-traj; nothing is built to read
+        return _eq("r5_prior", "kdx", want, "argv (no R5 head built)",
+                   "a prior stamped with no head to sit under")
+    return _eq("r5_prior", want, str(m.cfg.traj_prior), "model.cfg.traj_prior (read by "
+               "RefAV1.traj_readout on every forward)")
+
+
+def _c_r5_kappa_source(m, a):
+    want = str(_a(a, "r5_kappa_source", "steer_t0"))
+    if getattr(m, "traj_head", None) is None:
+        return _eq("r5_kappa_source", "steer_t0", want, "argv (no R5 head built)",
+                   "a kappa0 source stamped with no head to feed")
+    return _eq("r5_kappa_source", want, str(m.cfg.traj_kappa_source),
+               "model.cfg.traj_kappa_source (the loader is built from it: "
+               "`r1r6_loader_kwargs`)")
+
+
+def _c_cfg(dest, attr, want_fn, tol=None):
+    def chk(m, a):
+        want = want_fn(a)
+        got = getattr(m.cfg, attr, "<absent>")
+        if tol is not None:
+            return _near(dest, want, got, f"model.cfg.{attr}", tol=tol)
+        return _eq(dest, want, got, f"model.cfg.{attr}")
+    return chk
+
+
+def _c_motion_inject(m, a):
+    return _eq("motion_inject", bool(_a(a, "motion_inject", False)),
+               getattr(m, "motion_in", None) is not None, "model.motion_in is not None")
+
+
+def _c_detach_aux(m, a):
+    d = _a(a, "detach_aux", None)
+    return _eq("detach_aux", True if d is None else bool(d),
+               bool(m.cfg.detach_aux_targets), "model.cfg.detach_aux_targets")
+
+
+def _c_bptt(m, a):
+    want = int(_a(a, "bptt_truncate", 15))
+    out = _eq("bptt_truncate", want, int(getattr(m.operative, "bptt_truncate", -1)),
+              "model.operative.bptt_truncate")
+    out += _eq("bptt_truncate", want, int(getattr(m.tactical, "bptt_truncate", -1)),
+               "model.tactical.bptt_truncate")
+    return out
+
+
+def _c_speed_channel(m, a):
+    want = 2 + (1 if bool(_a(a, "speed_channel", False)) else 0)
+    return _eq("speed_channel", want, int(m.operative.act[0].in_features),
+               "model.operative.act[0].in_features", "(a, kappa) [+ v/30]")
+
+
+def _c_tmix(m, a):
+    g = _a(a, "tmix_groups", None)
+    want = int(m.cfg.d_state) if g is None else int(g)
+    return _eq("tmix_groups", want, int(m.adapter.tmix.groups), "model.adapter.tmix.groups")
+
+
+def _c_ema(m, a):
+    return _eq("ema_targets", bool(_a(a, "ema_targets", False)),
+               getattr(m, "ema", None) is not None, "model.ema is not None")
+
+
+def _c_target_space(m, a):
+    ts = str(_a(a, "target_space", "frozen"))
+    out = _eq("target_space", ts, str(m.cfg.target_space), "model.cfg.target_space")
+    out += _eq("target_space", ts == "frozen", getattr(m, "to_enc", None) is not None,
+               "model.to_enc is not None", "the frozen-target readout")
+    return out
+
+
+def _c_proposal_k(m, a):
+    k = int(_a(a, "proposal_k", 1))
+    c = m.cfg
+    out = _eq("proposal_k", k * int(c.plan_steps) * int(c.a_dim),
+              int(m.proposal[-1].out_features), "model.proposal[-1].out_features")
+    out += _eq("proposal_k", k > 1, getattr(m, "proposal_score", None) is not None,
+               "model.proposal_score is not None")
+    return out
+
+
+# ============================================================================
+# the registry -- one entry per `refa_v1_train.build_parser()` dest
+# ============================================================================
+register("no_hierarchy", "built", _c_no_hierarchy)
+register("strategic_off", "built", _c_strategic_off)
+register("vmax_input", "built", _c_vmax_input)
+register("w_goal", "loss", _c_loss_head("w_goal", "goal_head", _goal_width))
+register("w_speed_band", "loss", _c_loss_head("w_speed_band", "speed_band_head", _sb_width))
+register("w_traj", "loss", _c_loss_head("w_traj", "traj_head", _traj_width))
+register("r5_prior", "built", _c_r5_prior)
+register("r5_kappa_source", "built", _c_r5_kappa_source)
+register("goal_negatives", "elsewhere", reason=(
+    "a LOADER policy (`RefAV1Windows(goal_negatives=)` -> `v7_labels.tactical_goal_targets`), "
+    "not a model lever: the trainer refuses a non-default policy without --w-goal, fits the "
+    "head's pos_weight / class mask under THIS policy (`set_goal_supervision`, buffers in the "
+    "checkpoint) and stamps it as config.json goal_head.negatives"))
+register("cot_negative_sidecar", "data", reason=(
+    "the PI 2026-09-16 ruling as a file: `v7_labels.load_cot_negative_sidecar` refuses a sidecar "
+    "built over another blob md5, and the trainer requires it iff --goal-negatives "
+    "cot-absence-negative"))
+register("w_cf", "loss", _c_cfg("w_cf", "w_cf", lambda a: float(_a(a, "w_cf", 0.0)), tol=1e-12))
+register("cf_negs", "built", _c_cfg("cf_negs", "cf_negs", lambda a: int(_a(a, "cf_negs", 3))))
+register("cf_at_step", "built", _c_cfg("cf_at_step", "cf_at_step",
+                                       lambda a: int(_a(a, "cf_at_step", 4))))
+register("motion_inject", "built", _c_motion_inject)
+register("detach_aux", "built", _c_detach_aux)
+register("w_sigreg", "loss", _c_cfg("w_sigreg", "w_sigreg",
+                                    lambda a: float(_a(a, "w_sigreg", 0.0)), tol=1e-12))
+register("var_floor", "loss", _c_cfg("var_floor", "var_floor",
+                                     lambda a: float(_a(a, "var_floor", 0.0)), tol=1e-12))
+register("min_participation", "built", _c_cfg("min_participation", "min_participation",
+                                              lambda a: float(_a(a, "min_participation", 0.0)),
+                                              tol=1e-12))
+register("bptt_truncate", "built", _c_bptt)
+register("speed_channel", "built", _c_speed_channel)
+register("tmix_groups", "built", _c_tmix)
+register("ema_targets", "built", _c_ema)
+register("ema_decay", "built", _c_cfg("ema_decay", "ema_decay",
+                                      lambda a: float(_a(a, "ema_decay", 0.996)), tol=1e-12))
+register("ema_decay_end", "built", _c_cfg("ema_decay_end", "ema_decay_end",
+                                          lambda a: float(_a(a, "ema_decay_end", 0.999)),
+                                          tol=1e-12))
+register("target_space", "built", _c_target_space)
+register("w_aux_head", "loss", _c_cfg("w_aux_head", "w_aux_head",
+                                      lambda a: float(_a(a, "w_aux_head", 0.0)), tol=1e-12))
+register("proposal_k", "built", _c_proposal_k)
+for _d, _why in (
+        ("cache", "the stage-1 feature cache; its geometry is refused at load (`verify_cache`)"),
+        ("episodes", "the v2ep kinematics dir; the loader refuses a mis-gridded episode"),
+        ("labels", "the v7.2 label blob; its md5 is stamped by `load_v7_labels` (join_report)"),
+        ("nav", "the nav source; its md5 + the oracle stamp are in join_report"),
+        ("allow_unlabelled", "a REFUSAL switch (real cache without --labels), not a lever")):
+    register(_d, "data", reason=_why)
+for _d, _why in (
+        ("lru", "episodes held in RAM by the loader (a memory setting)"),
+        ("out", "the run directory"), ("steps", "the run length"),
+        ("bs", "the batch size (a loader argument)"),
+        ("lr", "the AdamW base lr (param group 1), stamped in config.json args"),
+        ("adapter_lr_mult", "the adapter param group's lr multiplier (optimizer)"),
+        ("log_every", "logging cadence"), ("save_every", "checkpoint cadence"),
+        ("seed", "the RNG seed (recorded)"), ("resume", "continue from <out>/ckpt.pt "
+                                                        "(strict load, `load_resume_state`)"),
+        ("smoke", "the CPU SmokeData rung (tiny dims, synthetic tensors) -- never a registered arm"),
+        ("device", "the torch device"),
+        ("precision", "the forward+loss autocast (stamped READ BACK by apply_precision_flags)"),
+        ("tf32", "a backend switch (stamped READ BACK)"),
+        ("clip", "the grad-norm clip (optimizer side)"),
+        ("skip_nonfinite", "an optimizer-step guard (counted in every log row)")):
+    register(_d, "runtime", reason=_why)
+
+
+# ============================================================================
+# the API
+# ============================================================================
+
+def coverage(parser) -> list[str]:
+    """Every ``dest`` of ``parser`` with no registry entry (``[]`` == every flag is covered)."""
+    dests = sorted({a.dest for a in parser._actions if a.dest not in ("help",)})
+    return [d for d in dests if d not in REGISTRY]
+
+
+def check(model, args, parser=None) -> list[Mismatch]:
+    """-> every declared-vs-built mismatch on the BUILT ``RefAV1``; ``[]`` == clean.
+
+    Order: unregistered flags first (a flag this guard cannot see is a hole in the guard), then
+    each lever in registry order, then G-HYG on the model's config tree."""
+    out: list[Mismatch] = []
+    if parser is not None:
+        for d in coverage(parser):
+            out.append(Mismatch(_flag(d), "a refav1 G-DVB registry entry", "none",
+                                "tanitad.train.declared_vs_built_refav1.REGISTRY",
+                                "a trainer flag with no declared-vs-built entry is refused: "
+                                "register it with its built reader"))
+    for lever in list(REGISTRY.values()):
+        if lever.kind in ("built", "loss") and lever.check is not None:
+            try:
+                out += list(lever.check(model, args) or [])
+            except Exception as e:                  # a reader that cannot read is a FAIL
+                out.append(Mismatch(_flag(lever.dest), "readable", f"{type(e).__name__}: {e}",
+                                    "refav1 G-DVB reader", "the built value could not be read"))
+    cfg = getattr(model, "cfg", None)
+    if cfg is not None:
+        for path, cls, attr in undeclared_attributes(cfg, "model.cfg"):
+            out.append(Mismatch(f"{path}.{attr}", "a declared field", "an ad-hoc attribute",
+                                f"{path} ({cls})", "G-HYG: dropped by the next rebuild"))
+    return out
+
+
+def refuse_on_mismatch(model, args, parser=None, where: str = "refa_v1_train") -> None:
+    """``SystemExit`` naming EVERY mismatch, or ``None`` when the build is clean."""
+    bad = check(model, args, parser)
+    if bad:
+        raise SystemExit(
+            f"[G-DVB refav1] ⛔⛔ {where}: {len(bad)} lever(s) DECLARED in argv are NOT what the "
+            f"model BUILT. Refusing before the first step -- a run that trains another arm "
+            f"while its record names this one is FALSE PROVENANCE:\n  - "
+            + "\n  - ".join(str(b) for b in bad))
diff --git a/stack/tests/test_refav1_dvb.py b/stack/tests/test_refav1_dvb.py
new file mode 100644
index 0000000..ff52224
--- /dev/null
+++ b/stack/tests/test_refav1_dvb.py
@@ -0,0 +1,139 @@
+"""G-DVB for `refa_v1_train.py` (PI 2026-09-27 item 4) -- declared-vs-built, refav1 profile.
+
+Pins, each with its deliberate-regression arm that must be REFUSED:
+  * COVERAGE: every `build_parser()` dest has an entry (a new flag cannot land without one),
+    and every PI 2026-09-27 flag is registered -- the model levers as `built` / `loss`;
+  * CLEAN: the trainer's own smoke builds (all flags off; all flags on) read back clean;
+  * each new lever's reader catches a model that does not have what argv declares;
+  * the trainer REFUSES before the first step when the build and argv disagree;
+  * the shared refcv7 registry is UNTOUCHED (a refav1 entry there would break refcv7).
+"""
+import argparse
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+from tanitad.train import declared_vs_built as dvb_refc
+from tanitad.train import declared_vs_built_refav1 as dvb
+
+_TRAIN = Path(__file__).resolve().parents[1] / "scripts" / "refa_v1_train.py"
+
+
+def _trainer():
+    spec = importlib.util.spec_from_file_location("_refa_v1_train_dvb", _TRAIN)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+T = _trainer()
+ON = ["--smoke", "--strategic-off", "--vmax-input", "--w-goal", "0.1", "--w-speed-band",
+      "0.1", "--w-traj", "1.0", "--r5-prior", "damp50"]
+
+
+def _built(argv):
+    a = T.build_parser().parse_args(argv)
+    torch.manual_seed(0)
+    return T.build_model(a), a
+
+
+def test_a_every_trainer_flag_has_an_entry_and_every_new_lever_is_checked():
+    p = T.build_parser()
+    assert dvb.coverage(p) == []
+    for d in dvb.NEW_2026_09_27:
+        assert d in dvb.REGISTRY, d
+    kinds = {d: dvb.REGISTRY[d].kind for d in dvb.NEW_2026_09_27}
+    for d in ("strategic_off", "vmax_input", "w_goal", "w_speed_band", "w_traj", "r5_prior",
+              "r5_kappa_source"):
+        assert kinds[d] in ("built", "loss"), (d, kinds[d])
+    # regression arm: a flag added to the parser WITHOUT an entry is reported by name
+    p.add_argument("--w-new-lever", type=float, default=0.0)
+    assert dvb.coverage(p) == ["w_new_lever"]
+    m, a = _built(["--smoke"])
+    bad = dvb.check(m, a, parser=p)
+    assert any("--w-new-lever" in str(x) for x in bad)
+
+
+@pytest.mark.parametrize("argv", [["--smoke"], ON, ["--smoke", "--no-hierarchy"],
+                                  ["--smoke", "--speed-channel", "--ema-targets",
+                                   "--proposal-k", "2", "--tmix-groups", "1"]])
+def test_b_the_trainers_own_builds_read_back_clean(argv):
+    m, a = _built(argv)
+    assert dvb.check(m, a, parser=T.build_parser()) == []
+
+
+def _drop(m, attr):
+    setattr(m, attr, None)
+    return m
+
+
+@pytest.mark.parametrize("argv,mutate,flag", [
+    (ON, lambda m: _drop(m, "traj_head"), "--w-traj"),
+    (ON, lambda m: _drop(m, "goal_head"), "--w-goal"),
+    (ON, lambda m: _drop(m, "speed_band_head"), "--w-speed-band"),
+    (ON, lambda m: _drop(m, "vmax_to_ctx"), "--vmax-input"),
+    (["--smoke", "--strategic-off"], None, "--strategic-off"),
+    (["--smoke", "--w-traj", "1", "--r5-prior", "cv"], None, "--r5-prior"),
+    (["--smoke", "--w-traj", "1", "--r5-kappa-source", "pose_past"], None,
+     "--r5-kappa-source"),
+    (["--smoke"], None, "--w-traj"),
+])
+def test_c_each_new_readers_regression_arm_is_caught(argv, mutate, flag):
+    m, a = _built(argv)
+    if mutate is not None:
+        mutate(m)
+    elif flag == "--strategic-off":
+        m, _ = _built(["--smoke"])                # built WITH the strategic layer
+    elif flag == "--r5-prior":
+        m.cfg.traj_prior = "kdx"                   # built on another prior than argv names
+    elif flag == "--r5-kappa-source":
+        m.cfg.traj_kappa_source = "steer_t0"       # built on another kappa0 source
+    else:
+        m, _ = _built(["--smoke", "--w-traj", "1"])   # a head argv never asked for
+    bad = dvb.check(m, a, parser=T.build_parser())
+    assert any(x.lever == flag for x in bad), [str(x) for x in bad]
+
+
+def test_d_G_HYG_an_undeclared_config_attribute_is_refused():
+    m, a = _built(["--smoke"])
+    m.cfg.w_traj_typo = 1.0                      # an ad-hoc attribute the next rebuild drops
+    bad = dvb.check(m, a)
+    assert any("w_traj_typo" in x.lever for x in bad)
+
+
+def test_e_the_trainer_refuses_before_the_first_step(tmp_path, monkeypatch):
+    real = T.build_model
+
+    def lossy(args):
+        m = real(args)
+        m.traj_head = None                       # the lever is LOST between argv and the build
+        return m
+    monkeypatch.setattr(T, "build_model", lossy)
+    with pytest.raises(SystemExit, match="G-DVB refav1"):
+        T.main(["--smoke", "--steps", "1", "--device", "cpu", "--out", str(tmp_path / "o"),
+                "--w-traj", "1"])
+    assert not (tmp_path / "o" / "train_log.jsonl").exists()
+
+
+def test_f_the_shared_refcv7_registry_is_untouched():
+    """A refav1 reader in the SHARED registry would run on a RefCV3Model at every refcv7
+    launch and fail it -- so the refav1 registry is its own dict and adds nothing there."""
+    assert dvb.REGISTRY is not dvb_refc.REGISTRY
+    for d in ("w_traj", "vmax_input", "strategic_off", "r5_prior", "w_speed_band", "w_goal"):
+        assert d not in dvb_refc.REGISTRY, d
+
+
+@pytest.mark.parametrize("argv,msg", [
+    (["--smoke", "--r5-prior", "cv"], "without --w-traj"),
+    (["--smoke", "--r5-kappa-source", "pose_past"], "without --w-traj"),
+    (["--smoke", "--goal-negatives", "cot-absence-negative"], "without --w-goal"),
+    (["--smoke", "--w-goal", "0.1", "--goal-negatives", "cot-absence-negative"], "ONE decision"),
+    (["--smoke", "--w-traj", "1", "--no-hierarchy"], "--no-hierarchy"),
+    (["--smoke", "--w-traj", "-1"], ">= 0")])
+def test_g_trainer_refusals(argv, msg, tmp_path):
+    with pytest.raises(SystemExit, match=msg):
+        T.main([*argv, "--steps", "1", "--device", "cpu", "--out", str(tmp_path / "o")])
