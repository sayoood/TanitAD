+def r1r6_refusals(a) -> None:
+    """⛔ The PI 2026-09-27 flags refuse every combination that would be
+    advertised in the launch line and inert (or silently narrower) in the run.
+    Called before anything touches the disk; a no-op with every flag off."""
+    on = {"--strategic-off": bool(getattr(a, "strategic_off", False)),
+          "--vmax-input": bool(getattr(a, "vmax_input", False)),
+          "--w-goal": float(getattr(a, "w_goal", 0.0) or 0.0) > 0.0,
+          "--w-speed-band": float(getattr(a, "w_speed_band", 0.0) or 0.0) > 0.0,
+          "--w-traj": float(getattr(a, "w_traj", 0.0) or 0.0) > 0.0}
+    for f, dest in (("--w-goal", "w_goal"), ("--w-speed-band", "w_speed_band"),
+                    ("--w-traj", "w_traj")):
+        if float(getattr(a, dest, 0.0) or 0.0) < 0.0:
+            raise SystemExit(f"⛔ {f} must be >= 0")
+    if a.no_hierarchy and any(on.values()):
+        raise SystemExit(
+            f"⛔ {sorted(k for k, v in on.items() if v)} with --no-hierarchy: "
+            "every PI 2026-09-27 lever acts on or through the TACTICAL layer, "
+            "which --no-hierarchy removes (R6's strategic-off arm is "
+            "--strategic-off, which KEEPS the tactical layer and nav)")
+    real = a.cache is not None
+    if real and not a.labels and (on["--vmax-input"] or on["--w-goal"]
+                                  or on["--w-speed-band"]):
+        raise SystemExit(
+            "⛔ --vmax-input / --w-goal / --w-speed-band read label fields "
+            "(SPEED_BAND, the goal set): they need --labels")
+    if real and on["--strategic-off"] and not a.nav:
+        raise SystemExit(
+            "⛔ --strategic-off without --nav: R6 keeps nav in the tactical "
+            "and operative layers, and with no nav source nav reaches NO layer")
+    neg = getattr(a, "goal_negatives", "measured")
+    side = getattr(a, "cot_negative_sidecar", None)
+    if neg != "measured" and not on["--w-goal"]:
+        raise SystemExit(f"⛔ --goal-negatives {neg} without --w-goal > 0: the "
+                         "policy would be stamped and inert")
+    if (side is not None) != (neg == "cot-absence-negative"):
+        raise SystemExit(
