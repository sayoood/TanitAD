+                         "prior would be stamped and inert")
+    if getattr(a, "r5_kappa_source", "steer_t0") != "steer_t0" and not on["--w-traj"]:
+        raise SystemExit(f"⛔ --r5-kappa-source {a.r5_kappa_source} without "
+                         "--w-traj > 0: the source would be stamped and inert")
