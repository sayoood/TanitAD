+def r1r6_cfg_kwargs(args) -> dict:
+    """The PI 2026-09-27 levers (R1/R3/R5/R6) as RefAV1Config kwargs.
+
+    ⛔ EMPTY when every new flag is at its default, so the OFF path builds the
+    config through EXACTLY the pre-directive call (and `getattr` keeps a caller
+    that hands `build_model` a pre-directive Namespace working). With
+    `--strategic-off` the three strategic loss weights are written as 0.0 into
+    the config -- the record then says the strategic terms are OFF instead of
+    advertising weights on terms that no longer exist (`sanity()` refuses the
+    other combination)."""
+    kw: dict = {}
+    if getattr(args, "strategic_off", False):
+        kw.update(strategic_off=True, w_feat_str=0.0, w_feat_str_ext=0.0,
+                  w_str_label=0.0)
+    if getattr(args, "vmax_input", False):
+        kw["vmax_input"] = True
+    for dest in ("w_goal", "w_speed_band", "w_traj"):
+        v = float(getattr(args, dest, 0.0) or 0.0)
+        if v:
+            kw[dest] = v
+    prior = getattr(args, "r5_prior", "kdx")
+    if prior != "kdx":
+        kw["traj_prior"] = prior
+    ksrc = getattr(args, "r5_kappa_source", "steer_t0")
+    if ksrc != "steer_t0":
+        kw["traj_kappa_source"] = ksrc
+    return kw
+
