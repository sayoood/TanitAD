+def _refav1_cap_unfloored(a, v0, v_max, dt, a_max):
+    """refav1's `_cap_speed`, VERBATIM in its arithmetic: the speed is tracked WITHOUT v6's
+    floor at 0. Used only as the discriminating control below."""
+    out = a.clone()
+    v = torch.full(a.shape[:-1], float(v0))
+    for t in range(a.shape[-1]):
+        lim = ((float(v_max) - v) / float(dt)).clamp(min=-float(a_max))
+        out[..., t] = torch.minimum(out[..., t], lim)
+        v = v + out[..., t] * float(dt)
+    return out
+
+
+def test_cap_LITERAL_tracks_the_v6_integrators_FLOOR_at_zero():
+    """⛔ The ONE deliberate difference from refav1, pinned with its control. v0 1.0, limit 1.2,
+    brake -4 x5 (the ego STOPS: 0.6, 0.2, 0, 0, 0) then +4 x6.
+      floored (this module): [-4]*5 + [4, 4, 4, 0, 0, 0] -> peak 1.2 m/s (legal)
+      refav1 unfloored     : [-4]*5 + [4, 4, 4, 4, 4, 2] -> peak 2.2 m/s through the v6
+                             integrator -- 1.0 m/s OVER the limit."""
+    a = torch.tensor([[-4.0] * 5 + [4.0] * 6])
+    v0, lim = torch.tensor([1.0]), torch.tensor([1.2])
+    got = cap_speed_profile(a, v0, lim, dt=DT, a_max=A_MAX)[0]
+    assert torch.allclose(got, torch.tensor([-4.0] * 5 + [4.0, 4.0, 4.0, 0.0, 0.0, 0.0]),
+                          atol=1e-4)
+    peak = float(closing_speeds(got[None, None], v0, dt=DT).max())
+    assert peak == pytest.approx(1.2, abs=1e-4)
+    ctl = _refav1_cap_unfloored(a, 1.0, 1.2, DT, A_MAX)[0]
+    assert torch.allclose(ctl, torch.tensor([-4.0] * 5 + [4.0] * 5 + [2.0]), atol=1e-4)
+    peak_ctl = float(closing_speeds(ctl[None, None], v0, dt=DT).max())
+    assert peak_ctl == pytest.approx(2.2, abs=1e-4)          # the control DOES exceed
+
+
+def _accelerating_stack(**kw) -> V6Stack:
+    """Every candidate commands a = +3 m/s^2 for all 60 steps, kappa 0 (the emission's raw
+    output is its final bias; `_squash` is the identity inside +-a_max)."""
+    s = _build(_cfg(**kw))
+    with torch.no_grad():
+        s.emission.net[-1].weight.zero_()
+        bias = torch.zeros_like(s.emission.net[-1].bias)
+        bias[0::2] = 3.0
+        s.emission.net[-1].bias.copy_(bias)
+    return s
+
