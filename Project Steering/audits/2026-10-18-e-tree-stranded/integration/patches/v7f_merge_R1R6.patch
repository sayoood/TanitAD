+    assert [float(y0[ix(t)]) for t in TL] == [0.0, 1.0, 0.0, 0.0]
+    assert [float(w0[ix(t)]) for t in TL] == [1.0, 1.0, 1.0, 1.0]   # colours ENTAILED negative
+    assert float(y0[ix("YIELD")]) == 1.0 and float(w0[ix("YIELD")]) == 1.0
