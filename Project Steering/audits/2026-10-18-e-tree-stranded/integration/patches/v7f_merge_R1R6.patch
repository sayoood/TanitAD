+def _c_anchor_goal(m, a) -> list:
+    want = str(_a(a, "anchor_goal", "none"))
+    out = _c_cfg("anchor_goal", "anchor_goal", lambda a: str(_a(a, "anchor_goal", "none")))(m, a)
