+def _pf(tmp_path, stage, *extra, dry=True):
+    argv = ["--stage", stage, "--out", str(tmp_path / "out"), "--horizons", "1",
+            *(["--dry-run"] if dry else ["--v2-cache", str(tmp_path)]), *extra]
+    ap = T.build_parser()
