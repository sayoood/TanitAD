+        _force_token(s.act_head_lat, 1)
+        p1 = s.forward(**b)
+        _force_token(s.act_head_lon, 0)
+        q0 = s.forward(**b)
+        _force_token(s.act_head_lon, 7)
+        q1 = s.forward(**b)
+    return (float((p0["plan"]["waypoints"] - p1["plan"]["waypoints"]).abs().max()),
+            float((q0["plan"]["waypoints"] - q1["plan"]["waypoints"]).abs().max()),
+            float((p0["a_lat"]["probs"] - p1["a_lat"]["probs"]).abs().max()))
