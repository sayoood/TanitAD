+    s = _build(_cfg(max_speed_input_v6=True, plan_vmax_cap=True))
+    a = _tiny_args(tmp_path, "S-T", "--max-speed-input-v6", "--plan-vmax-cap")
+    blk = r1r4_config_block(a, s)
+    assert_r1r4_record(dict(blk), a)                                  # clean
+    with pytest.raises(SpeedMaxStampError):
+        assert_r1r4_record({k: v for k, v in blk.items()
+                            if k != "speed_max_derivation_v6"}, a)
+    with pytest.raises(SystemExit, match="limit source"):
+        assert_r1r4_record({k: v for k, v in blk.items() if k != "plan_vmax_cap"}, a)
+    off = _tiny_args(tmp_path, "S-T")
+    with pytest.raises(SpeedMaxStampError):
+        assert_r1r4_record({"speed_max_derivation_v6": blk["speed_max_derivation_v6"]}, off)
+    with pytest.raises(SystemExit, match="control stamped as capped"):
+        assert_r1r4_record({"plan_vmax_cap": blk["plan_vmax_cap"]}, off)
+    assert r1r4_config_block(off, _build(_cfg())) == {}, "the default record is untouched"
+
+
+class _Ep:
+    def __init__(self, sid):
+        self.episode_id = sid
+
+
+def _write_sidecar(tmp_path, rows, *, md5="abc"):
+    p = tmp_path / "vmax.jsonl"
+    p.write_text("\n".join(json.dumps(r) for r in rows) + "\n", encoding="utf-8")
+    (tmp_path / "vmax.jsonl.meta.json").write_text(json.dumps({"source_md5": md5}))
+    return p
+
+
+def test_the_sidecar_JOIN_is_per_episode_by_stable_id_and_refuses_zero_coverage(tmp_path):
+    from train_v6_staged import build_vmax_join, vmax_batch
+    p = _write_sidecar(tmp_path, [{"sid": 11, "v_hi_ms": 12.5, "valid": 1, "bin": 1},
+                                  {"sid": 22, "v_hi_ms": None, "valid": 0},
+                                  {"sid": 33, "v_hi_ms": 30.0, "valid": 1, "bin": 3}])
+    eps = [_Ep(33), _Ep(11), _Ep(99), _Ep(22)]
+    index = [(0, 0), (1, 5), (2, 0), (3, 1), (1, 9)]
+    j = build_vmax_join(p, eps, index, label_md5="abc")
+    assert j["v"].tolist() == [30.0, 12.5, 0.0, 0.0]
+    assert j["ok"].tolist() == [1.0, 1.0, 0.0, 0.0]
+    assert j["report"]["n_windows_fed"] == 3 and j["report"]["n_windows"] == 5
+    bt = vmax_batch(j, [4, 2, 0], index, "cpu")
+    assert bt["v_max_ms"].tolist() == [12.5, 0.0, 30.0]
+    assert bt["v_max_valid"].tolist() == [1.0, 0.0, 1.0]
+    with pytest.raises(SystemExit, match="NOT ONE"):
+        build_vmax_join(p, [_Ep(99)], [(0, 0)], label_md5="abc")
+    from tanitad.refs.refcv6_max_speed import SpeedMaxStampError
+    with pytest.raises(SpeedMaxStampError, match="md5"):
+        build_vmax_join(p, eps, index, label_md5="a-different-blob")
+
+
+def test_the_DRY_RUN_exercises_all_three_levers_and_the_cap_never_exceeds(tmp_path):
+    from train_v6_staged import dry_run
+    out = tmp_path / "dry"
+    a = _tiny_args(out, "S-T", "--tac-op-cond", "e2e", "--max-speed-input-v6",
+                   "--plan-vmax-cap")
+    res = dry_run(a)
+    smoke = res["r1_r4"]["vmax_cap_smoke"]
+    assert smoke["n_plan_over_limit"] == 0
+    assert smoke["n_v0_over_limit"] >= 1, "the smoke's braking regime must be present"
+    cfg = json.loads((out / "config.json").read_text())
+    assert "speed_max_derivation_v6" in cfg and cfg["plan_vmax_cap"]["limit_source"]
+    assert cfg["v6_config"]["tac_op_cond"] == "e2e"
+    assert cfg["tac_op_cond"]["built"] and cfg["max_speed_input_v6"]["built"]
+
+
+def test_the_default_DRY_RUN_record_carries_no_R1_R4_key(tmp_path):
+    from train_v6_staged import dry_run
+    out = tmp_path / "dry0"
+    res = dry_run(_tiny_args(out, "S-T"))
+    assert "r1_r4" not in res
+    cfg = json.loads((out / "config.json").read_text())
+    assert not {"tac_op_cond", "speed_max_derivation_v6", "max_speed_input_v6",
+                "plan_vmax_cap"} & set(cfg)
+
+
+# =========================================================================== #
+# 6. G-DVB for the new levers (the refcv7-style PROPOSAL registry)
+# =========================================================================== #
+
+def test_every_new_trainer_flag_has_a_G_DVB_v6_entry():
+    from tanitad.train import declared_vs_built_v6 as dvb6
+    from train_v6_staged import build_parser
+    dests = {x.dest for x in build_parser()._actions}
+    assert set(dvb6.R1R4_DESTS) <= dests
+    assert dvb6.coverage(dvb6.R1R4_DESTS) == []
+
+
+def test_G_DVB_v6_is_clean_on_a_correct_build(tmp_path):
+    from tanitad.train import declared_vs_built_v6 as dvb6
+    from train_v6_staged import build_stack_from_args
+    for extra in ((), ("--tac-op-cond", "e2e", "--max-speed-input-v6", "--plan-vmax-cap"),
+                  ("--tac-op-cond", "detached")):
+        a = _tiny_args(tmp_path, "S-T", *extra)
+        assert dvb6.check(build_stack_from_args(a), a) == []
+
+
+def test_G_DVB_v6_CATCHES_a_lever_declared_but_not_built(tmp_path):
+    """The regression arm: argv declares every lever, the stack was built WITHOUT them."""
+    from tanitad.train import declared_vs_built_v6 as dvb6
+    a = _tiny_args(tmp_path, "S-T", "--tac-op-cond", "e2e", "--max-speed-input-v6",
+                   "--plan-vmax-cap")
+    bad = dvb6.check(_build(_cfg()), a)
+    names = {m.lever for m in bad}
+    assert {"--tac-op-cond", "--max-speed-input-v6", "--plan-vmax-cap"} <= names
+    with pytest.raises(SystemExit, match="G-DVB-v6"):
+        dvb6.refuse_on_mismatch(_build(_cfg()), a)
+    # ...and the MIRROR: built, not declared
+    bad = dvb6.check(_build(_cfg(tac_op_cond="e2e")), _tiny_args(tmp_path, "S-T"))
+    assert {m.lever for m in bad} == {"--tac-op-cond"}
