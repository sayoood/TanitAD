+    tab = getattr(getattr(m, "anchor_head", None), "anchors", None)
+    loaded = tab is not None and bool(tab.numel()) and bool((tab.detach().abs().sum() > 0).item())
+    return _eq("anchor_table", True, loaded, "stack.anchor_head.anchors (non-zero)",
