+def _behaviour_counterfactual(s: V6Stack) -> tuple[float, float, float]:
+    """(max|dplan| for a LAT behaviour swap, for a LON swap, max|d a_lat probs|)."""
+    b = s.synthetic_batch(2, seed=1)
+    with torch.no_grad():
