+
+def _c_vit5(m, a) -> list:
+    want = bool(_a(a, "vit5_encoder", False))
+    out = _c_cfg("vit5_encoder", "vit5_encoder", lambda a: bool(_a(a, "vit5_encoder", False)))(m, a)
+    return out + _eq("vit5_encoder", "ViT5Encoder" if want else "ViTEncoder",
