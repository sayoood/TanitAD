+def _verdict(text: str) -> dict:
+    """Parse a one-row inline backlog and return that row's verdict dict."""
+    rows, _s, _b, _missed = m.parse(
+        "## S\n\n| # | item | why |\n|---|---|---|\n" + text + "\n")
+    out = m.classify(rows)
+    assert len(out) == 1, out
+    return out[0]
