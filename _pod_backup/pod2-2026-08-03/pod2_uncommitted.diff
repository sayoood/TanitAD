-            row = {"step": step, "loss": float(total.item()), "lr": round(lr, 8),
-                   "data_s": round(t_data, 1), "step_s": round(t_step, 1)}
-            row.update(log)
-            row.update(_health_rows(hs))
-            t_data = t_step = 0.0
