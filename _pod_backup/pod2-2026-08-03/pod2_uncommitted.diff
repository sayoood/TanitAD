+    y_pred = torch.tensor([0, 0, 1, 1])
+    cm = eb.confusion_matrix(y_true, y_pred, 3)
+    assert eb.macro_f1(cm) == pytest.approx(1.0)
+    assert eb.balanced_accuracy(cm) == pytest.approx(1.0)
