+  function onKey(e) {
+    if (e.key === "/" && S.view === "home" && document.activeElement !== (S.dom && S.dom.input)) {
+      if (S.dom && S.dom.input) { S.dom.input.focus(); e.preventDefault(); }
+    } else if (e.key === "Escape") {
+      if (S.view === "detail") location.hash = "#/";
