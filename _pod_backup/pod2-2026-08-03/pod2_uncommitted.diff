+def check2_pixels_per_metre(comma_eps, pai_eps, comma_feff, pai_feff) -> dict:
+    gf_c = geom_sanity.check_ground_flow(comma_eps)
+    gf_p = geom_sanity.check_ground_flow(pai_eps)
