+# --------------------------------------------------------------------------- #
+# Statistics                                                                   #
+# --------------------------------------------------------------------------- #
+def test_mean_ci95_basic():
+    mean, ci = bk.mean_ci95([1.0, 2.0, 3.0])
+    assert mean == pytest.approx(2.0)
+    assert ci == pytest.approx(1.96 * 1.0 / math.sqrt(3), rel=1e-6)
+
