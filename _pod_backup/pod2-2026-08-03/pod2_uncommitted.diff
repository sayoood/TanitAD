+  function drawManeuverStrip(canvas) {
+    var steps = curEpisode().steps;
+    var f = fit(canvas, 30), ctx = f.ctx;
+    var n = steps.length, bw = f.w / n;
+    for (var i = 0; i < n; i++) {
