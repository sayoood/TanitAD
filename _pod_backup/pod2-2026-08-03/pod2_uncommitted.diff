-def _corpus_scopes(corpus: list[str]) -> dict[str, Tensor]:
-    scopes = {"_all": torch.ones(len(corpus), dtype=torch.bool)}
-    for c in sorted(set(corpus)):
-        scopes[c] = torch.tensor([x == c for x in corpus])
-    return scopes
-
