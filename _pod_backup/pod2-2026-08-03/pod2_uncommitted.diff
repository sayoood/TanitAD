-    def __init__(self, imag_threshold: float = 1.0, rank_floor: float = 4.0,
-                 mrc_hook=None):
-        self.imag_threshold = imag_threshold
-        self.rank_floor = rank_floor
-        self.mrc_hook = mrc_hook
