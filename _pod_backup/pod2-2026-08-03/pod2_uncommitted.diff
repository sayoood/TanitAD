-    data_iter = iter(dl)
-    accum = max(1, args.accum)
-    t_data = t_step = 0.0
-    logf = (out_dir / "finetune_log.jsonl").open("a")
-    t0 = time.time()
-
-    def save_ckpt(s):
-        tmp = ckpt_path.with_suffix(".tmp")
-        blob = {"model": model.state_dict(), "opt": opt.state_dict(), "step": s,
-                "mode": args.mode}
