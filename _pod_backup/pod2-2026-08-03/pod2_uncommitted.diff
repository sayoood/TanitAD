-ROUTE_H = 100                                     # 10 s route-intent lookahead
-ROUTE_MIN = 50                                    # >=5 s of future -> route-valid
-LATENT_SOURCES = ("encoder_state", "operative_k4", "tactical_k8", "tactical_k16")
