-def _flow_quality(gf: dict) -> bool:
-    foe = gf.get("horizon_row_FOE")
-    n = gf.get("n_straight_fast_bright_pairs", 0)
-    fh = gf.get("scale_fit", {}).get("f_times_h")
-    return bool(foe is not None and 96 <= foe <= 160 and n >= 40 and fh)
