+        log["route_vis"] = loss_route_vis.item()
+    if ego_r2 is not None:                       # lever on AND ego present
+        log["decorr"] = loss_decorr.item()
+        log["ego_r2"] = round(float(ego_r2), 4)  # DETACHED vision-reliance proxy
