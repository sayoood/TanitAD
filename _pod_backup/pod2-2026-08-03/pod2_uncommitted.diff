+    def param_table():
+        c = lambda m: sum(p.numel() for p in m.parameters())  # noqa: E731
+        return {
+            "operative": c(model.predictor) + c(model.inv_dyn),
+            "tactical_pred": c(model.tactical_pred) if model.tactical_pred else 0,
