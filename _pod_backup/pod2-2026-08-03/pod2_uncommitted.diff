-def _stats(x) -> dict:
-    a = np.asarray(x, float)
-    return {"mean": round(float(a.mean()), 3), "median": round(float(np.median(a)), 3),
-            "min": round(float(a.min()), 3), "max": round(float(a.max()), 3),
