+# --------------------------------------------------------------------------- #
+# CHECK 2 — empirical cross-corpus pixels-per-metre                            #
+# --------------------------------------------------------------------------- #
+def _flow_quality(gf: dict) -> bool:
+    foe = gf.get("horizon_row_FOE")
